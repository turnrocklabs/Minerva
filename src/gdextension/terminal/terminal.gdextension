[configuration]

entry_symbol = "terminal_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

; Windows
windows.template_debug.x86_64 = "res://bin/libterminal.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://bin/libterminal.windows.template_release.x86_64.dll"
windows.editor.x86_64 = "res://bin/libterminal.windows.template_debug.x86_64.dll"

; Linux
linux.template_debug.x86_64 = "res://bin/libterminal.linux.template_debug.x86_64.so"
linux.template_release.x86_64 = "res://bin/libterminal.linux.template_release.x86_64.so"
linux.editor.x86_64 = "res://bin/libterminal.linux.template_debug.x86_64.so"

; macOS (universal binary - works for both x86_64 and arm64)
macos.template_debug = "res://bin/libterminal.macos.template_debug.framework"
macos.template_release = "res://bin/libterminal.macos.template_release.framework"
macos.editor = "res://bin/libterminal.macos.template_debug.framework"

[dependencies]

; Source paths are relative to this .gdextension file; mirrors the working
; godot_cef.gdextension pattern. Godot's exporter ignores `res://`-prefixed
; entries here, so the shim wouldn't ship next to the exported binary.
linux.x86_64 = {
    "../../bin/libminerva-vt.so": ""
}

macos = {
    "../../bin/libminerva-vt.dylib": ""
}
