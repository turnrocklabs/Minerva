extends SceneTree
## Frozen PRE-extraction contracts. Expected dictionaries are checked-in data,
## never generated by the serializer during a verification run. JSON round
## trips normalize numeric representation only; no model fields are ignored.
const FIXTURE := "res://test/fixtures/spreadsheet_contract/"
const Data := preload("res://Scripts/UI/Controls/SpreadsheetEditor/SpreadsheetData.gd")
const Files := preload("res://Scripts/UI/Controls/SpreadsheetEditor/SpreadsheetFileHandler.gd")
var passed := 0
var failed := 0

class Manager extends RefCounted:
	var tool_registry: Dictionary = {}
	var http_server: Object = null

func _init() -> void:
	process_frame.connect(run, CONNECT_ONE_SHOT)

func check(label: String, ok: bool) -> void:
	if ok:
		passed += 1
		print("PASS: " + label)
	else:
		failed += 1
		printerr("FAIL: " + label)

func read_json(name: String) -> Variant:
	return JSON.parse_string(FileAccess.get_file_as_string(FIXTURE + name))

func json_value(value: Variant) -> Variant:
	return JSON.parse_string(JSON.stringify(value))

func catalog() -> Array:
	var manager := Manager.new()
	var server = load("res://Scripts/Services/MCP/MinervaMCPServer.gd").new()
	server.mcp_manager = manager
	for path: String in ["MCPSpreadsheetTools", "MCPSpreadsheetFilterTools"]:
		var module = load("res://Scripts/Services/MCP/Modules/" + path + ".gd").new(server)
		module.register_tools()
	var snapshot := MCPExportCatalog.new().snapshot(manager.tool_registry)
	check("registered spreadsheet catalog exports successfully", snapshot.get("ok", false))
	return snapshot.get("tools", [])

func run() -> void:
	create_timer(30.0).timeout.connect(func() -> void:
		printerr("FAIL: spreadsheet contract stalled")
		quit(1))
	var host := root.get_node("SingletonObject")
	var ui := preload("res://test/helpers/chat_host_render_fixture.gd").new()
	ui.install(host)
	var tools := catalog()
	if "--write-tools" in OS.get_cmdline_user_args():
		var output := FileAccess.open(FIXTURE + "tools.json", FileAccess.WRITE)
		output.store_string(JSON.stringify(tools, "\t") + "\n")
	else:
		check("current names/descriptions/input schemas match frozen catalog",
			json_value(tools) == read_json("tools.json"))
	var expected: Dictionary = read_json("baseline.minsheet")
	var data := Data.new()
	check("native fixture imports", Files.import_file(FIXTURE + "baseline.minsheet", data) == OK)
	check("complete native model is unchanged", json_value(data.to_dict()) == expected)
	check("formula evaluates to independent oracle 2+3", _recalculate(data))
	check("filter preserves hidden cells", not data.autofilter.is_row_visible(2)
		and data.get_cell_display(2, 0) == "hide")
	var native_path := "user://contract-roundtrip.minsheet"
	check("native model exports", Files.export_file(native_path, data) == OK)
	var reopened := Data.new()
	check("native model reopens with every saved field", Files.import_file(native_path, reopened) == OK
		and json_value(reopened.to_dict()) == expected)
	await session_and_note(host)
	for extension: String in ["csv", "tsv", "xlsx"]:
		var imported := Data.new()
		check(extension + " imports", Files.import_file(FIXTURE + "sample." + extension, imported) == OK)
		check(extension + " complete import model matches oracle",
			json_value(imported.to_dict()) == read_json(extension + "-expected.json"))
		if extension == "xlsx":
			check("XFAIL minerva:01a14b6935b8: inline strings currently lost", imported.get_cell_display(1, 0).is_empty())
		var restored := Data.new()
		restored.load_from_dict(json_value(imported.to_dict()))
		check(extension + " imported model survives native serialization",
			json_value(restored.to_dict()) == read_json(extension + "-expected.json"))
	var original := data.to_dict()
	for name: String in ["malformed.minsheet", "not-an-object.minsheet"]:
		var before := FileAccess.get_file_as_bytes(FIXTURE + name)
		check(name + " refuses without clearing model or rewriting input",
			Files.import_file(FIXTURE + name, data) != OK and data.to_dict() == original
			and FileAccess.get_file_as_bytes(FIXTURE + name) == before)
	var future := Data.new()
	var future_bytes := FileAccess.get_file_as_bytes(FIXTURE + "future.minsheet")
	var future_error := Files.import_file(FIXTURE + "future.minsheet", future)
	# Strict expected failure: an unexpected fix must remove this baseline and
	# add the desired refusal assertion, rather than silently staying green.
	check("XFAIL minerva:01a14b668a56: future version currently accepted and downgraded",
		future_error == OK and int(future.to_dict().version) == 1
		and json_value(future.to_dict()) == expected)
	check("future import leaves original bytes intact", future_bytes == FileAccess.get_file_as_bytes(FIXTURE + "future.minsheet"))
	DirAccess.remove_absolute(native_path)
	ui.restore()
	print("=== Results: %d passed, %d failed ===" % [passed, failed])
	quit(1 if failed else 0)

func _recalculate(data: Data) -> bool:
	data.recalculate_all()
	return data.get_cell_display(3, 1) == "5"

func session_and_note(host: Node) -> void:
	var saved_pane = host.editor_pane
	var pane = load("res://Scripts/UI/Views/EditorPane.gd").new()
	var tabs := TabContainer.new()
	root.add_child(tabs)
	pane.Tabs = tabs
	host.editor_pane = pane
	var container_script = load("res://Scripts/UI/Controls/vboxEditor.gd")
	var saved_container = host.editor_container
	var container = container_script.new()
	container.editor_pane = pane
	host.editor_container = container
	root.add_child(container)
	var plain: Dictionary = read_json("no-chart-session.minproj")
	var restored: Array = await container_script.deserialize(plain.Editors)
	check("production legacy session restore returns one opaque Sheets tab", restored.size() == 1
		and restored[0].type == Editor.Type.PLUGIN_SCENE and restored[0].pending_plugin_entry == plain.Editors[0])
	for view: Control in restored:
		tabs.add_child(view)
		tabs.set_tab_title(tabs.get_tab_count() - 1, plain.Editors[0].name)
	await process_frame
	check("production legacy session restore preserves complete non-chart model",
		json_value(await container.serialize()) == plain.Editors)
	for view: Control in restored:
		view.free()
	await package_roundtrip(container_script, container, tabs, plain)
	var fixture: Dictionary = read_json("session.minproj")
	# Restore the session content on a mounted editor, as required by chart UI.
	# The outer EditorContainer static restore is separately tracked: it calls
	# deserialize before mounting (bug minerva:01a14b693555).
	var editor_script = load("res://Scripts/UI/Controls/Editor.gd")
	var entry: Dictionary = fixture.Editors[0]
	check("legacy session uses the production spreadsheet type", int(entry.type) == editor_script.Type.SPREADSHEET)
	var editor = editor_script.create(int(entry.type), entry.file, entry.name, null, false)
	var editors: Array = [editor]
	tabs.add_child(editor)
	tabs.set_tab_title(0, entry.name)
	await process_frame
	editor.spreadsheet_editor.deserialize(entry.content)
	await process_frame
	var serializer = container_script.new()
	serializer.editor_pane = pane
	check("whole session editor envelope and charts round-trip", json_value(await serializer.serialize()) == fixture.Editors)
	if not editors.is_empty():
		check("chart native-file loss remains explicit (minerva:01a14b6689f0)",
			editors[0].spreadsheet_editor.serialize().charts.size() == 1
			and editors[0].spreadsheet_editor.spreadsheet_data.to_dict().charts.is_empty())
	var note_script = load("res://Scripts/UI/Controls/Note.gd")
	var note_fixture: Dictionary = read_json("linked-note.json")
	var note = note_script.deserialize(note_fixture, false)
	root.add_child(note)
	await process_frame
	var serialized: Dictionary = note.serialize()
	check("complete stable linked-note model reopens", normalized_note(serialized) == normalized_note(note_fixture))
	var reloaded = note_script.deserialize(json_value(serialized), false)
	root.add_child(reloaded)
	await process_frame
	check("complete stable linked-note model survives second save/reopen",
		normalized_note(reloaded.serialize()) == normalized_note(note_fixture))
	note.free()
	reloaded.free()
	tabs.free()
	serializer.free()
	container.free()
	host.editor_container = saved_container
	pane.free()
	host.editor_pane = saved_pane

func normalized_note(value: Dictionary) -> Dictionary:
	var normalized: Dictionary = json_value(value)
	var exclusions: Dictionary = read_json("known-gaps.json")
	for key: String in exclusions.volatile_note_fields:
		normalized.erase(key)
	return normalized

## R17: public package APIs over the real type-6 editor format. The current
## native sheet is not a plugin: collect/apply must leave its payload intact.
## After extraction these same gates must exercise the actual provider hooks.
func package_roundtrip(container_script: Script, container: Object, tabs: TabContainer, plain: Dictionary) -> void:
	var workspace := ProjectSettings.globalize_path("user://sheet-package-contract")
	var unpack_dir := workspace.path_join("unpacked")
	check("package destination starts clean", not DirAccess.dir_exists_absolute(unpack_dir))
	if DirAccess.dir_exists_absolute(unpack_dir):
		return
	DirAccess.make_dir_recursive_absolute(workspace)
	var source := workspace.path_join("sheet.minsheet")
	check("stage frozen sheet file", DirAccess.copy_absolute(FIXTURE + "baseline.minsheet", source) == OK)
	var source_hash := FileAccess.get_sha256(source)
	var sidecar: Dictionary = read_json("package-sidecar.json")
	check("stage annotation sidecar", AnnotationSidecar.write_sidecar(source, sidecar) == OK)
	var project := plain.duplicate(true)
	project.Editors[0].file = source
	var project_path := workspace.path_join("session.minproj")
	var project_file := FileAccess.open(project_path, FileAccess.WRITE)
	project_file.store_string(JSON.stringify(project))
	project_file.close()
	var saved: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(project_path))
	check("on-disk minproj save preserves complete project envelope", saved == project)
	var reopened: Array = await container_script.deserialize(saved.Editors)
	for view: Control in reopened:
		tabs.add_child(view)
		tabs.set_tab_title(tabs.get_tab_count() - 1, plain.Editors[0].name)
	await process_frame
	check("on-disk minproj reopens identical complete sheet", json_value(await container.serialize()) == project.Editors)
	for view: Control in reopened:
		view.free()
	var package = load("res://Scripts/Models/ProjectPackage.gd").new()
	var manager = load("res://Scripts/Services/Plugins/PluginManager.gd").new()
	var extras: Array = await package.collect_plugin_exports(project, manager, workspace)
	check("native sheet collect hook adds no plugin exports or payload changes", extras.is_empty() and project == saved)
	var archive := workspace.path_join("sheet.minpackage")
	check("package saves real sheet and sidecar", package.save_package(project,
		PackedStringArray([source]), PackedStringArray(["sheet.minsheet"]), archive) == OK)
	check("package opens", package.open_package(archive) == OK)
	var unpacked_project := unpack_dir.path_join("project.minproj")
	check("package unpacks into clean user directory", package.unpack(unpack_dir, unpacked_project) == OK)
	package.close()
	var unpacked: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(unpacked_project))
	var expected := project.duplicate(true)
	expected.Editors[0].file = unpack_dir.path_join("sheet.minsheet")
	expected.Editors[0].sidecar = "sheet.minsheet.annotations.json"
	await package.apply_plugin_exports(unpacked, unpack_dir, manager)
	check("unpacked project paths and all payload fields match oracle", unpacked == expected)
	check("packaged sheet bytes and original source are unchanged",
		FileAccess.get_sha256(expected.Editors[0].file) == source_hash and FileAccess.get_sha256(source) == source_hash)
	check("packaged sidecar preserves its complete model", json_value(AnnotationSidecar.read_sidecar(expected.Editors[0].file)) == sidecar)
	var views: Array = await container_script.deserialize(unpacked.Editors)
	for view: Control in views:
		tabs.add_child(view)
		tabs.set_tab_title(tabs.get_tab_count() - 1, plain.Editors[0].name)
	await process_frame
	var expected_editors: Array = project.Editors.duplicate(true)
	expected_editors[0].file = expected.Editors[0].file
	check("unpacked minproj reopens identical complete sheet", json_value(await container.serialize()) == expected_editors)
	for view: Control in views:
		view.free()
	manager.free()
	check("remove only test-owned package workspace", remove_package_workspace(workspace) == OK
		and not DirAccess.dir_exists_absolute(workspace))

func remove_package_workspace(path: String) -> Error:
	var workspace := ProjectSettings.globalize_path("user://sheet-package-contract").simplify_path()
	if path != path.simplify_path() or (path != workspace and not path.begins_with(workspace + "/")):
		return ERR_INVALID_PARAMETER
	var parent := DirAccess.open(path.get_base_dir())
	if parent == null or parent.is_link(path.get_file()):
		return ERR_INVALID_PARAMETER
	var directory := DirAccess.open(path)
	if directory == null:
		return ERR_CANT_OPEN
	for name: String in directory.get_files():
		var error := directory.remove(name)
		if error != OK:
			return error
	for name: String in directory.get_directories():
		var error := remove_package_workspace(path.path_join(name))
		if error != OK:
			return error
	return DirAccess.remove_absolute(path)
