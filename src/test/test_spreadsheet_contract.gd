extends SceneTree
## Frozen PRE-extraction contracts. Expected dictionaries are checked-in data,
## never generated by the serializer during a verification run. JSON round
## trips normalize numeric representation only; no model fields are ignored.
const FIXTURE := "res://test/fixtures/spreadsheet_contract/"
const Data := preload("res://Scripts/UI/Controls/SpreadsheetEditor/SpreadsheetData.gd")
const Files := preload("res://Scripts/UI/Controls/SpreadsheetEditor/SpreadsheetFileHandler.gd")
var passed := 0
var failed := 0

class Manager extends RefCounted:
	var tool_registry: Dictionary = {}
	var http_server: Object = null

func _init() -> void:
	process_frame.connect(run, CONNECT_ONE_SHOT)

func check(label: String, ok: bool) -> void:
	if ok:
		passed += 1
		print("PASS: " + label)
	else:
		failed += 1
		printerr("FAIL: " + label)

func read_json(name: String) -> Variant:
	return JSON.parse_string(FileAccess.get_file_as_string(FIXTURE + name))

func json_value(value: Variant) -> Variant:
	return JSON.parse_string(JSON.stringify(value))

func catalog() -> Array:
	var manager := Manager.new()
	var server = load("res://Scripts/Services/MCP/MinervaMCPServer.gd").new()
	server.mcp_manager = manager
	for path: String in ["MCPSpreadsheetTools", "MCPSpreadsheetFilterTools"]:
		var module = load("res://Scripts/Services/MCP/Modules/" + path + ".gd").new(server)
		module.register_tools()
	var snapshot := MCPExportCatalog.new().snapshot(manager.tool_registry)
	check("registered spreadsheet catalog exports successfully", snapshot.get("ok", false))
	return snapshot.get("tools", [])

func run() -> void:
	create_timer(30.0).timeout.connect(func() -> void:
		printerr("FAIL: spreadsheet contract stalled")
		quit(1))
	var host := root.get_node("SingletonObject")
	var ui := preload("res://test/helpers/chat_host_render_fixture.gd").new()
	ui.install(host)
	var tools := catalog()
	if "--write-tools" in OS.get_cmdline_user_args():
		var output := FileAccess.open(FIXTURE + "tools.json", FileAccess.WRITE)
		output.store_string(JSON.stringify(tools, "\t") + "\n")
	else:
		check("current names/descriptions/input schemas match frozen catalog",
			json_value(tools) == read_json("tools.json"))
	var expected: Dictionary = read_json("baseline.minsheet")
	var data := Data.new()
	check("native fixture imports", Files.import_file(FIXTURE + "baseline.minsheet", data) == OK)
	check("complete native model is unchanged", json_value(data.to_dict()) == expected)
	check("formula evaluates to independent oracle 2+3", _recalculate(data))
	check("filter preserves hidden cells", not data.autofilter.is_row_visible(2)
		and data.get_cell_display(2, 0) == "hide")
	var native_path := "user://contract-roundtrip.minsheet"
	check("native model exports", Files.export_file(native_path, data) == OK)
	var reopened := Data.new()
	check("native model reopens with every saved field", Files.import_file(native_path, reopened) == OK
		and json_value(reopened.to_dict()) == expected)
	await session_and_note(host)
	for extension: String in ["csv", "tsv", "xlsx"]:
		var imported := Data.new()
		check(extension + " imports", Files.import_file(FIXTURE + "sample." + extension, imported) == OK)
		check(extension + " complete import model matches oracle",
			json_value(imported.to_dict()) == read_json(extension + "-expected.json"))
		if extension == "xlsx":
			check("XFAIL minerva:01a14b6935b8: inline strings currently lost", imported.get_cell_display(1, 0).is_empty())
		var restored := Data.new()
		restored.load_from_dict(json_value(imported.to_dict()))
		check(extension + " imported model survives native serialization",
			json_value(restored.to_dict()) == read_json(extension + "-expected.json"))
	var original := data.to_dict()
	for name: String in ["malformed.minsheet", "not-an-object.minsheet"]:
		var before := FileAccess.get_file_as_bytes(FIXTURE + name)
		check(name + " refuses without clearing model or rewriting input",
			Files.import_file(FIXTURE + name, data) != OK and data.to_dict() == original
			and FileAccess.get_file_as_bytes(FIXTURE + name) == before)
	var future := Data.new()
	var future_bytes := FileAccess.get_file_as_bytes(FIXTURE + "future.minsheet")
	var future_error := Files.import_file(FIXTURE + "future.minsheet", future)
	# Strict expected failure: an unexpected fix must remove this baseline and
	# add the desired refusal assertion, rather than silently staying green.
	check("XFAIL minerva:01a14b668a56: future version currently accepted and downgraded",
		future_error == OK and int(future.to_dict().version) == 1
		and not future.to_dict().has("future_payload"))
	check("future import leaves original bytes intact", future_bytes == FileAccess.get_file_as_bytes(FIXTURE + "future.minsheet"))
	DirAccess.remove_absolute(native_path)
	ui.restore()
	print("=== Results: %d passed, %d failed ===" % [passed, failed])
	quit(1 if failed else 0)

func _recalculate(data: Data) -> bool:
	data.recalculate_all()
	return data.get_cell_display(3, 1) == "5"

func session_and_note(host: Node) -> void:
	var saved_pane = host.editor_pane
	var pane = load("res://Scripts/UI/Views/EditorPane.gd").new()
	var tabs := TabContainer.new()
	root.add_child(tabs)
	pane.Tabs = tabs
	host.editor_pane = pane
	var container_script = load("res://Scripts/UI/Controls/vboxEditor.gd")
	var fixture: Dictionary = read_json("session.minproj")
	# Restore the session content on a mounted editor, as required by chart UI.
	# The outer EditorContainer static restore is separately tracked: it calls
	# deserialize before mounting (bug minerva:01a14b693555).
	var editor_script = load("res://Scripts/UI/Controls/Editor.gd")
	var entry: Dictionary = fixture.editors[0]
	check("legacy session uses the production spreadsheet type", int(entry.type) == editor_script.Type.SPREADSHEET)
	var editor = editor_script.create(int(entry.type), entry.file, entry.name, null, false)
	var editors: Array = [editor]
	tabs.add_child(editor)
	tabs.set_tab_title(0, entry.name)
	await process_frame
	editor.spreadsheet_editor.deserialize(entry.content)
	await process_frame
	var serializer = container_script.new()
	serializer.editor_pane = pane
	check("whole session editor envelope and charts round-trip", json_value(await serializer.serialize()) == fixture.editors)
	if not editors.is_empty():
		check("chart native-file loss remains explicit (minerva:01a14b6689f0)",
			editors[0].spreadsheet_editor.serialize().charts.size() == 1
			and editors[0].spreadsheet_editor.spreadsheet_data.to_dict().charts.is_empty())
	var note_script = load("res://Scripts/UI/Controls/Note.gd")
	var note_fixture: Dictionary = read_json("linked-note.json")
	var note = note_script.deserialize(note_fixture, false)
	root.add_child(note)
	await process_frame
	var serialized: Dictionary = note.serialize()
	var note_matches := true
	for key: String in note_fixture:
		note_matches = note_matches and serialized.get(key) == note_fixture[key]
	check("linked note reopens content, identity and tab-name link", note_matches)
	var reloaded = note_script.deserialize(json_value(serialized), false)
	root.add_child(reloaded)
	await process_frame
	check("linked note survives second save/reopen", reloaded.linked_spreadsheet == "Contract sheet"
		and reloaded.get_controls_container().content == note_fixture.Content)
	note.free()
	reloaded.free()
	tabs.free()
	serializer.free()
	pane.free()
	host.editor_pane = saved_pane
