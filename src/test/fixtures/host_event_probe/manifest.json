{
  "id": "host_event_probe",
  "name": "Host Event Probe",
  "version": "0.1.0",
  "host_api_version": "1",
  "backend": {
    "transport": "stdio",
    "entrypoint": "python3",
    "args": [
      "host_event_probe.py"
    ]
  },
  "ui": {
    "panels": [],
    "ipc_messages": []
  },
  "permissions": {
    "host_capabilities": [
      "host.audio",
      "host.chat.input"
    ],
    "network": {
      "mode": "none"
    },
    "filesystem": {
      "mode": "none",
      "paths": []
    },
    "host_events": [
      "chat.turn_completed",
      "chat.directory_changed",
      "voice.audio"
    ]
  }
}
