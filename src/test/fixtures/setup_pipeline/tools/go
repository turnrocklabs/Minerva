#!/usr/bin/env bash
# Combined fake `go` toolchain for SetupPipeline functional tests
# (DCR 019f69428fa0). Unlike fixtures/plugin_setup/fake-go (which only
# understands `go build`), this fixture ALSO answers `go version` so a single
# binary can be resolved by ToolchainRegistry.preflight() (search_dirs_override
# pointed at this file's directory) AND then invoked by SetupExecutors for the
# actual build step, exactly like a real toolchain candidate would be used by
# the real pipeline end to end.
#
# It also increments an invocation-count marker file inside the target build
# dir on every `build` call (never on `version` calls) — F13's always-build
# proof needs a way to observe that a second pipeline run genuinely re-invoked
# the tool rather than skipping it via some cache.
set -euo pipefail

if [[ "${1:-}" == "version" ]]; then
	echo "go version go1.22.4 linux/amd64"
	exit 0
fi

dir=""
output=""
while [[ $# -gt 0 ]]; do
	case "$1" in
		-C)
			dir="$2"
			shift 2
			;;
		-o)
			output="$2"
			shift 2
			;;
		build)
			shift
			;;
		*)
			# package argument (e.g. "./") — ignored by this fake
			shift
			;;
	esac
done

if [[ -z "$output" ]]; then
	echo "fake-go: missing -o" 1>&2
	exit 1
fi

if [[ -n "$dir" ]]; then
	marker="$dir/.fake_go_invocations"
	count=0
	if [[ -f "$marker" ]]; then
		count="$(cat "$marker")"
	fi
	count=$((count + 1))
	echo "$count" > "$marker"
	cd "$dir"
fi

mkdir -p "$(dirname "$output")"
printf 'fake-go binary\n' > "$output"
exit 0
