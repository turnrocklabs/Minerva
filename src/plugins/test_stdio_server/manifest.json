{
  "id": "test_stdio_server",
  "name": "Test Stdio Server",
  "version": "0.1.0",
  "host_api_version": "1",
  "backend": {
    "transport": "stdio",
    "entrypoint": "python",
    "args": ["server.py"]
  },
  "tools": [
    {
      "name": "minerva_test_stdio_server_echo_text",
      "description": "Echoes back the input text with a prefix. Used to validate MCP stdio transport end-to-end.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to echo back"
          }
        },
        "required": ["text"]
      }
    }
  ],
  "permissions": {
    "host_capabilities": [],
    "network": {
      "mode": "none"
    },
    "filesystem": {
      "mode": "none"
    }
  }
}
