#!/usr/bin/env python
import os
import sys

env = SConscript("godot-cpp/SConstruct")

# Add include paths for both common and terminal root.
# The ghostty-shim include path is only added for unix platforms — Windows
# terminal.cpp doesn't use the shim (it uses native Windows PTY APIs instead).
env.Append(CPPPATH=[
    "gdextension/terminal/",       # For terminal root
    "gdextension/terminal/common",  # For common interface
])
if env["platform"] != "windows":
    env.Append(CPPPATH=["gdextension/terminal/ghostty-shim/zig-out/include"])
    # Link against minerva-vt shim library (ghostty-vt wrapper) — unix only.
    env.Append(LIBPATH=["gdextension/terminal/ghostty-shim/zig-out/lib"])
    env.Append(LIBS=["minerva-vt"])

# Platform specific sources
sources = ["gdextension/terminal/register_types.cpp"]

if env["platform"] == "windows":
    sources.append("gdextension/terminal/windows/terminal.cpp")
    env.Append(CPPDEFINES=["PLATFORM_WINDOWS"])
elif env["platform"] == "linux":
    sources.append("gdextension/terminal/unix/terminal.cpp")
    sources.append("gdextension/terminal/unix/subprocess.cpp")
    # Add Linux-specific libraries
    env.Append(LIBS=["util"])
    env.Append(CPPDEFINES=["PLATFORM_LINUX"])
elif env["platform"] == "macos":
    sources.append("gdextension/terminal/unix/terminal.cpp")
    sources.append("gdextension/terminal/unix/subprocess.cpp")
    # macOS uses the same PTY implementation as Linux
    env.Append(LIBS=["util"])
    env.Append(CPPDEFINES=["PLATFORM_MACOS"])
    # Workaround: macOS 26 (Tahoe) / Xcode 26 new linker ___dso_handle fixup error
    # in godot-cpp static lib. -ld_classic is deprecated but works for now.
    # TODO: Remove when godot-cpp fixes compatibility with the new Apple linker.
    env.Append(LINKFLAGS=["-Wl,-ld_classic"])

# Build the library
if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libterminal.{}.{}.framework/libterminal.{}.{}".format(
            env["platform"], env["target"], env["platform"], env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "bin/libterminal{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

Default(library)

# Copy minerva-vt dylib into the framework directory so Godot can find it at runtime.
# The libterminal dylib references @rpath/libminerva-vt.dylib, and @loader_path
# resolves to the framework directory.
if env["platform"] == "macos":
    framework_dir = "bin/libterminal.{}.{}.framework".format(env["platform"], env["target"])
    minerva_vt_dst = os.path.join(framework_dir, "libminerva-vt.dylib")
    # Prefer the universal binary (CI lipo's it into bin/) so the framework gets a
    # multi-arch dylib; fall back to the per-arch zig output for local dev builds.
    if os.path.exists("bin/libminerva-vt.dylib"):
        minerva_vt_src = "bin/libminerva-vt.dylib"
    else:
        minerva_vt_src = "gdextension/terminal/ghostty-shim/zig-out/lib/libminerva-vt.dylib"
    # Copy at build time (after the framework exists), not parse time.
    env.AddPostAction(library, "cp " + minerva_vt_src + " " + minerva_vt_dst)
    # Add @loader_path rpath so libterminal finds libminerva-vt.dylib next to itself
    env.AddPostAction(library, "install_name_tool -add_rpath @loader_path $TARGET 2>/dev/null || true")
    # Re-sign both dylibs (macOS rejects unsigned/invalidated code signatures)
    env.AddPostAction(library, "codesign --force --sign - $TARGET")
    env.AddPostAction(library, "codesign --force --sign - " + minerva_vt_dst)