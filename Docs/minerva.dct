INSERT INTO items VALUES('DKT-0002','bug','closed','Task completeness tracking — no per-task correlation','11 tasks planned but 9 files generated — all 11 bulk-moved to review regardless. No per-task correlation between plan tasks and generated files. All selected plan tasks bulk-transitioned to in_progress then review without verifying which tasks produced output.','2026-03-02T17:47:18','2026-03-03T00:12:30','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0003','bug','closed','Review max_tokens truncation — non-tool agents stuck at 4000','Non-tool review agents stuck at max_tokens=4000. Auto-increase to 16000 gated behind enable_tools and auto_fix condition. Causes truncation retry loops with verbose models. 2 of 4 agents produced no usable output in test session.','2026-03-02T17:47:18','2026-03-03T00:12:31','','ClaudeCode','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0004','bug','triaged','Message queue overflow — 50K queue drops critical notifications','50K queue overflows during LLM streaming dropping critical status notifications (awaiting_user delayed). 2058 drops in one session. Single message_handler_worker blocks during review. No priority mechanism for status-change messages.','2026-03-02T17:47:18','2026-03-03T00:12:31','','ClaudeCode','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0005','bug','new','Question overflow UI — horizontal overflow in option buttons','Long planning questions cause horizontal overflow in option buttons. Need autowrap on Button/Label in Godot client planning question display.','2026-03-02T17:47:18','2026-03-03T00:12:32','','ClaudeCode','',4,4,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0006','bug','closed','No files to stage early — spurious warning during cleanup','''No files to stage'' warning fires during stale file cleanup BEFORE generation starts. Non-fatal cosmetic issue. Happens after git init during cleanup phase.','2026-03-02T17:47:18','2026-03-03T00:12:32','','ClaudeCode','',4,4,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0007','bug','triaged','Review agent 120s timeout too aggressive','120s timeout too aggressive for verbose models (gpt-5.2). Causes retry loops during review phase. Consider increasing to 180s or making configurable per-agent.','2026-03-02T17:47:24','2026-03-03T00:12:33','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0008','bug','new','Review phase UX stall — no progress during long LLM calls','No heartbeat/progress during long review LLM calls. UI appears dead for 2+ minutes. Action emitter events only fire at start/complete of tool calls, not during waiting. Need periodic progress notification.','2026-03-02T17:47:27','2026-03-03T00:12:33','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0009','bug','new','Revision input no scroll — container doesn''t scroll to show input','''Request Revision'' text input appears but container doesn''t auto-scroll down to show it. User must manually scroll to find the input field.','2026-03-02T17:47:30','2026-03-03T00:12:34','','ClaudeCode','',4,4,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0010','bug','closed','No main scene not caught by headless validator','Generated project missing run/main_scene in project.godot. Headless validator didn''t flag it. godot --headless --import --quit only checks import/parse, not launch config. Project won''t launch.','2026-03-02T17:47:33','2026-03-03T00:12:34','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0011','bug','closed','Iteration counter stuck at 0 across revision cycles','All revision cycles publish as iteration 0 with Review count 1/5. Counter never increments across human revision cycles. Each cycle appears to start fresh. Likely hardcoded or not read from session storage on revision requests.','2026-03-02T17:47:36','2026-03-03T00:12:37','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0012','bug','closed','Validation gate no regression block — superseded by 017','No regression detection — validation output grew each review cycle. Superseded by bug 017 (validation gate false positives). The size-based check was added but uses wrong heuristic.','2026-03-02T17:47:43','2026-03-03T00:12:37','','ClaudeCode','',2,2,'superseded',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0013','bug','closed','Planning JSON parse failure — code fences break parsing','Follow-up planning response wrapped in code fences and all 7 parse repair strategies failed. 0 tasks published. May be truncated by max_tokens. Need fallback that extracts JSON between first { and last }.','2026-03-02T17:47:47','2026-03-03T00:12:38','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0014','bug','closed','Git revert fails on regression — broken commit remains','git revert fails (exit 128) but code proceeds as if succeeded. Broken commit remains. Need fallback using git reset --hard HEAD~1 and proper stderr logging from failed revert.','2026-03-02T17:47:49','2026-03-03T00:12:38','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0015','bug','closed','UI stuck in Plan state when 0 tasks published','Cascade from bug 014 — 0 tasks means no tasks_started notification so UI stays on Plan. Backend completes generation+review but UI never transitions. Need state notification even with 0 tasks.','2026-03-02T17:47:53','2026-03-03T00:12:39','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0016','bug','closed','Validation gate false positives — size-based check wrong for Godot','Size-based regression check (>20% growth) wrong for Godot — more output means deeper parse which means improvement not regression. 12/13 fixes reverted incorrectly. Replace size-growth check with error-line-count-growth check.','2026-03-02T17:47:56','2026-03-03T00:12:39','','ClaudeCode','',1,1,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0017','bug','closed','Missing asset validation — .tscn references ungenerated files','.tscn references icon.svg but never generated (binary asset). No review agent checks ExtResource paths resolve to real files. Game fails to launch because preload chain breaks on missing resource. Need post-generation scan of .tscn ext_resource paths.','2026-03-02T17:48:03','2026-03-03T00:12:40','','ClaudeCode','',1,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0018','bug','closed','Codegen UI stall — question tool blocks OpenCode forever','Gemini Flash called question tool and OpenCode blocked forever waiting for resolution. Fixed: denied question tool in opencode.json permissions + added stall diagnosis to orchestrator + /session-state endpoint in proxy.','2026-03-02T17:48:06','2026-03-03T00:12:40','','ClaudeCode','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0019','bug','new','Duplicate fixes across review agents','Multiple review agents independently find and fix the same issue. ValidationGate should catch via conflict detection when second agent''s commit introduces duplicate function errors. Relies on ValidationGate stderr fix being in place.','2026-03-02T17:48:10','2026-03-03T00:12:41','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0020','bug','closed','ValidationGate stderr blind — only checked stderr not stdout','Gate only checked stderr but 2>&1 redirects to stdout at shell level. Python subprocess.run(capture_output=True) sees empty stderr. Fixed: checks both stdout+stderr in _run_validation_commands(). Added SCRIPT ERROR and Failed to load patterns to error detection.','2026-03-02T17:48:13','2026-03-03T00:12:41','','ClaudeCode','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0021','bug','closed','Review fixes not in archive — packaged before review ran','Archive created before review ran so user downloaded pre-review code. Fixed: added post-review re-packaging step after AI review completes. Uses git ls-files and git format-patch for combined patch.','2026-03-02T17:48:16','2026-03-03T00:12:44','','ClaudeCode','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0022','bug','new','Auto-promote wrong model — reads UI dropdown not job submission','MCP auto-promote reads model from UI dropdown not from original job submission. When job submitted via MCP, dropdown has default/unrelated model so generation runs with wrong model.','2026-03-02T17:48:23','2026-03-03T00:12:45','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0023','bug','closed','No review after generation — no human approval gate without auto_review','awaiting_user only inside if run_review. No human approval gate when auto_review=false. Code conflates AI review with human approval. Need to transition to awaiting_user regardless of AI review setting.','2026-03-02T17:48:26','2026-03-03T00:12:45','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0024','bug','closed','Review model IDs mismatch — matches UUIDs not model names','MCP review models param matched against agent UUIDs not OpenRouter model names. Passing google/gemini-3-flash-preview fails with ''No valid models found''. Need to resolve model names to agents in _handle_request_review.','2026-03-02T17:48:30','2026-03-03T00:12:46','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0025','bug','closed','Review agents not visible in UI after MCP creation','No signal between AutocoderAdapter and ReviewAgentManager UI. MCP creates agents through adapter but UI only refreshed after its own operations. Fixed: added review_agents_changed signal to AutocoderAdapter.','2026-03-02T17:48:33','2026-03-03T00:12:46','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0026','bug','closed','DB update review state — stale Docker cache on AWS','Stale Docker cache on AWS storage-main. Workaround (hardcode Ok(1) for UPDATE queries) was in source but cached binary didn''t include it. Rebuilt with --no-cache fixed it.','2026-03-02T17:48:36','2026-03-03T00:12:47','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0027','bug','closed','Download timeout — GDScript lambda variable capture bug','GDScript lambda variable capture bug in ArtifactRegistryAdapter.gd. Lambda reassigned result = {...} which doesn''t propagate to outer scope. Fixed: mutate dict instead of reassign (result[''filename''] = filename).','2026-03-02T17:48:43','2026-03-03T00:12:47','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0028','bug','closed','MCP download timeout — binary transfer exceeds tool timeout','minerva_autocoder_download times out via MCP. _download_binary awaits binary chunk transfer from artifact-service over Core WebSocket. MCP tool call timeout fires before transfer completes. Need increased timeout or async download.','2026-03-02T17:48:46','2026-03-03T00:12:48','','ClaudeCode','',3,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0029','bug','closed','Plan tasks skip in-progress state display','Tasks jump from plan to review skipping in_progress state display. The orchestrator''s task status management may not emit intermediate status changes during generation.','2026-03-02T17:48:49','2026-03-03T00:12:48','','ClaudeCode','',4,4,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0030','rca','detected','5-Why: Critical notifications dropped during LLM streaming',replace('5-Why Root Cause Analysis for DKT-0004: Message queue overflow dropping critical notifications.\n\n## Symptom\nClient never receives `awaiting_user` notification after review completes. Job appears stuck. 2058 message drops observed in one session.\n\n## Why 1: Why does the client miss the awaiting_user notification?\nBecause the pub/sub notification is fire-and-forget — if the message is dropped anywhere in the pipeline, there is no retry or acknowledgment mechanism.\n\n## Why 2: Why is the message dropped?\nBecause the server-side asyncio.Queue (50K maxsize) overflows during LLM streaming. When the queue is full, `put_nowait()` silently drops new messages with only a print() statement (service.py:1153-1155).\n\n## Why 3: Why does the queue overflow during LLM streaming?\nBecause LLM token streaming generates hundreds of `response_chunk` events per second via `_stream_llm_traffic()` (autocoder.py:5216-5342), and a single `_message_handler_worker` processes them sequentially. During review phase with 3 agents streaming simultaneously, throughput exceeds the worker''s processing capacity.\n\n## Why 4: Why can''t the worker keep up with streaming volume?\nTwo factors:\n(a) **Single worker bottleneck**: Only one asyncio task (`_message_handler_worker`, service.py:1108-1130) processes ALL incoming messages — streaming chunks, status updates, storage responses, everything.\n(b) **No priority differentiation**: Critical status messages (awaiting_user) enter the same FIFO queue as high-volume streaming data, with no priority mechanism to ensure delivery.\n\n## Why 5: Why is there no priority mechanism or multi-worker architecture?\nThe message queue was designed as a simple decoupling layer (receive loop → handler) and was scaled by increasing maxsize from default to 50K. The architecture assumes all messages have equal importance and that a single worker can keep pace. No backpressure, priority queuing, or guaranteed delivery was designed for the system.\n\n## Contributing Factors (Client-Side)\n- WebSocket buffer conflict: global 16MB limit vs per-socket 32MB setting (core_client.gd:89-90 vs 185-187)\n- Single-frame packet processing in _process() — no backpressure\n- Signal connection race condition in AutocoderManager subscription setup\n- Event buffer cap of 200 events with FIFO eviction\n- No client-side polling fallback for missed critical notifications\n\n## Root Cause\nThe message bus lacks a guaranteed delivery mechanism for critical state-transition notifications. The system treats all messages equally in a single FIFO queue, and high-volume LLM streaming saturates the queue, displacing low-volume but high-importance status messages.\n\n## Potential Fix Directions\n1. **Priority queue**: Separate queues or priority levels for status vs streaming messages\n2. **Guaranteed delivery**: ACK/retry mechanism for critical state transitions\n3. **Client-side polling**: Periodic session state poll as fallback for missed notifications\n4. **Backpressure**: Rate-limit or batch streaming events when queue pressure is high\n5. **Multi-worker**: Multiple workers or dedicated worker for critical message types','\n',char(10)),'2026-03-02T18:13:53','2026-03-03T00:12:48','','ClaudeCode','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0004',NULL);
INSERT INTO items VALUES('DKT-0031','dcr','proposed','Improve review agent timeout handling and defaults',replace('Design Change Request for DKT-0007: Review agent timeout improvements.\n\n## Current State\n- Per-agent `timeout_seconds` is already configurable (30-600s range) — feature exists\n- Default is 120s (review_models.py:37) — too low for verbose models\n- On timeout: all accumulated findings DISCARDED, returns empty ReviewResult\n- Retry loop can attempt up to 78 HTTP requests per agent before giving up\n- No client-side UI to set timeout or see per-agent progress\n\n## Proposed Changes\n\n### A. Increase Default Timeout\n- Change default from 120s → 180s in `review_models.py:37`\n- Provides breathing room for standard models without needing per-agent config\n\n### B. Model-Tier-Based Defaults\n- Add model-aware timeout defaults based on model identifier:\n  - Fast models (haiku, flash, nano): 120s\n  - Standard models (sonnet, gpt-4o): 180s\n  - Verbose models (opus, gpt-5.2, o1): 300s\n- Applied when `timeout_seconds` is not explicitly set by user\n\n### C. Preserve Partial Results on Timeout\n- When final JSON synthesis times out, preserve accumulated tool findings\n- Return partial ReviewResult with `issues` extracted from tool call history\n- Add `partial: true` flag to indicate incomplete review\n\n### D. Adaptive Final JSON Timeout\n- Increase timeout for final JSON call to `timeout_seconds × 1.5`\n- Rationale: synthesis step is the most critical and often the longest\n\n### E. Client-Side UX (Minerva)\n- Expose `timeout_seconds` field in ReviewAgentManager agent editor UI\n- Show per-agent progress indicator during review phase\n- Display timeout-specific error messages (not generic "Generation error")\n\n### F. Fix HTTP Client Default\n- Change `review_executor.py:33` from `httpx.AsyncClient(timeout=120.0)` to `timeout=None`\n- Let per-request timeout be the sole authority','\n',char(10)),'2026-03-02T18:13:53','2026-03-03T00:12:52','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0007',NULL);
INSERT INTO items VALUES('DKT-0032','work_item','backlog','Remove legacy queue gate — enable direct-await message loop for all services',replace('## Goal\nEliminate the 50K asyncio.Queue bottleneck by switching all services from `_legacy_message_loop()` to `_message_loop()`.\n\n## Current State\n- `service.py:758` gates on `network_config.enabled AND connection_retry_loop`\n- `connection_retry_loop` is imported from `minerva.network_resilience` which **does not exist**\n- So ALL services fall through to `_single_connection_attempt()` → `_legacy_message_loop()` → 50K queue + single worker\n\n## What To Do\n\n### Option A: Remove the gate (minimal change)\nIn `service.py`, modify `start()` to always call `_start_with_resilience()` or restructure so the new `_message_loop()` is used even without `connection_retry_loop`. The resilience retry loop is a separate concern from which message loop to use.\n\nConcretely:\n1. In `_single_connection_attempt()` (line 863), change `_legacy_message_loop(websocket)` → `_message_loop(websocket)`\n2. Keep `_legacy_message_loop` for backward compatibility but mark deprecated\n3. Remove the 50K queue entirely from the active code path\n\n### Option B: Create minimal network_resilience module\nCreate `minerva/network_resilience.py` with a simple `connection_retry_loop` async generator that yields reconnected WebSockets. This unlocks `_start_with_resilience()` which already uses `_message_loop()`.\n\n### Safety Check\nThe direct-await `_message_loop()` blocks on `await self.text_message_received()`. Verify that `text_message_received()` in the autocoder orchestrator returns quickly — it should, because all long-running handlers (generate, plan, review, answer-question) are already spawned via `_spawn_background_handler()` (service.py:1184-1199). Only lightweight handlers like list-sessions and cleanup are awaited directly.\n\n### Test\n- Run a full autocoder session (plan → generate → review → awaiting_user)\n- Verify no message drops under load\n- Verify status notifications arrive at client without delay\n\n## Files\n- `infrastructure/minerva-services/minerva/service.py` — lines 758-762, 827-868, 1042-1090, 1131-1168\n- `infrastructure/services/autocoder-orchestrator/autocoder.py` — lines 1417-1519 (text_message_received handler routing)','\n',char(10)),'2026-03-02T18:22:14','2026-03-03T00:12:52','','ClaudeCode','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0030',NULL);
INSERT INTO items VALUES('DKT-0033','work_item','backlog','Add client-side session state polling as notification fallback',replace('## Goal\nAdd a periodic polling fallback in the Minerva Godot client so that if a critical pub/sub notification (like `awaiting_user`) is missed, the client still discovers the state change within a few seconds.\n\n## Why\nEven after fixing the server-side queue, pub/sub is inherently best-effort. A defense-in-depth approach requires the client to not rely solely on one-shot notifications for critical state transitions.\n\n## What To Do\n\n### Server Side (already partially done)\nThe `/session-state/<session_id>` endpoint was added to `openrouter-proxy` in Bug 019 fix. However, the full session review state (`awaiting_user`, `ai_review`, etc.) lives in the orchestrator''s storage, not the proxy.\n\nOptions:\n1. **Add `/session/status` endpoint to orchestrator** — new REST-like request topic that returns current `review_state` and `status` for a session. The orchestrator already has `autocoder/session/info` handler (autocoder.py:1440) — extend it or add a lightweight status-only variant.\n2. **Use existing session/info** — the client can send an `autocoder/session/info` request via Core pub/sub and get the full session state back.\n\n### Client Side (Minerva Godot)\nIn `AutocoderManager.gd`, add a timer-based poll:\n\n1. When a job is submitted (state = `in_review` or `generating`), start a `Timer` node with 5-10s interval\n2. On each tick, send `autocoder/session/info` request for the active session\n3. Compare returned `review_state` with local `AutocoderLogStore.review_state`\n4. If server says `awaiting_user` but client hasn''t received the notification → trigger the approval card display\n5. Stop polling when job reaches terminal state (`awaiting_user`, `complete`, `error`)\n\n### Files\n- `Minerva/src/Scripts/UI/Controls/Autocoder/manager/AutocoderManager.gd` — add poll timer + handler\n- `Minerva/src/Scripts/UI/Controls/Autocoder/AutocoderLogStore.gd` — compare states\n- `infrastructure/services/autocoder-orchestrator/autocoder.py` — ensure session/info returns review_state (verify existing handler at line 1440)','\n',char(10)),'2026-03-02T18:22:29','2026-03-03T00:12:53','','ClaudeCode','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0030',NULL);
INSERT INTO items VALUES('DKT-0034','work_item','backlog','Add drop counter and structured logging for queue overflow',replace('## Goal\nReplace the silent `print()` on queue overflow with proper structured logging and a drop counter, so we have operational visibility into message loss even if the queue architecture remains.\n\n## Current State\n`service.py:1154-1155`:\n```python\nexcept asyncio.QueueFull:\n    print(f"[{self.SERVICE_ID}] Warning: Message queue full, dropping message")\n```\nNo counter, no logger, no message type info. 2058 drops went unnoticed until user saw delayed notifications.\n\n## What To Do\n1. Add a `self._queue_drop_count` counter (int) initialized in `_legacy_message_loop()`\n2. Replace `print()` with `logger.warning()` including:\n   - Drop count (cumulative)\n   - Current queue size (`self._message_queue.qsize()`)\n   - Dropped message type (`data.get(''cmd'')`, `data.get(''topic'')`)\n   - Whether the dropped message was a status notification (flag critical drops)\n3. Log a summary every 100 drops (avoid log spam during sustained overflow)\n4. Optionally expose drop count in service health/status endpoint\n\n## Files\n- `infrastructure/minerva-services/minerva/service.py` — lines 1131-1168\n\n## Note\nThis is an observability improvement. If the queue is eliminated (DKT-0032), this becomes moot for the direct-await path, but still valuable if any service falls back to the legacy path.','\n',char(10)),'2026-03-02T18:22:39','2026-03-03T00:12:53','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0030',NULL);
INSERT INTO items VALUES('DKT-0035','work_item','backlog','Fix Godot WebSocket buffer settings conflict',replace('## Goal\nResolve the conflicting WebSocket buffer settings in the Minerva Godot client that may silently cap buffers at 16MB instead of 32MB.\n\n## Current State\n`core_client.gd`:\n- Lines 89-90 (`_ready()`): Global project settings set to 16384 KB (16 MB)\n  ```gdscript\n  ProjectSettings.set_setting("network/limits/websocket/max_in_buffer_kb", 16384)\n  ProjectSettings.set_setting("network/limits/websocket/max_out_buffer_kb", 16384)\n  ```\n- Lines 185-187 (`connect_to_core()`): Per-socket buffers set to 32 MB\n  ```gdscript\n  _client.inbound_buffer_size = 32 * 1024 * 1024\n  _client.outbound_buffer_size = 32 * 1024 * 1024\n  ```\n\nGodot may enforce the SMALLER of the two limits, making the 32MB per-socket setting ineffective.\n\n## What To Do\n1. **Research**: Verify which limit Godot 4.x actually enforces when both are set (project settings vs per-socket). Check Godot docs/source.\n2. **Align settings**: Either raise the project setting to match (32768 KB) or remove the project setting entirely and rely on per-socket config.\n3. **Consider reducing**: 32 MB buffers may be overkill. With the queue fix (DKT-0032) and polling fallback (DKT-0033), buffer pressure should drop. Evaluate whether 8-16 MB is sufficient.\n\n## Files\n- `Minerva/src/Scripts/Services/Providers/Core/core_client.gd` — lines 89-90, 185-187','\n',char(10)),'2026-03-02T18:22:48','2026-03-03T00:12:53','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0030',NULL);
INSERT INTO items VALUES('DKT-0036','work_item','backlog','Increase default review timeout and add model-tier defaults',replace('## Goal\nRaise the default review agent timeout from 120s to 180s and add model-aware defaults so verbose models get longer timeouts automatically.\n\n## Current State\n- `review_models.py:37`: `timeout_seconds: int = 120` — default for all models\n- `review_executor.py:33`: `httpx.AsyncClient(timeout=120.0)` — client-level default (overridden per-request but still a confusing secondary source)\n- Per-agent override already works via `timeout_seconds` field (range 30-600s)\n\n## What To Do\n\n### A. Raise default\nIn `review_models.py:37`, change `timeout_seconds: int = 120` → `timeout_seconds: int = 180`\n\n### B. Model-tier defaults\nIn `review_executor.py`, when building `ReviewModelConfig` for custom agents (lines 2422-2438), if the agent does NOT specify `timeout_seconds`, apply a model-tier default based on the model identifier:\n```python\nMODEL_TIER_TIMEOUTS = {\n    "fast": 120,     # haiku, flash, nano, gpt-4o-mini\n    "standard": 180, # sonnet, gpt-4o, gemini-pro\n    "verbose": 300,  # opus, gpt-5.2, o1, o3\n}\n```\nMatch by substring in model string (e.g., `"haiku" in model` → fast tier).\n\n### C. Fix HTTP client default\nIn `review_executor.py:33`, change `httpx.AsyncClient(timeout=120.0)` → `httpx.AsyncClient(timeout=None)`. Per-request timeout is already set explicitly; the client default just causes confusion.\n\n### D. Adaptive final JSON timeout\nIn `review_executor.py`, for the final JSON synthesis call (lines 1313-1395), use `timeout=model_config.timeout_seconds * 1.5` instead of the base timeout. The synthesis step is the most critical and often needs extra time after extensive tool exploration.\n\n## Test\n- Verify default agents get 180s timeout\n- Verify a model with "opus" gets 300s\n- Verify a model with "haiku" gets 120s\n- Verify explicit `timeout_seconds` override still takes precedence\n- Verify final JSON call gets 1.5x timeout\n\n## Files\n- `infrastructure/services/autocoder-orchestrator/review_models.py` — line 37\n- `infrastructure/services/autocoder-orchestrator/review_executor.py` — lines 33, 937, 1347, 2422-2438','\n',char(10)),'2026-03-02T18:23:07','2026-03-03T00:12:54','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0031',NULL);
INSERT INTO items VALUES('DKT-0037','work_item','backlog','Preserve partial review results on timeout',replace('## Goal\nWhen a review agent times out on the final JSON synthesis, preserve the findings accumulated during tool iterations rather than discarding everything.\n\n## Current State\n`review_executor.py:1618-1628`: On any error (including timeout), returns:\n```python\nReviewResult(model_id=..., approved=False, summary=f"Review failed: {error}", issues=[], error=error)\n```\n- `issues=[]` — ALL findings lost\n- If the agent spent 14+ tool calls reading files and running tests, then timed out on final JSON → all that work is wasted\n\n## What To Do\n\n### A. Track findings during tool iterations\nIn `_call_llm()`, maintain a `partial_findings` list that accumulates as tool calls complete:\n- After each `response_complete` with tool calls, extract any structured findings from the assistant''s messages\n- Look for patterns like "Issue found:", file references, error descriptions\n- Store raw assistant text from each tool iteration as fallback\n\n### B. Build partial result on timeout\nWhen the final JSON call times out (lines 1313-1395), instead of returning empty `issues=[]`:\n1. Attempt to parse any structured findings from `partial_findings`\n2. If structured parse fails, include the raw assistant text as a single "partial review" issue\n3. Set `partial: true` flag on the ReviewResult\n4. Set `summary` to "Review partially completed — final synthesis timed out. N findings extracted from tool iterations."\n\n### C. Surface partial results to user\nIn the orchestrator (`autocoder.py`), when a ReviewResult has `partial=True`:\n- Include findings in the review summary sent to client\n- Mark the agent''s review as "partial" in the approval card\n- Let the user see what the agent found before it timed out\n\n## Files\n- `infrastructure/services/autocoder-orchestrator/review_executor.py` — lines 890-1395 (_call_llm), 1618-1628 (error result)\n- `infrastructure/services/autocoder-orchestrator/autocoder.py` — review result processing','\n',char(10)),'2026-03-02T18:23:20','2026-03-03T00:12:54','','ClaudeCode','',2,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0031',NULL);
INSERT INTO items VALUES('DKT-0038','work_item','backlog','Expose timeout_seconds in Minerva review agent editor UI',replace('## Goal\nLet users configure `timeout_seconds` per review agent through the Minerva agent editor UI, so they can increase timeouts for verbose models without needing to know about the backend API.\n\n## Current State\n- Backend supports `timeout_seconds` (30-600s) per agent — fully functional\n- Minerva''s `ReviewAgentManager.gd` (lines 128-252) shows agent cards with: name, model, tools toggle, prompt preview, order controls\n- **No timeout field** in the agent editor UI\n- Users have no way to discover or set this parameter through the UI\n\n## What To Do\n\n### Agent Card / Editor\nIn the agent create/edit form (ReviewAgentManager.gd):\n1. Add a `SpinBox` or `HSlider` for "LLM Timeout (seconds)"\n2. Range: 30-600, step: 30, default: 180 (or show "auto" for model-tier default)\n3. Place below the model selector — timeout is model-dependent so proximity helps\n4. Tooltip: "Max seconds per LLM request. Increase for verbose models (Opus, GPT-5.2). Default: 180s."\n\n### Agent Card Display\nIn `_build_agent_card()`, add a compact timeout indicator:\n- Show current timeout value (e.g., "180s" or "auto") alongside the model name\n- Only show if non-default, to avoid clutter\n\n### Data Flow\n- On save: include `timeout_seconds` in the agent dict sent to orchestrator\n- On load: read `timeout_seconds` from agent config, fall back to placeholder "auto"\n\n## Files\n- `Minerva/src/Scripts/UI/Controls/Autocoder/manager/ReviewAgentManager.gd` — agent editor form + card display\n- `Minerva/src/Scripts/UI/Controls/Autocoder/manager/ReviewAgentManager.tscn` — scene layout (add SpinBox node)','\n',char(10)),'2026-03-02T18:23:32','2026-03-03T00:12:55','','ClaudeCode','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'DKT-0031',NULL);
INSERT INTO items VALUES('DKT-0039','bug','new','Docket allows creation of blank bugs/items.','Simply hitting New --> item creates and saves a blank item. This is unwanted behavior. I want to explicitely "save changes" when making new items.','2026-03-02T18:27:50','2026-03-03T00:12:55','','ClaudeCode','',1,1,'','',replace('1. Open docket\n2. Hit New -> Bug (really any item)\n3. Don''t hit save changes.\n4. Hit "<Back"\n\nExpected results:\nNo new item created\n\nActual result:\nblank new item created, saved.\n','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0040','bug','new','Don''t know where items save when multiple dockets open','Bug is bigger than title. I need to be able to specifiy which docket I''m working with when making new items.','2026-03-02T18:30:39','2026-03-03T00:12:56','','ClaudeCode','',1,1,'','','',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0041','dcr','proposed','Improve Query',replace('Query workflow has issues that make it hard to use\n- Need an [Any] value for type. Sometimes I wnt to see all Pri 1 items, regardless of item type.\n- Need a way to query for parents.\n-- I have a parent work item (or bug, I forget), and children have been created. I can''t query for those children.\n- Need "parented" items to have a "show children" in details somehow.\n- MCP query calls should update UI if I''m not actively typing (or something like that). \n-- If I''m just sitting in query view, not doing something with bugs, and I ask the agents for a query -- I can''t see the query results, as it return the query results to the agent, but doesn''t update my view.','\n',char(10)),'2026-03-02T18:36:24','2026-03-03T00:12:58','','ClaudeCode','',1,1,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('DKT-0042','dcr','proposed','Docket needs test type',replace('Docket needs a "Test" type that indicates a (hopefully automated) test to run against things.\n- Description of the test case so LLMs can choose what tests to run when making changes.\n- Test setup instructions\n-- Conda Envs, needed libs, needed resources -- can even be a "setup" script or something.\n- Test steps\n- Expected results\n\nWhen a test is run, it needs to go into the "runs" of the test case\n- What date/ time did it run?\n- What was the result?\n-- If it failed or warned -- why? What went wrong?\n','\n',char(10)),'2026-03-02T18:48:37','2026-03-03T00:12:59','','ClaudeCode','',1,1,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbedf0a9d78539b96eddbb41a794a','bug','resolved','Ctrl+Enter always triggers autocoder regardless of mode','Ctrl+Enter keystroke should be context-sensitive: in chat mode it sends chat requests, in autocoder mode it sends autocoder requests. Currently it always sends autocoder requests regardless of which mode is active.','2026-03-05T16:40:14','2026-03-06T00:25:50','','','',1,1,'fixed','Minerva desktop client',replace('1. Open Minerva and switch to chat mode\n2. Type a message and press Ctrl+Enter\n3. Observe that an autocoder request is sent instead of a chat request','\n',char(10)),'','','','','','','','','','','','','','','','','',0,0,'','',NULL);
INSERT INTO items VALUES('019cbee2d4667f9eafa6474b014438d3','bug','resolved','Retry disables cancel — no way to stop stalled chat','When regenerating a chat response (delete response + hit retry), the cancel button is disabled. If the retried request stalls, the user has no way to stop it.','2026-03-05T16:44:22','2026-03-06T00:28:29','','','',2,2,'fixed','Minerva desktop client',replace('1. In a Minerva chat, delete a chat response\n2. Hit the retry button to regenerate\n3. Observe that the cancel button is disabled\n4. If the request stalls, there is no way to stop it','\n',char(10)),'','','','','','','','','','','','','','','','','',0,0,'','',NULL);
INSERT INTO items VALUES('019cbc3fa4d074468a47bb9699e13bba','bug','resolved','System prompt sent as role:system message instead of top-level system parameter','Minerva sends system prompts as role:system in the messages array. Claude API rejects this — it expects a top-level system parameter. Minerva should handle this transparently: for providers that support top-level system params, use that format; for models/providers that don''t support system prompts at all, auto-inject the system prompt content into the first user message. The UI user shouldn''t need to know provider-specific message format requirements.','2026-03-05T04:26:53','2026-03-06T00:28:31','','','',1,2,'fixed','',replace('1. minerva_create_chat with provider claude_sonnet\n2. minerva_set_system_prompt with chat_id and prompt text\n3. minerva_send_message with any user message\n4. Error: "Unexpected role system"','\n',char(10)),'','','','','','','','','','','','','','','','','',0,0,'','',NULL);
INSERT INTO items VALUES('019cbef3897b7299a409548623391896','dcr','implementing','Chat compaction, summarization, and archival',replace('Long-running chats accumulate unbounded context. Minerva needs:\n\n1. **Compaction** — summarize older messages to reduce context size while preserving key information\n2. **Summarization** — generate concise summaries of chat sessions for reference\n3. **Archival** — move old/completed chats to cold storage, retrievable but not consuming active resources\n\nThis is critical for agent workflows that involve many turns (e.g. content pipeline, research tasks). Without compaction, chats hit context limits or OOM on local models.','\n',char(10)),'2026-03-05T17:02:37','2026-03-06T19:34:15','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbef398127954a9c6ba96bd8c138a','dcr','proposed','Time-based triggers',replace('Minerva has event-based triggers but no time-based ones. Need ability to fire triggers on a schedule (cron-style or interval-based). Use cases:\n\n- Daily content scout agent runs at a set time\n- Periodic health checks on services\n- Scheduled report generation\n- Reminder/follow-up triggers for workflow gates\n\nShould integrate with the existing trigger system, just adding time as a trigger source.','\n',char(10)),'2026-03-05T17:02:41','2026-03-05T17:02:41','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbf0627107bb8bd45657335659b0d','dcr','proposed','Establish automated test framework and CI pipeline',replace('Minerva has no unified test framework. Current tests are custom one-off scripts with manual assertions, no shared runner, and no CI integration.\n\n## Current State\n- 1 custom GDScript test (test_agent_definition.gd) using SceneTree + manual pass/fail counters\n- 1 markdown addon test using EditorScript\n- 1 Python integration test for MCP tools\n- No GUT, no gdUnit, no test runner, no CI\n- A branch (user/milos/feature/tests) suggests prior exploration but nothing landed\n\n## Proposed\n1. Adopt GUT (Godot Unit Testing) as the GDScript test framework — it integrates with Godot editor and CLI (`godot --headless -s addons/gut/gut_cmdln.gd`)\n2. Establish test directory conventions: `src/test/unit/`, `src/test/integration/`\n3. Add CLI test runner script for running all tests headlessly\n4. Add GitHub Actions step to run tests on PR\n5. Migrate existing custom tests to GUT format\n6. Document how to write and run tests\n\n## Why Now\nWe''re accumulating bugs (40+ in docket) with no regression protection. UI bugs like Ctrl+Enter mode confusion and retry/cancel state are hard to test without framework support. Data-layer bugs (provider Format(), message building) are easy to test but we have no place to put them.','\n',char(10)),'2026-03-05T17:22:57','2026-03-05T17:22:57','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbf063e1f7d2ea3c6ec969335e9b2','test','draft','Regression test: Provider Format() returns null for SYSTEM role','Verify that all provider Format() functions return null when given a ChatHistoryItem with ChatRole.SYSTEM, preventing system prompts from leaking into the messages array.','2026-03-05T17:23:03','2026-03-05T17:23:03','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbf10148e7d27a5c6ba078d0523bd','bug','resolved','MCP set_system_prompt doesn''t set SystemPromptEnabled — prompt ignored on send','minerva_set_system_prompt MCP tool sets HasUsedSystemPrompt = true but never sets SystemPromptEnabled = true. ChatPane line 527 requires both flags to extract the effective system prompt. Result: system prompt set via MCP is never passed to the provider''s top-level system param, only leaks into messages array via Format().','2026-03-05T17:33:48','2026-03-06T00:28:27','','','',1,2,'fixed',NULL,replace('1. Create a chat via MCP (minerva_create_chat)\n2. Set system prompt via MCP (minerva_set_system_prompt)\n3. Send a message via MCP (minerva_send_message)\n4. Observe: provider.system_prompt is empty, system prompt only appears as role:system in messages array','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbf1af65f7b0a955057703e7a94df','dcr','shipped','Dynamic model configuration for all providers (eliminate hardcoded model lists)',replace('Anthropic, OpenAI, and Google providers define models as hardcoded inner subclasses. Adding a new model (e.g. Claude Opus 4.6, GPT-5.3) requires code changes: new subclass, new enum, new registry entry. OpenRouter already solves this with a data-driven approach.\n\n## Current State\n- **OpenRouter**: Models are data (JSON config at user://openrouter_models.json). `create_from_config(config)` factory creates provider instances at runtime. Users can add/remove models without code changes.\n- **Anthropic**: 3 inner subclasses (Haiku, Sonnet, Opus) with hardcoded api_model_id, pricing, capabilities.\n- **OpenAI**: 3 inner subclasses (Nano, Standard, Deep) with hardcoded model_name, reasoning_effort, pricing.\n- **Google**: 2 inner subclasses (Flash, Pro) with hardcoded model_name, pricing.\n\n## Proposed\n1. Add `create_from_config(config)` factory method to AnthropicProvider, OpenAIProvider, GoogleProvider (OpenRouter already has this)\n2. Move model definitions from subclasses to JSON config files (e.g. `user://anthropic_models.json`, `user://openai_models.json`, `user://google_models.json`)\n3. Register dynamic models in SingletonObject using the same pattern as OpenRouter (dynamic IDs, MODEL_TO_PROVIDER mapping)\n4. Ship hardcoded defaults as fallback when no config file exists (current subclass definitions become the seed data)\n5. Optionally: add UI to manage models per provider (like OpenRouter''s model browser)\n\n## What stays as code\nProvider logic (API URLs, auth, message formatting, system prompt handling) remains in the provider classes. Only the model catalog becomes data.\n\n## Benefits\n- New model releases (Claude Opus 4.6, Gemini 4, etc.) can be added by editing a JSON file or via UI\n- Users can customize pricing, display names, capability flags without rebuilding\n- Consistent pattern across all providers','\n',char(10)),'2026-03-05T17:45:41','2026-03-06T02:47:26','','','',2,0,'Dynamic model config shipped: create_from_config factories for all providers, ProviderModelManager base class, Ollama auto-discovery, Add Model UI, API-based model browsing, MCP tools. Integration tested.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbf7c16ab744e9675ca2b00682eb2','work_item','done','Plan: Implement dynamic model configuration for all providers',replace('Implementation plan for DCR 019cbf1af65f — eliminate hardcoded model lists.\n\n## Approach\nHybrid: keep inner classes as factory defaults, add JSON config overlay for user-added models and overrides. Ollama uses server auto-discovery instead of JSON.\n\n## Startup Resolution Order\n1. Load built-in models from inner classes (shipped defaults)\n2. Load per-provider user JSON (additions + overrides)\n3. Merge: user-added models appended, user overrides layered on top\n4. For Ollama: query GET /api/tags instead of JSON\n\n## Config Migration\nNo explicit migration needed. Built-in models always come from code. User JSON is purely additive. New shipped models appear automatically via inner class additions.\n\n## Task Breakdown\n1. Add create_from_config() factory to Anthropic, OpenAI, Google providers\n2. Create ProviderModelManager base class (generalize OpenRouterModelManager)\n3. Extend singleton_object.gd dynamic registration for all providers\n4. Implement Ollama auto-discovery\n5. Add "Add Model" UI per provider\n6. Integration testing across all providers\n\n## Dependencies\n- Tasks 1-3 are the core plumbing (sequential)\n- Task 4 (Ollama) is independent, can parallel with 1-3\n- Task 5 (UI) depends on 1-3\n- Task 6 depends on all others','\n',char(10)),'2026-03-05T19:31:46','2026-03-05T21:11:24','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf1af65f',NULL);
INSERT INTO items VALUES('019cbf7c3d6d722ea43666a40c2b90e9','work_item','done','Add create_from_config() factory to Anthropic, OpenAI, Google providers',replace('Add a static create_from_config(config: Dictionary) -> Provider factory method to each provider, mirroring OpenRouterProvider.create_from_config().\n\n**AnthropicProvider:**\n- Config fields: api_model_id, max_tokens, display_name, short_name, input_token_cost, output_token_cost, is_reasoning_model\n- Sets system_prompt support, temperature_max=1.0, etc. from base class defaults\n\n**OpenAIProvider:**\n- Config fields: model_name, reasoning_effort ("" for non-reasoning), display_name, short_name, costs\n- Sets supports_temperature/top_p based on whether reasoning_effort is empty\n\n**GoogleProvider:**\n- Config fields: model_name, display_name, short_name, costs\n- Sets temperature_warning, default_timeout from base class defaults\n\nEach factory should produce an instance indistinguishable from the inner class .new() path.','\n',char(10)),'2026-03-05T19:31:56','2026-03-05T21:07:03','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbf7c4fed710a817999a289781b54','work_item','done','Create ProviderModelManager base class',replace('Generalize OpenRouterModelManager into a reusable base class, then have each provider use it.\n\n**ProviderModelManager base:**\n- load_config(path) / save_config(path) — JSON persistence\n- add_model(config) / update_model(id, config) / remove_model(id) / get_model(id)\n- models_changed signal\n- Dynamic ID assignment with configurable base (Anthropic 20000+, OpenAI 30000+, Google 40000+, OpenRouter 10000+ as today)\n\n**Per-provider managers:**\n- AnthropicModelManager, OpenAIModelManager, GoogleModelManager\n- Each defines its CONFIG_PATH (e.g. user://anthropic_models.json)\n- Each defines its DYNAMIC_ID_BASE\n- OpenRouterModelManager refactored to extend the base (keeps API fetch logic)\n\n**Depends on:** Task 1 (factories must exist before managers can use them)','\n',char(10)),'2026-03-05T19:32:01','2026-03-05T21:07:14','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbf7c617371eab982eeec4fff3bda','work_item','done','Extend singleton_object.gd dynamic registration for all providers',replace('Extend the dynamic model registration in singleton_object.gd to handle all providers, not just OpenRouter.\n\n**Changes:**\n- Add model manager instances for each provider (like existing openrouter_model_manager)\n- _init_dynamic_models() initializes all managers, calls _register_dynamic_models()\n- _register_dynamic_models() iterates all managers, registers each model''s ID into API_MODEL_PROVIDER_SCRIPTS and MODEL_TO_PROVIDER\n- Connect models_changed signal from each manager\n- Update AISettings._get_provider_instance() to dispatch dynamic IDs to the correct provider''s create_from_config() based on ID range or MODEL_TO_PROVIDER lookup\n\n**Depends on:** Task 2 (managers must exist)','\n',char(10)),'2026-03-05T19:32:05','2026-03-05T21:07:23','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbf7c784e741f95d0e42aaa9f86a5','work_item','done','Implement Ollama auto-discovery via GET /api/tags',replace('Replace hardcoded Ollama model with auto-discovery from the running Ollama server.\n\n**Approach:**\n- On startup (and on manual refresh), query GET /api/tags from OllamaProvider.BASE_URL\n- Parse response: each model has name, size, parameter_size, quantization_level, modified_at\n- Build model configs from response (display_name from name, costs=0, supports_num_ctx=true, supports_num_gpu=true)\n- Register discovered models as dynamic models using the same manager pattern\n- Handle offline case gracefully: if Ollama server unreachable, show last known models or empty list\n\n**Independent of tasks 1-3** — Ollama extends OpenAIProvider and has different discovery needs. Can be done in parallel.','\n',char(10)),'2026-03-05T19:32:11','2026-03-05T21:08:40','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbf7c88647f9b881829022c884fa1','work_item','done','Add "Add Model" UI per provider in settings',replace('Add UI in AISettings for users to add/remove/edit custom models per provider.\n\n**Anthropic, OpenAI, Google:**\n- "Add Model" button opens a form: API model ID, display name, short name, input/output costs, capability toggles (reasoning, temperature, etc.)\n- List of user-added models with edit/delete\n- Built-in models shown but not deletable (can override properties)\n\n**OpenRouter:**\n- Keep existing model browser (already works)\n\n**Ollama:**\n- Show installed models from auto-discovery with enable/disable toggles\n- "Refresh" button to re-query GET /api/tags\n\n**Depends on:** Tasks 1-3 (core plumbing must work first)','\n',char(10)),'2026-03-05T19:32:15','2026-03-05T21:11:18','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbf7c9e2673c29f80ef4fe77aab83','work_item','done','Integration test: dynamic model config across all providers',replace('End-to-end verification of the dynamic model system.\n\n**Test scenarios:**\n1. Fresh launch — built-in models appear, no JSON files exist yet\n2. Add a custom Anthropic model via UI — appears in dropdown, persists across restart\n3. Override pricing on built-in Sonnet — override persists, clearing it restores default\n4. Ship a new built-in model (simulate by adding inner class) — appears alongside user models\n5. Ollama discovery — start with models pulled, verify they appear; stop Ollama, verify graceful degradation\n6. OpenRouter — existing browser flow still works\n7. Remove a user-added model — disappears from dropdown, JSON updated\n\n**Depends on:** All other tasks','\n',char(10)),'2026-03-05T19:32:21','2026-03-06T02:46:23','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf7c16ab',NULL);
INSERT INTO items VALUES('019cbfdc45447a748838f1e7c07e8aa4','bug','closed','GDScript warnings: ternary type mismatch and shadowed variables',replace('Three GDScript warnings on startup:\n\n1. AgentRegistry.gd:49 — INCOMPATIBLE_TERNARY: Values of the ternary operator are not mutually compatible\n2. SubmitJob.gd:2410 — SHADOWED_VARIABLE_BASE_CLASS: local variable "scale" shadows Control.scale\n3. singleton_object.gd:1244 — SHADOWED_VARIABLE_BASE_CLASS: local function parameter "name" shadows Node.name (FIXED already)\n\nWarnings 1 and 2 are pre-existing.','\n',char(10)),'2026-03-05T21:16:49','2026-03-06T00:27:28','','','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbfe038cd79249f6c4a101612ea71','bug','resolved','GDScript warnings: shadowed variables and incompatible ternary types',replace('Three GDScript warnings at startup:\n1. AgentSpawner.gd:41 — INCOMPATIBLE_TERNARY: tool_def.name returns StringName, str(tool_def) returns String\n2. SubmitJob.gd:2410 — local variable ''scale'' shadows Control.scale\n3. singleton_object.gd:1244 — function parameter ''name'' shadows Node.name','\n',char(10)),'2026-03-05T21:21:08','2026-03-05T21:21:43','','','',3,3,replace('Fixed all three:\n1. AgentSpawner.gd: wrapped tool_def.name in str() so both ternary branches return String\n2. SubmitJob.gd: renamed ''var scale'' → ''var ui_scale''\n3. singleton_object.gd: renamed parameter ''name'' → ''model_name_''','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbfe2be7a77a6b99ac55479b24329','bug','resolved','Preferences popup too narrow to reveal new tabs','The PreferencesPopup window is not wide enough for the tab bar to show all tabs. Users can''t see that new tabs (e.g. Custom Models) exist because they''re clipped off-screen. Need to widen the popup or make tabs scrollable/visible.','2026-03-05T21:23:54','2026-03-05T21:24:32','','','',1,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cbfe3ee76758396380c1ff1d499a8','dcr','shipped','Rename preferences tabs: OpenRouter Models → OpenRouter, Custom Models → Models','Shorten tab names in PreferencesPopup for brevity: rename "OpenRouter Models" to "OpenRouter" and "Custom Models" to "Models".','2026-03-05T21:25:11','2026-03-06T02:49:20','','','',3,0,'Already done in code. .tscn has node name=\"OpenRouter\" and .gd sets _custom_models_tab.name = \"Models\".',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc07cdb0e748aa9557831f802f9f9','work_item','done','Add API-based model discovery for Anthropic, OpenAI, and Google providers',replace('The Custom Models tab has a blank text field for model names with no way to discover available models. Add browse/discover buttons that query each provider''s model listing API (requires API key):\n- Anthropic: GET /v1/models\n- OpenAI: GET /v1/models\n- Google: GET /v1beta/models?key=KEY\n\nFollow the same pattern as OpenRouter''s existing browse dialog. Show results in a searchable list, let user select and add.\n\nParent: DCR 019cbf1af65f','\n',char(10)),'2026-03-06T00:12:13','2026-03-06T00:15:00','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf1af65f',NULL);
INSERT INTO items VALUES('019cc081349477efa78dfe80417194cd','bug','resolved','Model browse dialog doesn''t support multi-select','Browse dialog for provider models (Anthropic, OpenAI, Google) only allows selecting and adding one model at a time. Should support multi-select so users can add several models in one go.','2026-03-06T00:16:59','2026-03-06T00:18:10','','','',2,3,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc08f989a73b888f979f71200c4cb','dcr','shipped','MCP tools for dynamic model management (add/remove/update/list across all providers)',replace('Add MCP tools so that AI agents (or the user via MCP) can manage model configurations at runtime across all providers. This enables workflows like: asking an AI to look up current model pricing and update it, adding new models without opening the UI, or switching model configs programmatically.\n\nProposed tools:\n- minerva_list_models: List all models (built-in + dynamic) across providers, or filter by provider\n- minerva_add_model: Add a dynamic model to a specific provider\n- minerva_update_model: Update fields (pricing, display name, short name, etc.) on an existing dynamic model\n- minerva_remove_model: Remove a dynamic model\n\nBuilds on the dynamic model config infrastructure (DCR 019cbf1af65f) and ProviderModelManager base class.','\n',char(10)),'2026-03-06T00:32:42','2026-03-06T02:47:10','','','',2,0,'All 4 MCP tools implemented and live: minerva_list_models, minerva_add_model, minerva_update_model, minerva_remove_model.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbf1af65f',NULL);
INSERT INTO items VALUES('019cb9be8b0d76be9c8636034c6ca24b','dcr','shipped','External provider cost tracking and budget enforcement',replace('Add cost tracking and budget enforcement for external API provider calls (OpenAI, Anthropic, Google, OpenRouter) in Minerva.\n\n## Problem\nMinerva can calculate per-call costs but does not track accumulated spend or enforce budgets. An unsupervised agent can burn unlimited money on API calls. Local models (via model-chat/gpu-node) are "too cheap to meter" but external providers cost real money and are required for agentic work since local models are poor at complex tasks.\n\n## Requirements\n\n### Tracking\n- Every external API call records: provider, model, tokens (prompt + completion), calculated cost, timestamp, owning task/session ID\n- Queryable: "How much did this task cost?", "What''s today''s total spend?", "Cost breakdown by provider"\n- Persistent storage (not just in-memory)\n\n### Budgeting\n- A task/session gets assigned a budget (e.g., "$5 for research")\n- Middleware checks accumulated spend before each external call\n- Approaching limit (e.g., 80%) → warn/notify\n- At limit → stop, report back to supervisor with summary of work done so far\n- Supervisor (human or agent) can extend budget or accept results\n\n### Reporting\n- Per-task cost summary\n- Per-day/week rollup\n- Per-provider breakdown\n- Cost-per-content-piece (ties into content engine experiment)\n\n## Architecture notes\n- This is Minerva app layer, not minerva-services (external calls bypass model-chat)\n- Likely a middleware/wrapper around provider API calls\n- Storage could be SQLite local or via DBProxy\n- Budget enforcement must be synchronous (check before call, not after)','\n',char(10)),'2026-03-04T16:46:38','2026-03-06T02:42:53','','','',1,0,'Implemented configurable budget time periods (hour/day/week/month), replaced SpinBox with LineEdit + regex validation + OptionButton period selector, fixed UTC mismatch bug in get_cost_today/get_hourly_costs_today, unified cost formatting to use ¢ symbol, added budget persistence (save_budgets/load_budgets + save_all on shutdown).','','','','','','','','','','','','','','','','','','','',0,0,'','',NULL);
INSERT INTO items VALUES('019cc0a4632e7621b60a23c35eefef1c','work_item','done','Implementation plan: Cost tracking and budget enforcement',replace('## Architecture\n\n### Interception points\n- **Post-call tracking:** `SingletonObject.chat_completed` signal carries `BotResponse` with `prompt_tokens`, `completion_tokens`, and `provider` reference (which has `input_token_cost`/`output_token_cost`). Best hook for recording costs.\n- **Pre-call budget enforcement:** Must happen before `BaseProvider.make_request()`. Two options: (A) add check in `ChatPane.generate_content_from_provider()`, or (B) add a guard in `BaseProvider.make_request()` itself. Option B is safer — catches all callers, not just ChatPane.\n\n### Existing infrastructure\n- `ServiceHistory.get_session_cost()` already calculates per-chat cost on demand\n- `ChatHistoryItem.InputTokens`/`OutputTokens` already stored and persisted\n- No cross-session aggregation, no persistent ledger, no budgets\n\n### Design decisions\n1. **New class: `CostTracker`** — singleton/autoload that owns the ledger, budget state, and query API\n2. **Storage: JSON file** (`user://cost_ledger.json`) — simple, matches existing pattern (model configs use JSON). SQLite is overkill for append-only cost records.\n3. **Budget scope: per-chat** — each chat can have an optional budget. Agent-spawned chats inherit parent budget or get explicit one.\n4. **Enforcement point: `BaseProvider.make_request()`** — add a pre-flight check that calls `CostTracker.check_budget()`. Returns error if over budget. This catches ALL external calls regardless of caller.\n5. **MCP tools** — expose cost queries and budget management so agents can self-monitor\n\n### Phases\n- Phase 1: CostTracker class + ledger recording (passive tracking)\n- Phase 2: Budget enforcement in BaseProvider (active gating)\n- Phase 3: MCP tools for cost queries and budget management\n- Phase 4: UI indicators (status bar cost display, budget warnings)','\n',char(10)),'2026-03-06T00:55:24','2026-03-06T01:08:44','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cb9be8b0d',NULL);
INSERT INTO items VALUES('019cc0a4917e7b6c91be0e3bd81a6307','work_item','done','Phase 1: CostTracker class and ledger recording',replace('Create `CostTracker` class (RefCounted or Node autoload) in `src/Scripts/Models/CostTracker.gd`.\n\n**Responsibilities:**\n- Connect to `SingletonObject.chat_completed` signal in `_init()` or `_ready()`\n- On each completion, record a ledger entry: `{timestamp, provider, model_name, prompt_tokens, completion_tokens, cost_usd, chat_id}`\n- Maintain in-memory array + periodic flush to `user://cost_ledger.json`\n- Query methods: `get_cost_today()`, `get_cost_by_provider(provider)`, `get_cost_by_chat(chat_id)`, `get_cost_range(from_date, to_date)`\n- Rolling file strategy: one JSON file per month (`cost_ledger_2026_03.json`) to avoid unbounded growth\n\n**Key files:**\n- New: `src/Scripts/Models/CostTracker.gd`\n- Modify: `singleton_object.gd` — instantiate CostTracker, expose as `SingletonObject.cost_tracker`\n- Reference: `BotResponse.gd` (prompt_tokens, completion_tokens, provider), `ServiceHistory.get_session_cost()` for cost formula\n\n**Ledger entry schema:**\n```\n{\n  "ts": "2026-03-06T01:00:00Z",\n  "provider": "anthropic",\n  "model": "claude-sonnet-4.5",\n  "input_tokens": 1500,\n  "output_tokens": 800,\n  "cost_usd": 0.0165,\n  "chat_id": "uuid"\n}\n```','\n',char(10)),'2026-03-06T00:55:36','2026-03-06T01:06:28','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0a4632e',NULL);
INSERT INTO items VALUES('019cc0a4b9b072c89d71ca966b6ed350','work_item','done','Phase 2: Budget enforcement in BaseProvider',replace('Add pre-flight budget check before external API calls.\n\n**Design:**\n- Add `budget_usd` and `budget_warn_pct` (default 0.8) to `ServiceHistory` or `ChatHistory` — each chat can optionally have a budget\n- Add guard in `BaseProvider.make_request()`: before HTTP call, check `CostTracker.check_budget(chat_id)` → returns `{ok, remaining, pct_used}`\n- If over budget: return `RequestResults.from_error("Budget exceeded ($X.XX / $Y.YY). Extend budget to continue.")` — no HTTP call made\n- If at warning threshold: emit `SingletonObject.budget_warning` signal with details — UI/agent can react but call proceeds\n- At limit: emit `SingletonObject.budget_exceeded` signal — call blocked\n\n**Budget management API on CostTracker:**\n- `set_budget(chat_id, amount_usd)`\n- `extend_budget(chat_id, additional_usd)`\n- `clear_budget(chat_id)`\n- `check_budget(chat_id) -> Dictionary` — returns ok/remaining/pct\n- `get_budget(chat_id) -> Dictionary` — returns budget, spent, remaining\n\n**Key files:**\n- Modify: `BaseProvider.gd` — add budget check in `make_request()`\n- Modify: `CostTracker.gd` — add budget state dict and check/set methods\n- Modify: `singleton_object.gd` — add `budget_warning` and `budget_exceeded` signals\n\n**Edge cases:**\n- No budget set → always allow (default behavior)\n- Local provider (cost=0) → skip check\n- Streaming responses → budget checked pre-call only (can''t cancel mid-stream yet, see cancel protocol DCR)','\n',char(10)),'2026-03-06T00:55:46','2026-03-06T01:06:41','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0a4632e',NULL);
INSERT INTO items VALUES('019cc0a4d988706cbc44116cb923c912','work_item','done','Phase 3: MCP tools for cost queries and budget management',replace('Add MCP tools so agents can monitor their own spend and manage budgets.\n\n**Tools (tool_set: "costs"):**\n\n1. `minerva_get_cost_summary` — Get cost summary for current session, today, or a date range\n   - Params: `period` (enum: session/today/week/month/all), `provider` (optional filter)\n   - Returns: total_cost, breakdown by provider, breakdown by model, call count\n\n2. `minerva_get_chat_cost` — Get cost for a specific chat\n   - Params: `chat_id` (required)\n   - Returns: total_cost, input_tokens, output_tokens, call_count, budget (if set), remaining\n\n3. `minerva_set_budget` — Set or update budget for a chat\n   - Params: `chat_id` (required), `budget_usd` (required)\n   - Returns: success, previous budget if any\n\n4. `minerva_extend_budget` — Add to an existing budget\n   - Params: `chat_id` (required), `additional_usd` (required)\n   - Returns: success, new_total_budget\n\n**Key files:**\n- Modify: `MinervaMCPServer.gd` — add `_register_cost_tools()`, 4 handler functions, match cases\n- Reference: `CostTracker.gd` for query/budget API\n\n**Pattern:** Same as model tools — register in `_init()`, match in `_execute_tool_impl()`, handler functions delegate to CostTracker.','\n',char(10)),'2026-03-06T00:55:55','2026-03-06T01:08:17','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0a4632e',NULL);
INSERT INTO items VALUES('019cc0a4fc0d7c1aa5d7a2fa237d16cf','work_item','done','Phase 4: UI cost indicators and budget warnings',replace('Add visual cost indicators to the Minerva UI.\n\n**Components:**\n\n1. **Per-message cost label** — Show cost next to each AI response in chat (already have token counts displayed, add dollar amount)\n   - Modify: ChatPane message rendering — add cost label using `(InputTokens * input_cost + OutputTokens * output_cost) / 1M`\n\n2. **Session cost in status bar** — Running total for current chat session\n   - Modify: status bar area — connect to `CostTracker.cost_updated` signal, display "$X.XX this session"\n\n3. **Budget indicator** — When a chat has a budget, show progress bar or fraction\n   - "$2.15 / $5.00" with color coding: green (<60%), yellow (60-80%), red (>80%)\n\n4. **Budget warning popup** — When `budget_warning` signal fires, show non-blocking notification\n   - "Approaching budget limit: $4.10 / $5.00 (82%)"\n\n5. **Budget exceeded dialog** — When `budget_exceeded` signal fires, show blocking dialog\n   - "Budget exceeded for this chat ($5.02 / $5.00). [Extend +$5] [Stop]"\n   - Extend button calls `CostTracker.extend_budget()`\n\n**Key files:**\n- Modify: ChatPane.gd — per-message cost label, session cost display\n- Modify or new: budget UI components\n- Connect: `CostTracker.cost_updated`, `budget_warning`, `budget_exceeded` signals','\n',char(10)),'2026-03-06T00:56:03','2026-03-06T01:08:23','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0a4632e',NULL);
INSERT INTO items VALUES('019cc0bad9867bb8a60d1d6738ae1d80','work_item','done','Spending Dashboard: Tools > Spending... window',replace('Add a dedicated Spending Dashboard window accessible via Tools > Spending... menu item. Follows AgentManagerWindow pattern (extends Window, procedural UI, cached instance, added to tree root).\n\n## Contents\n- Today''s spend (total)\n- This month''s spend (total)\n- Per-model breakdown: model name, tokens in/out, cost\n- Per-provider breakdown: provider name, total cost, % of spend\n- Spend per hour (recent activity)\n- Budget section: current budget, spent/remaining, progress bar, edit button\n\n## Pattern\n- New file: SpendingDashboard.gd (extends Window, builds UI in code)\n- Menu hookup in menuMain.gd (Tools menu, ID 103)\n- Reads from SingletonObject.cost_tracker for all data','\n',char(10)),'2026-03-06T01:19:56','2026-03-06T01:22:18','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0a4fc0d',NULL);
INSERT INTO items VALUES('019cc0baed737eb59e34832c1a4a951c','work_item','done','Create SpendingDashboard.gd window class','Build SpendingDashboard.gd extending Window. Procedural UI with summary cards, per-model table, per-provider breakdown, and budget controls. Reads from cost_tracker.','2026-03-06T01:20:01','2026-03-06T01:22:08','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0bad986',NULL);
INSERT INTO items VALUES('019cc0baf41870419515d37c7f3e44cc','work_item','done','Hook SpendingDashboard into Tools menu','Add ''Spending...'' item (ID 103) to Tools menu in menuMain.gd. Cache SpendingDashboard instance, add to tree root, popup_centered on click. Refresh data on each open.','2026-03-06T01:20:03','2026-03-06T01:22:17','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0bad986',NULL);
INSERT INTO items VALUES('019cc0bd67d17745a8dae379110fbc8c','dcr','shipped','Dynamic MCP server and skill registration at runtime',replace('## Problem\nMCP servers are currently hardcoded/configured at startup. There''s no way for a user or agent to dynamically add an MCP server (like Docket) at runtime so that Minerva''s agents can use its tools. Same for skills — no runtime registration.\n\n## Use Cases\n- User wants to connect Docket as an MCP server for agents to use during a session\n- Agent discovers it needs a tool (e.g., web search, database) and requests the MCP server be added\n- User builds a custom MCP server and wants to test it without restarting Minerva\n- Skills/tool sets that should be available only for specific workflows\n\n## Requirements\n\n### Dynamic MCP Server Registration\n- Add/remove MCP server connections at runtime (not just at startup)\n- UI to manage connected servers (similar to "Install MCP Servers..." but for live connections)\n- MCP tool to add a server: `minerva_connect_mcp_server(name, transport, url/command)`\n- Hot-reload: new server''s tools immediately available to agents\n- Persist configuration so servers reconnect on restart (optional per-server)\n\n### Dynamic Skill Registration\n- Register new skills/tool sets at runtime\n- Skills could come from MCP servers, local scripts, or agent-defined workflows\n\n### Safety\n- Sandboxing: dynamically added servers shouldn''t be able to escalate beyond their granted permissions\n- Tool namespace isolation to prevent conflicts between servers\n\n## Architecture Notes\n- Minerva already has MCPManager with server registry — extend it with add/remove at runtime\n- The "Install MCP Servers..." dialog already handles server config — extend with connect/disconnect\n- Tool set filtering (`_enabled_tool_sets`) already exists — new servers get their own tool set','\n',char(10)),'2026-03-06T01:22:44','2026-03-07T06:59:49','','','',2,0,'Both halves complete. Dynamic MCP: MCPKnownServers registry, add/remove_server_at_runtime(), Add Server dialog (HTTP/WS/STDIO with test connection), dynamic Preferences and menu UI, config validation, connection diagnostics, rollback on partial connect, tool collision warnings. Runtime Skills: SkillDefinition/SkillManager, Preferences Skills tab, system prompt injection, executable tool registration, 5 MCP management tools. Manual test item filed separately.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc100567b786eab9e234d12a38b6e','dcr','proposed','Multi-user autocoder: per-user API key UI, session controls, and spend tracking (client)',replace('Client-side changes for multi-user autocoder sessions with per-user OpenRouter keys. Companion to minerva-services DCR 019cc0fb3ad7.\n\n## Problem\n\nMinerva client has no concept of per-user API keys or per-user sessions. The autocoder uses a single shared backend key and a single shared budget. With multiple users this means no isolation, no attribution, and no independent spend control.\n\n## Requirements\n\n### 1. API key management UI\n- User enters their OpenRouter API key in Minerva client (Settings or Autocoder preferences)\n- Key stored securely on client side (not plaintext in config)\n- Key transmitted to backend securely (per-request header, session handshake, or encrypted via Profile — must align with backend DCR 019cc0fb3ad7)\n- Clear UX: user knows whether their key is set, can update/remove it\n\n### 2. Session lifecycle controls\n- UI to start/stop an autocoder coding session\n- Starting a session triggers per-user container spin-up on backend\n- Stopping a session (or idle timeout) triggers container tear-down\n- Session state visible to user: running, starting, stopped\n\n### 3. Per-user cost tracking and budget\n- CostTracker needs user-level concept (not just chat_id and __global__)\n- Budget can be set per-user (independent of other users)\n- Spend dashboard shows the user''s own spend, sourced from backend-authoritative ledger\n- Cross-reference: user''s OpenRouter dashboard should roughly match Minerva''s tracked spend\n\n## Notes\n- Backend companion: minerva-services DCR 019cc0fb3ad7\n- Profile service JWT already carries user identity — client already has this\n- Existing CostTracker has per-chat budgets and a global budget; needs a per-user layer between them','\n',char(10)),'2026-03-06T02:35:50','2026-03-06T02:36:13','','','',3,4,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc1119cfa75ee93d5301bb89441fd','work_item','backlog','Plan: Chat compaction, summarization, and archival',replace('## Context\n\nAgent-mode summarization already exists (ChatPane.gd:192-273) but is naive (counts + 200-char excerpts, no LLM call) and only triggers during agent tool-call loops at 60k tokens. Regular chats have zero compaction — full history is always sent until the API errors out.\n\nDesign from prior research (docket comments 13-17) proposes:\n- **Tiered memory**: Level 0 (full), Level 1 (compacted, originals in Ledger), Level 2 (archived, originals purged)\n- **Ledger**: project-scoped notes panel for compacted message archives, retrievable via MCP\n- **Triggers**: manual button, MCP tool, rule-based (token threshold prompt before send)\n- **Per-model thresholds**: default at ~60% of context window, overridable per-chat\n\n## Approach\n\nPhased — each phase is independently useful:\n\n### Phase 1: Generalize existing compaction to all chats\n- Extract `summarize_agent_history()` into a standalone `compact_chat()` on ChatPane\n- Add "Compact" button to chat controls\n- Add token threshold check before send in regular chats (prompt user, don''t auto-compact)\n- Keep the same naive summary format for now\n\n### Phase 2: Ledger storage for compacted messages\n- Create Ledger panel (project-scoped, not auto-injected into context)\n- When compaction runs, store originals as a Ledger entry (chat name, timestamp, message range, full text)\n- Summary message includes Ledger entry ID for retrieval\n- MCP tools: list/read Ledger entries\n\n### Phase 3: LLM-powered summarization\n- Replace naive summary with a call to a cheap model (Haiku/Flash)\n- Prompt: "Summarize this conversation preserving key decisions, facts, and action items"\n- Store LLM summary in chat, originals in Ledger\n- Fallback to naive if LLM call fails\n\n### Phase 4: MCP tools and auto-management\n- `minerva_compact_chat(chat_id)` — trigger compaction on demand\n- Per-model default thresholds (derive from context_length in model config)\n- Per-chat threshold override (already wired: ServiceHistory.AgentSummarizeThreshold)\n- Auto-compact setting: compact silently in agent mode, prompt in regular mode\n\n## Key files\n- `ChatPane.gd` — extract/generalize summarization, add threshold check, compact button\n- `ServiceHistory.gd` — per-chat compaction settings (already has AgentSummarize* fields)\n- New: Ledger panel (similar to Drawer, project-scoped)\n- `MinervaMCPServer.gd` — compact/ledger MCP tools\n- `ProjectMenuActions.gd` — serialize/deserialize Ledger entries','\n',char(10)),'2026-03-06T02:54:42','2026-03-06T02:54:42','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbef3897b',NULL);
INSERT INTO items VALUES('019cc111cfea72878056df4455ccb430','work_item','backlog','Phase 1: Generalize compaction to all chat modes',replace('Extract `summarize_agent_history()` from agent-only path into a reusable `compact_chat(history)` method.\n\n**Changes:**\n1. **ChatPane.gd** — new `compact_chat(history)` that works identically to current `summarize_agent_history()` but callable from any context (agent or regular chat)\n2. **ChatPane.gd** — add "Compact" button to chat controls bar (next to existing buttons). Calls `compact_chat(current_history)`. Disabled when chat has < threshold messages.\n3. **ChatPane.gd** — in `execute_regular_chat()`, before `create_prompt()`, check accumulated tokens. If over threshold, show confirmation dialog: "This chat is ~X tokens. Compact to reduce context?" [Compact] [Skip] [Don''t ask again for this chat]\n4. **Token counting** — use sum of `InputTokens + OutputTokens` from ChatHistoryItems (real API values) rather than character heuristic. Fall back to heuristic for items without API counts.\n5. **Agent mode** — refactor `summarize_agent_history()` to call the new `compact_chat()` internally (no behavior change, just dedup)\n\n**Keeps:** Same naive summary format (counts + excerpts). LLM summarization is Phase 3.\n**Config:** Uses existing `AgentSummarizeThreshold` / `AGENT_SUMMARIZE_THRESHOLD` for default. Regular chats use same threshold.','\n',char(10)),'2026-03-06T02:54:55','2026-03-06T02:54:55','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1119cfa',NULL);
INSERT INTO items VALUES('019cc111efd47d0d9ebbecd977094c41','work_item','backlog','Phase 2: Ledger panel for compaction archives',replace('Create the Ledger — a project-scoped notes panel for compacted message archives. Structurally similar to Drawer but NOT auto-injected into chat context.\n\n**New files:**\n- `LedgerPanel.gd` (or extend existing notes infrastructure) — collapsible panel showing Ledger entries grouped by chat\n- `LedgerEntry` data class: `{id, chat_id, chat_name, timestamp, message_range, original_messages, summary_text}`\n\n**Changes:**\n1. **Ledger panel UI** — collapsible panel accessible from sidebar or menu. Shows entries grouped by source chat. Each entry expandable to show original messages.\n2. **compact_chat() (from Phase 1)** — after compaction, create a LedgerEntry with the original messages. Insert Ledger entry ID into the summary message: "Compacted N messages. Originals: [Ledger:entry_id]"\n3. **ProjectMenuActions.gd** — serialize/deserialize Ledger entries in project file under `"Ledger"` key\n4. **MCP tools** — `minerva_list_ledger_entries(chat_id?)` and `minerva_get_ledger_entry(entry_id)` so agents can recover compacted detail on demand\n\n**Design:** Ledger entries are read-only after creation. Purging (Level 2 archival) is future work.','\n',char(10)),'2026-03-06T02:55:04','2026-03-06T02:56:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1119cfa',NULL);
INSERT INTO items VALUES('019cc1120d027f348dde7a03a79eb332','work_item','backlog','Phase 3: LLM-powered summarization',replace('Replace the naive summary (counts + 200-char excerpts) with an actual LLM call to produce a semantic summary.\n\n**Changes:**\n1. **compact_chat()** — instead of building a mechanical stats block, format the to-be-compacted messages as a prompt and send to a cheap/fast model (Haiku, Flash, or whatever the cheapest available model is)\n2. **Summary prompt**: "Summarize this conversation segment. Preserve: key decisions, facts learned, action items, important code snippets, and any unresolved questions. Be concise but complete."\n3. **Model selection** — use the cheapest available model. Check for local models first (free), then Haiku/Flash. Add a `compaction_model` preference (default: auto-select cheapest).\n4. **Fallback** — if LLM call fails (no API key, network error, budget exceeded), fall back to the naive mechanical summary. Log warning.\n5. **Async consideration** — LLM call is async. Show a brief "Compacting..." indicator. In agent mode, the compaction must complete before the next tool-call round continues.\n6. **Cost** — compaction calls go through CostTracker like any other API call. Budget enforcement applies.','\n',char(10)),'2026-03-06T02:55:11','2026-03-06T02:56:10','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1119cfa',NULL);
INSERT INTO items VALUES('019cc11224227fb1b3ddc842e71ce223','work_item','backlog','Phase 4: MCP compact tool and auto-management settings',replace('Add MCP tool for on-demand compaction and configurable per-model thresholds.\n\n**MCP tools:**\n1. `minerva_compact_chat(chat_id)` — trigger compaction on any chat. Returns summary text and Ledger entry ID. Agents can self-compact when they notice context growing.\n\n**Auto-management settings:**\n2. Per-model default compaction threshold — derive from `context_length` in model config (default: 60% of context window). Store in model config JSON alongside pricing.\n3. Per-chat override — already wired via `ServiceHistory.AgentSummarizeThreshold`. Expose in AISettings per-chat dialog.\n4. Compaction behavior setting: "Auto" (compact silently in agent mode, prompt in regular), "Always ask", "Never auto-compact"\n5. `minerva_set_compaction_threshold(chat_id, tokens)` — MCP tool for agents to adjust their own threshold','\n',char(10)),'2026-03-06T02:55:17','2026-03-06T02:56:10','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1119cfa',NULL);
INSERT INTO items VALUES('019cc1126b42790995136dc8af39c49b','work_item','backlog','Plan: Time-based triggers (wall-clock scheduling)',replace('## Context\n\nTriggerManager already supports TIMER triggers — interval-based (fire every N seconds via Godot Timer nodes, min 5s). What''s missing is wall-clock scheduling: "fire at 9am daily", "fire every Monday at noon", etc.\n\n### Existing infrastructure\n- `TriggerDefinition.gd`: `TriggerType { TIMER, EVENT }`, `interval_seconds` field, `enabled` flag\n- `TriggerManager.gd`: creates Godot Timer nodes per enabled TIMER trigger, stores in `_timer_nodes` dict\n- Timers restart from zero on project load (no persistence of remaining time)\n- Anti-flood: `_active_trigger_chats` prevents re-firing while triggered chat is active\n- Batch execution + chaining already work for both TIMER and EVENT types\n- MCP: `minerva_create_trigger`, `minerva_update_trigger`, `minerva_fire_trigger` already exist\n- UI: AgentManagerWindow has full trigger CRUD\n\n### What''s needed\n1. **Schedule type**: alongside interval, add wall-clock scheduling (time-of-day, day-of-week)\n2. **Schedule expressions**: simple enough for UI — not full cron, but structured fields\n3. **Timezone awareness**: schedules should respect local time\n4. **Missed fires**: if Minerva wasn''t running at scheduled time, option to fire on next startup\n5. **Persistence of schedule state**: track last-fired time so missed fires can be detected\n\n## Approach\n\n### Phase 1: Schedule data model and evaluation\n- Extend TriggerDefinition with schedule fields\n- Add a 1-minute poll timer in TriggerManager to check wall-clock schedules\n- Persist `last_fired_at` per trigger\n\n### Phase 2: UI for schedule configuration\n- Extend AgentManagerWindow trigger editor with schedule fields\n- Human-readable schedule preview ("Every day at 9:00 AM", "Every Monday at 2:00 PM")\n\n### Phase 3: MCP and missed-fire handling\n- Extend MCP create/update tools with schedule params\n- On project load, check for missed fires and optionally execute\n\n## Key files\n- `TriggerDefinition.gd` — new schedule fields\n- `TriggerManager.gd` — schedule evaluator, poll timer, missed-fire check\n- `AgentManagerWindow.gd` — schedule UI\n- `MinervaMCPServer.gd` — extend trigger MCP tools\n- `ProjectMenuActions.gd` — serialize last_fired_at','\n',char(10)),'2026-03-06T02:55:35','2026-03-06T02:55:35','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cbef39812',NULL);
INSERT INTO items VALUES('019cc112a19570758eabaebc2b89a15b','work_item','backlog','Phase 1: Schedule data model and wall-clock evaluator',replace('Extend the trigger system with wall-clock schedule support.\n\n**TriggerDefinition.gd — new fields:**\n- `schedule_type: ScheduleType` — enum: `INTERVAL` (existing behavior), `DAILY`, `WEEKLY`, `CUSTOM`\n- `schedule_time: String` — "HH:MM" in 24h local time (for DAILY/WEEKLY)\n- `schedule_days: Array[int]` — days of week 0-6, Mon=0 (for WEEKLY; empty = every day)\n- `last_fired_at: String` — ISO datetime of last successful fire (persisted)\n- `fire_if_missed: bool` — if true, fire on next startup if a scheduled time was missed (default: true)\n\nWhen `schedule_type == INTERVAL`, behavior is unchanged (existing Godot Timer).\n\n**TriggerManager.gd — schedule evaluator:**\n1. Add a single 60-second poll timer (`_schedule_check_timer`) created in `_ready()`\n2. On each tick, iterate all enabled triggers with `schedule_type != INTERVAL`\n3. For each: compute whether current local time matches the schedule and `last_fired_at` is before the most recent matching time\n4. If match: fire the trigger, update `last_fired_at`\n5. `_should_fire_schedule(trigger) -> bool` — core evaluation logic:\n   - DAILY: current time >= schedule_time AND last_fired_at < today''s schedule_time\n   - WEEKLY: same as DAILY but also check current day-of-week is in schedule_days\n   - CUSTOM: future extension point\n\n**Serialization:**\n- `last_fired_at` added to `serialize()` / `deserialize()` on TriggerDefinition\n- ProjectMenuActions already serializes all trigger fields — just needs the new ones','\n',char(10)),'2026-03-06T02:55:49','2026-03-06T02:55:49','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1126b42',NULL);
INSERT INTO items VALUES('019cc112c0e973b9a18d84c828af2233','work_item','backlog','Phase 2: Schedule configuration UI',replace('Extend the trigger editor in AgentManagerWindow with schedule configuration.\n\n**UI changes in AgentManagerWindow.gd:**\n1. When trigger_type == TIMER, show a `schedule_type` OptionButton: "Every N seconds" / "Daily" / "Weekly"\n2. **Interval mode** (existing): show `interval_seconds` SpinBox (unchanged)\n3. **Daily mode**: show time picker (HBoxContainer with hour SpinBox 0-23 + minute SpinBox 0-59). Hide interval_seconds.\n4. **Weekly mode**: show time picker + day-of-week checkboxes (Mon-Sun). At least one day must be selected.\n5. **Fire if missed** checkbox: "Run on startup if scheduled time was missed" (default: checked)\n6. **Schedule preview label**: human-readable text below the controls:\n   - "Every 300 seconds"\n   - "Every day at 9:00 AM"\n   - "Every Monday, Wednesday, Friday at 2:30 PM"\n7. **Last fired display**: read-only label showing `last_fired_at` if set ("Last ran: 2026-03-06 09:00")\n\n**Validation:**\n- Weekly mode requires at least one day selected\n- Time fields clamped to valid ranges\n- Save button writes all new fields to TriggerDefinition','\n',char(10)),'2026-03-06T02:55:57','2026-03-06T02:56:11','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1126b42',NULL);
INSERT INTO items VALUES('019cc112dd4f7e1ea0abd2c693c95afd','work_item','backlog','Phase 3: MCP schedule params and missed-fire recovery',replace('Extend MCP trigger tools with schedule params and add missed-fire recovery on project load.\n\n**MCP tool changes (MinervaMCPServer.gd):**\n1. `minerva_create_trigger` — add optional params: `schedule_type` (enum: interval/daily/weekly), `schedule_time` ("HH:MM"), `schedule_days` (array of ints 0-6), `fire_if_missed` (bool)\n2. `minerva_update_trigger` — same new params as patch fields\n3. `minerva_list_triggers` — include schedule fields and `last_fired_at` in response\n\n**Missed-fire recovery (TriggerManager.gd):**\n1. On `_ready()` (after project triggers are deserialized), call `_check_missed_fires()`\n2. For each enabled trigger with `fire_if_missed == true` and `schedule_type != INTERVAL`:\n   - Compute the most recent scheduled time before now\n   - If `last_fired_at` < that time: the scheduled fire was missed\n   - Queue a deferred fire (don''t block startup): `call_deferred("_fire_trigger", trigger.id)`\n   - Log: "[TriggerManager] Firing missed schedule for ''trigger_name'' (was due at HH:MM)"\n3. Cap: only fire the most recent missed instance, not all missed intervals since last run','\n',char(10)),'2026-03-06T02:56:04','2026-03-06T02:56:12','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc1126b42',NULL);
INSERT INTO items VALUES('019cc148b4ea794c9c59857a5b863e39','dcr','proposed','Allow internal MCP users to use tool grouping (with agent-mode overrides)','The external (HTTP) MCP server already supports grouping tools into logical sets. Extend this same tool-grouping capability to internal MCP consumers (i.e. agents and chats using MinervaMCPServer directly). Agent mode should be able to override which tool groups are enabled/disabled, allowing per-agent tool scoping. This makes the internal and external MCP experience consistent and gives agents fine-grained control over which tools they expose.','2026-03-06T03:54:53','2026-03-06T03:54:53','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc41b36f97012a4cc58cdb9193ab0','dcr','proposed','Planning improvements Autocoder',replace('Planning gives you choices in the autocoder. You can pick them. Problems:\n1. You cant "add your own option"\n2. You can''t enter text in a plan.\n3. You can''t append your own unrelated thoughts.\n\nExample:\nWhat python version do you want to target:\na. Python 2\nb. Pyhton 3.\n\nBut no option for "Python 3.12.1"\n\nAlso, can''t add a new instruction after making the choice above like:\nMake sure to use miniconda/anaconda for python env management.','\n',char(10)),'2026-03-06T17:04:03','2026-03-06T17:04:03','','','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc4db5db179be936c33184da0c9bd','bug','resolved','Clean up warnings',replace('Clean up these warnings:\n\n```\nW 0:00:01:898   GDScript::reload: Reassigning lambda capture does not modify the outer local variable "compacted".\n  <GDScript Error>CONFUSABLE_CAPTURE_REASSIGNMENT\n  <GDScript Source>ChatPane.gd:1123 @ GDScript::reload()\n\nW 0:00:01:898   GDScript::reload: The local function parameter "show" is shadowing an already-declared method in the base class "CanvasItem".\n  <GDScript Error>SHADOWED_VARIABLE_BASE_CLASS\n  <GDScript Source>ChatPane.gd:2237 @ GDScript::reload()\n\nW 0:00:02:104   GDScript::reload: Values of the ternary operator are not mutually compatible.\n  <GDScript Error>INCOMPATIBLE_TERNARY\n  <GDScript Source>AgentRegistry.gd:49 @ GDScript::reload()\n\nW 0:00:02:511   GDScript::reload: The local variable "check_hhmm" is declared but never used in the block. If this is intended, prefix it with an underscore: "_check_hhmm".\n  <GDScript Error>UNUSED_VARIABLE\n  <GDScript Source>TriggerManager.gd:656 @ GDScript::reload()\n\nW 0:00:02:735   GDScript::reload: The local variable "is_interval" is declared but never used in the block. If this is intended, prefix it with an underscore: "_is_interval".\n  <GDScript Error>UNUSED_VARIABLE\n  <GDScript Source>AgentManagerWindow.gd:1037 @ GDScript::reload()\n\nW 0:00:02:879   GDScript::reload: The local function parameter "show" is shadowing an already-declared method in the base class "Window".\n  <GDScript Error>SHADOWED_VARIABLE_BASE_CLASS\n  <GDScript Source>LedgerBrowserWindow.gd:178 @ GDScript::reload()\n```','\n',char(10)),'2026-03-06T20:33:56','2026-03-06T20:36:29','','','',3,0,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc4e9259f73bd9c49bfe62c9f084b','dcr','designing','Add OpenAI Codex subscription-backed provider via official Codex surfaces',replace('## Summary\n\nAdd a new Minerva provider that uses OpenAI Codex through the official ChatGPT-subscription-backed surfaces OpenAI permits, rather than through normal API billing.\n\nThis is **not** a standard OpenAI API provider. OpenAI''s current policy is that ChatGPT subscription billing and API billing are separate, and ChatGPT subscriptions cannot simply be used as API credits. However, OpenAI explicitly says Codex can be used with a ChatGPT plan in Codex clients such as the CLI, IDE extension, app/web, and programmatically via the Codex SDK.\n\nThat creates a plausible Minerva integration path: implement a dedicated `CodexProvider` that delegates requests through the official Codex CLI and/or Codex SDK, similar in spirit to the existing `ClaudeCodeProvider`, instead of trying to reuse `OpenAIProvider` or inject ChatGPT credentials into standard API calls.\n\n## Research Findings (as of 2026-03-06)\n\n### What OpenAI appears to allow\n\nOpenAI Help Center says Codex is included with ChatGPT plans and can be used by signing in with ChatGPT in:\n- Codex CLI\n- Codex IDE extension\n- Codex web\n- Codex app\n- programmatically via the Codex SDK\n- Slack\n\nOpenAI also states that if you previously used the Codex CLI via API key, you can switch it to subscription-based access by logging out and signing in with ChatGPT.\n\n### What OpenAI does **not** appear to allow\n\nOpenAI Help Center separately states:\n- ChatGPT and API platform billing are separate\n- a ChatGPT subscription cannot be moved to the API\n- normal API usage remains token-billed and separately managed\n\n### Implication for Minerva\n\nA Minerva provider is viable **only** if it uses the official Codex product surfaces/auth flows. It is **not** viable as "use my ChatGPT Plus/Pro account like an OpenAI API key".\n\n## Source Links\n\nOfficial sources used for this research:\n- https://help.openai.com/en/articles/11369540-using-codex-with-your-chatgpt-plan\n- https://openai.com/index/codex-now-generally-available/\n- https://openai.com/index/introducing-the-codex-app/\n- https://help.openai.com/en/articles/8156019-how-can-i-move-my-chatgpt-subscription-to-the-api\n- https://help.openai.com/en/articles/9039756-billing-settings-in-chatgpt-vs-platform\n- https://platform.openai.com/docs/guides/code-generation\n\n## Why this fits Minerva\n\nMinerva already has:\n- agent mode\n- MCP tool access, including `code-tools`\n- provider abstraction via `BaseProvider`\n- an existing precedent for subscription-backed CLI delegation in `ClaudeCodeProvider`\n\nRelevant local implementation precedent:\n- `src/Scripts/Services/Providers/ClaudeCode/ClaudeCodeProvider.gd`\n- `src/Scripts/Services/Providers/BaseProvider.gd`\n- `src/Scripts/Models/singleton_object.gd`\n- `src/Scripts/UI/Views/PreferencesPopup.gd`\n- `src/Scripts/UI/Controls/ProviderOptionButton.gd`\n\nThis means Minerva can likely support Codex as a dedicated provider class without re-architecting the entire provider stack.\n\n## Recommended Product Shape\n\n### User-facing goal\n\nAdd a provider named something like:\n- `OpenAI Codex`\n- `Codex (ChatGPT)`\n- `Codex CLI`\n\nThe naming should make the billing/auth distinction obvious:\n- this uses ChatGPT/Codex sign-in\n- this is not the normal OpenAI API provider\n\n### Preferred first implementation\n\n**Phase 1 should use the official Codex CLI** rather than the SDK.\n\nReasoning:\n- Minerva already has a CLI-backed provider pattern (`ClaudeCodeProvider`)\n- CLI integration minimizes policy ambiguity\n- it avoids embedding a Node/TS SDK runtime into Godot as the first step\n- it lets users bring an already-authenticated Codex installation\n- it is closer to the way OpenAI describes subscription usage today\n\n### Possible later implementation\n\n**Phase 2 can add a Codex SDK bridge** if needed for:\n- structured session control\nn- better resumability\n- more explicit context/session state\n- richer machine-readable outputs than raw CLI stdout\n\nBecause the SDK is TypeScript-first today, Minerva would likely need a helper bridge process instead of direct in-process use.\n\n## Proposed Architecture\n\n### Provider type\n\nCreate a new provider script similar to:\n- `src/Scripts/Services/Providers/Codex/CodexProvider.gd`\n\nThis provider should:\n- extend `BaseProvider`\n- shell out to the official `codex` CLI for requests\n- treat ChatGPT-authenticated Codex as the underlying execution engine\n- report token/cost fields conservatively, likely as `0.0` or `unknown` under subscription mode unless Codex exposes structured usage for local sessions\n\n### Provider registration\n\nUpdate provider registries and menus in:\n- `src/Scripts/Models/singleton_object.gd`\n- `src/Scripts/UI/Views/PreferencesPopup.gd`\n- `src/Scripts/UI/Controls/ProviderOptionButton.gd`\n- `src/Scripts/UI/Views/AISettings.gd`\n- MCP agent-definition descriptions if provider enum IDs are exposed there\n\n### Auth model\n\nMinerva should **not** ask for a ChatGPT username/password or API key.\n\nInstead it should assume one of:\n- Codex CLI is already installed and authenticated via `codex login`\n- user points Minerva at a `codex` executable path\n- Minerva provides a simple "verify Codex CLI" action that runs a harmless check and returns auth/install status\n\n### Invocation model\n\nLikely request flow:\n1. Minerva formats the conversation/history into a prompt\n2. Minerva invokes the `codex` CLI in non-interactive mode\n3. CLI runs against local repo context when relevant\n4. stdout/stderr is parsed into `BotResponse`\n\nOpen questions to resolve in implementation:\n- exact non-interactive CLI command shape to use\n- best machine-readable output mode\n- whether local Codex sessions can be resumed per chat/history\n- whether Minerva should maintain one Codex thread/session per `HistoryId`\n\n### Session model\n\nMinerva should evaluate two modes:\n- **stateless mode**: each request is a fresh Codex invocation using current chat history\n- **sessionful mode**: preserve a Codex session/thread per chat tab\n\nStateless is simpler and should likely be the first implementation.\n\n## Scope Recommendation\n\n### Phase 1: Minimal viable provider\n\nImplement a `CodexProvider` that:\n- sends text prompts only\n- works for regular chat and Minerva agent mode prompts\n- does not attempt image input\n- does not attempt streaming unless CLI output makes this straightforward\n- does not expose internal Codex cloud task management yet\n\nThis phase answers the main user need: use a ChatGPT subscription-backed Codex workflow inside Minerva.\n\n### Phase 2: Agentic integration improvements\n\nInvestigate whether Codex should be treated as:\n- a plain text provider in Minerva agent mode, or\n- a more autonomous coding agent with stronger repo/command affordances\n\nLikely differences vs normal providers:\n- Codex already has native repo navigation / edit / command execution behaviors in its own product model\n- Minerva MCP `code-tools` may become redundant or complementary depending on how Codex local execution works\n\nDesign decision needed:\n- **Option A:** disable Minerva MCP tool-calling when using Codex provider and let Codex handle autonomy itself\n- **Option B:** still use Minerva''s agent loop and just treat Codex as a model backend\n\nMy current recommendation is **Option B for Phase 1** because it fits Minerva''s current provider contract. Later, evaluate an Option A-style deeper integration if Codex proves substantially better when allowed to operate through its own native loop.\n\n### Phase 3: SDK bridge\n\nIf the CLI proves too lossy or hard to parse, add a small helper service using the Codex SDK.\n\nPossible shape:\n- Node/TypeScript sidecar process started by Minerva\n- JSON request/response bridge over stdio or local HTTP\n- session persistence keyed by Minerva `HistoryId`\n\n## Important Constraints / Risks\n\n### Policy / ToS risk\n\nDo **not** attempt:\n- browser automation login hacks\n- cookie scraping\n- reverse-engineering ChatGPT web traffic\n- using ChatGPT subscription credentials as an API token surrogate\n\nThe DCR should stay within official Codex surfaces only.\n\n### Capability mismatch risk\n\nMinerva providers today are largely model-like request/response wrappers. Codex is more agent-like.\n\nPotential mismatches:\n- CLI may expect filesystem/project context, not just plain prompt arrays\n- output may be richer than a single assistant message\n- streaming/tool-call semantics may differ from Minerva''s current provider contract\n\n### Dependency/runtime risk\n\nCodex CLI availability/auth is external to Minerva.\n\nNeed clear UX for:\n- CLI not installed\n- CLI installed but not authenticated\n- wrong executable path\n- unsupported platform\n- permission or sandbox failures\n\n### Cost/usage visibility risk\n\nSubscription-backed usage may not map cleanly to token costs. Minerva''s budget and cost tracking should either:\n- show `N/A` / `subscription-backed`, or\n- treat cost as zero with a clear label that this is not real token accounting\n\n### Non-coding use risk\n\nCodex is optimized for coding workflows. It may be worse than standard chat models for general conversation. The provider should likely be presented as a specialized coding provider rather than a universal OpenAI replacement.\n\n## UX Requirements\n\n### Preferences\n\nAdd a provider section that clearly distinguishes:\n- `OpenAI API` (requires API key)\n- `OpenAI Codex` or `Codex (ChatGPT)` (requires official Codex CLI login)\n\nSuggested fields:\n- provider enable toggle\n- codex executable path (default `codex`)\n- "Verify installation" button\n- optional mode selector: `CLI` now, `SDK bridge` later\n- optional working directory / repo-root strategy if needed\n\n### Error handling\n\nFriendly errors for:\n- `codex` executable not found\n- not authenticated with ChatGPT\n- Codex plan unavailable on current account\n- unsupported command flags/version mismatch\n\n### Provider naming\n\nAvoid naming that suggests API billing compatibility, e.g. avoid plain `OpenAI`.\nPrefer something explicit like:\n- `Codex (ChatGPT)`\n- `OpenAI Codex`\n- `Codex CLI`\n\n## Suggested Implementation Tasks\n\n1. Add `API_PROVIDER.CODEX` and related display names\n2. Create `CodexProvider.gd` modeled after `ClaudeCodeProvider.gd`\n3. Register one or more built-in Codex variants in `API_MODEL_PROVIDERS`\n4. Add Preferences UI for CLI path and verification\n5. Add provider to `ProviderOptionButton` and AI settings\n6. Add fallback behavior when CLI/auth unavailable\n7. Define how Minerva agent mode should behave when Codex is selected\n8. Decide how cost tracking should represent subscription-backed usage\n9. Add tests or at least a headless verification path for provider registration and CLI error handling\n\n## Open Questions\n\n1. Which Codex CLI command/output mode is the most stable for machine parsing?\n2. Should Minerva use stateless invocations first, or preserve Codex sessions per chat?\n3. Should Codex provider participate in Minerva MCP tool-calling, or should it be treated as a more autonomous local coding agent?\n4. Does the CLI support a sufficiently structured JSON output contract for robust parsing?\n5. Is SDK integration worth the added runtime complexity, or is the CLI enough?\n\n## Recommendation\n\nProceed with a **Phase 1 DCR implementation for an official Codex CLI-backed provider**, explicitly scoped to:\n- official Codex login/auth only\n- no API-key billing crossover\n- text-first / coding-first usage\n- reuse of the existing CLI-backed provider pattern from Claude Code\n\nThis is the lowest-risk path that aligns with OpenAI''s current published guidance and Minerva''s existing architecture.','\n',char(10)),'2026-03-06T20:48:59','2026-03-06T21:48:54','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc4fb36827533910e0bf8701d8cbf','work_item','backlog','Implementation plan for ChatGPT OAuth provider and ChatGPT backend transport',replace('Convert the DCR into an executable implementation plan for a dedicated Minerva `chatgpt` provider that uses Codex/OpenCode-style OAuth PKCE login tied to a ChatGPT account, persists and refreshes tokens, derives account metadata, and routes requests to ChatGPT backend endpoints instead of the standard OpenAI platform API.\n\nGoals:\n- deliver a distinct provider family rather than overloading the existing OpenAI API-key provider\n- support browser-based connect/reconnect UX inside Minerva\n- isolate the ChatGPT-backend transport contract behind a provider adapter\n- preserve Minerva agent-mode compatibility by keeping Minerva in control of MCP/tool orchestration in Phase 1\n- include verification for auth lifecycle, transport adaptation, provider registration, tool-result serialization, and failure handling\n\nExecution phases:\n1. Product and protocol validation\n2. Provider model and settings plumbing\n3. OAuth PKCE auth subsystem\n4. ChatGPT backend transport and request adaptation\n5. UI and provider selection UX\n6. Agent-mode integration decisions and Minerva-managed tool strategy\n7. Validation, diagnostics, and regression coverage\n\nPhase 1 execution model:\n- the `chatgpt` provider is treated as a backend/model transport, not as a native tool-calling runtime\n- Minerva remains the owner of MCP/tool orchestration\n- tool calls are executed by Minerva and fed back into the provider as conversation context\n- backend-native function/tool calling is explicitly out of scope for the initial implementation\n\nDefinition of done:\n- Minerva can connect a ChatGPT account through browser OAuth PKCE\n- tokens are stored securely and refreshed automatically\n- provider appears separately from normal OpenAI API provider\n- Minerva can send a basic text request through ChatGPT backend endpoints and receive a parsed response\n- Minerva-managed tool workflows continue to function by serializing tool requests/results through the existing agent loop\n- failure states are surfaced clearly for missing auth, expired refresh token, and backend incompatibility\n- verification exists for the main non-UI logic and headless startup/provider registration remains clean','\n',char(10)),'2026-03-06T21:08:43','2026-03-06T21:11:30','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4e9259f73bd9c49bfe62c9f084b',NULL);
INSERT INTO items VALUES('019cc4fb4be07ad6964b2e748522aaba','work_item','backlog','Validate product constraints and freeze the ChatGPT-provider protocol contract',replace('Confirm the exact implementation envelope before coding.\n\nScope:\n- verify current OpenAI allowance for third-party desktop apps using ChatGPT-account OAuth plus ChatGPT backend endpoints\n- document which parts are inferred from public OSS behavior versus documented product guarantees\n- capture required headers, endpoints, callback shape, token claim dependencies, and request-shaping rules to isolate in code\n- define fallback assumptions if backend details change\n- decide whether Phase 1 targets generic chat responses only or also agent-mode/code workflows\n\nDeliverables:\n- protocol note linked from the provider implementation item\n- explicit risk register for endpoint/header drift and entitlement failures\n- go/no-go decision on implementing direct ChatGPT transport versus delegating to an external Codex helper','\n',char(10)),'2026-03-06T21:08:49','2026-03-06T21:08:49','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fb628b730c963339439b0e81f1','work_item','backlog','Add provider model, settings schema, and registration for a dedicated ChatGPT provider',replace('Introduce the provider as a first-class Minerva provider family.\n\nScope:\n- add a distinct provider enum/id and display name separate from OpenAI API\n- register built-in provider/model entries in singleton/provider registries\n- add persisted settings fields for OAuth state, token metadata, callback port, and provider enablement\n- define secure storage boundaries for access token, refresh token, expiry, and derived account metadata\n- ensure cost/budget reporting is labeled as subscription-backed or unavailable rather than API-billed\n\nDeliverables:\n- provider registration merged into selection flows\n- settings migration/update path for existing installs\n- clear separation between `openai` API-key config and `chatgpt` OAuth config','\n',char(10)),'2026-03-06T21:08:55','2026-03-06T21:08:55','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fb76de735daf0ddc237f797aab','work_item','backlog','Implement OAuth PKCE login, localhost callback handling, secure token persistence, and refresh',replace('Build the auth subsystem for ChatGPT-account connection.\n\nScope:\n- generate PKCE verifier/challenge and state\n- launch browser to auth.openai.com authorize endpoint with configurable callback port\n- run a localhost callback listener with timeout/cancellation and manual-paste fallback for unsupported environments\n- exchange authorization code for access and refresh tokens\n- decode token claims needed for account metadata such as `chatgpt_account_id`\n- persist and refresh tokens securely\n- detect and recover from revoked/expired refresh credentials\n\nDeliverables:\n- reusable auth service with connect/disconnect/reconnect operations\n- token refresh path callable from provider requests\n- structured auth error taxonomy for UI consumption','\n',char(10)),'2026-03-06T21:09:00','2026-03-06T21:09:00','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fb8cf3711cbbdc1af37377d823','work_item','backlog','Implement ChatGPT backend transport, request adaptation, and response parsing',replace('Create the provider transport layer that talks to ChatGPT backend endpoints rather than OpenAI platform endpoints.\n\nScope:\n- build a transport client for `https://chatgpt.com/backend-api`\n- attach bearer token auth and derived `chatgpt_account_id`\n- encapsulate backend-specific headers and endpoint paths used by the provider\n- adapt Minerva request payloads to the backend contract, including any required field stripping, `store:false`, model normalization, and history shaping\n- support Minerva-managed tool workflows by serializing tool request/result turns as plain conversation context rather than relying on backend-native tool-calling objects in Phase 1\n- parse assistant output, failures, and backend-specific error responses into Minerva response objects\n- isolate all backend-contract assumptions to one adapter boundary\n\nDeliverables:\n- basic text request/response support\n- transport behavior compatible with Minerva-owned tool orchestration\n- robust error handling for entitlement, auth, and contract mismatch failures\n- versioned adapter surface to simplify future backend changes','\n',char(10)),'2026-03-06T21:09:05','2026-03-06T21:11:37','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fba28373ebabe1c09507b1ff4c','work_item','backlog','Add Preferences and provider-selection UX for ChatGPT connect, status, and diagnostics',replace('Expose the provider cleanly in the Minerva UI.\n\nScope:\n- add provider choice and labels that clearly distinguish ChatGPT OAuth from OpenAI API-key usage\n- add `Connect ChatGPT`, `Reconnect`, and `Disconnect` actions\n- show install/auth/connection state, token expiry health, and account status where available\n- surface callback/port issues and browser-launch failures with clear guidance\n- prevent confusing mixed configuration between OpenAI API provider and ChatGPT provider\n- expose subscription-backed cost labeling and unsupported capability messaging\n\nDeliverables:\n- Preferences UX for connect/disconnect flows\n- provider selection updates in option buttons and settings screens\n- user-facing diagnostics for auth and transport readiness','\n',char(10)),'2026-03-06T21:09:11','2026-03-06T21:09:11','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fbb4f4724699491c7154e65c6f','work_item','backlog','Integrate ChatGPT provider with Minerva agent mode, Minerva-managed tools, and conversation state',replace('Define how the new provider behaves inside Minerva’s agentic workflows.\n\nScope:\n- formalize Phase 1 behavior: Minerva remains the tool orchestrator for MCP, code-tools, and editor integrations when ChatGPT provider is active\n- determine whether the provider is stateless per request or maintains backend conversation/session identifiers per HistoryId\n- define how conversation history, tool requests, and tool results are serialized for backend compatibility\n- handle unsupported capabilities gracefully when agent-mode expectations exceed provider/backend contract\n- explicitly defer backend-native tool/function-calling semantics unless later research shows a stable/documented contract\n- document behavioral differences versus normal API-backed providers\n\nDeliverables:\n- explicit Phase 1 agent-mode strategy centered on Minerva-owned tool orchestration\n- conversation/session mapping design\n- tool-turn serialization rules for provider/backend compatibility\n- fallback behavior when tools or backend semantics do not align','\n',char(10)),'2026-03-06T21:09:16','2026-03-06T21:11:44','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc4fbcd1e7217a47e23d5c1e4c5ab','work_item','backlog','Add verification, diagnostics, and regression coverage for ChatGPT-provider auth and transport',replace('Cover the new provider with pragmatic verification and debugging support.\n\nScope:\n- add unit/integration coverage for PKCE generation, token expiry/refresh decisions, claim decoding, and transport request shaping where test infrastructure allows\n- add verification for Minerva-managed tool-turn serialization and provider compatibility with the existing agent loop\n- add headless verification for provider registration and startup safety\n- add mockable transport/auth seams so backend-dependent code can be tested without live credentials\n- add diagnostic logging that is useful for debugging without leaking tokens\n- define manual verification checklist for browser auth, refresh, reconnect, tool-use flows, and common failure modes\n\nDeliverables:\n- automated coverage for core non-UI logic where practical\n- repeatable manual verification checklist including tool workflows\n- safe diagnostics for field debugging','\n',char(10)),'2026-03-06T21:09:22','2026-03-06T21:11:49','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc5226c787bda90f51c3dc462480a','bug','resolved','ChatGPT provider implementation does not compile due to unresolved ChatGPTProvider/ChatGPTAuth script references',replace('Headless load of the modified tree fails with GDScript parse errors before the provider can even be exercised.\n\nObserved failures:\n- `PreferencesPopup.gd` references `ChatGPTProvider.get_auth()` directly, but `ChatGPTProvider` is not declared in that script scope during compilation.\n- `ChatGPTProvider.gd` uses `ChatGPTAuth` as a type and constructor target, but Godot cannot resolve that type at compile time in the current load order.\n- These failures cascade into provider dropdown/runtime initialization errors because the provider script never compiles.\n\nEvidence:\n- `src/Scripts/UI/Views/PreferencesPopup.gd:262,817,842,852`\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd:18,21,23`\n- `godot --headless --path /home/imran/github/Minerva/src --quit` reports `Identifier "ChatGPTProvider" not declared in the current scope` and `Could not find type "ChatGPTAuth" in the current scope`.\n\nWhy this blocks the feature:\nIf the scripts do not compile, Minerva cannot present the provider, start OAuth, or instantiate the provider at all.\n\nSuggested fix:\n- Stop relying on global `class_name` discovery here.\n- Add explicit preloads in the consuming scripts, e.g. preload `ChatGPTProvider.gd` in `PreferencesPopup.gd` and preload `ChatGPTAuth.gd` in `ChatGPTProvider.gd`.\n- Alternatively route all access through `SingletonObject.ChatGPTProviderScript` and instantiate the auth helper through a preloaded script constant.\n- Re-run headless Godot until provider registration and both preferences/provider scripts compile cleanly.','\n',char(10)),'2026-03-06T21:51:33','2026-03-06T22:00:05','','','',1,1,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc5228d3d73f884d61bd15d64b2d4','bug','resolved','BaseProvider API-key guard prevents all ChatGPT OAuth requests from being sent',replace('Even if the ChatGPT provider scripts compiled, the request path is still blocked by the shared BaseProvider API-key check.\n\nObserved behavior:\n- `BaseProvider.make_request()` rejects any non-local provider whose `API_KEY` getter returns an empty string.\n- The new provider is registered as `API_PROVIDER.CHATGPT`, not `LOCAL`.\n- The implementation depends on OAuth bearer auth headers and should not be forced through the API-key requirement.\n- `PreferencesPopup.get_api_key(CHATGPT)` tries to return the OAuth access token, but that is the wrong abstraction boundary and still depends on the provider class compiling and auth already being loaded.\n\nEvidence:\n- `src/Scripts/Services/Providers/BaseProvider.gd:261-266`\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd:118-125`\n- `src/Scripts/UI/Views/PreferencesPopup.gd:257-267`\n\nWhy this blocks the feature:\nThe OAuth provider is not API-key-based. Forcing it through the generic API-key gate will either reject requests outright or couple transport auth to unrelated preferences code.\n\nSuggested fix:\n- Add a provider capability such as `requires_api_key` on `BaseProvider`, default `true`, override to `false` in `ChatGPTProvider`.\n- Keep OAuth tokens inside the provider/auth subsystem rather than exposing them as faux API keys through `PreferencesPopup.get_api_key()`.\n- Update UI error strings so ChatGPT failures surface as auth/session problems, not missing API key problems.','\n',char(10)),'2026-03-06T21:51:41','2026-03-06T22:00:06','','','',1,1,'not_a_bug',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc522aff370759c850aab4e7ee761','bug','resolved','ChatGPT request shaping breaks Minerva-managed tool workflows and still depends on backend-native tool calling',replace('The current provider implementation does not match the agreed Phase 1 tool strategy and will likely produce invalid request payloads for chats containing tool turns.\n\nObserved behavior:\n- `ChatGPTProvider.generate_content()` appends each `prompt` item directly into `input_items` without flattening nested arrays.\n- `ChatGPTProvider.Format()` can return an `Array` for assistant turns that include tool calls.\n- That means tool-using histories will serialize as nested arrays inside `input`, which does not match the expected Responses-style item list.\n- Separately, the provider still sends a `tools` array to the backend, which reintroduces undocumented backend-native tool-calling semantics even though Phase 1 is supposed to keep Minerva as the tool orchestrator.\n\nEvidence:\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd:89-111`\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd:214-250`\n\nWhy this blocks the feature:\nThis provider is supposed to preserve Minerva-owned MCP/tool orchestration. As written, tool-using conversations are at risk of malformed `input` payloads, and the provider simultaneously opts into backend-native tool calling that the plan explicitly deferred.\n\nSuggested fix:\n- Flatten `Format()` results before building `input` so arrays of items are expanded into the top-level request item list.\n- Remove backend `tools` emission for Phase 1 and treat tool calls/results strictly as serialized conversation turns owned by Minerva.\n- Add tests covering a conversation that includes assistant tool calls and tool outputs, then verify the final `input` JSON is flat and backend-compatible.','\n',char(10)),'2026-03-06T21:51:50','2026-03-06T22:00:08','','','',1,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc522d00f7613a3003ac5d01f8eb0','bug','resolved','OAuth success path can report success without a usable ChatGPT account binding',replace('The auth flow treats `account_id` extraction failure as a warning, then still emits a successful completion signal and saves the tokens.\n\nObserved behavior:\n- After token exchange, `ChatGPTAuth` extracts `account_id` from JWT claims.\n- If extraction fails, the code only logs a warning and still emits `auth_completed(true, "")`.\n- `is_connected()` requires both `access_token` and `account_id`, so the UI/provider will still consider the session unusable.\n- The provider also always sends `chatgpt-account-id` in request headers, so a blank or stale account id will produce confusing backend failures.\n\nEvidence:\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTAuth.gd:33-41`\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTAuth.gd:196-205`\n- `src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd:118-125`\n\nWhy this matters:\nA login that appears successful but leaves the provider disconnected is hard to diagnose and will look like a random transport failure to the user.\n\nSuggested fix:\n- Treat missing `account_id` after token exchange as an auth failure unless the provider has an alternate documented way to obtain the required account binding.\n- Surface a specific error message in the auth UI when account metadata cannot be derived.\n- Consider storing more complete account metadata from the OAuth/token response if available, rather than assuming JWT claim shape is stable.','\n',char(10)),'2026-03-06T21:51:58','2026-03-06T22:00:08','','','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc4fb36827533910e0bf8701d8cbf',NULL);
INSERT INTO items VALUES('019cc53a10ef75949a09440c0dc04dcf','bug','resolved','Cobrowser cannot start up and connect','Cobrowser fails to start up and establish a connection. User reports this was believed to be fixed in a different branch but the fix may not have been merged or the regression reappeared.','2026-03-06T22:17:22','2026-03-06T22:31:06','','','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc54f57c97e7db5242d6165af5523','dcr','proposed','Tool Preferences pane for MCP server configuration',replace('Add a "Tools" tab to PreferencesPopup for configuring MCP tool servers. Currently, server management (install, locate, start/stop, connect/disconnect) is crammed into the top-level Tools menu. Configuration like Python environment and installation paths has no UI — it''s either hardcoded or stored silently in mcp_config.json.\n\n**Problem**: Users with conda/pyenv/system Python can''t pick which environment to use for running tool servers. The Tools menu mixes configuration concerns (paths, environments) with runtime actions (connect/disconnect). Installation paths set via "Locate Existing Installation" have no way to be viewed or changed after initial selection.\n\n**Requested change**: Split tool configuration into a dedicated Preferences tab; simplify the Tools menu to runtime actions only.','\n',char(10)),'2026-03-06T22:40:37','2026-03-06T22:41:09','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc550adbe7f3aa5e1e4ccc081901f','work_item','done','Tool Preferences pane — implementation plan',replace('Master work item for implementing the Tool Preferences pane (DCR 019cc54f). Contains the full implementation plan and child tasks.\n\n## Plan Overview\n\n### New "Tools" Tab in PreferencesPopup\nAdd tab after "Services" in TabContainer with:\n- Global Python environment picker (Auto / conda envs / system / custom)\n- Per-server sections (Cobrowser, Nudge, CodeTools) with installation path, port, auto-connect, status\n- Tool group enable/disable (extending internal MCP to support tool grouping, per DCR 019cc148)\n\n### Layout\n```\nTools (tab)\n└─ ScrollContainer\n   └─ VBoxContainer\n      ├─ Label "Python Environment"\n      ├─ HBoxContainer\n      │  ├─ OptionButton (Auto / conda:base / conda:llm / System / Custom...)\n      │  └─ Button "Refresh"\n      ├─ HSeparator\n      ├─ Label "Tool Groups"\n      ├─ VBoxContainer [CheckButtons for each tool group]\n      ├─ HSeparator\n      ├─ Label "Cobrowser (HumanWeb)"\n      ├─ HBoxContainer [Install Path: LineEdit (ro) + Browse + Clear]\n      ├─ HBoxContainer [Port: Label + SpinBox]\n      ├─ CheckButton "Auto-connect on startup"\n      ├─ HSeparator\n      ├─ Label "Nudge" ... (same pattern)\n      ├─ HSeparator\n      ├─ Label "CodeTools" ... (same pattern)\n```\n\n### Storage\nExtends `user://mcp_config.json` (version 1 → 2):\n```json\n{\n  "version": 2,\n  "python_environment": "auto",\n  "installation_paths": { ... },\n  "server_ports": { "cobrowser": 8677, "nudge": 8765, "codetools": 8700 },\n  "enabled_tool_groups": ["all"],\n  "servers": [ ... ]\n}\n```\n\n### Agent-Mode Tool Group Overrides\nAgent definitions can specify `tool_groups` to override defaults. MinervaMCPServer exposes group filtering to internal callers.\n\n### Files to Modify\n| File | Changes |\n|------|---------|\n| PreferencesPopup.tscn | Add "Tools" tab UI |\n| PreferencesPopup.gd | Tools tab logic, python env detection, tool groups, save/load |\n| MCPConfig.gd | python_environment, server_ports, enabled_tool_groups, v2 migration |\n| MCPServerInstaller.gd | detect_python_environments(), use config python |\n| menuMain.gd | Add "Tool Settings..." item, simplify submenus |\n| MinervaMCPServer.gd | Expose tool group filtering to internal callers |\n| Agent config/definitions | Support tool_groups override field |','\n',char(10)),'2026-03-06T22:42:04','2026-03-06T23:01:09','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc54f',NULL);
INSERT INTO items VALUES('019cc550cc4a703980014c5cc8d2a42d','work_item','done','MCPConfig.gd: add python_environment, server_ports, v2 migration',replace('Extend MCPConfig with new fields and schema migration.\n\n**Changes:**\n- Add `python_environment: String = "auto"` property\n- Add `server_ports: Dictionary = {}` property with defaults from MCPServerInstaller.PORTS\n- Add `get_python_for_server(server_name) -> String` that resolves: config python > venv python > system python\n- Update `save_config()` to write new fields and `"version": 2`\n- Update `load_config()` to read new fields\n- Add v1→v2 migration: default `python_environment = "auto"`, populate `server_ports` from PORTS constants\n\n**File:** `src/Scripts/Services/MCP/MCPConfig.gd`','\n',char(10)),'2026-03-06T22:42:12','2026-03-06T23:01:27','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc550',NULL);
INSERT INTO items VALUES('019cc550e4fa71308718edb8314510d3','work_item','done','MCPServerInstaller.gd: detect_python_environments() and use config python',replace('Add Python environment detection and make startup commands use the configured python.\n\n**Changes:**\n1. Add `detect_python_environments() -> Array[Dictionary]`:\n   - Parse `conda info --envs` output → extract env name + path, append `/bin/python`\n   - Check system `python3` via `which`\n   - Check per-server `.venv/bin/python` if installation path known\n   - Return `[{name: "conda:base", path: "/home/.../bin/python", type: "conda"}, ...]`\n\n2. Update `get_startup_command()`:\n   - Load MCPConfig, call `get_python_for_server(server_name)`\n   - Use returned python instead of hardcoded `_get_python_in_venv()`\n   - Already partially done (venv fallback to system), now adds config-first lookup\n\n**File:** `src/Scripts/Services/MCP/MCPServerInstaller.gd`','\n',char(10)),'2026-03-06T22:42:19','2026-03-06T23:01:29','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc550',NULL);
INSERT INTO items VALUES('019cc55105597e358e7775d746e69ed2','work_item','done','PreferencesPopup: build Tools tab UI and logic',replace('Add a "Tools" tab to PreferencesPopup for MCP server configuration.\n\n**UI elements (build programmatically or in .tscn):**\n- **Python Environment section:**\n  - OptionButton populated by `MCPServerInstaller.detect_python_environments()`\n  - Options: "Auto (recommended)", each detected conda env, "System python3", "Custom..."\n  - "Custom..." selection opens FileDialog to pick a python executable\n  - "Refresh" button re-scans environments\n- **Per-server sections** (Cobrowser, Nudge, CodeTools), each with:\n  - Installation Path: read-only LineEdit + "Browse..." Button + "Clear" Button\n  - Browse reuses validation from `_validate_server_directory()` (move from menuMain.gd or share)\n  - Port: SpinBox (range 1024-65535, default from PORTS)\n  - Auto-connect: CheckButton\n  - Status label (installed/not installed)\n\n**Save/Load:**\n- On tab shown or Preferences opened: load from MCPConfig\n- On change: save immediately to mcp_config.json via MCPConfig.save_config()\n\n**Files:** `PreferencesPopup.tscn`, `PreferencesPopup.gd`','\n',char(10)),'2026-03-06T22:42:27','2026-03-06T23:01:31','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc550',NULL);
INSERT INTO items VALUES('019cc551151c7841a78fbcc9c5c6270b','work_item','done','menuMain.gd: add "Tool Settings..." and simplify server submenus',replace('Simplify the Tools menu now that configuration lives in Preferences.\n\n**Changes:**\n1. Add "Tool Settings..." item at top of Tools menu → opens PreferencesPopup focused on Tools tab\n2. Remove "Locate Existing Installation..." from server submenus (now in Preferences)\n3. Keep runtime actions: status display, Connect/Disconnect, Start/Stop Server\n4. Keep server-specific actions: Nudge Pull/Push, Cobrowser Install Extension\n5. Move `_validate_server_directory()` to a shared location (MCPServerInstaller or MCPConfig) so both menuMain and PreferencesPopup can use it\n\n**File:** `src/Scripts/UI/Controls/menuMain.gd`','\n',char(10)),'2026-03-06T22:42:31','2026-03-06T23:01:33','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc550',NULL);
INSERT INTO items VALUES('019cc55384f77ad2a6c47d600dbbc743','work_item','done','Extend tool grouping to internal MCP users with agent-mode overrides',replace('Bring tool grouping (already supported by external HTTP MCP server) to internal MCP consumers — agents and chats using MinervaMCPServer directly. Integrate with the new Tools Preferences tab.\n\n**Context:** External MCP already groups tools into logical sets. Internal users (agents, chat) don''t have access to this grouping. Agent mode should be able to override which tool groups are enabled/disabled for per-agent tool scoping.\n\n**Changes:**\n1. **Tools Preferences tab** (from sibling task 019cc55105): add a "Tool Groups" section showing available groups with enable/disable checkboxes. This controls the default set for chat mode.\n2. **MinervaMCPServer**: expose tool group filtering to internal callers (list_tools should respect group settings)\n3. **Agent definitions**: allow `tool_groups` field in agent config to override which groups are active during agent execution\n4. **Persistence**: save default tool group settings in `mcp_config.json` alongside other tool preferences\n\n**Derived from DCR:** 019cc148b4ea794c9c59857a5b863e39','\n',char(10)),'2026-03-06T22:45:11','2026-03-06T23:01:35','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc550',NULL);
INSERT INTO items VALUES('019cc55ee2127b549493b88207790e0b','work_item','done','Implementation plan for dynamic MCP server connections and runtime skill registration',replace('Convert the DCR into an executable implementation plan for two related capabilities:\n1. dynamically adding/removing MCP servers at runtime without restarting Minerva; and\n2. introducing runtime skill registration in a staged way, starting from lightweight skill bundles built on top of existing tool-set filtering and later evolving toward first-class skill objects.\n\nPlanning assumptions from current codebase:\n- runtime MCP connection/disconnection already exists in `MCPManager`\n- MCP server configuration is already mutable/persistable in `MCPConfig`\n- Minerva tool-set filtering already exists for the internal MCP server\n- there is not yet a first-class runtime skill registry separate from tool sets\n\nExecution phases:\n1. Product and architecture definition\n2. Runtime MCP server registration and persistence plumbing\n3. UI and MCP tools for live server management\n4. Runtime skill model built on tool sets and prompt/config bundles\n5. Internal-agent integration for skills and tool filtering\n6. Validation, diagnostics, and safety hardening\n\nDefinition of done:\n- a user or agent can register an MCP server during a running session\n- Minerva can connect/disconnect/reconnect that server without restart\n- newly connected tools appear in registries and selection flows immediately\n- server configs can optionally persist across restart\n- skills can be registered/activated at runtime at least as named bundles of tool sets plus related agent config\n- internal Minerva agent flows can consume those skill/tool filters without relying only on external MCP clients','\n',char(10)),'2026-03-06T22:57:35','2026-03-07T06:54:00','','','',2,0,'All 6 subtasks complete: architecture definition, runtime MCP add/remove, UI for server management, Phase 1 skills (superseded by real skills DCR), agent flow integration, validation and safety. Add Server dialog supports HTTP/WS/STDIO with test connection. Tool collision and connection failure diagnostics surfaced via toast notifications.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc0bd67d17745a8dae379110fbc8c',NULL);
INSERT INTO items VALUES('019cc55ef9317c41a828bbffa4ea8c34','work_item','done','Define the runtime MCP and skill architecture, scope boundaries, and phased rollout',replace('Freeze the product and technical envelope before coding.\n\nScope:\n- define exactly what counts as a runtime-added MCP server versus an installed/configured server\n- define persistence semantics: session-only versus saved-and-reconnectable\n- define the initial skill abstraction for Phase 1 as a lightweight bundle of tool sets plus optional prompt/provider/agent settings\n- define what is deferred to a later first-class skill system (manifests, packaging, imports, richer workflow definitions)\n- define how internal Minerva agents will consume tool-group restrictions and skill activation state\n- identify namespace, permissions, and conflict rules for dynamically added servers and skills\n\nDeliverables:\n- implementation note describing the staged architecture\n- explicit Phase 1/Phase 2 boundaries\n- risk register for dynamic server trust, name collisions, and stale tool registry state','\n',char(10)),'2026-03-06T22:57:41','2026-03-07T06:11:24','','','',2,0,'Architecture defined: MCPKnownServers registry, dynamic server add/remove, SkillDefinition/SkillManager/SkillPresets for profiles, real skills with instructions + executables. Plan at .claude/plans/federated-swinging-knuth.md.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc55f33ae74d48f059537200d5c2f','work_item','done','Add runtime MCP server registration, removal, persistence, and live tool refresh',replace('Turn the existing MCPManager and MCPConfig capabilities into a supported runtime workflow.\n\nScope:\n- add APIs to create/update/remove server configs during a running session\n- connect/disconnect/reconnect newly added servers without restart\n- refresh tool registry and downstream tool views immediately after connection changes\n- support session-only servers and optionally persisted servers that auto-reconnect on restart\n- handle HTTP, WebSocket, and STDIO transport setup using the existing MCPConfig/MCPServerConnection model\n- ensure dynamic server removal cleans up registered tools and active connections correctly\n\nDeliverables:\n- runtime registration methods in MCP manager/config layers\n- clean tool-registry updates on connect/disconnect/remove\n- persistence behavior defined and implemented','\n',char(10)),'2026-03-06T22:57:56','2026-03-07T06:45:46','','','',2,0,'All transport types supported: HTTP, WebSocket, STDIO. AddMCPServerDialog enhanced with transport selector, per-type fields (URL+port+endpoint for HTTP/WS, command+args+working_dir for STDIO). Duplicate name check against existing config. Both PreferencesPopup and menuMain handlers updated to create correct ServerConfig for all transports.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc55f4d9a77eca5aecb4d3460bb31','work_item','done','Add UI and MCP tools for live MCP server management',replace('Expose runtime MCP server management to both users and agents.\n\nScope:\n- extend the existing MCP server install/manage UI with connect/disconnect/add/remove actions for live sessions\n- add runtime server-management tools such as connect/add/remove/reconnect/list for agent use where appropriate\n- surface connection status, errors, endpoint/command details, and persistence settings in the UI\n- support testing a server definition before saving it\n- update menus/tool panes immediately when servers are added or removed\n\nDeliverables:\n- user-facing live server management UI\n- agent-accessible management tools where approved\n- clear diagnostics for failed startup, handshake, or tool refresh','\n',char(10)),'2026-03-06T22:58:03','2026-03-07T06:45:50','','','',2,0,'Add Server dialog with transport selection, test connection button (HTTP reachability check, STDIO command existence check), validation. Dynamic server list shows transport type (HTTP/WS/STDIO) with appropriate details. Available from both Preferences Tools tab and Tools menu. Server rows show connect/disconnect and remove (user servers).',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc55f61467cfd8d8307c566a48ace','work_item','done','Implement Phase 1 runtime skills as named bundles over tool sets and agent configuration',replace('Introduce a pragmatic runtime skill system without waiting for a full packaging/manifests design.\n\nScope:\n- define a skill as a named runtime bundle containing one or more tool sets plus optional agent-facing metadata\n- support optional prompt fragments, preferred provider/model hints, and mode flags as part of the bundle\n- persist and activate/deactivate skills at runtime\n- map existing Minerva tool sets into skill-selectable building blocks\n- keep the implementation separate enough that a future first-class skill registry can replace the underlying storage/model later\n\nDeliverables:\n- runtime skill data model for Phase 1\n- storage and activation rules\n- mapping from skill activation to enabled tool groups and related agent settings','\n',char(10)),'2026-03-06T22:58:08','2026-03-07T06:11:26','','','',2,0,'Superseded by DCR 019cc5eaca. Tool Profiles (SkillPresets) and real Skills (instructions + executables) both implemented and operational.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc55f75447be5b74926b0a1577427','work_item','done','Integrate runtime skills and tool-group filtering into internal Minerva agent flows',replace('Extend the current external-MCP-facing tool-set controls so Minerva itself can use them internally.\n\nScope:\n- apply skill activation and tool-group filtering to internal Minerva agent/tool selection, not only to external MCP sessions\n- define precedence rules between explicit agent-mode overrides, selected skill bundles, and global defaults\n- ensure internal tool availability can be narrowed without breaking required meta/admin operations\n- wire the chosen skill/tool-filter state into agent creation, agent execution, and relevant UI surfaces\n- keep compatibility with the existing `Allow internal MCP users to use tool grouping (with agent-mode overrides)` work\n\nDeliverables:\n- internal agent/tool filtering model\n- precedence rules for skill selection versus explicit overrides\n- integration points identified for chat/agent execution paths','\n',char(10)),'2026-03-06T22:58:13','2026-03-07T06:11:28','','','',2,0,'ChatPane uses get_effective_tool_sets() and get_skill_instructions() with per-chat > per-agent > global precedence. ServiceHistory.ActiveSkills and AgentDefinition.skills wired.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc55f87b374cca53954f4ab8c5bb5','work_item','done','Add validation, diagnostics, and safety checks for dynamic servers and runtime skills',replace('Harden the runtime system so it is supportable.\n\nScope:\n- validate server definitions before connect/save\n- add safeguards for duplicate server names, duplicate tool names, and namespace collisions\n- add diagnostics for connection, initialization, and tool-refresh failures\n- define cleanup and rollback behavior when dynamic connect partially succeeds\n- verify that skill activation cannot silently hide required meta tools or create unusable internal agent configurations\n- add manual and automated verification where feasible for connect/disconnect, persistence, skill activation, and tool filtering\n\nDeliverables:\n- validation rules and user-facing error reporting\n- diagnostics for runtime server/skill failures\n- verification checklist and test coverage where practical','\n',char(10)),'2026-03-06T22:58:18','2026-03-07T06:53:47','','','',2,0,'Validation: validate_server_config() checks name, transport, URL scheme, command. Duplicate name warning on overwrite. Diagnostics: connect_server() surfaces errors via toast notifications. Tool collisions reported to user via toast (count of blocked/colliding tools). Rollback: if tool refresh fails after connect, connection is rolled back. Dead connection cleanup: execute_tool() detects disconnected server and cleans up. Safety: activate_skill() warns if active profiles exclude ''chat'' tool set. Meta tools always pass filters by design.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc55ee2127b549493b88207790e0b',NULL);
INSERT INTO items VALUES('019cc5eaca627aa7a48fb7b519d9b88e','dcr','shipped','Runtime Skills — instruction notes + optional executables for consistent LLM behaviors',replace('## Problem\n\nMinerva has "Tool Profiles" (named tool group filters) but no concept of skills. A skill — like CLAUDE.md or Codex system prompt customizations — teaches the LLM consistent behavior through instructions, optionally paired with executables it can invoke.\n\n## What is a Skill\n\n1. **Instructions** — markdown text injected into the system prompt when the skill is active. Teaches the LLM a behavior pattern (e.g. "You are a PCB design reviewer. Always check DRC rules. Use these pin naming conventions...")\n2. **Optional executable** — a script, binary, or container the LLM can call as a tool when the skill is active. Example: a DRC checker binary, a code formatter, a test runner.\n3. **Activation scope** — skills can be activated globally, per-agent, or per-chat. Most specific wins.\n\n## Storage\n\nSkills store instructions as a direct `instructions: String` field on `SkillDefinition`. Persisted to `user://skills.json`. No NotesContainer dependency.\n\n## Design\n\n### Skill Definition\n- `id`: unique identifier\n- `name`: display name\n- `description`: short summary\n- `instructions`: markdown text injected into system prompt when active\n- `executable_path`: optional — path to script/binary\n- `executable_args`: optional — default arguments\n- `executable_description`: optional — tool description exposed to the LLM\n- `executable_working_dir`: optional — working directory for execution\n\n### UI — Preferences "Skills" Tab\nA dedicated tab in Preferences with:\n- **Left panel**: skill list with New/Remove buttons\n- **Right panel**: name, description, active toggle, instructions TextEdit (markdown), executable config (path, args, tool description, working dir)\n- Full CRUD with auto-save on field changes\n\n### System Prompt Integration\n- When a skill is active, its `instructions` field content is injected into the system prompt\n- Multiple active skills = all their instructions concatenated\n- Precedence: per-chat > per-agent > global (same as profiles)\n- `SkillManager.get_skill_instructions()` collects instructions from active skills\n\n### Executable Integration\n- When a skill has an `executable_path`, register it as an internal tool named `skill_{id}` on activation\n- Tool execution: `OS.execute()` with args, stdout captured as tool result\n- On deactivation, unregister the tool\n- MCPManager.execute_tool() intercepts `skill_*` tool names and routes to SkillManager\n\n## Not in Scope\n- Tool Profiles (already implemented — separate concept, filters tool groups)\n- Skill marketplace / import-export (future)\n- Container lifecycle management (future — start with local scripts)\n- MCP tools for skill management (Task 6, deferred P3)','\n',char(10)),'2026-03-07T01:30:24','2026-03-07T06:59:35','','','',2,0,'All tasks complete. Skills system: SkillDefinition data model, SkillManager with activation/persistence/executable registration, Preferences Skills tab with full CRUD, system prompt injection, executable tool routing, 5 MCP management tools.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc5ee819978f8806a7380e4ba80b6','work_item','done','Implementation plan: Runtime Skills (instructions + executables)',replace('## Architecture\n\n### What is a Skill\nA skill is a named behavior bundle: markdown instructions (injected into system prompt) + an optional executable (registered as a tool). Like CLAUDE.md but scoped and activatable.\n\n### Storage\nSkills instructions live in a **Skills NotesContainer** — a third notes panel alongside Memory (project-scoped) and Drawer (app-scoped). Each tab = one skill. Tab name = skill name. Markdown content = instructions. The Skills panel is app-scoped (saved to `user://skills_data.json` like Drawer saves to `user://drawer_data.json`).\n\n### Data Model\n`SkillDefinition` (refactored from current tool-profile use):\n- `id: String` — unique identifier\n- `name: String` — display name, matches Skills panel tab name\n- `description: String` — short summary\n- `notes_tab_id: String` — UUID of the tab in the Skills NotesContainer\n- `executable_path: String` — optional path to script/binary\n- `executable_args: Array[String]` — default arguments\n- `executable_description: String` — tool description for LLM\n- `executable_working_dir: String` — working directory for execution\n- `active: bool` — whether currently enabled globally\n\n### System Prompt Integration\n`NotesContainer.to_prompt()` already collects enabled notes from Memory + Drawer containers. For skills:\n- When a skill is active, its tab''s notes are collected and injected into the system prompt via a new `skills_notes_container.to_prompt()` call in `ChatPane.create_prompt()`.\n- Skills notes are injected BEFORE working memory (Memory + Drawer notes), so they set behavioral context first.\n- Per-agent: `AgentDefinition.skills` lists active skill IDs. `AgentSpawner` sets `history.ActiveSkills`. Only matching skills'' notes are injected.\n- Per-chat: `ServiceHistory.ActiveSkills` overrides agent/global.\n\n### Executable Integration\nWhen a skill has an `executable_path`:\n- On activation, register an internal tool named `skill_{skill_id}` with the executable_description\n- Tool execution: spawn the process with `executable_args`, capture stdout as tool result\n- On deactivation, unregister the tool\n- Executables run in a subprocess (OS.execute or OS.create_process), not as MCP servers\n\n### UI Components\n1. **Skills NotesContainer panel** — new tab in the notes area (alongside Memory, Drawer). Standard NotesContainer with tabs. Each tab = one skill''s instructions.\n2. **Skill management in Preferences** — list of skills with: name, active toggle, executable path (optional), description. Add/remove skills.\n3. **Agent editor** — skill assignment (already has `skills` field, just needs UI to pick from available skills)\n\n### Persistence\n- Skills panel content: `user://skills_data.json` (same pattern as Drawer)\n- Skill definitions (metadata + executable config): `user://skills.json` (already exists from profiles work, extend it)\n- Active skills state: already in `user://skills.json`\n\n### Relationship to Tool Profiles\nTool Profiles (the renamed "skills") filter which tool groups are visible. Real Skills inject behavior instructions + optional executables. They are orthogonal — a skill doesn''t filter tools, a profile doesn''t inject instructions. Both can be active simultaneously.\n\n## Task Breakdown\nSee child work items for implementation tasks.','\n',char(10)),'2026-03-07T01:34:28','2026-03-07T06:10:39','','','',2,0,'Tasks 1-5 complete. Task 6 (MCP tools) deferred as P3. Skills system functional: notes panel, data model, system prompt injection, executable registration/execution, preferences UI.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ea',NULL);
INSERT INTO items VALUES('019cc5eeb230781590823ca80d99cba6','work_item','done','Task 1: Skills NotesContainer panel — UI and persistence',replace('Add a third NotesContainer panel for skills instructions, alongside Memory and Drawer.\n\n**New files:**\n- `Scripts/Skills/SkillsNotesManager.gd` — mirrors `Drawer/Drawer_manager.gd`. Saves/loads to `user://skills_data.json`. Manages the skills NotesContainer lifecycle.\n\n**Modified files:**\n- `Models/singleton_object.gd` — add `skills_notes_container: NotesContainer` var (alongside existing `notes_container` and `drawer_notes_container`)\n- `UI/Views/MainScene.gd` — instantiate the Skills NotesContainer panel, wire it up in the notes area as a third tab/panel\n- Relevant `.tscn` scene file — add the Skills panel node\n\n**Behavior:**\n- Skills panel appears as a third tab in the notes area (Memory | Drawer | Skills)\n- Users can add/remove/rename tabs (each tab = one skill''s instructions)\n- Notes in skills tabs are standard MemoryItems with markdown content\n- Persistence via `user://skills_data.json` (same JSON pattern as drawer_data.json)\n- Skills notes are NOT auto-injected into all prompts (unlike Memory/Drawer) — only when the corresponding skill is active\n\n**Acceptance:**\n- Skills panel visible in notes area\n- Can create tabs, add notes with markdown content\n- Content persists across restarts\n- Content is NOT injected into prompts yet (that''s Task 3)">','\n',char(10)),'2026-03-07T01:34:40','2026-03-07T06:10:29','','','',1,0,'Skills NotesContainer panel created. SkillsNotesManager.gd saves/loads to user://skills_data.json. Wired into MainScene.gd with toggle button next to Drawer. Drawer and Skills panels are mutually exclusive. skills_notes_container added to singleton_object.gd.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc5eed3797649943b36f255733b86','work_item','done','Task 2: Refactor SkillDefinition — notes_tab_id + executable fields',replace('Refactor the existing SkillDefinition from a tool-profile model to a real skill model.\n\n**Modified files:**\n- `Services/Skills/SkillDefinition.gd` — replace tool_sets/required_servers with:\n  - `notes_tab_id: String` — UUID linking to a tab in the Skills NotesContainer\n  - `executable_path: String` — optional path to script/binary\n  - `executable_args: Array[String]` — default arguments\n  - `executable_description: String` — tool description exposed to LLM\n  - `executable_working_dir: String` — working directory\n  - `active: bool` — whether globally active\n  - Keep `prompt_fragments` as fallback for presets without notes tabs\n  - Remove `tool_sets` and `required_servers` (those belong to profiles now)\n- `Services/Skills/SkillPresets.gd` — remove or simplify. Presets become empty skill definitions the user populates with their own instructions. Or remove presets entirely (skills are user-created).\n- `Services/Skills/SkillManager.gd` — update to work with new fields. Remove tool_set recomputation (that''s profiles). Add executable registration/unregistration on activate/deactivate.\n- `user://skills.json` — updated schema, migration from v1\n\n**Acceptance:**\n- SkillDefinition has notes_tab_id and executable fields\n- SkillManager activate/deactivate handles executable tool registration\n- Existing skills.json migrates cleanly">','\n',char(10)),'2026-03-07T01:34:49','2026-03-07T06:10:30','','','',1,0,'SkillDefinition refactored with notes_tab_id, executable_path, executable_args, executable_description, executable_working_dir. is_skill()/is_profile()/has_executable() helpers. SkillManager updated with get_profiles()/get_skills_only(), executable registration/unregistration, execute_skill_tool(), get_skill_instructions(). PreferencesPopup shows profiles and skills in separate sections with Add Skill dialog.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc5eef9c57be4b7e0a1e7f636ea5d','work_item','done','Task 3: System prompt injection from active skills',replace('When a skill is active, inject its notes tab content into the system prompt.\n\n**Modified files:**\n- `UI/Views/ChatPane.gd` — in `_build_agent_system_prompt()` and `create_prompt()`:\n  - Determine active skills (per-chat > per-agent > global, using existing ActiveSkills precedence)\n  - For each active skill with a `notes_tab_id`, look up the tab in `skills_notes_container`\n  - Collect all enabled notes from matching tabs\n  - Inject them into the system prompt BEFORE working memory\n  - Skills without a notes_tab_id but with prompt_fragments (legacy presets) use prompt_fragments as fallback\n\n**Key design:**\n- `NotesContainer.to_prompt()` already handles collecting notes from tabs. For skills, we call it on `skills_notes_container` but filtered to only tabs matching active skills'' `notes_tab_id`.\n- Alternatively, add a `to_prompt_for_tabs(tab_ids: Array[String])` method to NotesContainer that only collects from specified tab UUIDs.\n- Skills notes go into system prompt as behavioral instructions, distinct from working memory notes.\n\n**Acceptance:**\n- Create a skill with instructions in its tab (e.g. "Always respond in French")\n- Activate the skill\n- Start a chat — LLM follows the skill''s instructions\n- Deactivate — LLM reverts to normal behavior\n- Per-agent skill assignment works (agent''s chat gets skill instructions)">','\n',char(10)),'2026-03-07T01:34:59','2026-03-07T01:45:59','','','',1,0,'ChatPane._build_agent_system_prompt() now injects skill instructions from notes tabs before profile prompt fragments. Skill instructions collected via SkillManager.get_skill_instructions() which reads from skills_notes_container tabs. MCPManager.execute_tool() intercepts skill_* tool names and routes to SkillManager.execute_skill_tool().',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc5ef23857637864a7d86c98e74dc','work_item','done','Task 4: Executable tool registration and invocation',replace('When a skill with an executable is activated, register it as an invocable tool. LLM can call it like any MCP tool.\n\n**Modified files:**\n- `Services/Skills/SkillManager.gd` — on `activate_skill()`:\n  - If skill has `executable_path`, create an MCPToolDefinition with name `skill_{id}`, description from `executable_description`\n  - Input schema: `{\"type\": \"object\", \"properties\": {\"args\": {\"type\": \"string\", \"description\": \"Arguments to pass\"}}}` (simple string args for v1)\n  - Register in MCPManager''s tool_registry with server_name = \"minerva_skills\"\n  - On `deactivate_skill()`, unregister the tool\n- `Services/MCP/MCPManager.gd` or `MinervaMCPServer.gd` — add execution handler for `skill_*` tools:\n  - Look up skill by tool name\n  - Spawn process: `OS.execute(executable_path, args)` or `OS.create_process()` for async\n  - Capture stdout/stderr, return as tool result\n  - Respect `executable_working_dir`\n  - Timeout: 30s default, configurable later\n- `Services/MCP/MCPToolDefinition.gd` — ensure skill tools pass through tool_set filters (always pass, like meta tools)\n\n**Security:**\n- Only execute paths explicitly configured by the user\n- No shell expansion (use OS.execute, not shell)\n- Log all executions\n\n**Acceptance:**\n- Create skill with executable_path pointing to a test script (e.g. `echo hello`)\n- Activate skill\n- In chat, LLM can discover and call the skill tool\n- Tool returns script output\n- Deactivate — tool disappears">','\n',char(10)),'2026-03-07T01:35:09','2026-03-07T01:46:11','','','',2,0,'Executable tool registration/unregistration in SkillManager. Execution routing in MCPManager.execute_tool() via skill_* prefix interception. OS.execute() with args, working dir support.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc5ef3eae7e47b76cea2799502858','work_item','done','Task 5: Skills management UI in Preferences',replace('Add skill management to the Preferences Tools tab, separate from Tool Profiles.\n\n**Modified files:**\n- `UI/Views/PreferencesPopup.gd` — add a \"Skills\" section below (or above) Tool Profiles:\n  - List of defined skills with: name, description, active toggle, executable path display\n  - \"Add Skill\" button — creates a new SkillDefinition + a new tab in Skills NotesContainer\n  - \"Remove Skill\" button — removes definition + optionally removes the notes tab\n  - Executable configuration: path picker (FileDialog), args field, description field, working directory\n  - Link to Skills panel tab: clicking skill name navigates to its notes tab\n- `UI/Windows/AgentManagerWindow.gd` — add skill picker to agent editor:\n  - Multi-select list of available skills\n  - Selected skills stored in `AgentDefinition.skills`\n  - Already has the field, just needs UI widget\n\n**Acceptance:**\n- Can create/remove skills from Preferences\n- Creating a skill auto-creates a matching notes tab\n- Can configure executable path/args/description\n- Can assign skills to agents in agent editor\n- Active toggle works (activates/deactivates skill globally)">','\n',char(10)),'2026-03-07T01:35:16','2026-03-07T06:10:31','','','',2,0,'Preferences Tools tab now shows Profiles and Skills in separate sections. Add Skill dialog creates SkillDefinition + notes tab. Remove button for user skills. Executable path/description fields in dialog. Done as part of Task 2 refactor.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc5ef529d7682b710b27895ebecb3','work_item','done','Task 6: MCP tools for skill management (minerva_list_skills, minerva_activate_skill, etc.)',replace('Expose skill management as internal MCP tools so agents can discover and manage skills programmatically.\n\n**Modified files:**\n- `Services/MCP/MinervaMCPServer.gd` — register new tools:\n  - `minerva_list_skills` — list all defined skills with active state\n  - `minerva_get_skill(id)` — get skill details including instructions content\n  - `minerva_activate_skill(id)` — activate a skill\n  - `minerva_deactivate_skill(id)` — deactivate a skill\n  - `minerva_update_skill_instructions(id, content)` — update a skill''s instructions text\n  - Tool set: "utility" or new "skills" group\n\n**Acceptance:**\n- Agent can list, read, activate, and update skills via tool calls\n- Updating skill instructions persists changes to user://skills.json','\n',char(10)),'2026-03-07T01:35:21','2026-03-07T06:58:53','','','',3,0,'5 MCP tools registered in MinervaMCPServer under "utility" tool set: minerva_list_skills (with include_profiles filter), minerva_get_skill (full detail including instructions and executable config), minerva_activate_skill, minerva_deactivate_skill, minerva_update_skill_instructions (user skills only). All validated with headless compile.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5ee',NULL);
INSERT INTO items VALUES('019cc65ce2ee72ddb82ac3adb0cc3c65','dcr','proposed','Add a ''just chat'' conversational voice mode for Minerva',replace('Introduce a casual voice conversation mode for Minerva that lets a user ''just chat'' naturally, including local barge-in behavior, without turning Core into a live audio streaming transport.\n\nProblem statement:\n- We want a conversational voice mode that feels natural enough for casual back-and-forth with Minerva.\n- We want barge-in support so the user can interrupt playback and start a new turn naturally.\n- We do not want to swamp Core with per-frame, per-chunk, or live duplex audio messages.\n- The current GPU scheduling model is optimized for discrete jobs, cold starts, and fast completion rather than long-lived streaming sessions.\n\nDesign observations from existing repo work:\n- The `experiments/narrator` dungeon-crawl voice game has useful interaction patterns: client-side audio capture/playback, VAD, pre-roll buffering, and barge-in/session logic.\n- The narrator design is explicitly streaming-first and optimized for low-latency voice gameplay; that is not a good direct fit for Core-wide service transport.\n- The new `voice-service` work is intentionally non-streaming and transaction-oriented, which fits the current gpu-node / gpu-dispatch architecture much better.\n- `model-chat` and `voice-service` can serve as reusable backend services for a general conversational voice mode, but a thin session/controller layer is still needed to deliver a natural chat experience.\n\nProposed overall architecture:\n- Client or edge conversation controller owns local microphone capture, speaker playback, VAD, pre-buffering, and barge-in detection.\n- The controller stops local playback immediately on barge-in and begins capturing the next user utterance locally.\n- After endpointing, the controller sends one completed STT request to `voice-service`.\n- The controller then sends one completed chat request to `model-chat`.\n- The controller then sends one completed TTS request to `voice-service`.\n- The returned audio artifact is played locally as a completed result.\n- Core remains a control plane and turn-transport layer, not a live duplex media bus.\n\nExplicit non-goals for the initial design:\n- No live ASR partials over Core.\n- No token streaming from LLM over Core.\n- No chunked TTS playback over Core.\n- No design that requires Core to carry continuous audio streams.\n\nWhy this shape is preferred:\n- Preserves compatibility with gpu-node''s discrete-job model.\n- Avoids excessive Core websocket traffic and statefulness.\n- Allows most of the perceived user experience benefit of barge-in without requiring full streaming infrastructure.\n- Keeps real GPU model execution in the existing backend services rather than moving media handling into Core.\n\nKey difficulties / open design challenges:\n- Local playback interruption is easy, but backend cancellation of in-flight STT, LLM, or TTS work is harder.\n- Cold starts will still dominate time-to-first-response when containers cannot be kept warm.\n- Echo/self-interference handling is non-trivial in always-listening mode.\n- A session controller will need explicit turn state and probably cancellation semantics across services.\n\nReasonable first milestone:\n- A turn-based ''chat mode'' with local VAD and local barge-in.\n- Completed STT -> completed model-chat -> completed TTS.\n- Optional cancellation/control messages for in-flight work, without introducing streaming semantics.\n\nDesired outcome:\n- A user can enter a voice chat mode with Minerva that feels conversational and interruption-friendly, while remaining operationally aligned with the existing service and GPU orchestration architecture.','\n',char(10)),'2026-03-07T03:35:02','2026-03-07T03:35:02','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc6e9f00376c68d06d2a73770411f','test','draft','Manual testing: Skills system (Preferences tab, activation, prompt injection, executables)','End-to-end manual validation of the runtime Skills system implemented in the Preferences tab.','2026-03-07T06:09:06','2026-03-07T06:09:06','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc5eaca627aa7a48fb7b519d9b88e',NULL);
INSERT INTO items VALUES('019cc71ef68d716280740bb81e5382fa','dcr','reviewing','Push-to-talk voice conversation mode for Minerva',replace('## Problem\n\nMinerva has basic speech-to-text (OpenAI Whisper via HTTP) but no voice conversation mode. Users cannot talk to Minerva and hear it respond. There is no TTS integration and no way to configure voice service preferences.\n\n## Goal\n\nAdd a push-to-talk voice conversation mode: user holds a button to speak, Minerva transcribes via STT, sends to the LLM, then speaks the response via TTS. No barge-in — simple turn-based voice chat.\n\n## Voice Service Backend\n\nThe minerva-services `voice-service` provides STT and TTS over Core WebSocket:\n- **STT**: `voice/stt/transcribe` — accepts `audio_base64` (WAV), returns `text`\n- **TTS**: `voice/tts/synthesize` — accepts `text` + `voice_id` + `backend`, returns `audio_base64` (WAV)\n- **Voices**: `voice/voices/list` — lists available voices with backend_family and capabilities\n- **Status**: `voice/manage/status` — backend health check\n\nThese are standard Core request/response messages (non-streaming, transaction-oriented) using the existing `Core.send_message()` pattern.\n\n## Existing Infrastructure\n\n- **Microphone capture**: `AudioToText.gd` — AudioStreamMicrophone + AudioEffectCapture on "Rec" bus, saves to WAV\n- **Audio playback**: AudioStreamPlayer with volume/position controls\n- **Core WebSocket**: `Core.send_message(service, action, data)` with AwaitMessage correlation\n- **Chat flow**: `ChatPane.execute_regular_chat()` → CoreProvider → model-chat\n- **Current STT**: OpenAI Whisper API (direct HTTP, not via Core)\n\n## Design\n\n### Voice Preferences Tab (in Preferences)\n\nA new "Voice" tab in Preferences with:\n\n**STT Provider Selection:**\n- OpenAI Whisper (existing, direct HTTP — requires OpenAI API key)\n- Voice Service (via Core — uses gpu-node''s faster-whisper/whisper backends)\n- Default: Voice Service when Core connected, OpenAI Whisper as fallback\n\n**TTS Provider Selection:**\n- Voice Service (via Core — Kokoro, Qwen TTS backends)\n- None / disabled\n- Default: Voice Service\n\n**Voice Selection:**\n- Dropdown populated from `voice/voices/list` response\n- Preview button (synthesize a short sample and play it)\n- Backend filter (kokoro, qwen, etc.)\n\n**Audio Settings:**\n- Input device selection (if Godot exposes it)\n- Playback volume for TTS responses\n- Auto-play TTS toggle (on by default)\n\n**Voice config persisted to user config file.**\n\n### Voice Conversation Flow (Push-to-Talk)\n\n1. User presses and holds voice button (or keybind)\n2. Microphone captures audio → WAV buffer\n3. User releases button → capture stops\n4. WAV encoded to base64 → sent to STT provider\n5. Transcribed text appears in chat input (editable, user can review)\n6. Text sent to LLM via normal chat flow (`execute_regular_chat`)\n7. LLM response received → sent to TTS provider\n8. TTS audio played back via AudioStreamPlayer\n9. Chat history shows both text and audio indicators\n\n### UI Elements\n\n- **Push-to-talk button** in chat input area (next to send button)\n- **Recording indicator** (pulsing dot or waveform while recording)\n- **Playback controls** on assistant messages (play/stop TTS audio)\n- **Voice mode toggle** — when on, auto-TTS all assistant responses\n- **Keyboard shortcut** for push-to-talk (e.g., hold Space when chat input not focused)\n\n### Voice Service Client\n\nNew `VoiceServiceClient.gd` that wraps Core messages:\n- `transcribe(audio_wav: PackedByteArray, language: String) -> String`\n- `synthesize(text: String, voice_id: String, backend: String) -> PackedByteArray`\n- `list_voices(backend: String) -> Array[Dictionary]`\n- `get_status() -> Dictionary`\n- Handles the Core send_message / AwaitMessage pattern internally\n- Falls back to OpenAI Whisper for STT if configured\n\n### Integration with Existing AudioToText\n\nRefactor `AudioToText.gd` to support multiple STT backends:\n- Extract mic capture logic into reusable component\n- Add voice-service STT path alongside existing Whisper HTTP path\n- Selection driven by Voice Preferences\n\n## Phase 1 (This DCR)\n- Voice Preferences tab (STT/TTS provider, voice selection, audio settings)\n- VoiceServiceClient wrapping Core messages for STT/TTS\n- Push-to-talk button in chat input area\n- STT → chat input → LLM → TTS → playback flow\n- Basic recording/playback indicators\n\n## Phase 2 (Future)\n- Barge-in (interrupt TTS playback to start new turn)\n- VAD (voice activity detection — auto-endpoint without button release)\n- Streaming TTS playback (play chunks as they arrive)\n- Voice cloning / custom voice upload\n- Per-agent voice assignment\n- Echo cancellation for always-listening mode','\n',char(10)),'2026-03-07T07:07:01','2026-03-07T07:47:48','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc71f3c2e79d6a6e0cbbe24e48c47','work_item','backlog','Implementation plan: Push-to-talk voice conversation',replace('Implementation plan for Phase 1 push-to-talk voice conversation in Minerva.\n\n## Task Breakdown\n\n### Task 1: Voice Preferences Tab\nNew "Voice" tab in PreferencesPopup with:\n- STT provider selector (Voice Service / OpenAI Whisper)\n- TTS provider selector (Voice Service / None)\n- Voice selector dropdown (populated from voice/voices/list)\n- Voice preview button\n- Playback volume slider\n- Auto-play TTS toggle\n- Persist to user config\n\n### Task 2: VoiceServiceClient\nNew `Services/Voice/VoiceServiceClient.gd`:\n- Wraps Core.send_message() for voice-service topics\n- `transcribe(audio_wav: PackedByteArray, language: String) -> String`\n- `synthesize(text: String, voice_id: String, backend: String) -> PackedByteArray`\n- `list_voices(backend: String) -> Array[Dictionary]`\n- `get_status() -> Dictionary`\n- Base64 encode/decode of WAV audio\n- Error handling and timeouts\n- Singleton accessor in singleton_object.gd\n\n### Task 3: Refactor AudioToText for multiple STT backends\n- Extract mic capture (record start/stop → WAV bytes) into reusable method\n- Add voice-service STT path alongside existing OpenAI Whisper\n- STT backend selection driven by Voice Preferences config\n- Keep backward compatibility with existing Whisper flow\n\n### Task 4: Push-to-talk UI in ChatPane\n- Push-to-talk button next to send button in chat input area\n- Hold to record, release to stop and transcribe\n- Recording indicator (visual feedback while capturing)\n- Transcribed text populates chat input field (editable before send)\n- Optional: auto-send after transcription\n\n### Task 5: TTS response playback\n- After LLM response received, send text to TTS if voice mode active\n- Play returned WAV audio via AudioStreamPlayer\n- Playback controls on assistant message bubbles (play/stop)\n- Auto-play toggle from preferences\n- Store TTS audio in chat history for replay\n\n### Task 6: Voice mode toggle and keybindings\n- Voice mode toggle button in chat toolbar\n- When voice mode on: auto-TTS responses, show push-to-talk prominently\n- Keyboard shortcut for push-to-talk (configurable)\n- Visual state indicator (voice mode on/off)\n\n## Implementation Order\nTasks 1-2 first (preferences + client), then 3-4 (STT refactor + push-to-talk UI), then 5-6 (TTS + polish). Each task is independently testable.\n\n## Key Files to Create\n- `Services/Voice/VoiceServiceClient.gd` — Core message wrapper\n- `Services/Voice/VoiceConfig.gd` — Voice preferences persistence\n\n## Key Files to Modify\n- `UI/Views/PreferencesPopup.gd` — Voice tab\n- `Models/AudioToText.gd` — Multi-backend STT\n- `UI/Views/ChatPane.gd` — Push-to-talk button, TTS playback\n- `Models/singleton_object.gd` — VoiceServiceClient accessor','\n',char(10)),'2026-03-07T07:07:18','2026-03-07T07:07:18','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71ef68d716280740bb81e5382fa',NULL);
INSERT INTO items VALUES('019cc71f658a7439a7250b6006f1e108','work_item','done','Task 1: Voice Preferences tab — STT/TTS provider, voice selection, audio settings',replace('Add a "Voice" tab to PreferencesPopup with all voice configuration.\n\n**UI Elements:**\n- STT provider: OptionButton (Voice Service | OpenAI Whisper)\n- TTS provider: OptionButton (Voice Service | None)\n- Voice selector: OptionButton populated from voice/voices/list, with backend filter\n- Preview button: synthesize + play a short sample with selected voice\n- Playback volume: HSlider (0-100%)\n- Auto-play TTS: CheckButton (default on)\n- STT language: LineEdit or OptionButton (default "en")\n\n**Persistence:**\n- New `Services/Voice/VoiceConfig.gd` — loads/saves to `user://voice_config.json`\n- Fields: stt_provider, tts_provider, voice_id, voice_backend, playback_volume, auto_play_tts, stt_language\n- Singleton accessor in singleton_object.gd\n\n**Dependencies:** VoiceServiceClient (Task 2) for voice list population and preview, but the tab structure and config persistence can be built independently.','\n',char(10)),'2026-03-07T07:07:29','2026-03-07T07:44:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc71f8a1479479cc4c2212648293f','work_item','done','Task 2: VoiceServiceClient — Core message wrapper for voice-service STT/TTS',replace('New `Services/Voice/VoiceServiceClient.gd` wrapping Core WebSocket messages for voice-service.\n\n**API:**\n- `transcribe(audio_wav: PackedByteArray, language: String = "en", backend: String = "faster-whisper") -> Dictionary` — sends base64-encoded WAV to `voice/stt/transcribe`, returns {text, backend, ...}\n- `synthesize(text: String, voice_id: String, backend: String = "kokoro") -> Dictionary` — sends to `voice/tts/synthesize`, returns {audio_base64, mime_type, ...}\n- `list_voices(backend: String = "") -> Array[Dictionary]` — calls `voice/voices/list`, returns voice entries\n- `get_status() -> Dictionary` — calls `voice/manage/status`\n- `is_available() -> bool` — checks if Core connected and voice-service reachable\n\n**Implementation Pattern:**\nFollow the existing `Core.send_message(service, action, data)` → `AwaitMessage.receive()` pattern from CoreProvider.\n\nRequires a Service definition for voice-service with actions for each topic. Either register dynamically or define statically.\n\n**Base64 Handling:**\n- `Marshalls.raw_to_base64(wav_bytes)` for encoding\n- `Marshalls.base64_to_raw(b64_string)` for decoding\n\n**Error handling:** Timeout (voice operations can take 5-30s for cold starts), connection errors, empty responses.\n\n**Singleton:** Add `voice_client` to singleton_object.gd, initialized when Core connects.','\n',char(10)),'2026-03-07T07:07:38','2026-03-07T07:44:06','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc71f9f71705488374082f93e5243','work_item','done','Task 3: Refactor AudioToText for multiple STT backends',replace('Refactor `Models/AudioToText.gd` to support multiple STT backends.\n\n**Current state:** AudioToText records mic → WAV file → HTTP POST to OpenAI Whisper API → transcription text.\n\n**Target:** Extract mic capture into reusable start/stop/get_wav_bytes methods. Add voice-service STT path using VoiceServiceClient. Backend selection driven by VoiceConfig.stt_provider.\n\n**Changes:**\n- Extract `start_recording()` → `stop_recording() -> PackedByteArray` (returns WAV bytes)\n- Add `transcribe_via_voice_service(wav_bytes) -> String` alongside existing `_StartConverting()` (Whisper)\n- Route based on VoiceConfig: if "voice_service" → use VoiceServiceClient.transcribe(), if "openai_whisper" → existing HTTP path\n- Keep backward compatibility — existing callers still work\n\n**No UI changes in this task** — just backend plumbing.','\n',char(10)),'2026-03-07T07:07:44','2026-03-07T07:45:25','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc71fb63e72fba82c331292901282','work_item','done','Task 4: Push-to-talk UI in ChatPane',replace('Add push-to-talk button to the chat input area in ChatPane.\n\n**UI:**\n- Microphone button next to send button\n- Press and hold to record (button_down → start_recording, button_up → stop and transcribe)\n- Recording indicator: change button color/icon, optional pulsing animation\n- While transcribing: show spinner/status text\n- Transcribed text populates the chat input TextEdit (user can review/edit before sending)\n- Optional auto-send setting (from VoiceConfig)\n\n**Flow:**\n1. User presses mic button → AudioToText.start_recording()\n2. User releases → AudioToText.stop_recording() → WAV bytes\n3. WAV bytes → STT (via configured provider) → transcribed text\n4. Text inserted into chat input field\n5. User presses Send (or auto-sends if configured)\n\n**Integration:** Uses refactored AudioToText (Task 3) for recording and transcription.','\n',char(10)),'2026-03-07T07:07:50','2026-03-07T07:47:26','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc71fd07d7a139723be42b7c6fb2d','work_item','done','Task 5: TTS response playback',replace('After LLM responds, synthesize and play the response as speech.\n\n**Flow:**\n1. LLM response text received in ChatPane\n2. If voice mode active and TTS provider configured: send text to VoiceServiceClient.synthesize()\n3. Decode returned WAV audio (base64 → PackedByteArray → AudioStreamWAV)\n4. Play via AudioStreamPlayer at configured volume\n5. Show play/stop controls on the assistant message bubble\n\n**Implementation:**\n- Hook into ChatPane after assistant response is rendered\n- AudioStreamWAV.load_from_buffer() or save to temp file and load\n- Playback volume from VoiceConfig\n- Auto-play controlled by VoiceConfig.auto_play_tts\n- Cache TTS audio on ChatHistoryItem for replay (new optional field)\n\n**Edge cases:**\n- Long responses: may want to truncate or split text for TTS\n- Tool call responses: skip TTS for tool results, only speak final assistant text\n- Multiple rapid responses: queue playback, don''t overlap','\n',char(10)),'2026-03-07T07:07:56','2026-03-07T07:47:36','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc71fe5ca76ef8d1f03713d2bba56','work_item','done','Task 6: Voice mode toggle and keybindings',replace('Add voice mode toggle and keyboard shortcuts.\n\n**Voice Mode Toggle:**\n- Button in chat toolbar (headphone/mic icon)\n- When on: push-to-talk button prominent, auto-TTS enabled, visual indicator\n- When off: standard text chat, push-to-talk still available but TTS disabled\n- State persisted per-session (not per-chat)\n\n**Keybindings:**\n- Push-to-talk shortcut (e.g., hold V or hold Space when chat input not focused)\n- Voice mode toggle shortcut\n- Configurable via existing keybinding system if available\n\n**Visual indicators:**\n- Voice mode icon in chat toolbar\n- Recording state feedback (mic icon animates)\n- TTS playback state (speaker icon on message)','\n',char(10)),'2026-03-07T07:08:02','2026-03-07T07:47:43','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc71f3c2e79d6a6e0cbbe24e48c47',NULL);
INSERT INTO items VALUES('019cc996ead77d9ca4d714831573dfba','dcr','reviewing','Voice: separate auto-speak responses from minerva_speak tool, add per-call voice selection',replace('Two issues with current voice implementation:\n\n1. **Auto-speak is always on** — when auto_play_tts is enabled, ALL chat responses get spoken. Need a runtime toggle (not just preferences) to turn auto-speak on/off without affecting the minerva_speak tool. The minerva_speak MCP tool should always work regardless of auto-speak setting (this part already works, but the auto-speak behavior is too aggressive).\n\n2. **minerva_speak voice selection** — the tool accepts optional voice_id and backend params, but agents have no way to discover or use different voices per call. Need to surface available voices so agents can choose contextually appropriate voices for different speech acts.','\n',char(10)),'2026-03-07T18:37:16','2026-03-07T18:39:25','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc9b8014e7b408176056d09a25c80','dcr','reviewing','Voice: summarize-then-speak mode using a fast model without tool calls',replace('New voice response mode: instead of speaking the full LLM response verbatim, route the last user message + assistant response to a fast/cheap model (e.g. gemma3:12b via model-chat) to summarize into a single conversational sentence, then speak that summary via TTS.\n\nKey requirements:\n- Must work without tool calls — fast/cheap models don''t handle tool-calling well\n- The summarization model should receive just the last user message and the provider''s response (not full history)\n- Should be a selectable voice mode option (e.g. alongside "speak full response" and "off")\n- Model selection for summarization should be configurable (default to a small fast model)\n- Triggered automatically in the response flow (like current auto-play TTS), not via minerva_speak tool','\n',char(10)),'2026-03-07T19:13:25','2026-03-07T19:29:29','','','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cc9c0810f7f1fbb583df51e72a566','work_item','done','Plan: Summarize-then-speak voice mode',replace('## Architecture\n\n### Speak Mode Enum\nAdd `SpeakMode` to VoiceConfig: `OFF`, `FULL`, `SUMMARIZE`. Replaces the boolean `auto_play_tts`. OFF = no auto-speak. FULL = current behavior (speak entire response). SUMMARIZE = route user msg + response to a fast model, speak the summary.\n\n### Summarization Flow\nIn `_voice_speak_response()`:\n1. If mode is SUMMARIZE, build a one-shot prompt with the last user message and assistant response\n2. Send to a configured summarization model via Core.send_message (OpenAI-compatible format to model-chat)\n3. Use a hardcoded system prompt: "Summarize this conversation exchange into a single conversational sentence suitable for speaking aloud."\n4. Speak the returned summary via TTS (same synthesize path as FULL mode)\n\n### No Tool Calls\nThe summarization request sends only messages (system + user), no tools array. Fast/cheap models handle this fine.\n\n### Config Additions to VoiceConfig\n- `speak_mode: SpeakMode` (default OFF — replaces `auto_play_tts`)\n- `summary_model: String` (default "" — user picks from available model-chat models)\n- `summary_timeout: float` (default 30.0 — fast models should respond quickly)\n\n### UI Changes\n- Voice Preferences: replace auto-play TTS checkbox with a 3-option dropdown (Off / Full / Summarize)\n- When Summarize selected, show model picker populated from model-chat available models\n- ChatPane TTS toggle button: cycles through OFF → FULL → SUMMARIZE instead of binary toggle\n\n### Data Flow at Call Site\nAt ChatPane line 552, both `user_history_item` (the user''s message) and `chi.Message` (the response) are available. Pass both to `_voice_speak_response` so it can build the summarization prompt.\n\n### Backward Compatibility\n- `auto_play_tts: bool` replaced by `speak_mode: SpeakMode`\n- Config load: if old `auto_play_tts=true` found, migrate to `speak_mode=FULL`\n- The quick toggle button ("S") and minerva_speak tool are unaffected — minerva_speak always speaks regardless of speak_mode','\n',char(10)),'2026-03-07T19:22:42','2026-03-07T19:29:16','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9b801',NULL);
INSERT INTO items VALUES('019cc9c09aa87807b0e7ce331865ab05','work_item','done','Task 1: Add SpeakMode enum and config fields to VoiceConfig',replace('In VoiceConfig.gd:\n- Add `enum SpeakMode { OFF, FULL, SUMMARIZE }`\n- Replace `auto_play_tts: bool` with `speak_mode: SpeakMode = SpeakMode.OFF`\n- Add `summary_model: String = ""` (model name for summarization)\n- Add `summary_timeout: float = 30.0`\n- Update `save()` and `load_from_config()` — migrate old `auto_play_tts` bool to `speak_mode`\n- Keep backward compat: if config has `auto_play_tts=true` and no `speak_mode`, set `speak_mode=FULL`','\n',char(10)),'2026-03-07T19:22:48','2026-03-07T19:28:59','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9c081',NULL);
INSERT INTO items VALUES('019cc9c0afe4768cbcb777ce109435f4','work_item','done','Task 2: Add one-shot summarization method to VoiceServiceClient',replace('In VoiceServiceClient.gd, add:\n```\nfunc summarize_for_speech(user_text: String, response_text: String, model: String, timeout: float) -> String\n```\n- Build OpenAI-format messages: system prompt ("Summarize this conversation exchange into a single conversational sentence suitable for speaking aloud.") + user message containing both the user''s input and the assistant''s response\n- Send to model-chat via Core.send_message with no tools\n- Parse OpenAI-format response, extract choices[0].message.content\n- Return summary text, or fallback to truncated response_text on error\n\nNeed to determine the correct action/topic for model-chat. The model name must be routed correctly — check how CoreProvider handles model selection (may need to include model in the action or data).','\n',char(10)),'2026-03-07T19:22:54','2026-03-07T19:28:59','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9c081',NULL);
INSERT INTO items VALUES('019cc9c0c4fe7da08095258db71a5d80','work_item','done','Task 3: Update ChatPane voice speak flow for SpeakMode',replace('In ChatPane.gd:\n- Update call site (line 552): pass user message text alongside response text to `_voice_speak_response`\n- Refactor `_voice_speak_response(response_text, user_text)`:\n  - Check `cfg.speak_mode` instead of `cfg.auto_play_tts`\n  - OFF → return\n  - FULL → current behavior (synthesize response_text directly)\n  - SUMMARIZE → call `client.summarize_for_speech(user_text, response_text, cfg.summary_model, cfg.summary_timeout)`, then synthesize the summary\n- Update `_on_tts_toggle_pressed()`: cycle OFF → FULL → SUMMARIZE, update button text ("x" / "S" / "Σ")\n- Update all references to `auto_play_tts` in ChatPane (init, toggle handler)','\n',char(10)),'2026-03-07T19:22:59','2026-03-07T19:29:00','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9c081',NULL);
INSERT INTO items VALUES('019cc9c0d4f47d00a318fcf16f1c4c27','work_item','done','Task 4: Update Voice Preferences tab UI for SpeakMode',replace('In PreferencesPopup.gd Voice tab:\n- Replace auto-play TTS checkbox with OptionButton dropdown: "Off" / "Speak Full Response" / "Summarize then Speak"\n- When "Summarize then Speak" selected, show additional controls:\n  - Model picker (OptionButton) populated from available model-chat models/actions\n  - Summary timeout spinbox (default 30s)\n- Update save/load to use `speak_mode` instead of `auto_play_tts`\n- Model picker population: iterate Core.services for model-chat, list available actions/models','\n',char(10)),'2026-03-07T19:23:03','2026-03-07T19:29:00','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9c081',NULL);
INSERT INTO items VALUES('019cc9c0dfd57a599af8a34b9875c570','work_item','done','Task 5: Update minerva_speak tool and references for SpeakMode compat',replace('In MinervaMCPServer.gd:\n- minerva_speak tool is unaffected (always speaks regardless of speak_mode) — verify this still works\n- Any other references to `auto_play_tts` in the codebase need updating to use `speak_mode`\n\nGrep for all `auto_play_tts` references and update them.','\n',char(10)),'2026-03-07T19:23:06','2026-03-07T19:29:08','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cc9c081',NULL);
INSERT INTO items VALUES('019ccea1ce00747ea2ca7e89fdac05c8','dcr','reviewing','Voice: inline status feedback for summarize-then-speak pipeline',replace('Currently the voice speak pipeline (summarize → synthesize → play) has no visible UI feedback. The TTS toggle button approach causes layout overflow in the chat controls bar. Need inline status display in the chat response area instead.\n\n## Option A: Lightweight status label on message node\n\nAppend a small Label or RichTextLabel to the bottom of the model''s MessageMarkdown node. Shows pipeline state, then final result.\n\n**States:** "Summarizing..." → "Synthesizing speech..." → "Speaking..." → "Spoke: [summary text]" (or fades/hides after playback)\n\n**Implementation hints:**\n- `MessageMarkdown` has a `message_labels_container` (VBoxContainer) that holds all rendered content\n- After TTS completes or during each phase, access the model message node from `update_ui_after_response()` where `model_msg_node` is available\n- Add a Label child to `model_msg_node`''s container. Update its text at each stage.\n- `_voice_speak_response` needs access to the model message node — pass it as a parameter from the call site at ChatPane line 552\n- Use `label.add_theme_color_override("font_color", Color(...))` for subtle styling (e.g. dim gray)\n- On completion: either hide the label, or leave it showing the summary sentence for context\n- Minimal code: ~15 lines added to `_voice_speak_response`, no new files\n\n**Pros:** Simple, fast, non-intrusive. No new scenes or scripts.\n**Cons:** Limited space for detail. No expand/collapse for the summary text.\n\n## Option B: Collapsible VoiceSpeakBlock (like ToolCallBlock)\n\nCreate a `VoiceSpeakBlock` control similar to `ToolCallBlock`. Embedded inline in the response, shows full pipeline detail with collapse.\n\n**Implementation hints:**\n- Copy `ToolCallBlock.tscn` → `VoiceSpeakBlock.tscn`, strip tool-specific parts (arguments/result sub-sections, action buttons)\n- Header shows status: "[Voice] Summarizing..." → "[Voice] Speaking" → "[Voice] Done"\n- Content area shows: summary model used, summary text, original response length vs summary length\n- Integration pattern: after response renders, append a VoiceSpeakBlock to `model_msg_node`''s content container (same as tool blocks but without the `{{TOOL_BLOCK}}` marker system — just append directly)\n- Live updates: call `block.set_status("Summarizing...")` etc. during pipeline\n- Reuse `_animate_sub_collapse` pattern from ToolCallBlock for consistent UX\n- Files needed: `VoiceSpeakBlock.gd` + `VoiceSpeakBlock.tscn`\n\n**Pros:** Rich detail, consistent with existing tool call UX, expandable for future voice features.\n**Cons:** More code, new scene file, heavier for a simple status display.\n\n## Also: Remove TTS toggle button from chat controls\nThe quick-cycle button (x/S/Σ) causes pane overflow. Remove `_tts_toggle_button` from ChatPane. Speak mode is already controllable from Voice Preferences dropdown. If a quick toggle is needed later, consider a menu item or keyboard shortcut instead.','\n',char(10)),'2026-03-08T18:07:16','2026-03-08T18:08:41','','','',3,3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019ccebd707672c398807388f7a771c0','rca','investigating','Audio device broken on startup with multiple audio devices','On machines with multiple audio devices, the currently selected/default audio device stops working — sometimes for the entire PC — when Minerva starts. Switching to a different audio device in Minerva restores functionality: the new device works in Minerva, and the previously broken device resumes working for the rest of the PC (but not Minerva).','2026-03-08T18:37:27','2026-03-08T19:54:58','','','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,replace('1. Why does the saved mic not work after restart, but switching to another mic works?\nThe mic that''s active when Godot''s engine initializes gets grabbed/locked during engine startup (before any GDScript runs). Switching to a different mic works because it triggers a fresh device open that isn''t tainted by the startup grab.\n\n2. Why does Godot''s engine startup break the mic?\nproject.godot has audio/driver/enable_input=true, which causes Godot to open the default input device at engine initialization — before _ready() or any user code. This initial grab may use exclusive mode or incompatible buffer settings.\n\n3. Why does the initial grab break the device even after GDScript re-sets it?\nCalling AudioServer.set_input_device() with the same device that is already open may be a no-op in Godot, or it may not properly reinitialize the device. The device stays in the broken state from engine init. Only switching to a DIFFERENT device forces a proper close-and-reopen cycle.\n\n4. Why does switching to a different device fix everything?\nSwitching forces Godot to: (a) close/release the broken device (OS reclaims it, other apps work again), (b) open the new device fresh with proper initialization. The close-reopen cycle is what fixes the state.\n\n5. Why can''t we prevent the engine from grabbing the device at startup?\naudio/driver/enable_input=true is a project-level setting required for microphone recording. Godot does not support enabling input on-demand — it is all-or-nothing at engine init. The workaround may be to disable it in project settings and manually enable input when recording starts, OR to force a device cycle on startup (set to different device, then set back).','\n',char(10)),NULL,replace('- audio/driver/enable_input=true in project.godot causes engine-level device grab before GDScript runs\n- Godot AudioServer.set_input_device() with same device is a no-op (does not reinitialize)\n- Device cycling (switch away then back) does NOT fix the original device — confirmed by manual testing\n- The device corrupted at engine init is permanently broken for that Minerva session\n- This is a known Godot engine bug: issues #75603, #72892, #54584, #76797\n- PulseAudio pa_stream_disconnect Bad state error confirmed in crash log\n- No GDScript-level fix possible — corruption happens in C++ audio driver during engine init\n- Code changes reverted — no workaround applied','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019ccedb4faf74139cd01ac7fc6d5c0a','work_item','backlog','Analyze stubborn startup audio-device bug after failed deferred-init fix',replace('Static analysis of the Minerva codebase in /home/imran/github/Minerva against RCA 019ccebd707672c398807388f7a771c0.\n\n## Summary\nThe initial fix attempt did not address the actual failure mode. The project still enables microphone input at Godot engine startup, so the engine opens the input device before any GDScript runs. After that, Minerva''s startup code re-applies the saved devices, but the current implementation deliberately skips re-setting a device if AudioServer already reports that same device as current. In the exact failure case described by the RCA, this means startup performs no device reinitialization at all.\n\n## Key finding\nThe code currently implements the opposite of the workaround implied by the RCA.\n\nThe RCA hypothesis is:\n1. Godot opens the audio input device too early at engine startup because project.godot has audio/driver/enable_input=true.\n2. The opened device can enter a bad state.\n3. Re-setting the same device may be a no-op.\n4. Only switching to a different device forces a close/reopen cycle.\n\nThe current Minerva startup logic does this instead:\n- defer startup device application to a later frame\n- skip calling AudioServer.set_input_device() if the current device name already matches the saved device\n- skip calling AudioServer.output_device = ... if the current output device already matches the saved device\n\nThat means the deferred startup path still does nothing in the exact case where the engine has already opened the saved device in a bad state.\n\n## Exact code path to verify\n\n### 1. Engine-level startup still opens input device before script code\nFile: /home/imran/github/Minerva/src/project.godot\nRelevant setting:\n- [audio]\n- driver/enable_input=true\n\nThis means microphone input is enabled at engine init time. The RCA''s core assumption remains true in the current code.\n\n### 2. SingletonObject defers device application, but only after engine init\nFile: /home/imran/github/Minerva/src/Scripts/Models/singleton_object.gd\nRelevant area: _ready()\n\nObserved behavior:\n- output_device_changed.connect(set_output_device)\n- later: call_deferred("_apply_saved_audio_devices")\n\nThis defers Minerva''s own device-selection logic until after the engine has already started and opened audio input.\n\n### 3. Startup path re-applies saved devices via _apply_saved_audio_devices()\nFile: /home/imran/github/Minerva/src/Scripts/Models/singleton_object.gd\nRelevant function:\n- _apply_saved_audio_devices()\n\nObserved behavior:\n- var mic_selected: String = get_microphone()\n- if not mic_selected.is_empty():\n    set_microphone(mic_selected)\n- set_output_device(get_output_device())\n\nThis is the only startup remediation path found in the code.\n\n### 4. set_microphone() short-circuits when the broken device is already current\nFile: /home/imran/github/Minerva/src/Scripts/Models/singleton_object.gd\nRelevant function:\n- set_microphone(mic: String)\n\nObserved behavior:\n- validates mic exists in AudioServer.get_input_device_list()\n- if AudioServer.get_input_device() == mic:\n    return\n- otherwise calls AudioServer.set_input_device(mic)\n\nThis is the critical flaw relative to the RCA. If Godot already opened the saved device during startup, and AudioServer reports that same device as current, Minerva intentionally does nothing. No close/reopen cycle is forced.\n\n### 5. set_output_device() has the same no-op behavior\nFile: /home/imran/github/Minerva/src/Scripts/Models/singleton_object.gd\nRelevant function:\n- set_output_device(device: String)\n\nObserved behavior:\n- validates device exists in AudioServer.get_output_device_list()\n- if AudioServer.output_device == device:\n    return\n- otherwise applies AudioServer.output_device = device\n\nSo the same flaw exists on the output side. This matches the RCA note that the same pattern likely affects output devices.\n\n## Why the first fix failed\nThe failed fix in the RCA was:\n- defer initialization\n- skip redundant re-set\n- validate device exists and fall back to Default\n\nStatic analysis indicates:\n- deferring init cannot prevent the engine-level input-device open, because that already happened before _ready()\n- skipping redundant re-set suppresses the only possible recovery action if the current device is already the engine-opened broken one\n- validating device existence only handles stale/missing device names, not the startup bad-state problem\n\nSo the failed fix was ineffective by design for the RCA''s own hypothesized failure mode.\n\n## Why users with Default are likely affected hardest\nFile: /home/imran/github/Minerva/src/Scripts/Models/singleton_object.gd\nRelevant functions:\n- get_microphone() default return value: "Default"\n- get_output_device() default return value: "Default"\n\nFor users who saved or inherited "Default":\n- Godot likely opens the default device at startup\n- _apply_saved_audio_devices() later calls set_microphone("Default") / set_output_device("Default")\n- both paths can early-return because the current device is already "Default"\n- result: no forced device cycle, no recovery\n\nThis aligns with a symptom where Minerva startup breaks the currently active/default device, and only switching to another device revives it.\n\n## Secondary risk: audio-device policy is not fully centralized\nThere is at least one direct AudioServer.set_input_device() call outside SingletonObject.\n\nFile: /home/imran/github/Minerva/src/Scripts/UI/Controls/VideoRecorder/VideoRecorderOverlay.gd\nObserved behavior:\n- _on_mic_selected(index) calls AudioServer.set_input_device(device) directly\n\nThis is not necessarily the startup bug, but it means device-handling policy is not enforced in one place. A junior dev should verify whether there are any other direct input/output device setters that bypass the singleton logic.\n\n## Supporting evidence from repo contents\nA checked-in crash/log file exists at:\n- /home/imran/github/Minerva/src/1\n\nIt contains a PulseAudio error at shutdown:\n- "PulseAudio: pa_stream_disconnect error: Bad state"\n- at finish_input_device (drivers/pulseaudio/audio_driver_pulseaudio.cpp:758)\n\nThis is not proof of the startup bug by itself, but it is consistent with audio input device lifecycle problems in Godot/PulseAudio.\n\n## What a junior dev should verify manually\n1. Confirm project.godot still contains audio/driver/enable_input=true.\n2. Add temporary logging around:\n   - _apply_saved_audio_devices()\n   - set_microphone()\n   - set_output_device()\n3. On a machine with multiple audio devices, launch Minerva with the saved mic/output set to the currently active/default device.\n4. Verify whether startup logs show:\n   - _apply_saved_audio_devices() runs\n   - set_microphone() sees AudioServer.get_input_device() == saved mic\n   - function returns without calling AudioServer.set_input_device()\n5. Verify the same pattern for output_device.\n6. Confirm that switching to another device in Preferences immediately restores functionality, supporting the "forced cycle fixes it" theory.\n7. Audit for any other direct calls to AudioServer.set_input_device() or output_device assignment outside singleton_object.gd.\n\n## Conclusion\nThe stubborn bug likely remains because the code still allows Godot to open the input device at engine startup, and Minerva''s own deferred startup logic refuses to reinitialize the device when the saved device equals the already-open current device. The initial fix reduced activity on startup, but it also removed the only startup action that might have forced recovery.\n','\n',char(10)),'2026-03-08T19:10:05','2026-03-08T19:10:05','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019ccebd707672c398807388f7a771c0',NULL);
INSERT INTO items VALUES('019ccf0cce767a23921aa34ce7f0295f','rca','detected','Minerva TTS reports ''no synth data'' when voice-service request is missing voice_id',replace('Minerva TTS synthesis can fail from the UI even when the local voice-service stack is healthy because the frontend sends voice-service TTS requests without a required voice_id, then misreports the backend schema error as ''no synth data''.\n\n## Observed symptom\n- User attempted audio synth via Minerva UI with Kokoro selected.\n- Minerva reported effectively ''no synth data'' / no returned audio.\n- Backend voice stack was believed to be running locally via voice-service -> gpu-node -> voice-container.\n\n## Static analysis findings\n### Backend contract\nThe running backend requires both text and voice_id for voice/tts/synthesize.\n- minervaservices/infrastructure/services/voice-service/voice-service.py\n  - _handle_tts_synthesize() rejects requests missing text or voice_id with SCHEMA_VALIDATION_ERROR.\n- minervaservices/infrastructure/services/gpu-node/services/voice_service.py\n  - synthesize() also rejects requests missing text or voice_id.\n\n### Minerva frontend request shape\nIn Minerva:\n- src/Scripts/Services/Voice/VoiceServiceClient.gd\n  - synthesize(text, voice_id = "", backend = "kokoro") only includes voice_id in the request if it is non-empty.\n  - therefore Minerva can send a TTS request containing text + backend but no voice_id.\n\n### Why Minerva surfaces the wrong error\nVoiceServiceClient.synthesize() expects a success envelope containing params.result.audio_base64.\nIf Core returns an error envelope instead (for example, missing required fields: text, voice_id), the code does not recognize that as the primary failure. It reads params.result as empty and falls through to:\n- "TTS returned no audio"\nThis makes a frontend request validation failure look like a backend synthesis/data failure.\n\n### Why voice_id is plausibly empty in real use\n- src/Scripts/Services/Voice/VoiceConfig.gd\n  - voice_id defaults to empty string.\n- src/Scripts/UI/Views/PreferencesPopup.gd\n  - voice list is auto-refreshed only if Core is already connected when the Voice tab is created.\n  - if Core connects later, _on_core_connection_changed() enables controls but does not auto-load voices.\n  - therefore cfg.voice_id may remain empty until the user explicitly refreshes/selects a voice.\n- Chat and MCP speech paths both rely on cfg.voice_id if none is explicitly supplied.\n\n## Likely root cause\nFrontend state and request construction are inconsistent with the backend contract:\n1. Minerva allows TTS to proceed without guaranteeing a selected voice_id.\n2. voice-service requires voice_id.\n3. Minerva interprets the resulting backend/Core error as missing synth data instead of a schema/request error.\n\n## Why this is likely not a backend outage\nThe local backend stack has existing E2E coverage in minervaservices/infrastructure/test/voice-service-test.py that validates:\n- voice/manage/status\n- voice/voices/list\n- voice/stt/transcribe\n- voice/tts/synthesize\nincluding Kokoro and faster-whisper paths.\nA fresh rerun should confirm whether the local backend remains healthy.\n\n## Verification steps for junior dev\n1. In Minerva, inspect current Voice config and confirm whether cfg.voice_id is empty when synth is attempted.\n2. Log the exact request payload from VoiceServiceClient.synthesize().\n3. Confirm whether voice_id is omitted from the message when synth fails.\n4. Inspect the Core response envelope and confirm it is an error message rather than a success message with empty audio.\n5. Compare with a successful synth after manually refreshing voices and selecting one.\n6. Independently rerun the backend E2E test in minervaservices to confirm backend health.\n','\n',char(10)),'2026-03-08T20:04:08','2026-03-08T20:04:08','','','',1,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf40c3f7376fab870013a0f7f1ed0','dcr','approved','Replace custom terminal emulator with libghostty-vt integration',replace('## Summary\n\nReplace Minerva''s hand-rolled C++ ANSI/VT100 terminal parser and renderer with libghostty-vt, a battle-tested zero-dependency VT state machine from the Ghostty project. Add vertical split support for side-by-side terminal tab groups. Enable Claude Code integration via terminal tabs.\n\n## Current State\n\nMinerva has a custom GDExtension terminal (src/gdextension/terminal/) with:\n- Unix: forkpty() PTY + hand-rolled ANSI/VT100 regex parser (~743 lines C++)\n- Windows: ConPTY implementation\n- GDScript layer (TerminalNew.gd, ~937 lines): TextLayer/CursorLayer inner classes for rendering\n- Signal-based architecture: C++ parses sequences, emits Godot signals, GDScript renders\n- Single tab group via TerminalTabContainer (TabBar + PanelContainer)\n- Partial command injection/output capture (shell prompt markers [888z]/[999z])\n\n### Current Limitations\n- No scrollback buffer\n- No mouse protocol support\n- No image protocol (kitty/sixel)\n- Custom parser likely has gaps vs battle-tested VT implementations\n- Single tab group only (no splits)\n- Output capture to notes is partially implemented (commented out)\n\n## Proposed Design\n\n### Library Choice: libghostty-vt (not full libghostty)\n\nlibghostty-vt is the right layer — it''s a zero-dependency VT state machine that:\n- Parses VT escape sequences\n- Maintains terminal state (cells, cursor, styles, scrollback)\n- Provides formatter output (plain text, VT, HTML)\n- Does NOT render (embedder renders — fits Godot''s draw model)\n- Does NOT manage PTY (embedder manages — keep existing forkpty/ConPTY)\n\nThe full libghostty includes GPU renderers and PTY management but is not stable for external use.\n\n### Source Management\n\n- Git submodule: vendor/ghostty pinned to a release tag (MIT licensed, public repo)\n- Cannot vendor just lib-vt sources — they import from full ghostty src/ tree\n- Repo is ~66MB\n\n### Build Integration\n\n- Build libghostty-vt via `zig build lib-vt` (requires Zig 0.15.2+)\n- Cross-compile from Linux in ~20-30s (-Dsimd=false) or native macOS ~3min (with SIMD)\n- macOS universal: build aarch64 + x86_64 separately, combine with lipo\n- GitHub Actions: mlugg/setup-zig@v1, cache on ghostty submodule commit hash\n\n### Zig Shim for Cell Access (Key Design Decision)\n\nlibghostty-vt''s C API exposes Formatter (bulk text output) but NOT per-cell access. The Zig internals have full cell/row/page/style types. Rather than forking ghostty, we write a thin Zig shim:\n\n- Lives in src/gdextension/terminal/ghostty-shim/\n- build.zig.zon path dependency points to vendor/ghostty\n- Imports ghostty-vt Zig module, exports C functions: minerva_cell_get(term, row, col, *CellInfo)\n- Cell is packed u64: codepoint + style_id + wide flag\n- Style lookup: page.styles.get(cell.style_id) → fg/bg/bold/italic/etc\n- Compiles to single libminerva-vt.dylib (ghostty-vt + shim in one binary)\n- When ghostty adds official cell C API, shrink or drop the shim\n\n### GDExtension Adapter\n\nReplace current C++ terminal_interface.h implementation:\n- Keep forkpty()/ConPTY PTY management\n- Feed PTY output to ghostty_terminal_vt_write()\n- Use ghostty_key_encoder_encode() for input (replaces hand-rolled key mapping)\n- Call minerva_cell_get() from shim to populate Godot-side rendering\n- Emit equivalent Godot signals for GDScript layer\n\n### Rendering\n\nTextLayer._draw() stays but switches from signal-driven text appending to cell-grid polling:\n- Each frame (or on dirty flag): iterate rows/cols via shim C API\n- Draw each cell with character + fg color + bg color + style flags\n- CursorLayer stays (cursor position from terminal state)\n\n### Vertical Split (Side-by-Side Tab Groups)\n\nCurrent terminal layout: VSplitContainer holds MainUI (top) + TerminalTabContainer (bottom).\n\nDesign: Replace TerminalTabContainer''s PanelContainer with HSplitContainer holding two independent tab groups. Each group has its own TabBar + PanelContainer + terminal instances. Split toggle button next to the + tab button. Second group starts hidden. Follows existing HSplitContainer patterns in MainScene.\n\n### Claude Code Integration\n\nClaude Code is a CLI — spawn `claude` as shell process in a terminal tab. Minerva interacts via PTY: inject commands with write_input(), extract responses with formatter, detect prompt patterns. Can auto-launch in dedicated tab, pipe editor context, capture responses as docket items.\n\n## Decisions Made\n- libghostty-vt over full libghostty (state machine only, embedder renders)\n- Zig shim over fork (maintainable, no rebase burden, shim shrinks when upstream adds cell API)\n- Git submodule over Zig package manager (Minerva uses SCons, not Zig build system)\n- Vertical split = HSplitContainer with two tab groups (not drag-and-drop panes)\n\n## Prior Art\n- No Godot projects use libghostty yet — Minerva would be first\n- GodotXterm uses libtsm (same architectural pattern: state machine + separate PTY)\n- gpui-ghostty uses ghostty as git submodule (vendor/ghostty pinned to tag)\n- libkoda-terminal demonstrates cell-grid rendering from ghostty-vt Zig internals\n\n## Risks\n- libghostty-vt API is not yet stable (Cell packed u64 struct could change between versions)\n- No tagged libghostty release yet (building from tip/main)\n- Zig 0.15.2 is a recent requirement — CI and local dev environments need it\n- Shell prompt markers ([888z]/[999z]) are custom sequences — libghostty treats them as unknown; need callback or post-processing','\n',char(10)),'2026-03-16T00:29:29','2026-03-16T00:32:14','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf40c710e7e338449ef00aacef83f','work_item','active','Implementation plan: libghostty-vt terminal integration',replace('## Implementation Plan\n\nPhased approach to replace Minerva''s custom terminal with libghostty-vt. Each phase is a child work item below.\n\n### Phase 1: Foundation (vendor + build)\nSet up ghostty submodule, Zig shim project, and CI pipeline. No functional changes to Minerva yet.\n\n### Phase 2: Core Integration (parser swap)\nReplace the hand-rolled ANSI parser with libghostty-vt. Keep existing PTY layer and rendering. Terminal should work identically from user''s perspective.\n\n### Phase 3: Cell-Grid Rendering\nSwitch TextLayer from signal-driven text append to cell-grid polling via shim API. Enables scrollback, proper wide-char support, and style accuracy.\n\n### Phase 4: Input Encoding\nReplace hand-rolled key mapping with ghostty_key_encoder_encode(). Enables kitty keyboard protocol and correct modifier handling.\n\n### Phase 5: Vertical Split\nAdd HSplitContainer with two independent tab groups. Split toggle button. Each group manages its own terminals.\n\n### Phase 6: Enhanced Features\nShell prompt markers, command injection, output capture via formatter, Claude Code dedicated tab support.\n\n### Phase 7: Polish\nMouse protocol, scrollback UI, performance tuning, cross-platform testing.','\n',char(10)),'2026-03-16T00:29:42','2026-03-16T00:32:15','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c3f7376fab870013a0f7f1ed0',NULL);
INSERT INTO items VALUES('019cf40c99d07cf4b7f81f64f7f58f74','work_item','done','Phase 1: Add ghostty submodule and Zig shim scaffold',replace('- Add ghostty-org/ghostty as git submodule at vendor/ghostty, pinned to latest stable tag\n- Create src/gdextension/terminal/ghostty-shim/ with build.zig, build.zig.zon, src/shim.zig\n- build.zig.zon: path dependency to ../../vendor/ghostty\n- build.zig: create shared lib "minerva-vt" importing ghostty-vt module\n- shim.zig: stub C-exported functions (minerva_terminal_new, minerva_terminal_free, minerva_cell_get)\n- Define CellInfo extern struct (codepoint, fg_r/g/b, bg_r/g/b, bold, italic, underline, wide)\n- Verify `zig build` produces libminerva-vt.dylib/.so\n- Update SConstruct to link against libminerva-vt (LIBPATH, CPPPATH, LIBS)\n- Add corresponding C header file for GDExtension C++ to include','\n',char(10)),'2026-03-16T00:29:52','2026-03-16T00:53:42','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40caf6d7f81a618c93ef700d970','work_item','done','Phase 1b: GitHub Actions CI for libghostty-vt builds',replace('- Add build-libghostty job to .github/workflows/build.yml\n- Use mlugg/setup-zig@v1 with version 0.15.2\n- Matrix: aarch64-macos (macos-latest), x86_64-macos (macos-latest), x86_64-linux (ubuntu-latest)\n- Build command: cd src/gdextension/terminal/ghostty-shim && zig build -Dtarget=$TARGET -Doptimize=ReleaseFast\n- macOS: build both archs, combine with lipo for universal binary\n- Cache: key on hash of vendor/ghostty submodule commit\n- Upload artifact for downstream SCons build job to consume\n- Trigger on pushes to development branch','\n',char(10)),'2026-03-16T00:29:57','2026-03-16T01:47:32','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40cc9fc7291bcff84b497816b16','work_item','done','Phase 2: Replace ANSI parser with libghostty-vt terminal state',replace('- In C++ GDExtension terminal class (unix/terminal.cpp, windows/terminal.cpp):\n  - Keep forkpty()/ConPTY PTY creation and management\n  - Keep read thread that reads from master FD\n  - Replace _process_input() / _process_sequence() regex parsing with ghostty_terminal_vt_write()\n  - Create GhosttyTerminal instance on start(), destroy on stop()\n  - Call ghostty_terminal_resize() on resize events\n- Continue emitting existing Godot signals (output_received, seq_*) so GDScript layer works unchanged initially\n- Terminal should behave identically from user perspective — this is a parser-only swap\n- Remove all hand-rolled ANSI parsing code (~400 lines of regex matching)','\n',char(10)),'2026-03-16T00:30:04','2026-03-16T01:28:59','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40cef3a7700bec2d6567a32910e','work_item','done','Phase 3: Cell-grid rendering via shim API',replace('- Implement minerva_cell_get() in shim.zig:\n  - Access terminal.screens.active to get current screen\n  - Iterate page rows/cells for requested (row, col)\n  - Resolve cell.style_id via page.styles.get() → fg/bg colors, bold/italic/underline flags\n  - Handle wide characters (wide/spacer_head/spacer_tail)\n  - Fill CellInfo extern struct and return\n- Add minerva_terminal_get_size() → current rows/cols\n- Add minerva_terminal_get_cursor() → cursor row/col/visible\n- In GDExtension C++: expose cell data to GDScript (PackedByteArray or method calls)\n- Rewrite TextLayer._draw() in TerminalNew.gd:\n  - Switch from signal-driven content array to cell-grid polling\n  - Each redraw: iterate rows/cols, call cell getter, draw character with colors/styles\n  - Support dirty-row tracking for efficient redraws\n- Rewrite CursorLayer to read cursor position from terminal state\n- Remove signal-driven text append architecture (content array, Modifier class)\n- Gains: scrollback buffer, correct wide-char rendering, proper style stacking','\n',char(10)),'2026-03-16T00:30:14','2026-03-16T01:32:11','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40d00ac7fd8b3c0445bf0fbe369','work_item','done','Phase 4: Replace key mapping with ghostty key encoder',replace('- Use ghostty_key_encoder_new() / ghostty_key_encoder_encode() from libghostty-vt C API\n- Map Godot InputEventKey → GhosttyKeyEvent (action, key, modifiers)\n- Encode to terminal escape sequence, write to PTY master FD\n- Replace hand-rolled mapping in TerminalNew.gd _input() handler (~80 lines of arrow/function/ctrl key handling)\n- Gains: kitty keyboard protocol support, correct modifier handling, less code to maintain\n- ghostty_key_encoder_setopt_from_terminal() syncs encoder state with terminal mode','\n',char(10)),'2026-03-16T00:30:18','2026-03-16T01:47:29','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40d1c4770988300af5ea2f45f2e','work_item','backlog','Phase 5: Vertical split — side-by-side terminal tab groups',replace('## Vertical split — side-by-side terminal tab groups\n\n**Updated 2026-03-24 after codebase audit**\n\n### Current Architecture\n```\nTerminalTabContainer (VBoxContainer, 51 lines)\n├── h (HBoxContainer)\n│   ├── TabBar\n│   └── NewTabButton (+)\n└── PanelContainer (holds TerminalNew instances)\n```\n- `TerminalTabContainer.gd` manages tabs, creates `TerminalNew.create()` instances\n- Each `TerminalNew` is independent (own PTY, own _blocks for injection, own gutter)\n- Scene: `TerminalTabContainer.tscn`\n\n### Target Architecture\n```\nTerminalTabContainer (VBoxContainer)\n└── HSplitContainer\n    ├── TerminalTabGroup (left, always visible)\n    │   ├── HBox: TabBar + NewTabButton(+)\n    │   └── PanelContainer (terminals)\n    └── TerminalTabGroup (right, created on split)\n        ├── HBox: TabBar + NewTabButton(+)\n        └── PanelContainer (terminals)\n```\n\n### Implementation Steps\n\n**Step 1: Extract TerminalTabGroup** (can be done by Sonnet)\n- New file: `TerminalTabGroup.gd` extending VBoxContainer\n- Move tab management logic from TerminalTabContainer (51 lines) into this class\n- Methods: `add_terminal()`, `close_terminal(tab)`, `get_active_terminal()`, `tab_count()`\n- New scene: `TerminalTabGroup.tscn` (TabBar + PanelContainer)\n- Pure extraction refactor — no behavior change\n\n**Step 2: Write tests for TerminalTabGroup** (can be done by Sonnet)\n- Test: create group, add terminal, switch tabs, close tab\n- Test: close last tab in group → signal (for split cleanup)\n- Run via `godot --headless --script`\n\n**Step 3: Rewrite TerminalTabContainer with HSplitContainer** (Opus)\n- Replace current VBoxContainer content with HSplitContainer\n- Left side: TerminalTabGroup instance (always present)\n- Right side: null initially\n- Add split toggle button ("⫼") next to left group''s "+" button\n- Split button creates/destroys right TerminalTabGroup\n\n**Step 4: Focus management** (Opus)\n- Track `_active_group: TerminalTabGroup` — which group has focus\n- Click on a group''s terminal → that group becomes active\n- Visual indicator: subtle border/highlight on active group\n- Keyboard shortcut: Ctrl+\ or similar to toggle focus between groups\n- New terminal (+) always goes to the focused group\n\n**Step 5: Edge cases** (Opus)\n- Close last tab in right group → destroy right group, unsplit\n- Close last tab in left group when right exists → move right to left? or just empty?\n- Resize split via drag handle (HSplitContainer handles this natively)\n- Terminal injection: already per-terminal, no changes needed\n- Preferences: apply to all terminals in all groups\n\n### No changes needed for:\n- TerminalNew.gd (each instance is independent)\n- Terminal injection/blocks (per-instance)\n- Terminal preferences (applied globally)\n- Shell prompt hooks (per-PTY)','\n',char(10)),'2026-03-16T00:30:25','2026-03-24T21:31:41','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40d3cb37349b6b871a5bfd1584c','work_item','backlog','Phase 6: Command injection, output capture, and Claude Code support',replace('- Shell prompt markers ([888z]/[999z]):\n  - libghostty treats these as unknown sequences\n  - Option A: post-process raw PTY output before feeding to ghostty_terminal_vt_write() — detect markers, emit signals, strip before feeding\n  - Option B: register custom sequence callback if ghostty supports it\n- Output capture:\n  - Use ghostty_formatter_terminal_new() with GHOSTTY_FORMATTER_FORMAT_PLAIN to extract screen text\n  - Expose as method: get_terminal_text() → String\n  - Wire up CheckButton toggle to capture text between prompt markers as notes/docket items\n- Command injection:\n  - write_input() to PTY master FD stays unchanged\n  - Add programmatic API: inject_command(cmd: String) that writes cmd + "\r\n"\n- Claude Code integration:\n  - "New Claude Tab" button spawns terminal with `claude` as shell process instead of default shell\n  - Detect Claude Code prompt patterns for structured interaction\n  - Pipe selected editor text or notes context as input\n  - Capture Claude Code responses via formatter extraction','\n',char(10)),'2026-03-16T00:30:34','2026-03-16T00:30:34','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf40d54a87e5db9d3fce964b5a991','work_item','backlog','Phase 7: Polish — mouse protocol, scrollback UI, cross-platform testing',replace('- Mouse protocol: forward Godot mouse events to terminal for apps that support mouse (tmux, vim, etc.)\n- Scrollback UI: scrollbar or scroll gesture to navigate scrollback buffer (libghostty-vt maintains pages)\n- Performance: dirty-row tracking, minimize cell queries per frame, batch rendering\n- Cross-platform testing: verify macOS (arm64, x86_64), Linux x86_64, Windows (ConPTY + libghostty-vt)\n- Text selection: adapt existing mouse selection to cell-grid model\n- Copy/paste: use formatter to extract selected text region\n- Window title: handle OSC title sequences from terminal state\n- Alternative buffer: verify full-screen apps (vim, htop, less) work correctly','\n',char(10)),'2026-03-16T00:30:40','2026-03-16T00:30:40','','','',4,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf40c710e7e338449ef00aacef83f',NULL);
INSERT INTO items VALUES('019cf442a9867803bd46ff192e93b647','bug','new','godot-cpp ___dso_handle linker fixup error on macOS 26 / Xcode 26',replace('The Xcode 26 new linker rejects ARM64 ADRP/LO12 relocations referencing ___dso_handle in godot-cpp''s static library. This is a C++ global initializer issue — the __GLOBAL__sub_I_godot.cpp function uses ___dso_handle for atexit registration, and the new linker can''t process the fixup.\n\n**Workaround:** Add -Wl,-ld_classic to LINKFLAGS. This uses the deprecated classic linker which handles the fixup correctly. Applied in SConstruct for macOS platform.\n\n**Root cause:** Apple''s new linker (default in Xcode 26) handles ADRP/LO12 relocations differently than the classic linker. godot-cpp''s compiled objects contain relocations the new linker rejects.\n\n**Long-term fix needed:** Either godot-cpp needs to be updated to produce objects compatible with the new linker, or the build flags need adjustment. -ld_classic is deprecated and will be removed in a future Xcode release.\n\n**Not filed upstream yet.** Should be reported to godotengine/godot-cpp.','\n',char(10)),'2026-03-16T01:28:55','2026-03-16T01:28:55','','','',2,0,NULL,'macOS 26.2 (Tahoe), Apple clang 17.0.0, ld 1230.1, godot-cpp godot-4.3-stable',replace('1. Build any GDExtension on macOS 26 with Xcode Command Line Tools\n2. SCons: python -m SCons platform=macos arch=arm64\n3. Link fails with: ld: fixup error (kind=arm64_adrp_lo12) at ''__GLOBAL__sub_I_godot.cpp'' ... target ''___dso_handle'' does not have address','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf45be3ed70979cd886e20dc73afd','dcr','proposed','Add CAD tool to Minerva — SDF-based code-CAD for LLM-driven 3D modeling',replace('Propose adding a CSG-based "code-CAD" system to Minerva, optimized for LLM-driven iteration. Built on Signed Distance Fields (SDF) with GPU ray marching in Godot.\n\n## Motivation\nOpenSCAD pioneered code-based CAD but lacks GPU acceleration, fillets/chamfers, and LLM integration. A modern SDF-based approach solves all three while keeping the familiar CSG mental model.\n\n## Use Cases\n\n**1. Enclosure design around PCBs**\nImport PCB STL from KiCad, design parametric enclosures with cutouts for connectors, displays, controls. LLM iterates geometry based on human feedback. First target: smart-remote enclosure.\n\n**2. Game/visualization asset creation**\nModel spaceships, props, architectural elements via Python DSL. Export GLTF/GLB for use in Blender, Godot, or web. Assembly support with PBR materials and node hierarchy.\n\n**3. Reference-based modeling**\nImport STL/GLTF as reference geometry, import photos to trace planes. Build new geometry around existing parts with clearance offsets.\n\n**4. Printability analysis**\nWall thickness heatmaps (color_by), overhang detection, clearance checks. Geometry assertions for automated verification.\n\n**5. Visual diffing for human review**\nSDF diff mode shows added (green) / removed (red) material between iterations. Human supervises LLM-driven changes with meaningful visual feedback.\n\n## Architecture Summary\n- Python-embedded DSL with OpenSCAD primitive names (cube, cylinder, sphere, r1/r2 cones, fn)\n- Operators: - difference, + union, & intersection, hull(), minkowski()\n- First-class .fillet() and .chamfer() with edge selectors (CONCAVE/CONVEX, CUT/JOIN, near(), parallel())\n- Exact circular fillets in SDF via circular smooth min — no B-Rep needed\n- Godot viewer with compute shader ray marching, edge picking UI, hot-reload\n- 2-3 MCP tools for LLM interaction (cad_render, cad_query, cad_export)\n- Export: STL, 3MF, AMF (curved triangles), GLTF/GLB (PBR + hierarchy), STEP (future via OCCT)\n- Three-layer color: .color() for debug viz, .color_by() for analysis, .material for export PBR\n- Incremental rendering: parameter-only changes are instant, subtree caching for complex models','\n',char(10)),'2026-03-16T01:56:28','2026-03-16T01:56:28','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf45c2ecc74f9b75f42f72cd008bf','work_item','backlog','experiments/cad — Prototype SDF code-CAD engine',replace('Prototype implementation in experiments/cad/ to validate the SDF code-CAD architecture before Minerva integration.\n\n## Plan\n\n### Phase 1: Core SDF engine (Python)\n- Solid class with operator overloads (- + &) and transform methods (.translate, .rotate, .scale, .mirror)\n- OpenSCAD primitives: cube, cylinder (r1/r2, fn), sphere, polyhedron\n- SDF evaluation: each primitive returns signed distance at a point\n- Boolean ops as SDF tree nodes (min/max)\n- hull() and minkowski() as SDF operations\n- SDF tree serialization to JSON for viewer consumption\n\n### Phase 2: Fillets & edge selection\n- Circular smooth min for exact fillet cross-sections\n- Chamfer via linear smooth blend\n- Edge selectors: CONCAVE/CONVEX, CUT/JOIN/ORIGINAL, near(), parallel(), on_face()\n- Selector composition with & | ~\n- Spatial masking to apply fillets selectively in SDF\n\n### Phase 3: Godot viewer\n- Compute shader SDF ray marcher\n- SDF tree loader from JSON\n- Orbit/pan/zoom camera\n- File watcher for hot-reload from Python\n- Edge detection via normal divergence\n- Edge picking UI with predicate generation\n- Render modes: solid, wireframe, diff, section\n- Screenshot auto-save for LLM consumption\n\n### Phase 4: Color & materials\n- .color() debug visualization (named colors, hex, alpha, priority)\n- .color_by("thickness") analysis heatmaps\n- .material PBR assignment (metal, glass, emissive, matte)\n- Transparency via continued ray marching\n\n### Phase 5: Import/Export\n- import_stl() / import_gltf() as reference geometry (mesh → SDF via 3D texture)\n- import_image() for trace reference on planes\n- Adaptive marching cubes (SDF → watertight mesh)\n- Export: STL, 3MF, AMF (curved triangles), GLTF/GLB (PBR + hierarchy)\n- STEP export (future, via OCCT dual tree)\n\n### Phase 6: MCP & integration\n- 2-3 MCP tools: cad_render (returns image), cad_query (edges/info/checks), cad_export\n- Geometry assertions API (wall thickness, clearance, fits_inside)\n- Assembly class for multi-part models\n- Printability checks (thin walls, overhangs, bridging)\n\n### Phase 7: Smart remote enclosure (validation)\n- Import smart-remote PCB STL from KiCad\n- Design parametric enclosure with cutouts (joystick, OLED, mic, speaker)\n- Iterate with LLM, validate diff workflow\n- Export STL for printing','\n',char(10)),'2026-03-16T01:56:47','2026-03-16T01:56:47','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf45be3ed70979cd886e20dc73afd',NULL);
INSERT INTO items VALUES('019cf46b2a2e75c29366b905d054474e','rca','closed','Terminal output has inconsistent column spacing — wrong font used',replace('Terminal output shows messy, inconsistent column spacing. `ls` output with tab-aligned columns appears misaligned. Characters don''t sit on a clean grid.\n\n## 5-Why Analysis\n\n**Why 1: Why are terminal columns misaligned?**\nCharacters are drawn at grid positions (col * char_width), but the rendered characters don''t actually occupy exactly char_width pixels each. Some are narrower, some wider, creating visual drift.\n\n**Why 2: Why don''t characters occupy exactly char_width pixels?**\nchar_width is calculated from the "M" character: `font.get_char_size("M".unicode_at(0), font_size).x`. But other characters in the font have different widths — the font is not monospaced.\n\n**Why 3: Why is the font not monospaced?**\nThe script loads `CascadiaCode.ttf` (line 29 of TerminalNew.gd): `preload("res://assets/fonts/CascadiaCode/CascadiaCode.ttf")`. CascadiaCode is a **variable-width font with programming ligatures**. It is NOT the monospaced variant.\n\n**Why 4: Why was CascadiaCode used instead of CascadiaMono?**\nThe project includes both `CascadiaCode.ttf` and `CascadiaMono.ttf` in assets/fonts/CascadiaCode/. The scene file (Terminal.tscn) correctly uses CascadiaMono for the legacy RichTextLabel, but the GDScript hardcodes the wrong one. This was a pre-existing bug — the original signal-based renderer happened to work around it because it used draw_string() with multi-character strings, letting the font handle its own spacing. The cell-grid renderer exposes the bug because it places each character at a mathematically exact grid position.\n\n**Why 5: Why wasn''t this caught earlier?**\nThe old renderer drew text as concatenated strings, so the font''s internal proportional spacing was applied consistently. Characters weren''t aligned to a grid — they just flowed left to right with the font''s natural spacing. It looked "OK enough" even though it was technically wrong. The new cell-grid renderer, which correctly places each character at col*char_width, makes the proportional font mismatch immediately visible.\n\n## Root Cause\n`TerminalNew.gd` line 29 loads `CascadiaCode.ttf` (proportional/ligature font) instead of `CascadiaMono.ttf` (monospaced).\n\n## Fix\nChange the font preload from `CascadiaCode.ttf` to `CascadiaMono.ttf`.','\n',char(10)),'2026-03-16T02:13:09','2026-03-16T02:36:54','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,replace('1. Terminal columns misaligned and lines don''t end right\n2. Shell formats output for 182 columns, but fewer fit in visible area\n3. Terminal dimensions calculated from self.size (root PanelContainer = 1711px) instead of _output_container.size (actual drawable area, smaller due to ScrollContainers/margins/scrollbars)\n4. _cols = 1711/9.38 = 182 but actual visible area is fewer columns\n5. Original code used self.size because the old signal-based renderer didn''t need exact grid alignment — text just flowed left-to-right. Cell-grid rendering requires PTY width to exactly match visible columns.\n\nADDITIONAL: Font was also wrong (CascadiaCode.ttf = proportional, fixed to CascadiaMono.ttf = monospaced) but that alone didn''t fix the issue because the dimension mismatch was the primary cause.','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf480ca957324b5204727e0c4b831','bug','triaged','Terminal rendering shows misaligned columns and incorrect spacing',replace('## Status: Under investigation\n\nThe cell-grid renderer (Phase 3 of libghostty-vt integration) renders text at correct grid positions, but the visual output has column alignment issues. Multiple fixes attempted — issue persists.\n\n## What we know\n\n1. **The rendering code IS running** — confirmed via debug prints:\n   - `vt_state_changed signal connected` ✓\n   - `_draw() cell-grid mode` ✓\n   - CascadiaMono.ttf (monospaced) loaded ✓\n\n2. **Cell data from libghostty is populated** — draw #9 in one session showed actual filenames in cells with correct-looking codepoints\n\n3. **80x24 hardcoded size works correctly** — terminal renders properly but lines wrap because visible area is much wider. This confirms per-character rendering with draw_char() is fundamentally working.\n\n4. **Size calculation was the first issue found** — `self.size` (root PanelContainer) was used instead of actual drawable area. Fixed to use `text_layer.size.x` for cols, `_output_container.size.y` for rows. Current size: 177x11.\n\n5. **Font was wrong (secondary issue, fixed)** — CascadiaCode.ttf (proportional) was loaded instead of CascadiaMono.ttf (monospaced). Fixed but didn''t resolve the spacing issue alone.\n\n## What we haven''t verified yet\n\n- Whether the cell data at 177 columns is CORRECT (full row dump hasn''t succeeded — debug trigger timing issue)\n- Whether the terminal dimensions match what the shell actually thinks (stty size)\n- Whether the persistent VT stream is working correctly (fixed in this session but not visually confirmed)\n- Whether draw_char positions actually match the cell grid visually (no pixel-level verification)\n\n## Fixes applied this session\n- Persistent VT stream (was creating/destroying per write, losing parser state)\n- Mutex for thread safety between output thread and render thread\n- Font changed to CascadiaMono.ttf (monospaced)\n- Size calculation from text_layer.size.x instead of self.size.x\n- Code signing for dylibs (crash fix)\n- draw_char instead of draw_string for per-character grid placement\n- SConstruct auto-copies dylib + signs after build\n\n## Next investigation steps\n1. Get a successful cell dump (fix debug trigger) — verify cell data content\n2. Run `stty size` in the terminal to verify shell agrees on dimensions\n3. Run `echo "AAAA BBBB CCCC DDDD"` to test simple spacing\n4. Check if _output_container ScrollContainer viewport clips the TextLayer\n5. Consider: is the issue that cells are correct but DRAW positions don''t match visible area due to nested ScrollContainer offsets?','\n',char(10)),'2026-03-16T02:36:47','2026-03-16T02:36:53','','','',1,0,NULL,'macOS 26.2, Godot 4.6.1, CascadiaMono.ttf, libghostty-vt v1.3.1',replace('1. Launch Minerva, open terminal pane (Ctrl+N)\n2. Type ''ls'' and press Enter\n3. Output shows filenames with inconsistent spacing — tabs/columns don''t align\n4. Type ''ls -la'' and press Enter\n5. Lines don''t end at the right edge — different kind of messy','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf59979e872a0b468900b48c1e844','dcr','approved','Minerva Docker container management: build, lifecycle, and UI',replace('Minerva currently has no Docker container management. The Phase 2 voice gateway is the first feature requiring a managed container. This DCR adds the general-purpose infrastructure.\n\n## Scope\n- Detect Docker availability on host (docker CLI, Colima on macOS, Docker Desktop on Windows)\n- Build containers from bundled Dockerfiles (no registry pull — build locally)\n- Start/stop containers with port mapping\n- Health check polling\n- Container status in UI (building, running, stopped, error)\n- Graceful shutdown on Minerva exit\n\n## UI\n- Preferences > Containers tab showing managed containers and their status\n- Build progress indicator (docker build can take minutes on first run)\n- Start/stop toggle per container\n- Error display if Docker not installed (with install guidance link)\n\n## Platforms\n- Linux: Docker natively\n- macOS: Colima or Docker Desktop\n- Windows: Docker Desktop / WSL2\n\n## First consumer\nVoice gateway container (Phase 2 voice DCR). But infrastructure should be generic enough for future containers.\n\n## Fallback\nIf Docker not available: features requiring containers degrade gracefully (e.g., voice → PTT-only, no wake word).','\n',char(10)),'2026-03-16T07:43:22','2026-03-16T07:47:43','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cf599b1817cfcb663a1afebba5e2e','work_item','backlog','Plan: Docker container management for Minerva',replace('Implementation plan for Docker container management in Minerva.\n\n## Task breakdown\nD1: Docker detection and platform abstraction\nD2: Container build engine (Dockerfile → image)\nD3: Container lifecycle management (start/stop/health)\nD4: Preferences UI — Containers tab\nD5: Graceful shutdown and error recovery\nD6: Voice gateway integration (first consumer)\n\n## Implementation order\nD1 → D2 → D3 → D4 → D5 → D6\n\n## Architecture\nDockerManager singleton (GDScript or GDNative) wraps docker CLI commands. Runs docker commands via OS.execute(). Async status polling via Timer nodes. Container definitions stored in resource files (Dockerfile path, port mappings, health endpoint, display name).\n\n## Key files to create\n- Services/Docker/DockerManager.gd — singleton, build/start/stop/health\n- Services/Docker/ContainerDefinition.gd — resource class (image name, Dockerfile, ports, health URL)\n- Services/Docker/DockerDetector.gd — platform detection (Docker, Colima, Docker Desktop)\n- UI section in PreferencesPopup.gd — Containers tab\n\n## Key files to modify\n- Models/singleton_object.gd — DockerManager accessor\n- PreferencesPopup.gd — add Containers tab','\n',char(10)),'2026-03-16T07:43:36','2026-03-16T07:43:36','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf59979e872a0b468900b48c1e844',NULL);
INSERT INTO items VALUES('019cf59a04d67e729ad7ebac11cf3348','work_item','done','D1: Docker detection and platform abstraction',replace('Detect Docker availability and abstract platform differences.\n\nDockerDetector.gd:\n- Check if ''docker'' CLI is available (OS.execute ''docker --version'')\n- Detect platform: Linux (native Docker), macOS (Colima or Docker Desktop), Windows (Docker Desktop / WSL2)\n- Check if Docker daemon is running (''docker info'')\n- Check if nvidia-container-toolkit is available (''docker run --gpus all'' test)\n- Report: {available: bool, platform: str, gpu_available: bool, version: str, error: str}\n\nSignals:\n- docker_detected(result: Dictionary)\n- docker_not_available(reason: String)\n\nPlatform-specific notes:\n- macOS Colima: ''colima status'' to check if VM is running\n- Windows: Docker Desktop may need WSL2 backend enabled\n- Linux: check docker group membership if permission denied','\n',char(10)),'2026-03-16T07:43:57','2026-03-16T07:49:45','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf59a60a27a8b9e4fe38aaa98eef9','work_item','done','D2: Container build engine (Dockerfile to image)',replace('Build Docker images from Dockerfiles bundled with Minerva.\n\nDockerManager.build_image(definition: ContainerDefinition) -> Signal:\n- Run ''docker build -t <image_name> -f <dockerfile_path> <context_dir>'' via OS.execute\n- Stream build output for progress display\n- Emit build_progress(line: String) for UI updates\n- Emit build_complete(success: bool, image_name: String, error: String)\n- Cache check: skip build if image already exists (''docker images -q <name>'')\n\nContainerDefinition resource:\n- image_name: String (e.g. ''minerva-voice-gateway'')\n- dockerfile_path: String (relative to Minerva install dir)\n- build_context: String (directory containing Dockerfile)\n- ports: Dictionary (host_port -> container_port)\n- health_endpoint: String (e.g. ''http://localhost:8080/health'')\n- display_name: String (e.g. ''Voice Gateway'')\n- gpu_optional: bool (request --gpus all if available, fall back to CPU)\n\nBuild runs in background thread (OS.execute with blocking=false or Thread). Minerva remains responsive during build.','\n',char(10)),'2026-03-16T07:44:21','2026-03-16T15:23:12','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf59a6fde79c4a1f5daea63a76d92','work_item','done','D3: Container lifecycle management (start/stop/health)',replace('Start, stop, and monitor Docker containers.\n\nDockerManager methods:\n- start_container(definition) — ''docker run -d --name <name> -p <ports> [--gpus all] <image>''\n- stop_container(name) — ''docker stop <name> && docker rm <name>''\n- is_running(name) -> bool — ''docker ps -q -f name=<name>''\n- health_check(definition) -> bool — HTTP GET to health_endpoint\n- get_container_status(name) -> {state: running|stopped|building|error, uptime, port}\n\nHealth polling:\n- Timer node polls health endpoint every 5s while container is running\n- Emit container_health_changed(name, healthy: bool)\n- After 3 consecutive health failures, emit container_unhealthy(name)\n- Auto-restart option (configurable per container)\n\nContainer naming:\n- Prefix all containers with ''minerva-'' to avoid conflicts\n- Check for existing container with same name before start (stop old one first)\n\nSignals:\n- container_started(name)\n- container_stopped(name)\n- container_health_changed(name, healthy)\n- container_error(name, error)','\n',char(10)),'2026-03-16T07:44:25','2026-03-16T15:23:34','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf59a8e137c90b56343f5f89868e4','work_item','done','D4: Preferences UI — Containers tab',replace('Add Containers tab to Preferences showing managed container status and controls.\n\n## Layout\nHeader: Docker status line (available/unavailable, platform, GPU support)\n\nPer-container card:\n- Display name + image name\n- Status indicator: building (spinner), running (green), stopped (grey), error (red)\n- Start/Stop toggle button\n- Build/Rebuild button\n- Health status (healthy/unhealthy)\n- Uptime display\n- Port info\n- Expand for build log output\n\n## Docker not available state\n- Show explanation: ''Docker is required for [feature]. Install Docker to enable.''\n- Platform-specific install link (Docker Desktop for Mac/Windows, docker.io for Linux)\n- Re-check button to detect Docker after install\n\n## Build progress\n- Progress bar or streaming log output during docker build\n- Cancel build button\n- Build time estimate based on previous builds (stored in config)\n\n## Integration\n- Tab added to existing PreferencesPopup.gd\n- Container definitions auto-discovered from registered ContainerDefinition resources\n- Status updates via DockerManager signals','\n',char(10)),'2026-03-16T07:44:32','2026-03-16T15:26:45','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf59aac8b7edbb7bb9565a1b127db','work_item','done','D5: Graceful shutdown and error recovery',replace('Handle Minerva exit and container failures gracefully.\n\n## Shutdown\n- On Minerva exit (SceneTree.NOTIFICATION_WM_CLOSE_REQUEST): stop all managed containers\n- ''docker stop'' with timeout (5s), then ''docker kill'' if unresponsive\n- Option in preferences: ''Keep containers running after Minerva exits'' (default: stop)\n\n## Error recovery\n- Container crash: detect via health check failure, show error in UI, offer restart\n- Docker daemon not running: detect on startup, show guidance in Containers tab\n- Build failure: show build log, offer retry\n- Port conflict: detect ''port already in use'' error, suggest alternative port or kill conflicting process\n\n## Startup behavior\n- On Minerva launch: check which containers were running last session (stored in config)\n- Auto-start containers that were previously running (configurable per container)\n- Don''t auto-build — only auto-start if image already exists\n\n## Config persistence\n- Store container state (was_running, last_port, build_time) in user config\n- Survive Minerva restarts','\n',char(10)),'2026-03-16T07:44:40','2026-03-16T15:27:31','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf59ac93173008b4c0ad06c67476d','work_item','done','D6: Voice gateway integration (first consumer)',replace('Wire the voice gateway container into Minerva as the first consumer of DockerManager.\n\n## Container definition\nRegister a ContainerDefinition resource for voice-gateway:\n- image_name: ''minerva-voice-gateway''\n- dockerfile_path: bundled Dockerfile (from wakeword_training container, adapted)\n- ports: {8090: 8080} (host 8090 → container 8080)\n- health_endpoint: ''http://localhost:8090/health''\n- display_name: ''Voice Gateway''\n- gpu_optional: true\n\n## Voice preferences integration\n- Voice tab in Preferences: show voice gateway status from DockerManager\n- ''Enable always-listening'' toggle: starts voice gateway container if not running\n- If container not built: prompt user to build (shows estimated time)\n- If Docker not available: disable always-listening, show PTT-only mode\n\n## Automatic lifecycle\n- When user enables voice features that need the gateway: auto-start container\n- When user disables voice: stop container (optional, configurable)\n- Health check drives VoiceServiceClient connection state\n\n## Depends on\n- D1-D5 (DockerManager infrastructure)\n- Phase 2 voice T0 (voice gateway container itself)','\n',char(10)),'2026-03-16T07:44:47','2026-03-16T16:06:40','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019cf599b1817cfcb663a1afebba5e2e',NULL);
INSERT INTO items VALUES('019cf77bea1071b1986c612ca9402e15','dcr','proposed','Minerva-managed autocoder: containerized opencode + orchestrator with client-side key management',replace('Move autocoder infrastructure from Core-hosted to Minerva-managed Docker container. Eliminates single-tenant bottleneck and server-side key management burden.\n\n## Current architecture (problems)\n- opencode + orchestrator + openrouter-proxy all run on Core (AWS)\n- Single user: only one autocoder instance, shared infrastructure\n- API keys (OpenRouter) managed server-side by admin — doesn''t scale to multiple users\n- Core bears compute and orchestration load for builds\n\n## Proposed architecture\nMinerva manages an autocoder container locally via DockerManager (already built):\n\n**Container contents:**\n- opencode (code generation agent)\n- orchestrator (build coordination, review cycles)\n- openrouter-proxy or direct API client\n\n**Key management:**\n- Minerva already has infrastructure for managing API keys per provider (Preferences → API Keys)\n- Minerva already handles OAuth token acquisition for providers that need it\n- On container start, Minerva injects the user''s own API keys as environment variables\n- No server-side key storage needed — keys stay on the user''s machine\n\n**Multi-user enablement:**\n- Each Minerva instance runs its own autocoder container\n- No shared server state — container is fully self-contained\n- Core is no longer a bottleneck for autocoder workloads\n\n**UGC broadcast for remote management:**\n- Minerva, as a Core client, registers its autocoder container with the user-generated-content service\n- The UGC service broadcasts container status to Core\n- User can monitor and manage builds from any connected device (phone, tablet, another PC)\n- Build status, logs, and results accessible via Core message bus from anywhere\n\n## Benefits\n1. **Multi-user**: each user runs their own autocoder, uses their own API keys\n2. **No server-side key management**: keys stay client-side in Minerva''s existing preferences\n3. **Reduced Core load**: orchestration runs locally, Core only carries status/control messages\n4. **Remote management**: UGC broadcast lets users manage builds from any device\n5. **Leverages DockerManager**: container lifecycle already built (build/start/stop/health/UI)\n\n## Dependencies\n- Docker container management DCR (done — D1-D6 complete)\n- ContainerDefinition with environment variable injection (done — DockerManager.start_container passes env vars)\n- Minerva API key infrastructure (exists in Preferences)\n- UGC service integration (existing Core service, needs client-side registration)\n\n## Implementation sketch\n1. Create autocoder Dockerfile (opencode + orchestrator)\n2. Register as builtin ContainerDefinition in DockerManager\n3. On container start: read API keys from VoiceConfig/Preferences, inject as env vars\n4. Add autocoder-specific MCP tools (start build, check status, get logs)\n5. UGC registration: broadcast container availability to Core for remote access\n6. Mobile-friendly status page via UGC consumer (build progress, logs, results)','\n',char(10)),'2026-03-16T16:30:19','2026-03-16T16:30:19','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfa98c5737d6a8d76a66b9bd68950','work_item','backlog','Voice UX polish: warm-up button, summary prompt customization, summary context control',replace('Three improvements from first usability test of always-listening voice mode:\n\n1. Warm-up button: cold starts are slow (model loading on gpu-node). Add a "Warm Up" button in Voice Preferences that sends a pre-warm request to gpu-dispatch, reserving containers and loading STT/TTS/LLM models before the user starts speaking. Visual feedback: warming → ready.\n\n2. Summary prompt customization: the summarize-then-speak prompt is hardcoded in VoiceServiceClient.summarize_for_speech(). Expose it in Voice Preferences as a text area so users can tweak how the LLM summarizes responses for speech (e.g., "Be more concise", "Focus on the answer, skip caveats").\n\n3. Summary context control: currently summarize_for_speech sends both user text and response text to the summary model. Add a toggle: "Include user message in summary context" (default: on). When off, only the response is sent — useful when the user message doesn''t add context for summarization.','\n',char(10)),'2026-03-17T07:00:41','2026-03-17T07:00:41','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfab48c597943b5bccb1acef24753','work_item','backlog','Auto pre-warm gpu-node when always-listening enabled',replace('When user enables always-listening toggle, send a session reservation + pre-warm request to gpu-dispatch through Core. This loads STT, TTS, and LLM models on the gpu-node before the user speaks, eliminating cold start on first utterance.\n\nFlow: toggle on → start gateway container → send pre-warm via Core (reserve session with containers=[''voice'', ''ollama''], models=[''stt'', ''tts'', ''llm'']) → gpu-node starts containers and loads models → user says "Minerva" → instant response.\n\nInfrastructure exists: session broker in gpu-dispatch, pre-warm handler in gpu-node. Just need to wire from Minerva''s VoiceGatewayClient or ChatPane.','\n',char(10)),'2026-03-17T07:31:02','2026-03-17T07:31:02','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfab4bb397816a5da4b6feceeb5ea','chore','open','Rebuild voice gateway container with /config endpoint','The voice gateway container source was updated with a POST /config endpoint for runtime VAD silence duration changes, but the running container image is stale. Rebuild to pick up changes. Pause tolerance slider won''t work until rebuilt.','2026-03-17T07:31:14','2026-03-17T07:31:14','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfab4ecf67f78a50a5283efd8b824','work_item','backlog','Tune noise rejection: raise energy gate, discard short recordings','Energy gate threshold in voice gateway detector.py is 50 (int16 RMS), too low — ambient noise passes through. Raise to ~200-300. Also discard recordings shorter than 0.5s in VoiceGatewayClient (clicks, bumps, not speech). The _has_speech_energy check (RMS > 200) in GDScript already helps but the gateway-side gate should also be tightened.','2026-03-17T07:31:27','2026-03-17T07:31:27','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfdf5567b773d8ef766ded4d2ea81','work_item','backlog','Contract tests: verify Minerva ↔ minerva-services message format agreement',replace('Create an external contract test suite that validates message format agreement between Minerva (Godot client) and minerva-services (backend services). Lives outside both codebases. Catches format mismatches before they reach users.\n\nMotivation: Three bugs in one session caused by contract disagreements — voice UUID vs name, pre-warm models dict vs string, STT model field confused with ollama model. None had test coverage.\n\n## 1. What minerva-services contracts does Minerva depend on?\n\n**voice-service (via Core):**\n- voice/stt/transcribe — request: {audio_base64, language, backend, model?}, response: {text, language?, segments?}\n- voice/tts/synthesize — request: {text, voice_id, backend?}, response: binary transfer (Format A) OR {audio_base64}\n- voice/voices/list — request: {backend?}, response: {voices: [{id, name, backend_family, available_backends, capabilities}]}\n- voice/manage/status — request: {}, response: {backends: {...}}\n\n**gpu-dispatch (via Core):**\n- gpu-dispatch/session/reserve — request: {job_types, containers, models: {stt: {model, backend}, tts: {backend}, llm: {}}, keep_warm_seconds}, response: {node_id, session_id, warm}\n- gpu-dispatch/session/heartbeat — request: {session_id}, response: {status}\n- gpu-dispatch/session/release — request: {session_id}, response: {status}\n\n**model-chat (via Core):**\n- model-chat/<model_name> — request: {messages: [{role, content}], ...}, response: {choices: [{message: {role, content}}]} (OpenAI-compatible)\n\n**media-gen (via Core):**\n- media_gen/generate — request: {prompt, ...}, response: binary transfer (Format B) with image files\n\n**Core system:**\n- system/discover — response: {services: [{client_id, name, actions: [{name, topic}]}]}\n- Binary transfer frames: Format A (voice), Format B (media-gen/artifacts)\n\n## 2. Current Minerva contract definitions (client-side)\n\nLocated in GDScript across:\n- VoiceServiceClient.gd — voice-service request/response shapes\n- ChatPane.gd / provider scripts — model-chat request shapes\n- core_client.gd — binary transfer frame parsing, system/discover\n- Implicit in VoiceConfig.gd — what fields are saved and sent (voice_id vs voice_name, stt_model, tts_backend)\n\nNo formal schema. Message shapes are embedded in code: `data["audio_base64"]`, `result.get("text")`, etc.\n\n## 3. minerva-services contract definitions (server-side, source of truth)\n\nLocated in Python across:\n- voice-service.py — topic handlers, request validation, response construction\n- gpu-dispatch.py — session/reserve handler, pre-warm forwarding, model field parsing\n- gpu-node.py — pre-warm handler (models dict shape), voice_service.py (TTS/STT proxy)\n- model-chat service — OpenAI-compatible chat completion format\n- BaseService binary protocol (service.py) — Format A frame layout\n- gpu-node binary_protocol.py — Format B frame layout\n\nminerva-services is source of truth: if the server changes a field name, Minerva must follow.\n\n## 4. When a contract is updated, how does Minerva see the update?\n\nCurrently: Minerva doesn''t see it. There is no notification mechanism. A backend developer changes a field in voice-service.py, deploys, and Minerva breaks silently (returns empty audio, wrong format, etc.). Discovery only happens during manual testing.\n\nDesired: Contract schema files (JSON Schema) live in a shared location (contracts repo or minerva-services repo). When a backend developer changes a message format, they update the schema. CI runs contract tests against both sides. Minerva developer sees the schema change and updates GDScript accordingly.\n\nPossible mechanisms:\n- Shared git submodule with schema files\n- Schema files in minerva-services repo, Minerva CI pulls and validates\n- Contract test repo that both projects'' CI pipelines trigger\n- Version field in message headers (future: format negotiation)\n\n## 5. How can the test independently verify both sides?\n\n**Server-side verification (runs against live minerva-services):**\nExternal Python test suite connects to Core as a fake Minerva client. For each contract:\n- Sends a request in the schema-defined format\n- Verifies the response matches the schema (field presence, types, binary transfer format)\n- Tests edge cases: optional fields omitted, voice name vs UUID, empty model field\n- Runs after any minerva-services deployment\n\n**Client-side verification (runs against Minerva codebase):**\nGDScript unit tests (or static analysis) that verify:\n- Request construction matches the schema (correct field names, types, nesting)\n- Response parsing handles all schema-defined fields\n- Fallback behavior when optional fields are missing\n- Binary transfer frame parsing matches Format A/B specs\n\n**Both-side verification (integration):**\nFull round-trip test: contract test sends request through Core → minerva-services processes → response returns → verify response matches schema. This tests the actual deployed system, not mocks.\n\n**Schema as shared artifact:**\n```\ncontracts/\n  schemas/\n    voice/\n      stt_transcribe_request.json\n      stt_transcribe_response.json\n      tts_synthesize_request.json\n      tts_synthesize_response.json    (includes binary transfer variant)\n      voices_list_request.json\n      voices_list_response.json\n    dispatch/\n      session_reserve_request.json\n      session_reserve_response.json\n      prewarm_request.json\n    model_chat/\n      chat_completion_request.json\n      chat_completion_response.json\n    binary_transfer/\n      format_a.json                   (voice: frame layout, field sizes)\n      format_b.json                   (media-gen: frame layout, field sizes)\n  tests/\n    conftest.py                       (Core connection fixture, auth)\n    test_voice_contracts.py\n    test_dispatch_contracts.py\n    test_model_chat_contracts.py\n    test_binary_transfer_contracts.py\n  golden_messages/\n    voice_tts_request_with_name.json  (known-good request)\n    voice_tts_request_with_uuid.json  (known-good request, legacy)\n    prewarm_request.json              (known-good request)\n```\n\n## Implementation order\n1. Audit: extract current implicit contracts from both codebases\n2. Write JSON Schema files for each contract\n3. Build Python test harness (Core connection, send/receive, schema validation)\n4. Write contract tests for voice-service (highest recent bug rate)\n5. Write contract tests for gpu-dispatch (pre-warm, session)\n6. Write contract tests for model-chat\n7. Write contract tests for binary transfer formats\n8. Wire into CI for both repos','\n',char(10)),'2026-03-17T22:40:40','2026-03-17T22:40:40','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019cfe1b8d8e744caf99952b53b4e496','dcr','proposed','Refactor TTS to signal-based audio delivery: speak() + audio_ready signal',replace('Replace the current await-and-poll TTS pattern with Godot-idiomatic signal-based audio delivery.\n\n## Current design (problematic)\n```\ncaller → await synthesize() → get bytes → load_audio_into_stream() → play\n```\n- Callers deal with raw bytes, format detection (WAV vs PCM), polling loops\n- Binary vs base64 path leaks into caller code\n- synthesize() has a 120s polling loop that blocks the coroutine\n- Every caller duplicates stream loading logic (was duplicated in ChatPane + PreferencesPopup until consolidated)\n\n## Proposed design (signal-based)\n```\ncaller → voice_client.speak(text, voice, backend)   # fire and forget\nVoiceServiceClient handles binary/base64/format internally\nVoiceServiceClient emits audio_ready(stream: AudioStreamWAV, request_id: String)\ncaller''s connected handler → play the stream\n```\n\n## Changes\n- VoiceServiceClient: new `speak()` method (public), `synthesize()` becomes internal\n- VoiceServiceClient: new `audio_ready` signal carrying a ready-to-play AudioStreamWAV\n- VoiceServiceClient: binary transfer and base64 handling stay internal, callers never see bytes\n- VoiceServiceClient: `load_audio_into_stream()` called internally before emitting signal\n- ChatPane._voice_speak_response: connects to audio_ready, plays stream. No await, no bytes.\n- PreferencesPopup preview: connects to audio_ready for one-shot playback\n- Future: streaming TTS (emit audio chunks as they arrive) fits naturally into this pattern\n\n## Benefits\n- Single responsibility: VoiceServiceClient owns all audio format handling\n- Callers are decoupled from transport (binary vs base64) and format (WAV vs PCM)\n- No polling loops in caller code\n- Adding new audio formats or transport modes requires zero caller changes\n- Follows Godot signal convention used throughout the codebase','\n',char(10)),'2026-03-17T23:22:24','2026-03-17T23:22:24','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d17be393b7cc1a0cecca905d8d6fe','bug','resolved','Terminal output diagonal — LF without CR due to OPOST disabled on PTY master',replace('## Summary\n\nTerminal output renders diagonally — each new line starts at the column where the previous line ended instead of returning to column 0. This is because `OPOST` is cleared on the PTY master''s termios settings, which disables `ONLCR` (the kernel''s `\n` → `\r\n` translation).\n\n## Root Cause\n\nIn `unix/terminal.cpp` line 671:\n```cpp\nterm_settings.c_oflag &= ~(OPOST);\n```\n\nThis disables all output post-processing, including `ONLCR`. Programs like `ls` emit bare `\n` (LF), expecting the PTY driver to prepend `\r` (CR). With `OPOST` off, ghostty-vt receives only LF, which moves the cursor down one row but does NOT reset to column 0.\n\n## Fix\n\nRemove the `OPOST` clearing (or at minimum preserve `ONLCR`). Real terminal emulators (Ghostty, iTerm2, xterm) all expect `ONLCR` to be active on the PTY.','\n',char(10)),'2026-03-22T22:50:35','2026-03-22T23:31:21','','ClaudeCode','',1,2,'fixed','macOS 26.2, Godot 4.6.1, libghostty-vt',replace('1. Launch Minerva, open a terminal tab\n2. Type `ls -l` and press Enter\n3. Each output line starts where the previous line ended — diagonal staircase pattern\n4. Same with any command that produces multi-line output','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d17fd9adb7d2182e2ad388cded02f','dcr','designing','Terminal Preferences pane: color themes, font, scrollback, cursor settings',replace('## Summary\n\nAdd a Terminal tab to the Preferences popup with configurable settings for the built-in terminal emulator. Settings persist to config_file.cfg.\n\n## Settings\n\n1. **Color Theme**: Preset palettes (Default, Solarized Dark, Dracula, Nord, Monokai, custom) for the 16 ANSI colors + default fg/bg\n2. **Font**: Family picker (CascadiaMono, CascadiaMonoNF, system monospace), size slider\n3. **Scrollback**: Buffer line count (500, 1000, 5000, 10000, unlimited)\n4. **Cursor**: Style (block/bar/underline), blink toggle\n5. **Default foreground/background colors**: Independent of theme preset\n\n## Motivation\n\nDark blue directories on black background have poor contrast. Users need to customize terminal appearance to their preference and display conditions. Font size/family affects readability. Scrollback affects memory usage vs history availability.','\n',char(10)),'2026-03-22T23:59:49','2026-03-23T00:33:15','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d17fdc35973ff84f261695cf20c29','work_item','active','Implementation plan: Terminal Preferences pane',replace('## Implementation Plan\n\nPhased approach to add terminal settings to Minerva''s Preferences popup. Each phase is a child work item.\n\n### Phase 1: TerminalConfig data model + persistence\nData class for all terminal settings, load/save to config_file.cfg, signal on change.\n\n### Phase 2: Color theme presets\nDefine 5-6 built-in palettes as static dictionaries. TerminalConfig stores selected theme name + custom overrides.\n\n### Phase 3: Preferences UI — Terminal tab\nAdd Terminal tab to PreferencesPopup with controls for all settings. Wire to TerminalConfig.\n\n### Phase 4: Apply settings to TerminalNew\nTerminalNew reads TerminalConfig on ready and reacts to setting changes in real time.\n\n### Phase 5: Automated tests\nGDScript unit tests for TerminalConfig persistence, palette resolution, theme switching, and font metric updates.\n\n### Dependencies\n- Existing PreferencesPopup tab infrastructure\n- TerminalNew.gd palette, font, cursor systems\n- SingletonObject config persistence','\n',char(10)),'2026-03-22T23:59:59','2026-03-23T00:02:30','','ClaudeCode','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fd9adb7d2182e2ad388cded02f',NULL);
INSERT INTO items VALUES('019d17fdfa6d7488864a7004fa46fb41','work_item','done','T1: TerminalConfig data model and persistence',replace('Create `TerminalConfig` RefCounted class in `src/Scripts/Models/`.\n\n**Properties (all with setget + signal):**\n- `theme_name: String` — preset name or "custom" (default: "default")\n- `custom_palette: PackedColorArray` — 16 ANSI colors (used when theme_name == "custom")\n- `default_fg: Color` — default foreground (default: Color.WHITE)\n- `default_bg: Color` — default background (default: Color.BLACK)\n- `font_family: String` — resource path (default: "res://assets/fonts/CascadiaCode/CascadiaMono.ttf")\n- `font_size: int` — in points (default: ThemeDB.fallback_font_size)\n- `scrollback_lines: int` — (default: 5000, -1 = unlimited)\n- `cursor_style: int` — 0=block, 1=bar, 2=underline (default: 0)\n- `cursor_blink: bool` — (default: true)\n\n**Signals:**\n- `settings_changed` — emitted on any property change\n\n**Methods:**\n- `save(config: ConfigFile, section: String)` — write all properties\n- `load(config: ConfigFile, section: String)` — read all properties with defaults\n- `get_active_palette() -> PackedColorArray` — returns preset palette or custom palette\n- `get_font() -> Font` — loads and returns the Font resource\n\n**Persistence:**\n- Section: `[terminal]` in `user://config_file.cfg`\n- Load in SingletonObject._ready(), save on change\n\n**Key files:**\n- New: `src/Scripts/Models/terminal_config.gd`\n- Modify: `src/Scripts/Models/singleton_object.gd` — add `terminal_config: TerminalConfig` property, load/save calls','\n',char(10)),'2026-03-23T00:00:13','2026-03-23T00:11:03','','ClaudeCode','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fdc35973ff84f261695cf20c29',NULL);
INSERT INTO items VALUES('019d17fe219e7cc98dc8797f125c8dd3','work_item','done','T2: Color theme presets',replace('Define built-in terminal color palettes as static data.\n\n**Presets (each is a Dictionary with 16 ANSI colors + default_fg + default_bg):**\n1. **Default** — current palette from TerminalNew._init_palette() with brighter blue (fix contrast)\n2. **Solarized Dark** — Ethan Schoonover''s palette on dark base03 background\n3. **Dracula** — purple-tinted dark theme\n4. **Nord** — Arctic blue-gray palette\n5. **Monokai** — warm dark theme\n6. **Light** — dark-on-white for light environments\n\n**Implementation:**\n- New: `src/Scripts/Models/terminal_themes.gd` — static class with `const THEMES: Dictionary`\n- Each theme entry: `{"name": "...", "palette": PackedColorArray[16], "fg": Color, "bg": Color}`\n- `static func get_theme(name: String) -> Dictionary`\n- `static func list_themes() -> PackedStringArray`\n\n**Source:** Use exact RGB values from each theme''s official spec. All values hardcoded — no external files.','\n',char(10)),'2026-03-23T00:00:23','2026-03-23T00:11:08','','ClaudeCode','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fdc35973ff84f261695cf20c29',NULL);
INSERT INTO items VALUES('019d17fe4f74709b83b5b9b685aebb05','work_item','done','T3: Preferences UI — Terminal tab',replace('Add a "Terminal" tab to PreferencesPopup with controls for all TerminalConfig settings.\n\n**UI Layout (top to bottom):**\n\n1. **Theme section**\n   - Label: "Color Theme"\n   - OptionButton: dropdown of preset names from terminal_themes.gd + "Custom"\n   - 16 ColorPickerButton grid (2 rows x 8) — shows active palette, editable when "Custom" selected\n   - Two ColorPickerButtons for default fg/bg\n\n2. **Font section**\n   - Label: "Font"\n   - OptionButton: font family picker (scan res://assets/fonts/CascadiaCode/ for .ttf files)\n   - HSlider + SpinBox: font size (8–32, step 1)\n   - Label: preview text "The quick brown fox jumps over the lazy dog" rendered in selected font\n\n3. **Scrollback section**\n   - Label: "Scrollback Lines"\n   - OptionButton: 500 / 1000 / 5000 / 10000 / Unlimited\n\n4. **Cursor section**\n   - Label: "Cursor Style"\n   - OptionButton: Block / Bar / Underline\n   - CheckBox: "Blink cursor"\n\n**Wiring:**\n- On any control change → update TerminalConfig → triggers settings_changed signal\n- On tab shown → populate controls from current TerminalConfig\n- Theme dropdown change → load preset palette into color pickers\n\n**Key files:**\n- Modify: `src/Scripts/UI/Popups/preferences_popup.gd` — add Terminal tab\n- Pattern: Follow existing Voice/Tools tab implementation','\n',char(10)),'2026-03-23T00:00:35','2026-03-23T00:11:15','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fdc35973ff84f261695cf20c29',NULL);
INSERT INTO items VALUES('019d17fe834c7790acd6bbe5e73c5cd6','work_item','done','T4: Apply settings to TerminalNew at runtime',replace('Wire TerminalConfig.settings_changed to TerminalNew so changes apply in real time.\n\n**On settings_changed:**\n1. **Palette** — rebuild `_palette` array from `TerminalConfig.get_active_palette()` + 216 cube + 24 grayscale. Replace `_init_palette()` body with config-driven version.\n2. **Default fg/bg** — store as instance vars, use in resolve_color() fallback and TextLayer background clear.\n3. **Font** — load new Font resource, update `font`, call `_update_font_metrics()`, `_recalc_terminal_size()`, `terminal.resize()`, `queue_redraw()`.\n4. **Scrollback** — call ghostty-vt resize or set scrollback page limit (if API exists; otherwise store for next terminal creation).\n5. **Cursor style** — set via ghostty-vt `terminal.setCursorStyle()` or local CursorLayer rendering switch.\n6. **Cursor blink** — toggle CursorLayer blink timer.\n\n**On _ready():**\n- Read initial settings from SingletonObject.terminal_config\n- Connect settings_changed signal\n- Apply all settings once\n\n**Background clear:**\n- TextLayer._draw() should clear with default_bg color before drawing cells (currently transparent).\n\n**Key files:**\n- Modify: `src/Scripts/UI/Controls/TerminalNew.gd`','\n',char(10)),'2026-03-23T00:00:48','2026-03-23T00:11:22','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fdc35973ff84f261695cf20c29',NULL);
INSERT INTO items VALUES('019d17feb0807e91a5e40c53c1f138c8','work_item','done','T5: Automated tests for terminal preferences',replace('GDScript unit tests for the terminal preferences system. Follow existing test pattern in `src/test/`.\n\n**Test cases:**\n\n1. **TerminalConfig defaults** — new instance has expected default values for all properties\n2. **TerminalConfig save/load roundtrip** — set non-default values, save to ConfigFile, create new instance, load, verify all values match\n3. **TerminalConfig signal emission** — changing any property emits settings_changed exactly once\n4. **Theme presets** — every preset name in terminal_themes.gd returns a valid dict with 16-color palette + fg + bg\n5. **get_active_palette()** — returns preset palette when theme_name is a preset, returns custom_palette when "custom"\n6. **Palette structure** — active palette always has exactly 256 entries (16 ANSI + 216 cube + 24 grayscale)\n7. **Font loading** — get_font() returns a valid Font resource for each available font family\n8. **Invalid theme name** — falls back to "default" gracefully\n9. **Scrollback bounds** — values clamped to valid range (min 100, or -1 for unlimited)\n10. **Config migration** — missing keys in old config files get defaults, don''t crash\n\n**Key files:**\n- New: `src/test/test_terminal_config.gd`\n- Pattern: Follow `src/test/test_agent_definition.gd` structure','\n',char(10)),'2026-03-23T00:01:00','2026-03-23T00:11:29','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fdc35973ff84f261695cf20c29',NULL);
INSERT INTO items VALUES('019d17ff090d716c85a4908179a4a373','chore','open','Manual test: Terminal Preferences end-to-end',replace('Manual verification of terminal preferences after all tasks complete.\n\n**Setup:** Minerva running from Godot editor with terminal extension built.\n\n**Steps:**\n1. Open Preferences, verify Terminal tab exists\n2. Change color theme to Dracula — terminal immediately updates\n3. Run `ls --color` — directories use theme''s blue\n4. Run `printf ''\\033[31mRED \\033[32mGREEN \\033[34mBLUE \\033[0m\\n''` — colors match theme\n5. Switch to Solarized Dark — palette changes live\n6. Select "Custom", modify blue color picker — terminal updates\n7. Change font to CascadiaMonoNF — Nerd Font glyphs render\n8. Change font size to 20 — terminal resizes, text larger\n9. Change font size to 10 — more cols/rows visible\n10. Change scrollback to 500, run long command, scroll up — limited history\n11. Change cursor to Bar — shape changes\n12. Toggle blink off — cursor stops blinking\n13. Close and reopen Minerva — all settings persisted\n14. Open second terminal tab — inherits current settings\n\n**Expected:** All settings apply in real time, persist across restart, apply to new tabs.','\n',char(10)),'2026-03-23T00:01:23','2026-03-23T00:01:23','','Imran','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d17fd9adb7d2182e2ad388cded02f',NULL);
INSERT INTO items VALUES('019d181c5c7871d882855b55644f0805','bug','resolved','Terminal scrollback broken — scroll window fixed to exactly 1 screen height',replace('The terminal ScrollContainer only allows scrolling the current viewport height. No scrollback history is accessible. TextLayer.custom_minimum_size.y is set to `rows * lh` (visible rows only), so the scrollable area equals the visible area.\n\nghostty-vt maintains a scrollback buffer and has `minerva_vt_scroll_viewport()` for navigating it, but the current rendering only queries the visible viewport rows. Need to either:\n1. Use ghostty-vt''s viewport scrolling on scroll events (query different viewport offsets), or\n2. Query total scrollback rows and render them all into a taller TextLayer','\n',char(10)),'2026-03-23T00:33:25','2026-03-23T00:55:59','','ClaudeCode','',2,2,'fixed',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d181c6596780cbaef0b9fdcbab136','bug','closed','Terminal Delete key acts as Backspace instead of forward-delete','Pressing Delete in the terminal sends a backspace sequence instead of the forward-delete (CSI 3~) sequence. Likely a key mapping issue in the Godot-to-ghostty key encoder mapping in TerminalNew.gd.','2026-03-23T00:33:27','2026-03-23T00:38:32','','ClaudeCode','',3,3,'not_a_bug',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d184443587c869343556dd49c978d','dcr','proposed','Terminal-to-chat injection: block selection, range marking, and tab targeting',replace('## Summary\n\nRestore and enhance the terminal-to-chat injection capability lost during the ghostty-vt migration. Users need to send terminal command+output blocks into chat conversations as context for LLM interactions.\n\n## Problem\n\n1. **Lost feature**: The old terminal had gutter checkbuttons for injecting terminal blocks into chat. These stopped working after the ghostty-vt migration.\n2. **Context overflow**: Commands like `find .` or `git log` produce output that easily exceeds LLM context windows. Users need surgical control over what gets injected — not just full blocks.\n3. **Multi-tab targeting**: Minerva now has multiple chat tabs. Injection needs to target a specific tab, not just the active one.\n\n## Proposed Solution\n\n### Block detection + gutter controls\nShell prompt markers segment output into command blocks. Each block gets a gutter checkbox to toggle inclusion. Blocks can be collapsed to show first/last N lines.\n\n### Mark-in / Mark-out range selection\nFor partial block injection: Shift+click two points → marked range (green highlight). Multiple ranges per block. Only marked ranges get injected if any exist, otherwise full block.\n\n### Tab targeting\nPopup picker listing open chat tabs by name. Default to active tab. Option to create new tab.\n\n### Context budget awareness\nToken estimate shown before injection. Warning if injection exceeds threshold. Encourages using marked ranges for large outputs.\n\n### Injection format\nWrapped in terminal code fence with command line visible:\n```\n\`\`\`terminal\n$ command-here\nselected output lines...\n\`\`\`\n```','\n',char(10)),'2026-03-23T01:17:00','2026-03-23T01:17:00','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d1844746e73299344d4e787a5648b','insight','draft','Context management problem: terminal injection can silently overflow LLM context',replace('Terminal commands routinely produce output that exceeds LLM context windows. A single `find .` in a large repo can produce 50K+ lines (~200K tokens). Users injecting terminal blocks into chat have no visibility into the context cost until the LLM silently truncates or errors.\n\n**Key observations:**\n- Users think in "blocks" (one command = one unit) but blocks vary from 1 line to 100K+ lines\n- The natural action (check a block, inject) has no guardrails for size\n- Truncation by the LLM is invisible — users don''t know they lost context\n- Mark-in/mark-out is the mitigation but adds friction\n\n**Implications for design:**\n- Must show token count before injection, not after\n- Should default to collapsed view for blocks over N lines, forcing conscious expansion\n- Consider auto-summarization: for blocks over threshold, offer "inject summary instead" using a fast model\n- The context budget display should show cumulative cost of all checked blocks, not just individual','\n',char(10)),'2026-03-23T01:17:12','2026-03-23T01:17:12','','','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d184443587c869343556dd49c978d',NULL);
INSERT INTO items VALUES('019d1844a3f47dd78f920920a22469b9','work_item','done','Implementation plan: Terminal-to-chat injection',replace('## Implementation Plan\n\nPhased approach to restore and enhance terminal-to-chat injection. Each phase is a child work item.\n\n### Phase 1: Block detection and gutter checkboxes\nRestore shell prompt-based block segmentation. Re-enable gutter checkbuttons that appear at each prompt boundary. Track checked blocks as pending injection content.\n\n### Phase 2: Injection action with tab picker\nAdd "Send to Chat" button/shortcut that assembles checked blocks into terminal code fences and injects into a selected chat tab. Popup lists all open chat tabs.\n\n### Phase 3: Mark-in / Mark-out range selection\nAdd Shift+click range marking (distinct from copy selection). Multiple ranges per block. Ranges override full-block injection for their parent block.\n\n### Phase 4: Context budget display and warnings\nToken estimation for pending injection. Cumulative display in gutter area. Warning when injection exceeds configurable threshold. Auto-collapse for large blocks.\n\n### Phase 5: Tests\nAutomated tests for block detection, range assembly, injection formatting. Manual test for full end-to-end flow.\n\n### Dependencies\n- Shell prompt markers (on_shell_prompt_start/end) — already working\n- ghostty-vt get_cell/get_plain_text — already available\n- Chat system injection API (SingletonObject chat management) — exists','\n',char(10)),'2026-03-23T01:17:24','2026-03-23T03:08:40','','ClaudeCode','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d184443587c869343556dd49c978d',NULL);
INSERT INTO items VALUES('019d1844d7637a29851743bd72c2bf42','work_item','done','T1: Block detection and gutter checkboxes',replace('Restore shell prompt-based block segmentation and gutter controls.\n\n**Block model:**\n- `TerminalBlock`: RefCounted with `command: String`, `start_row: int`, `end_row: int`, `checked: bool`\n- Array of blocks maintained in TerminalNew, updated on prompt signals\n- `on_shell_prompt_start` → finalize previous block''s end_row, start new block\n- `on_shell_prompt_end` → record command line from cursor row\n\n**Gutter checkboxes:**\n- `_check_buttons_container` already exists (32px wide, currently hidden)\n- Make visible, position CheckButton at each block''s start_row * line_height\n- Toggle sets block.checked\n- Visual: checked blocks get a subtle highlight band in TextLayer\n\n**Extracting block text:**\n- `get_block_text(block) -> String`: iterate get_cell() from start_row to end_row, build text\n- First line = command, remaining = output\n\n**Key files:**\n- New: `src/Scripts/Models/terminal_block.gd`\n- Modify: `src/Scripts/UI/Controls/TerminalNew.gd` — block tracking, gutter visibility, prompt signal handlers','\n',char(10)),'2026-03-23T01:17:38','2026-03-23T01:23:16','','ClaudeCode','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1844a3f47dd78f920920a22469b9',NULL);
INSERT INTO items VALUES('019d184508167c27845470f4bcce09c7','work_item','done','T2: Injection action with chat tab picker',replace('Add "Send to Chat" action that assembles checked blocks and injects into a selected chat tab.\n\n**Assembly:**\n- Iterate checked blocks in order\n- For each block: format as terminal code fence with `$ command` header\n- Concatenate all blocks with blank line separator\n\n**Tab picker popup:**\n- Small PopupMenu or Window listing open chat tabs from SingletonObject.ChatHistories\n- Show tab name/title for each\n- Default selection = active chat tab\n- "New Chat" option at bottom\n- On selection: inject assembled text as a user message or append to input field\n\n**Injection target:**\n- Option A: Append to chat input TextEdit (user reviews before sending)\n- Option B: Send directly as a message\n- Prefer Option A for safety — user confirms before sending\n\n**Trigger:**\n- Button in terminal toolbar/gutter area: "→ Chat" or icon\n- Keyboard shortcut: Ctrl+Shift+Enter\n- Only enabled when ≥1 block is checked\n\n**Key files:**\n- Modify: `src/Scripts/UI/Controls/TerminalNew.gd` — add inject button, assembly logic\n- Read: `src/Scripts/Models/singleton_object.gd` — ChatHistories access\n- Modify: Chat input TextEdit — accept injected text','\n',char(10)),'2026-03-23T01:17:50','2026-03-23T01:26:36','','ClaudeCode','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1844a3f47dd78f920920a22469b9',NULL);
INSERT INTO items VALUES('019d184535027fdb9a0675691f7454ea','work_item','done','T3: Mark-in / Mark-out range selection',replace('Add Shift+click range marking for partial block injection.\n\n**Range model:**\n- `TerminalRange`: start_row, end_row, parent_block reference\n- Stored as array on each TerminalBlock: `marked_ranges: Array[TerminalRange]`\n- When ranges exist on a block, injection uses only the marked lines (not full block)\n\n**UX:**\n- Shift+click in terminal = set mark-in point (row). Visual: green arrow in gutter\n- Shift+click again = set mark-out point. Visual: green band between marks\n- Range highlight: green tint on marked rows in TextLayer (distinct from blue selection)\n- Click existing mark to remove it\n- Multiple ranges per block allowed (Shift+click after closing a range starts a new one)\n\n**Integration with injection:**\n- `get_block_text(block)` checks block.marked_ranges\n- If ranges exist: extract only those row spans\n- If no ranges: extract full block (existing behavior)\n- Injection format includes `[... N lines omitted ...]` markers between non-contiguous ranges\n\n**Key files:**\n- Modify: `src/Scripts/Models/terminal_block.gd` — add marked_ranges\n- Modify: `src/Scripts/UI/Controls/TerminalNew.gd` — Shift+click handler, range highlight rendering','\n',char(10)),'2026-03-23T01:18:01','2026-03-23T01:26:38','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1844a3f47dd78f920920a22469b9',NULL);
INSERT INTO items VALUES('019d184564aa7b49a5677b7644129bf2','work_item','done','T4: Context budget display and warnings',replace('Show token estimate for pending injection and warn on overflow.\n\n**Token estimation:**\n- Rough estimate: chars / 4 (standard approximation for English text)\n- Display in gutter footer or near inject button: "~2.4K tokens (3 blocks)"\n- Update live as blocks are checked/unchecked and ranges are added\n\n**Threshold warning:**\n- Configurable threshold (default: 8K tokens, stored in TerminalConfig)\n- When estimate exceeds threshold: inject button turns amber, tooltip warns\n- Over 2x threshold: inject button turns red, shows "Consider using mark-in/mark-out"\n\n**Auto-collapse for large blocks:**\n- Blocks with >50 lines of output: auto-collapse in gutter display\n- Collapsed view shows: "$ command" + first 3 lines + "... 847 lines ..." + last 3 lines\n- Click to expand/collapse\n- Collapsed blocks still inject full content unless ranges are set\n\n**Key files:**\n- Modify: `src/Scripts/UI/Controls/TerminalNew.gd` — token counter, warning UI\n- Modify: `src/Scripts/Models/terminal_config.gd` — add injection_token_threshold setting','\n',char(10)),'2026-03-23T01:18:14','2026-03-23T01:26:39','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1844a3f47dd78f920920a22469b9',NULL);
INSERT INTO items VALUES('019d18459688794dbe04abd66910bfe6','work_item','done','T5: Automated and manual tests for terminal injection',replace('**Automated tests (test_terminal_injection.gd):**\n1. TerminalBlock defaults — new block has empty command, unchecked, no ranges\n2. Block text extraction — mock cell data, verify get_block_text output\n3. Injection formatting — single block wraps in terminal code fence with $ prefix\n4. Multi-block assembly — multiple checked blocks separated by blank lines\n5. Range extraction — block with marked ranges only includes those rows\n6. Range omission markers — non-contiguous ranges show [... N lines omitted ...]\n7. Token estimation — verify chars/4 approximation for known strings\n8. Unchecked blocks excluded — only checked blocks appear in assembly\n\n**Manual test checklist:**\n1. Run `ls -la` → checkbox appears in gutter at prompt\n2. Check the checkbox → block highlights\n3. Run `echo hello` → second checkbox appears\n4. Click "→ Chat" → tab picker shows all open chats\n5. Select a tab → terminal code fence appears in chat input\n6. Shift+click two rows in ls output → green range highlight\n7. Inject → only marked range included, with omission markers\n8. Token count updates as blocks checked/unchecked\n9. Run `find /` (large output) → warning appears on inject button\n\n**Key files:**\n- New: `src/test/test_terminal_injection.gd`','\n',char(10)),'2026-03-23T01:18:26','2026-03-23T03:08:51','','ClaudeCode','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1844a3f47dd78f920920a22469b9',NULL);
INSERT INTO items VALUES('019d1845c03375a987f9afa562721d49','chore','open','Manual test: Terminal injection end-to-end',replace('Full end-to-end manual verification after all injection tasks complete.\n\n**Steps:**\n1. Open terminal, run `ls -la` → gutter checkbox appears\n2. Run `echo hello world` → second checkbox\n3. Check both checkboxes → blocks highlight\n4. Click "→ Chat" → tab picker popup\n5. Select active chat tab → code fences appear in chat input\n6. Verify format: \`\`\`terminal with $ prefix on commands\n7. Clear, run `find . -name "*.gd"` (medium output)\n8. Shift+click row 5, Shift+click row 15 → green range\n9. Check block, inject → only rows 5-15 included with omission markers\n10. Token count shows reasonable estimate\n11. Run very long command → amber/red warning on inject button\n12. Inject to a background chat tab → switch to that tab, verify content\n13. Create new chat from picker → new tab created with injection','\n',char(10)),'2026-03-23T01:18:37','2026-03-23T01:18:37','','Imran','',0,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d184443587c869343556dd49c978d',NULL);
INSERT INTO items VALUES('019d1b8765fe7125bcd387b57178c1d4','dcr','approved','Stream Deck integration via WebSocket control channel',replace('Add Stream Deck (Elgato MK.2 / Mini) support to Minerva via a two-part architecture:\n\n1. **StreamDeckServer.gd** (Minerva side): WebSocket server on localhost:7778 that exposes control actions and pushes state updates using existing Godot signals. No polling — event-driven push. Only runs when enabled in Preferences.\n\n2. **Minerva Stream Deck Plugin** (TypeScript, compiled with Bun): Cross-platform plugin that works with both official Elgato software (Windows/Mac) and OpenDeck (Linux). Implements the Elgato Stream Deck WebSocket protocol directly (no @elgato/streamdeck SDK). Compiled to standalone binaries via `bun build --compile` for each platform.\n\n**V1 actions (scope reduced for initial release):**\n- PTT (push-to-talk) — chat-only, toggle mode\n- Input audio device selection (cycle through favorites)\n\n**Key decisions:**\n- Bun compile for standalone binaries — eliminates Node.js runtime dependency\n- Direct WebSocket protocol implementation (no SDK) — simpler, no npm dependency risk\n- Plugin location: `plugins/elgato/` in Minerva repo\n- Cross-compile targets: linux-x64, windows-x64, darwin-arm64\n- Server enabled via Preferences toggle (defaults OFF)\n- Error feedback: showAlert on button, clears on next press\n- Button images via setImage PNG + setTitle text overlay\n- Installation via Tools menu (same pattern as MCP server install)\n- Favorite input devices filter in preferences\n- Friendly PulseAudio device names (2-line display)\n- manifest needs Platform linux + CodePaths with target triples\n- Security: mTLS pairing (future, shared with smart-remote ESP32 pattern)\n- Protocol includes version field for future compatibility\n- Clean state on reconnect — release stale PTT on client disconnect\n\n**Implementation status (as of 2026-03-23):**\nAll v1 work items completed except E2E testing. 80 bun tests passing.\n\n**Current bug:** PTT visual feedback mismatch — Stream Deck shows REC but Minerva app mic button doesn''t change. Root cause: StreamDeckServer._handle_ptt_down() sets AtT.btn=null. Fix: set AtT.btn to chat_pane.find_child(''btnMicrophone'') and AtT.btnStop to find_child(''AudioStop1'').\n\n**Remaining:**\n- Fix PTT visual sync bug\n- Move Stream Deck prefs from Voice tab to Audio & Video tab\n- Remove debug print() from StreamDeckServer.gd\n- E2E testing on Win/Mac\n- Test Tools > Install Plugin on other platforms','\n',char(10)),'2026-03-23T16:29:11','2026-03-23T16:29:17','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d1b9927d37a50a27d593368451804','dcr','approved','Remove foreign checked-in binaries (FCIBs) and rebuild from source',replace('Remove ~27MB of pre-built binary libraries checked into git and update the build process to rebuild them from source.\n\n**Current FCIBs:**\n\n1. **ffmpeg libraries (~25MB across 3 platforms)**\n   - `src/addons/ffmpeg/linux64/` — 2 .so files (2.5MB)\n   - `src/addons/ffmpeg/macos/` — 6 .dylib files (12.7MB)\n   - `src/addons/ffmpeg/win64/` — 8 .dll/.lib files + 1 tilde-prefixed dupe (12.4MB)\n\n2. **Terminal extension Windows build (~390KB)**\n   - `src/bin/libterminal.windows.template_debug.x86_64.dll`\n   - `src/bin/libterminal.windows.template_debug.x86_64.lib`\n\n3. **Windows .obj intermediate build files (~1MB)**\n   - `src/gdextension/terminal/register_types.windows.template_debug.x86_64.obj`\n   - `src/gdextension/terminal/windows/terminal.windows.template_debug.x86_64.obj`\n\n**Goals:**\n- Remove all FCIBs from git tracking\n- Update build-extensions.sh/.ps1 to build or download ffmpeg libraries\n- Add .gitignore rules to prevent re-committing binaries\n- Clean git history of large binaries (optional, via git filter-branch or BFG)\n- Document the build process for each platform\n\n**Approach options for ffmpeg:**\n- Option A: Build from source in build script (complex, slow)\n- Option B: Download pre-built from a release/artifact URL during build (faster, simpler)\n- Option C: Use system package manager (apt/brew/vcpkg) and link dynamically\n\n**Constraints:**\n- Must work on Linux, macOS, and Windows\n- No sudo/admin required for build\n- Build script should handle ffmpeg acquisition automatically','\n',char(10)),'2026-03-23T16:48:35','2026-03-23T16:58:28','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d1b9955457d39bfce7492b5cc2cce','work_item','done','Audit and document all FCIBs with source/rebuild info',replace('For each FCIB, document:\n- Where the source code lives (repo URL, branch, commit)\n- How it was originally built (build commands, dependencies)\n- What Godot GDExtension expects (file names, paths, linking)\n- Whether system packages are viable (apt libavcodec-dev, brew ffmpeg, vcpkg)\n\nKey questions:\n- Is the ffmpeg GDExtension (`libgdffmpeg`) from a public repo or custom? Check for a SConstruct/build system in `src/addons/ffmpeg/`\n- Are the ffmpeg dylibs/DLLs stock ffmpeg or custom-compiled?\n- What ffmpeg version/config was used?\n\nThis research gates all other tasks.','\n',char(10)),'2026-03-23T16:48:46','2026-03-23T17:03:06','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b9965277c91b415e092a6d96142','work_item','done','Remove Windows .obj intermediate files from git',replace('Remove these build intermediates — they are never needed in source control:\n- `src/gdextension/terminal/register_types.windows.template_debug.x86_64.obj`\n- `src/gdextension/terminal/windows/terminal.windows.template_debug.x86_64.obj`\n- `src/addons/ffmpeg/win64/~libgdffmpeg.windows.template_debug.x86_64.dll` (tilde-prefixed temp file)\n\nAdd `.obj` and `~*.dll` patterns to .gitignore.\nRun `git rm --cached` to untrack without deleting local files.','\n',char(10)),'2026-03-23T16:48:50','2026-03-23T17:03:08','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b99733779419b627b5bda26a78d','work_item','done','Remove Windows terminal extension DLL/LIB from git',replace('Remove pre-built Windows terminal extension from git:\n- `src/bin/libterminal.windows.template_debug.x86_64.dll`\n- `src/bin/libterminal.windows.template_debug.x86_64.lib`\n\nThese are already rebuildable via `scons platform=windows` (or `scripts/build-extensions.ps1`).\n\n`src/bin/` is already gitignored but these files were committed before the rule existed. Run `git rm --cached` to untrack.','\n',char(10)),'2026-03-23T16:48:54','2026-03-23T17:03:32','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b998ed27263933a34f543aa80d9','work_item','done','Determine ffmpeg acquisition strategy per platform',replace('Decide how the build script acquires ffmpeg libraries on each platform. Options:\n\n**Linux:**\n- System package: `apt install libavcodec-dev libavformat-dev ...` (requires sudo)\n- Download pre-built from BtbN/FFmpeg-Builds GitHub releases (no sudo)\n- Build from source (slow, complex)\n\n**macOS:**\n- Homebrew: `brew install ffmpeg` (common, no sudo)\n- Download pre-built universal binary\n- Build from source\n\n**Windows:**\n- vcpkg: `vcpkg install ffmpeg`\n- Download pre-built from BtbN or gyan.dev\n- Build from source (complex)\n\n**Also decide:**\n- Do we need the gdffmpeg GDExtension wrapper, or can Godot use ffmpeg directly?\n- Should ffmpeg be bundled in the repo as a git submodule?\n- Should build-extensions.sh handle ffmpeg, or a separate script?\n\nDepends on: FCIB audit (item 1) to understand current ffmpeg usage.','\n',char(10)),'2026-03-23T16:49:01','2026-03-23T17:03:33','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b99a0237b78bdd29f7fb69fdb40','work_item','done','Add ffmpeg acquisition to build scripts',replace('Update build-extensions.sh and build-extensions.ps1 to acquire ffmpeg libraries automatically based on the strategy chosen in the design task.\n\nMust handle:\n- Download/install ffmpeg if not present\n- Build the gdffmpeg GDExtension against installed ffmpeg (if applicable)\n- Copy resulting libraries to the correct paths in src/addons/ffmpeg/\n- Skip if already built/present (incremental builds)\n- Work without sudo/admin\n\nDepends on: ffmpeg strategy decision.','\n',char(10)),'2026-03-23T16:49:06','2026-03-23T17:03:36','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b99af3e7cb7830e14f9fe4b9c86','work_item','done','Remove ffmpeg binaries from git tracking',replace('After the build scripts can acquire ffmpeg, remove all ffmpeg binaries from git:\n\n- `git rm --cached src/addons/ffmpeg/linux64/*.so`\n- `git rm --cached src/addons/ffmpeg/macos/*.dylib`\n- `git rm --cached src/addons/ffmpeg/win64/*.dll src/addons/ffmpeg/win64/*.lib`\n\nAdd gitignore rules for these paths.\n\n**Do this AFTER build scripts work** — otherwise cloning the repo leaves Minerva broken until you run the build script. Coordinate with README update.\n\nDepends on: ffmpeg in build scripts.','\n',char(10)),'2026-03-23T16:49:09','2026-03-23T17:03:37','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b99c81d7cd7a487f2df28574187','work_item','done','Update .gitignore and clean git history (optional)',replace('Final cleanup:\n\n1. Ensure .gitignore covers all binary patterns:\n   - `*.so`, `*.dylib`, `*.dll`, `*.lib`, `*.obj`, `*.a` in relevant paths\n   - `src/addons/ffmpeg/*/` binaries\n   - `src/bin/` (already covered)\n   - `.zig-cache/`, `zig-out/` (already covered)\n\n2. Optional: clean git history with BFG Repo Cleaner or git filter-repo to remove large binaries from pack files. This reduces clone size but requires force-push.\n   - Current repo size with FCIBs in history: check with `git count-objects -vH`\n   - Decision: worth it if history has >100MB of binaries\n\n3. Update README build instructions to note that binaries are not included and must be built.','\n',char(10)),'2026-03-23T16:49:16','2026-03-23T17:10:33','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b99d565704096026a9a33a548dd','work_item','backlog','Verify clean clone + build on all platforms',replace('Fresh clone test on each platform to verify the FCIB-free build works:\n\n1. `git clone --recursive` (no binaries in repo)\n2. Run build script\n3. Launch Minerva — terminal and ffmpeg features work\n\nTest matrix:\n- Linux x86_64\n- macOS arm64 (Apple Silicon)\n- Windows x86_64\n\nThis is the final validation that FCIBs are fully eliminated.','\n',char(10)),'2026-03-23T16:49:19','2026-03-23T16:49:19','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b9b293d7fb4a9a1bedccc7e1818','work_item','done','Update GitHub Actions workflows to build without FCIBs',replace('After FCIBs are removed, the CI pipelines must acquire dependencies and build everything from source.\n\n**Existing workflows:**\n- `.github/workflows/build.yml` — main project build (all platforms, creates GitHub releases)\n- `.github/workflows/minerva-vt.yml` — ghostty-vt shim build (already builds from source with Zig)\n\n**Changes needed for build.yml:**\n- Add ffmpeg acquisition step (matching the strategy from the design task)\n- Ensure `git submodule update --init --recursive` runs (for godot-cpp + vendor/ghostty)\n- Run `scripts/build-extensions.sh` or equivalent steps for the ghostty shim + SCons build\n- Cache ffmpeg downloads and Zig downloads across runs to speed up CI\n- Verify the workflow still produces valid release artifacts\n\n**Changes needed for minerva-vt.yml:**\n- Likely minimal — already builds from source\n- Verify the `link_libc = true` fix is picked up\n\n**Caching strategy:**\n- Cache Zig toolchain by version\n- Cache ffmpeg pre-built downloads by version/platform\n- Cache godot-cpp build artifacts by commit hash (already expensive to build)\n\n**Test:** Trigger workflow_dispatch on both workflows after changes, verify all platform builds succeed.\n\nBlocked by: items 5 and 6 (ffmpeg in build scripts, binaries removed)','\n',char(10)),'2026-03-23T16:50:46','2026-03-23T17:10:35','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b9fbda2734980de22d5928c4448','work_item','done','Document all external libraries in README with purpose and acquisition',replace('Add a "Dependencies" or "External Libraries" section to the README listing every external library Minerva uses.\n\nFor each library, document:\n- **Name and version**\n- **What it does / why Minerva needs it**\n- **License** (must be permissive — MIT, BSD, Apache 2.0, Zlib, etc.)\n- **How to acquire** (build script, system package, submodule, etc.)\n- **Source URL** (repo or download)\n\nKnown external dependencies to document:\n- godot-cpp (Godot GDExtension C++ bindings) — submodule\n- ghostty / libghostty-vt (terminal emulator core) — submodule + Zig shim\n- ffmpeg (libavcodec, libavformat, etc.) — video/audio codec support\n- gdffmpeg (Godot ffmpeg GDExtension wrapper) — builds against ffmpeg\n- uucode (Unicode grapheme break tables, used by ghostty) — Zig dependency\n- Bun (Stream Deck plugin compiler) — user-local install\n- Any other libraries discovered during the FCIB audit\n\nDepends on: FCIB audit (item 1) for complete inventory.','\n',char(10)),'2026-03-23T16:55:46','2026-03-23T17:13:03','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b9fdf3a73f5ac64ef271de10359','work_item','done','Add Help → About dialog with library attributions and licenses',replace('Add or update Help → About in Minerva to include proper attribution for all external libraries.\n\n**Contents:**\n- Minerva version, build info\n- List of all external libraries with:\n  - Name + version\n  - License type (linked to full text)\n  - Copyright holder\n  - One-line description\n\n**License verification required for each dependency:**\n- Confirm license is permissive (MIT, BSD, Apache 2.0, Zlib, MPL 2.0, etc.)\n- Flag any copyleft (GPL, LGPL) — LGPL is OK for dynamic linking but must be documented\n- ghostty is MIT — verify\n- ffmpeg is LGPL 2.1+ (with optional GPL components) — verify which config we use\n- godot-cpp is MIT — verify\n- Bun is MIT — verify\n\n**Implementation:**\n- Check if Help → About already exists in menuMain.gd\n- If not, add menu item and popup window\n- Could be a simple ScrollContainer with RichTextLabel (BBCode for links)\n- Consider auto-generating from a LICENSES.md or dependencies.json file\n\nDepends on: README external libraries documentation (for the inventory).','\n',char(10)),'2026-03-23T16:55:55','2026-03-23T17:13:07','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1b9ffdd37ccc9544aebc6d55c2a3','work_item','done','Verify all external dependencies have permissive licenses',replace('Audit every external dependency for license compatibility. This is informational — not expected to surface blockers since we use ffmpeg unmodified as a dynamically linked library (LGPL allows this).\n\n**Check each dependency:**\n\n| Library | Expected License | Notes |\n|---------|-----------------|-------|\n| Godot Engine | MIT | known |\n| godot-cpp | MIT | known |\n| ghostty / libghostty-vt | MIT | verify permits embedding as library |\n| ffmpeg (libavcodec, etc.) | LGPL 2.1+ | unmodified, dynamically linked — LGPL OK |\n| gdffmpeg wrapper | ? | check source |\n| uucode | ? | check Zig package |\n| Bun | MIT | known |\n\n**Deliverable:** A LICENSES.md listing each dependency, its license, and compatibility. Feeds into the Help → About dialog.','\n',char(10)),'2026-03-23T16:56:03','2026-03-23T17:13:05','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1b9927d37a50a27d593368451804',NULL);
INSERT INTO items VALUES('019d1d3af2b275ec8b106d2a3ad6e52e','dcr','approved','Signal-based injection lifecycle: UUID-tracked proxies with consumption signals',replace('Replace the global `detached_note_proxies` array with targeted, signal-based injection lifecycle.\n\n**Root cause:** `detached_note_proxies` is a global array with no chat targeting. `NotesContainer.to_prompt()` consumes ALL proxies regardless of which chat is sending. Regular notes already have `linked_chat_ids` for per-chat targeting — proxies don''t.\n\n**Verified scope (ast-grep audit 2026-03-24):**\n- 2 injection sources: Editor.gd:1133, TerminalNew.gd:425\n- 1 consumer: NotesContainer.to_prompt():337 (no filtering)\n- 7 clear() calls across ChatPane + SubmitJob\n- 4 erase() calls in Terminal + Editor (toggle off)\n\n**Plan — 6 focused changes:**\n\n1. **Note.Proxy: add `target_chat_id`** — empty string = any chat (current behavior), set = specific chat only. Mirrors `Note.linked_chat_ids` pattern.\n\n2. **NotesContainer.to_prompt(): filter proxies** — skip proxies whose `target_chat_id` doesn''t match `history_id`. Empty target = always include (backward compatible).\n\n3. **Proxy cleanup: selective clear** — replace 7x `.clear()` with filtered removal. Only clear proxies whose target matches the sending chat (or empty). Leave other-chat-targeted proxies alive.\n\n4. **Signal: injection_consumed** — `SingletonObject.injection_consumed.emit(history_id)` after message send. Sources (terminal, editor) listen and uncheck/deactivate only their consumed proxies.\n\n5. **Terminal redirect: set target_chat_id** — when user clicks redirect icon and picks a tab, sets `block.proxy.target_chat_id = selected_chat_history_id`. No tab switching.\n\n6. **Editor: same pattern** — Editor proxies default to empty (any chat). Future: could add targeting UI.\n\n**Backward compatible:** Empty `target_chat_id` preserves current behavior for existing proxies. No changes to provider Format() or InjectedNotes pipeline.','\n',char(10)),'2026-03-24T00:24:55','2026-03-24T17:58:06','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d1d4525c076389b43940a3a8bf110','dcr','implementing','Simplify terminal injection: per-block send button, remove right gutter',replace('Simplify the terminal-to-chat injection UX by removing clutter and making injection per-block.\n\n**Remove:**\n- Token count label in terminal (redundant — chat already estimates tokens from detached proxies)\n- "→ Chat" button (bottom-right overlay)\n- Tab picker popup (no longer needed)\n- Right gutter / overlay UI entirely\n\n**Add:**\n- Per-block send icon button in the left gutter, below each block''s checkbox\n- Small iconic button (e.g. send arrow icon) with tooltip "Inject into chat"\n- Only visible when the block is checked\n- Click injects ONLY that block into the currently active chat tab''s input field\n- Block auto-unchecks after injection\n\n**Behavior:**\n1. User checks a block''s gutter checkbox\n2. Small send icon appears below the checkbox\n3. User clicks send icon\n4. Block content is injected into the active chat tab''s input TextEdit\n5. Checkbox unchecks, send icon hides, proxy cleared\n\n**Why per-block, not all-checked:**\n- Multi-block injection is rare for humans\n- Agents use MCP, not UI\n- Eliminates need for tab picker (always targets active chat)\n- Simpler mental model: check → send → done','\n',char(10)),'2026-03-24T00:36:04','2026-03-24T01:56:44','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d20de94c579a9a3170881d68d9cad','work_item','backlog','Add target_chat_id to Note.Proxy',replace('Add `target_chat_id: String` field to `Note.Proxy` class (Note.gd:1146).\n\n- Empty string = any chat (backward compatible, current behavior)\n- Non-empty = only consumed by that specific chat''s history_id\n- Mirrors the `Note.linked_chat_ids` pattern but simplified to single target\n\nFile: `src/Scripts/UI/Controls/Note.gd`','\n',char(10)),'2026-03-24T17:22:31','2026-03-24T17:22:31','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d20dea7c77771a2c2c15769e73e3f','work_item','backlog','Filter proxies by target_chat_id in NotesContainer.to_prompt()',replace('Update the proxy iteration loop in `NotesContainer.to_prompt()` (NotesContainer.gd:337) to filter by `target_chat_id`.\n\nCurrent (line 337):\n```\nfor proxy_note in SingletonObject.detached_note_proxies:\n```\n\nNew: skip proxies where `proxy_note.target_chat_id` is non-empty and doesn''t match `history_id`.\n\nThis is the single consumer of proxies — fixing this one loop enables per-chat targeting.\n\nFile: `src/Scenes/note/NotesContainer.gd`\nBlocked by: item 1 (target_chat_id field)','\n',char(10)),'2026-03-24T17:22:36','2026-03-24T17:22:36','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d20debdc970859251e76ecb385bf1','work_item','backlog','Selective proxy cleanup: only clear consumed proxies',replace('Replace 7x `detached_note_proxies.clear()` with selective removal that only clears proxies matching the sending chat''s history_id (or untargeted proxies with empty target_chat_id).\n\n**Locations to update:**\n- ChatPane.gd: lines 571, 969, 1127, 1291, 1594, 1636\n- SubmitJob.gd: line 2109\n\nReplace each `.clear()` with a helper that filters:\n```gdscript\nfunc _clear_consumed_proxies(history_id: String) -> void:\n    var remaining: Array[Note.Proxy] = []\n    for proxy in SingletonObject.detached_note_proxies:\n        if proxy.target_chat_id.is_empty() or proxy.target_chat_id == history_id:\n            continue  # consumed — drop it\n        remaining.append(proxy)  # targeted elsewhere — keep\n    SingletonObject.detached_note_proxies = remaining\n```\n\nThis preserves proxies targeted at other chat tabs.\n\nBlocked by: item 1 (target_chat_id field)','\n',char(10)),'2026-03-24T17:22:41','2026-03-24T17:22:41','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d20ded44f7064bcedae209f8ff9da','work_item','backlog','Add injection_consumed signal for source notification',replace('Add signal to SingletonObject:\n```gdscript\nsignal injection_consumed(history_id: String)\n```\n\nEmit after each proxy cleanup in ChatPane/SubmitJob (at the same points where .clear() currently runs).\n\n**Listeners:**\n- TerminalNew.gd: connect in _ready(), on signal → uncheck blocks whose proxy was consumed (proxy no longer in detached_note_proxies array)\n- Editor.gd: connect in _ready(), on signal → uncheck "Send to LLM" toggle if proxy was consumed\n\nThis decouples sources from ChatPane — no more `get_tree().get_first_node_in_group("terminal_pane")` hacks.\n\nFiles: singleton_object.gd, ChatPane.gd, TerminalNew.gd, Editor.gd\nBlocked by: item 3 (selective cleanup)','\n',char(10)),'2026-03-24T17:22:47','2026-03-24T17:22:47','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d20dee55e7588bc74a82a5862291d','work_item','backlog','Terminal redirect: set target_chat_id on proxy',replace('Update terminal redirect popup (`_on_redirect_tab_selected`) to set `block.proxy.target_chat_id` to the selected chat''s HistoryId instead of switching the active tab.\n\nCurrent (broken): switches active tab\nNew: `block.proxy.target_chat_id = SingletonObject.ChatList[tab_index].HistoryId`\n\nNo tab switching. The proxy silently targets the selected chat. Next send from that chat consumes it. Next send from any other chat ignores it.\n\nFile: TerminalNew.gd\nBlocked by: items 1-2 (target_chat_id + filtering)','\n',char(10)),'2026-03-24T17:22:51','2026-03-24T17:22:51','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d20def64b758095ab5527d79f1b6a','work_item','backlog','Editor proxy: support targeting (default untargeted)',replace('Editor proxies currently have no targeting — they''re consumed by any chat. This is correct default behavior.\n\nEnsure Editor.gd proxy creation (line 1119) leaves `target_chat_id` empty (default). No UI changes needed for now — editor targeting is a future enhancement.\n\nAlso: connect Editor to `injection_consumed` signal to uncheck "Send to LLM" toggle when its proxy is consumed, replacing the current cleanup pattern.\n\nFile: Editor.gd\nBlocked by: item 4 (signal)','\n',char(10)),'2026-03-24T17:22:56','2026-03-24T17:22:56','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d1d3af2b275ec8b106d2a3ad6e52e',NULL);
INSERT INTO items VALUES('019d222b53d17ccb93746c71f733ce38','dcr','proposed','MCP terminal capability with CodeTools integration',replace('Expose Minerva''s terminal as MCP tools and absorb CodeTools entirely into Minerva. CodeTools repo will be retired.\n\n**Motivation:**\n- LLM agents need terminal + file manipulation via MCP\n- CodeTools (~/github/CodeTools) provides read/write/edit/glob/grep/bash with policy enforcement\n- Now that Minerva''s terminal works (libghostty-vt), CodeTools should live inside Minerva\n- Single app = single MCP server = simpler for agents, visible to user in UI\n\n**Integration approach: Full embed (CodeTools retired)**\n- Port all CodeTools tools to MinervaMCPServer as native GDScript implementations\n- Port policy.py enforcement to GDScript\n- CodeTools repo retired after migration complete\n- Policy file location shared: ~/.codetools/policy.json (or migrated to Minerva config)\n\n**Tools to add to MinervaMCPServer:**\n\n*Terminal tools (new, need Godot scene tree):*\n- `minerva_terminal_list` — list open terminal tabs\n- `minerva_terminal_create` — open new terminal tab\n- `minerva_terminal_close` — close terminal tab\n- `minerva_terminal_write` — send input to terminal PTY (visible in UI)\n- `minerva_terminal_read` — get screen/scrollback content\n- `minerva_terminal_get_blocks` — get command+output blocks for injection\n\n*File tools (ported from CodeTools):*\n- `minerva_file_read` — read file with offset/limit\n- `minerva_file_write` — create/overwrite files\n- `minerva_file_edit` — targeted string replacements\n- `minerva_file_glob` — find files by pattern\n- `minerva_file_grep` — search content with regex\n- `minerva_bash` — execute shell commands (policy-enforced)\n- `minerva_cwd` — get/set working directory\n\n*Policy enforcement (ported from CodeTools):*\n- Load from ~/.codetools/policy.json\n- Immutable at runtime\n- bash.deny regex patterns\n- Baseline protection: policy file always protected\n- Applied to minerva_bash AND minerva_terminal_write\n\n**Agent UX:**\n- Agent terminals visually distinguished (icon/color)\n- User can see all agent terminal activity\n- Multiple agents = multiple terminal tabs (split view)\n\n**Related repos:**\n- CodeTools: ~/github/CodeTools (to be retired)\n- Minerva MCP: src/Scripts/Services/MCP/MinervaMCPServer.gd (156 tools currently)','\n',char(10)),'2026-03-24T23:25:58','2026-03-24T23:26:55','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d222b914775d5a6a11b04d5534854','work_item','backlog','Plan CodeTools → Minerva port: audit tools, map GDScript equivalents',replace('CodeTools is being fully absorbed into Minerva. Audit each tool''s Python implementation and plan the GDScript port.\n\n**For each tool (bash, read, write, edit, glob, grep, cwd), document:**\n- Python implementation complexity (lines, dependencies)\n- GDScript equivalent APIs (FileAccess, DirAccess, OS.execute, RegEx)\n- Edge cases handled in Python that need porting\n- Test coverage in CodeTools that should migrate\n\n**Specific concerns:**\n- `bash`: Uses subprocess. GDScript has OS.execute() and the terminal PTY. Which path?\n- `edit`: String replacement with uniqueness check. Straightforward in GDScript.\n- `grep`: Uses regex. GDScript has RegEx class.\n- `glob`: Python glob → GDScript DirAccess + pattern matching\n- `read`: File offset/limit → FileAccess.seek + get_buffer\n- Policy: Regex deny patterns → GDScript RegEx\n\n**Deliverable:** Migration plan with estimated effort per tool, ordered by dependency.','\n',char(10)),'2026-03-24T23:26:13','2026-03-24T23:27:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d222bb5bd7efd946bfbf1132fd28f','work_item','backlog','Add core terminal MCP tools (list, create, close, write, read)',replace('Register terminal MCP tools in MinervaMCPServer following existing patterns (_register_X_tools + handler functions).\n\n**Tools:**\n- `minerva_terminal_list` — return [{id, name, group, cols, rows, cwd}] for all open terminals\n- `minerva_terminal_create` — create new terminal tab, return its id. Optional: group (left/right), cwd\n- `minerva_terminal_close` — close terminal by id\n- `minerva_terminal_write` — send text input to terminal (command string + optional newline)\n- `minerva_terminal_read` — get screen content. Params: terminal_id, optional row range, format (raw/blocks)\n- `minerva_terminal_get_blocks` — get finalized command+output blocks for injection\n\n**Implementation notes:**\n- Need to find terminal instances across split groups. Add a registry or use `get_tree().get_nodes_in_group("terminal_pane")`\n- Terminal IDs: use Godot instance_id or a generated UUID\n- `write` sends through PTY so it appears in the UI\n- `read` uses get_cell_screen for scrollback-safe content\n- Blocks come from TerminalBlock data already captured\n\nBlocked by: research decision (phase 1)','\n',char(10)),'2026-03-24T23:26:23','2026-03-24T23:26:23','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d222bc7f871109e8337c7ba173514','work_item','backlog','Integrate CodeTools policy enforcement into Minerva',replace('Bring CodeTools'' policy enforcement into Minerva so MCP terminal commands respect deny patterns.\n\n**Policy model (from CodeTools policy.py):**\n- Load from `~/.codetools/policy.json` (shared location)\n- Immutable at runtime (LLM can''t modify)\n- `bash.deny` — array of regex patterns\n- Baseline deny: always block access to policy file itself\n- PolicyViolationError returned as MCP error when denied\n\n**Implementation:**\n- Port policy loading to GDScript or keep as Python bridge\n- Check policy before `minerva_terminal_write` executes\n- Return clear error message when command denied\n- Policy file path configurable in Minerva preferences\n\nBlocked by: research decision (embed vs bridge)','\n',char(10)),'2026-03-24T23:26:27','2026-03-24T23:26:27','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d222bdf047b4b83e0abeb103216ec','work_item','backlog','Agent terminal UX: visual distinction and lifecycle',replace('When an LLM agent creates a terminal via MCP, the user should be able to see and distinguish it.\n\n**Visual distinction:**\n- Agent terminal tabs: different icon or color accent (e.g., robot icon, blue tab)\n- Tab tooltip shows: "Created by [agent name] via MCP"\n- Agent terminal output visible and scrollable by user (read-only view option?)\n\n**Lifecycle:**\n- Agent creates terminal → tab appears in UI\n- Agent closes terminal → tab disappears (or stays with "session ended" indicator)\n- User can close agent terminals manually\n- Multiple agents can have parallel terminals (split view handles this)\n\n**Access model:**\n- Agent can read/write its own terminals\n- Agent can read (but not write) other terminals? Or fully isolated?\n- User can always see and interact with all terminals','\n',char(10)),'2026-03-24T23:26:33','2026-03-24T23:26:33','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d222bf5277c928868cc32cf96d700','work_item','backlog','Integrate CodeTools file tools (read/write/edit/glob/grep) into Minerva MCP',replace('Bring CodeTools'' file manipulation tools into Minerva''s MCP server.\n\n**Tools to integrate:**\n- `minerva_file_read` — read file with offset/limit (mirrors CodeTools read)\n- `minerva_file_write` — create/overwrite (mirrors CodeTools write)\n- `minerva_file_edit` — targeted string replacement (mirrors CodeTools edit)\n- `minerva_file_glob` — find files by pattern (mirrors CodeTools glob)\n- `minerva_file_grep` — search content with regex (mirrors CodeTools grep)\n- `minerva_cwd` — get/set working directory\n\n**Approach depends on research decision:**\n- If embedded: port Python implementations to GDScript\n- If bridged: proxy calls to CodeTools subprocess\n- If hybrid: proxy file tools, keep terminal tools native\n\n**Policy:** All file tools go through the same policy check as bash commands.\n\nBlocked by: research decision, policy integration','\n',char(10)),'2026-03-24T23:26:39','2026-03-24T23:26:39','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d22311422784e932edb7475618bd1','work_item','done','Audit all CodeTools Python implementations','Read each CodeTools Python tool and document: lines, APIs used, edge cases, test coverage. Output as a Docket comment.','2026-03-24T23:32:15','2026-03-24T23:33:18','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d22311ef178b68a9a0285d3b00a54','work_item','done','Port CodeTools cwd.py to GDScript','Port ~/github/CodeTools/src/codetools/tools/cwd.py to GDScript. Create standalone file at src/Scripts/Services/CodeTools/CwdTool.gd. Include test.','2026-03-24T23:32:17','2026-03-24T23:35:37','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d2231261b77ab8d175f052d87fbe8','work_item','done','Port CodeTools read.py to GDScript','Port ~/github/CodeTools/src/codetools/tools/read.py to GDScript. Create standalone file at src/Scripts/Services/CodeTools/ReadTool.gd. Include test.','2026-03-24T23:32:19','2026-03-24T23:34:31','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d22312ce07fda928c477f529f8888','work_item','done','Port CodeTools write.py to GDScript','Port ~/github/CodeTools/src/codetools/tools/write.py to GDScript. Create standalone file at src/Scripts/Services/CodeTools/WriteTool.gd. Include test.','2026-03-24T23:32:21','2026-03-24T23:35:38','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d2231359971bf9ea6108fa527afd3','work_item','done','Port CodeTools policy.py to GDScript','Port ~/github/CodeTools/src/codetools/policy.py to GDScript. Create at src/Scripts/Services/CodeTools/Policy.gd. Include test. Must handle: JSON loading, regex deny patterns, baseline protection, immutable at runtime.','2026-03-24T23:32:23','2026-03-24T23:37:51','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d22313c5f7456b6d50a42343fc9ac','work_item','done','Port CodeTools glob.py to GDScript','Port ~/github/CodeTools/src/codetools/tools/glob.py to GDScript. Create at src/Scripts/Services/CodeTools/GlobTool.gd. Include test. Must handle: recursive directory walk, glob patterns (*, **, ?), DirAccess API.','2026-03-24T23:32:25','2026-03-24T23:36:51','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d222b53d17ccb93746c71f733ce38',NULL);
INSERT INTO items VALUES('019d2269e58b7e06b3060987ba8ce7bd','dcr','proposed','Terminal virtual blocks: interleaved MCP tool call visualization',replace('Interleave MCP tool call/response blocks into the terminal timeline alongside real PTY command blocks. Provides 100% traceability — every action (shell commands AND file operations) is visible, injectable, and auditable in the terminal UI.\n\n**Motivation:** Secure codebase workflows (e.g., SIEM tools) require full traceability. Agent actions via MCP (file reads/writes/edits, grep, glob) currently bypass the terminal and are invisible to the user. They should appear inline in the terminal timeline.\n\n**Two block types in the terminal:**\n1. **Real blocks** (existing) — command typed in PTY, output from PTY\n2. **Virtual blocks** (new) — MCP tool calls rendered as styled cards, interleaved chronologically\n\n**Visual design:**\n- Virtual blocks rendered as bordered cards (distinct from PTY output)\n- Show: tool name, key arguments, result summary\n- Different background/border color from real blocks\n- Collapsible for long results (e.g., file_read with 100 lines)\n- Gutter checkbox for injection (same as real blocks)\n\n**Data model:**\n- Extend TerminalBlock with a `block_type` enum: COMMAND (existing) vs VIRTUAL\n- Virtual blocks store: tool_name, arguments dict, result dict, timestamp\n- `format_for_injection()` formats virtual blocks as tool-call markdown\n- Both types live in the same `_blocks` array, ordered by time\n\n**Which tools create virtual blocks:**\n- All CodeTools: file_read, file_write, file_edit, file_glob, file_grep, bash, cwd\n- Future: any MCP tool call that modifies state or returns data\n\n**`minerva_bash` specifically:**\n- Should execute through the real PTY (visible, creates real block)\n- NOT through OS.execute() headless\n- This means bash becomes a real block, not virtual\n- Requires terminal MCP tools (write to PTY, wait for prompt)\n\n**Integration points:**\n- MinervaMCPServer: after each tool execution, emit signal with tool call data\n- TerminalNew: listen to signal, create virtual block, render inline\n- Virtual blocks injectable into chat via same proxy mechanism\n- Virtual blocks saveable as notes via same pipeline\n\n**Not in scope (future):**\n- Dedicated agent terminal tabs\n- Terminal MCP tools (list/create/write/read) — separate DCR\n- Replay/playback of tool call history','\n',char(10)),'2026-03-25T00:34:18','2026-03-25T00:34:18','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d226a106271d4a786454ef5b2c435','work_item','done','Extend TerminalBlock data model with virtual block type',replace('Extend terminal_block.gd to support virtual blocks.\n\n**Changes to TerminalBlock:**\n- Add `enum BlockType { COMMAND, VIRTUAL }`\n- Add `var block_type: BlockType = BlockType.COMMAND`\n- Add `var tool_name: String` (for virtual blocks)\n- Add `var tool_arguments: Dictionary` (for virtual blocks)\n- Add `var tool_result: Dictionary` (for virtual blocks)\n- Add `var timestamp: int` (unix time, for chronological ordering)\n- Update `format_for_injection()` to handle virtual blocks:\n  ```\n  ```tool-call\n  minerva_file_write\n  path: /tmp/test.txt\n  content: "hello world"\n  → success, 11 bytes\n  ```\n  ```\n\n**Backward compatible:** Existing COMMAND blocks unchanged. New fields default to empty.','\n',char(10)),'2026-03-25T00:34:29','2026-03-25T00:38:34','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a23a877048dd0b708e6688e94','work_item','done','Add MCP tool call signal to MinervaMCPServer',replace('Emit a signal from MinervaMCPServer after each CodeTools tool execution so the terminal can capture it.\n\n**Signal on SingletonObject (or MinervaMCPServer):**\n```gdscript\nsignal mcp_tool_executed(tool_name: String, arguments: Dictionary, result: Dictionary)\n```\n\n**Emit in `_execute_tool_impl()`** after each CodeTools match case returns. Only emit for codetools tool set (not all 163 tools).\n\n**Payload:** tool_name, arguments (sanitized — truncate large content values), result dict.','\n',char(10)),'2026-03-25T00:34:34','2026-03-25T00:38:55','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a34d87e2d99f073bfd7ee5835','work_item','backlog','TerminalNew: listen to signal, create virtual blocks',replace('Terminal listens to `mcp_tool_executed` signal and creates virtual blocks.\n\n**On signal received:**\n- Create a TerminalBlock with `block_type = VIRTUAL`\n- Set tool_name, tool_arguments, tool_result, timestamp\n- Append to `_blocks` array\n- Create gutter checkbox (same as real blocks)\n- Trigger re-render of the virtual block area\n\n**Which terminal receives it:**\n- The active terminal in the active group\n- If no terminal visible, queue and display when terminal opens\n\n**Blocked by:** items 1 and 2','\n',char(10)),'2026-03-25T00:34:38','2026-03-25T00:34:38','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a4a1179e58e8750549dea6b26','work_item','backlog','Render virtual blocks as styled cards in terminal',replace('Render virtual blocks visually distinct from PTY output.\n\n**Visual design:**\n- Bordered card/panel with subtle background (e.g., dark blue-grey, 1px border)\n- Header: tool name + icon (e.g., wrench icon)\n- Body: key arguments formatted as key: value pairs\n- Footer: result summary (success/fail, key metrics like bytes_written)\n- Collapsible: click to expand full arguments/result for large payloads\n- Gutter checkbox aligned with real block checkboxes\n\n**Rendering approach:**\n- Virtual blocks are Control nodes (not cell-grid rendered)\n- Inserted into the terminal''s output container at the correct position\n- Must scroll with terminal content\n- Must not interfere with PTY rendering above/below\n\n**Blocked by:** item 3','\n',char(10)),'2026-03-25T00:34:44','2026-03-25T00:34:44','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a5b627744b35865717ada350a','work_item','backlog','Virtual block injection and note proxy support',replace('Virtual blocks should be injectable into chat via the same checkbox + proxy mechanism as real blocks.\n\n**format_for_injection() for virtual blocks:**\n```markdown\n```tool-call\nminerva_file_edit\npath: /tmp/test.txt\nold_string: "hello"\nnew_string: "goodbye"\n→ success, 1 replacement\n```\n```\n\n**Proxy creation:** Same Note.Proxy pattern as real blocks — check gutter → proxy created → consumed on chat send.\n\n**Blocked by:** item 4 (rendering for checkbox placement)','\n',char(10)),'2026-03-25T00:34:48','2026-03-25T00:34:48','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a726f76e3905e08b8cbf634c8','work_item','backlog','Route minerva_bash through terminal PTY instead of OS.execute',replace('Change minerva_bash to execute through a real terminal PTY tab instead of headless OS.execute(). This makes bash commands real blocks (not virtual), fully visible and traceable.\n\n**Implementation:**\n- Find or create an agent terminal tab\n- Write command to PTY via terminal.write_input(command + "\\n")\n- Wait for block finalization (next prompt arrives)\n- Return the block''s captured output_text\n- The command and output appear in the terminal UI in real-time\n\n**Requires:** Terminal MCP tools (minerva_terminal_write, minerva_terminal_read) or direct access to TerminalNew instance.\n\n**Challenge:** Async — need to await block finalization signal. OS.execute is synchronous; PTY execution is async.\n\n**Fallback:** If no terminal is visible, fall back to OS.execute + create virtual block for traceability.','\n',char(10)),'2026-03-25T00:34:54','2026-03-25T00:34:54','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d226a80a0742fb3d8be14a103242a','work_item','done','Write tests for virtual block lifecycle',replace('Headless tests for virtual block data model and injection formatting.\n\n**Tests:**\n- Create virtual block, verify fields set correctly\n- format_for_injection() produces correct tool-call markdown\n- Virtual blocks interleave correctly with real blocks in _blocks array\n- Virtual block proxy creation and consumption\n- Large result truncation in format_for_injection\n\nSame SceneTree test pattern as other tests.','\n',char(10)),'2026-03-25T00:34:58','2026-03-25T00:42:16','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2269e58b7e06b3060987ba8ce7bd',NULL);
INSERT INTO items VALUES('019d22c8bbd0765f8b0b1d4e148748d0','dcr','proposed','1-agent-1-terminal: per-agent terminal tabs for MCP tool traceability',replace('Each MCP agent gets its own terminal tab for tool call traceability. Virtual blocks route to the agent''s tab, not the user''s terminal.\n\n**Rules:**\n- Agent with ID → gets its own named tab ("Agent: Claude Code")\n- No agent ID → goes to default "MCP Activity" tab\n- User typing → normal terminal, no virtual blocks\n- Tab auto-created on first tool call from that agent\n- Tab labeled with agent identity, visually tagged\n- Tab persists after agent finishes (audit trail)\n- User can close agent tabs manually\n\n**Data flow:**\n1. MCP tool call arrives with optional agent_id\n2. MinervaMCPServer emits mcp_tool_executed with agent_id\n3. TerminalTabContainer routes to agent''s tab (creates if needed)\n4. Virtual block written to that tab via write_to_screen()\n\n**Changes needed:**\n- Signal: add agent_id parameter to mcp_tool_executed\n- MCP HTTP server: extract agent identity from request headers or session\n- TerminalTabContainer: maintain agent_id → terminal tab mapping\n- TerminalNew: remove is_visible_in_tree() gate, receive blocks via direct call\n- Agent tab styling: different tab icon/color\n\n**Multi-agent scenario:**\n- 5 sub-agents running → 5 agent tabs in terminal\n- User can split-view to watch 2 agents side-by-side\n- Each tab is a clean sequential audit trail\n- No interleaving between agents','\n',char(10)),'2026-03-25T02:17:53','2026-03-25T02:17:53','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d22c8e5387f719e3fac9caa599ed3','work_item','done','Add agent_id to mcp_tool_executed signal and MCP call path',replace('Add agent_id to the signal and plumb it through the MCP call path.\n\n- Signal: `mcp_tool_executed(tool_name, arguments, result, agent_id)`\n- MinervaMCPServer: pass agent_id in all 7 emit calls\n- MCP HTTP server: extract agent identity from request (X-Agent-Id header, session, or default "")\n- Default agent_id: empty string = "MCP Activity" catch-all\n\nFiles: singleton_object.gd, MinervaMCPServer.gd, MinervaMCPHttpServer.gd','\n',char(10)),'2026-03-25T02:18:04','2026-03-25T02:20:24','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d22c8bbd0765f8b0b1d4e148748d0',NULL);
INSERT INTO items VALUES('019d22c8fa2f7e2d8d8abeffdee747f3','work_item','backlog','TerminalTabContainer: agent tab registry and auto-creation',replace('TerminalTabContainer maintains agent_id → TerminalNew mapping. Auto-creates agent tabs.\n\n- `var _agent_terminals: Dictionary = {}` — agent_id → TerminalNew\n- `func get_or_create_agent_terminal(agent_id: String) -> TerminalNew`\n- Empty agent_id → "MCP Activity" default tab\n- Non-empty → "Agent: {agent_id}" tab\n- Agent tabs created in left group (or whichever group has space)\n- Tab label includes agent name\n- Returns the TerminalNew instance for direct write_to_screen calls\n\nFiles: TerminalTabContainer.gd, TerminalTabGroup.gd','\n',char(10)),'2026-03-25T02:18:09','2026-03-25T02:18:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d22c8bbd0765f8b0b1d4e148748d0',NULL);
INSERT INTO items VALUES('019d22c90e7f7b59bc9eeae9c737f9b2','work_item','backlog','Route virtual blocks to agent terminal instead of visible terminal',replace('Change virtual block creation to route through TerminalTabContainer to the agent''s tab.\n\nCurrent: each TerminalNew listens to mcp_tool_executed, only visible one acts.\nNew: TerminalTabContainer listens to signal, routes to agent''s tab via get_or_create_agent_terminal().\n\n- Remove mcp_tool_executed listener from TerminalNew._ready()\n- Add listener to TerminalTabContainer\n- TerminalTabContainer calls agent terminal''s write methods directly\n- Move _on_mcp_tool_executed, _write_virtual_summary, _expand_virtual_block to work on any TerminalNew (pass as parameter)\n\nBlocked by: items 1 and 2','\n',char(10)),'2026-03-25T02:18:15','2026-03-25T02:18:15','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d22c8bbd0765f8b0b1d4e148748d0',NULL);
INSERT INTO items VALUES('019d22c919f4776e99a51e37dd998163','work_item','backlog','Agent tab visual styling: icon, color, label',replace('Visually distinguish agent terminal tabs from user terminal tabs.\n\n- Tab label: "Agent: Claude Code" or "MCP Activity"\n- Tab icon: robot or gear icon (use existing Minerva icon assets)\n- Optional: different tab background color tint\n- Tooltip: "MCP agent terminal — auto-created for tool call traceability"\n\nBlocked by: item 2','\n',char(10)),'2026-03-25T02:18:17','2026-03-25T02:18:17','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d22c8bbd0765f8b0b1d4e148748d0',NULL);
INSERT INTO items VALUES('019d237cc59c731faa978904f0a08353','dcr','proposed','Activity Log editor: per-agent MCP tool call traceability in editor pane',replace('Replace terminal-based virtual blocks with a dedicated Activity Log editor type in the editor pane. Each agent gets its own tab. Terminal goes back to being a pure terminal.\n\n**Design:**\n- New editor type: `Editor.Type.ACTIVITY_LOG`\n- Each agent gets its own Activity Log tab, auto-created on first tool call\n- Tab label: "Activity: Claude Code" or "Activity: MCP" (default)\n- Read-only scrollable log of MCP tool calls with collapsible entries\n- Entries show: timestamp, tool name, key args, result summary\n- Click to expand: full arguments + full result\n- Injectable into chat (select entries → reference block via proxy)\n- Auto-scrolls to latest entry\n\n**What to REVERT (terminal virtual block experiment):**\nThese commits added virtual blocks to the terminal and should be undone:\n- `0efdd9fc` Virtual terminal blocks: MCP tool calls rendered inline\n- `331fbd74` Fix type inference for create_virtual\n- `0bebb273` Virtual blocks: write ANSI text via write_to_screen\n- `54663914` Virtual blocks: terminal-native expand via gutter button\n- `48e2adad` Virtual blocks: remove ▸ prefix, enlarge button\n- `fb06bbfd` Virtual blocks: save/restore cursor\n- `00945dd5` Fix duplicate esc variable\n- `78ae5952` 1-agent-1-terminal: route to per-agent terminal tabs\n- `b34d2969` Fix agent tab: defer write_to_screen\n\n**What to KEEP:**\n- `mcp_tool_executed` signal on SingletonObject (with agent_id) — the Activity Log listens to this\n- `TerminalBlock.BlockType.VIRTUAL` + `create_virtual()` + `_format_virtual_for_injection()` — reused by Activity Log entries\n- `write_to_screen()` C++ method — useful for future terminal features, costs nothing to keep\n- CodeTools MCP tools (file_read/write/edit/glob/grep/bash/cwd) — working, tested\n- Agent tab concept — moves from terminal to editor pane\n\n**What to REMOVE from terminal:**\n- `_on_mcp_tool_executed` handler in TerminalNew\n- `_write_virtual_summary`, `_expand_virtual_block` in TerminalNew\n- Agent terminal registry in TerminalTabContainer\n- `get_or_create_agent_terminal`, `_write_virtual_to_terminal`','\n',char(10)),'2026-03-25T05:34:32','2026-03-25T05:34:32','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d237cf64f761a8b6c843d34d3c9c8','work_item','done','Revert terminal virtual block code, keep signal + data model',replace('Clean up terminal code — remove virtual block rendering, agent tab routing. Keep reusable pieces.\n\n**Remove from TerminalNew.gd:**\n- _write_virtual_summary(), _expand_virtual_block()\n- _on_mcp_tool_executed handler (already a comment)\n- Any remaining virtual block UI code\n\n**Remove from TerminalTabContainer.gd:**\n- _agent_terminals registry\n- get_or_create_agent_terminal()\n- _on_mcp_tool_executed(), _write_virtual_to_terminal()\n- mcp_tool_executed signal connection\n\n**KEEP (reused by Activity Log):**\n- TerminalBlock.BlockType enum, virtual fields, create_virtual(), _format_virtual_for_injection()\n- SingletonObject.mcp_tool_executed signal (with agent_id)\n- MinervaMCPServer emit calls\n- write_to_screen() C++ method\n- test_virtual_blocks.gd tests','\n',char(10)),'2026-03-25T05:34:45','2026-03-25T05:38:19','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d237d0d3a77a7beb342bf92b06d5c','work_item','done','Create ActivityLogEditor type in Editor system',replace('Add ACTIVITY_LOG to Editor.Type enum and create the editor panel.\n\n**Follow existing editor patterns (see PCBEditor as reference):**\n- Add `Type.ACTIVITY_LOG` to Editor.Type enum\n- Add match case in Editor.create()\n- Add case in Editor._ready() for button hiding\n- Add case in EditorPane.add() for tab naming\n- Add case in Editor.get_saved_state()\n\n**ActivityLogPanel.gd (new file):**\n- Extends Control (or VBoxContainer)\n- ScrollContainer with VBoxContainer for log entries\n- Auto-scrolls to bottom on new entries\n- Each entry: timestamp label + tool summary + expand button\n- Read-only — no editing\n\n**Scene:** Build UI in _build_ui() like PCBEditor (no .tscn needed)','\n',char(10)),'2026-03-25T05:34:51','2026-03-25T05:40:00','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d237d267c79a497574adabc7c7804','work_item','backlog','ActivityLogPanel: render tool call entries with collapse/expand',replace('Render each tool call as a compact entry with expand/collapse.\n\n**Collapsed entry (default):**\n```\n12:04:01  file_write /tmp/test.txt → 33 bytes written\n```\nOne line: timestamp + tool name + key arg + result. Color-coded.\n\n**Expanded entry (click to toggle):**\n```\n12:04:01  file_write /tmp/test.txt → 33 bytes written\n  path: /tmp/test.txt\n  content: "Testing compact virtual blocks"\n  success: true\n  bytes_written: 33\n```\n\n**Implementation:**\n- Each entry is an HBoxContainer or custom Control\n- Collapse button toggles visibility of details VBoxContainer\n- Details show all arguments + all result fields\n- Long values truncated with "..." \n- Color: tool name in blue, args in grey, success green / fail red\n\nBlocked by: ActivityLogEditor type','\n',char(10)),'2026-03-25T05:34:57','2026-03-25T05:34:57','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d237d38fa790fabdefe7d3f706f30','work_item','backlog','Route mcp_tool_executed signal to Activity Log editors',replace('Listen to mcp_tool_executed signal, route to correct Activity Log tab.\n\n**Logic:**\n- EditorPane or a manager listens to SingletonObject.mcp_tool_executed\n- On signal: find or create Activity Log editor tab for this agent_id\n- Empty agent_id → "Activity: MCP" tab\n- Named agent → "Activity: {agent_id}" tab\n- Add entry to that Activity Log''s panel\n\n**Auto-create on first call:**\n- No Activity Log exists yet → create one via Editor.create(Type.ACTIVITY_LOG)\n- Store agent_id → editor mapping (similar to old _agent_terminals)\n\nBlocked by: ActivityLogEditor type','\n',char(10)),'2026-03-25T05:35:02','2026-03-25T05:35:02','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d237d4df07407ab4a57de6d1fef50','work_item','backlog','Activity Log entries: injectable into chat as reference blocks',replace('Allow Activity Log entries to be selected and injected into chat.\n\n**Approach:**\n- Checkbox next to each entry (like terminal block gutter)\n- Checked entries create Note.Proxy with target_chat_id\n- format_for_injection() on virtual blocks already exists — reuse it\n- Entries consumed on chat send via injection_consumed signal\n\n**Or simpler:** Use the existing Editor "Send to LLM" toggle, which sends the entire Activity Log content as a note. Individual entry selection is a future enhancement.\n\nBlocked by: Activity Log rendering','\n',char(10)),'2026-03-25T05:35:07','2026-03-25T05:35:07','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d237d5c00782995e5a8c9f25b3790','work_item','backlog','Write tests for Activity Log editor lifecycle',replace('Headless tests for Activity Log entry creation, formatting, routing.\n\n- Test: create virtual block, format for injection\n- Test: multiple entries maintain chronological order\n- Test: agent_id routing creates separate logs\n- Test: entry expand/collapse data integrity\n\nReuse existing test_virtual_blocks.gd data model tests.','\n',char(10)),'2026-03-25T05:35:11','2026-03-25T05:35:11','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d237cc59c731faa978904f0a08353',NULL);
INSERT INTO items VALUES('019d27433533752685776558b8046c78','dcr','approved','Interactive terminal control via MCP: read, write, wait',replace('Enable MCP agents to interactively control terminal sessions — read screen content, write keystrokes without blocking, and detect new output. This enables launching and conversing with interactive CLI tools (like Claude Code) from within Minerva.\n\n**The three missing capabilities:**\n\n1. **minerva_terminal_read** — Read current terminal screen content (or row range from scrollback). Returns plain text of what''s visible. Uses existing get_cell_screen() for scrollback-safe reads.\n\n2. **minerva_terminal_write** — Send keystrokes/text to a terminal''s PTY input without waiting for a prompt. Non-blocking. Uses existing write_input() on the C++ terminal object.\n\n3. **minerva_terminal_wait** — Block until new output appears on the terminal, with a timeout. Uses the existing vt_state_changed signal. Returns the new screen content when output arrives or times out.\n\n**Additional terminal MCP tools (from earlier DCR, now needed):**\n- minerva_terminal_list — list open terminal tabs with metadata\n- minerva_terminal_create — open a new terminal tab\n- minerva_terminal_close — close a terminal tab\n\n**Interactive flow example (agent drives claude CLI):**\n1. terminal_write "claude\n" → launches claude\n2. terminal_wait timeout=10000 → waits for claude to show its prompt\n3. terminal_read → sees claude''s welcome/prompt\n4. terminal_write "build hello world in rust\n" → sends prompt\n5. terminal_wait timeout=60000 → waits for response\n6. terminal_read → reads claude''s response\n7. Repeat or terminal_write "/exit\n" to quit\n\n**Implementation approach:**\n- terminal_read: new MCP tool calling get_cell_screen() across row range, returns text\n- terminal_write: new MCP tool calling terminal.write_input(), returns immediately\n- terminal_wait: new MCP tool that awaits vt_state_changed signal with timeout, returns screen content after change\n- All tools take a terminal_id parameter to target specific tabs\n- terminal_list/create/close for tab management\n\n**Key design decisions:**\n- terminal_read returns plain text (not cell data) — sufficient for agent use\n- terminal_wait needs a settle delay (output may arrive in chunks; wait for N ms of silence)\n- Terminal targeting: by tab index or auto-created agent terminal','\n',char(10)),'2026-03-25T23:10:09','2026-03-25T23:13:06','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d27435bdf7bd4ad45d89f683e8516','work_item','done','Add minerva_terminal_list MCP tool',replace('Register MCP tool to list all open terminal tabs.\n\nReturns array of: {id (instance_id), name, group (left/right), cols, rows, visible}\n\nNeeds to traverse TerminalTabContainer → TerminalTabGroup(s) → TerminalNew instances. Use get_tree().get_nodes_in_group("terminal_pane") or traverse the container.\n\nRegister in MinervaMCPServer._register_codetools(). Add handler function.','\n',char(10)),'2026-03-25T23:10:19','2026-03-25T23:14:21','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d274367da7ce2bfc5d30af7cae626','work_item','backlog','Add minerva_terminal_create and minerva_terminal_close MCP tools',replace('Register MCP tools to create and close terminal tabs.\n\nterminal_create: optional name param, creates via TerminalTabGroup.add_terminal(), returns {id, name}.\nterminal_close: takes terminal_id, finds and closes the tab.\n\nNeed to make terminal visible if hidden (toggle terminal container visibility).','\n',char(10)),'2026-03-25T23:10:22','2026-03-25T23:10:22','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d2743790a74d0badac0756322ac00','work_item','done','Add minerva_terminal_read MCP tool',replace('Register MCP tool to read terminal screen content as plain text.\n\nParameters: terminal_id (optional, defaults to active), start_row (optional), end_row (optional)\n\nImplementation: iterate rows calling _extract_row_text_screen() or get_cell_screen(). Return {content: String, rows: int, cols: int}.\n\nIf no row range specified, return the full visible viewport. If start/end given, read that range from scrollback.\n\nThis is the critical "look at screen" capability. Uses existing get_cell_screen() which we already built and tested.','\n',char(10)),'2026-03-25T23:10:26','2026-03-25T23:15:46','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d2743890e79afa72aeb40655c220b','work_item','done','Add minerva_terminal_write MCP tool (non-blocking)',replace('Register MCP tool to send text/keystrokes to a terminal''s PTY input.\n\nParameters: terminal_id (optional, defaults to active), text (the input to send)\n\nImplementation: find the TerminalNew instance, call terminal.write_input(text). Returns immediately (non-blocking). The text appears in the terminal as if typed.\n\nCommon patterns: send "command\n" to execute, send "\x03" for Ctrl+C, send "	" for tab completion.\n\nUses existing write_input() C++ method — just needs MCP registration and routing.','\n',char(10)),'2026-03-25T23:10:30','2026-03-25T23:14:21','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d27439fd770b7b6c347687e40aea3','work_item','backlog','Add minerva_terminal_wait MCP tool (await output with timeout)',replace('Register MCP tool that waits for new terminal output, then returns screen content.\n\nParameters: terminal_id (optional), timeout_ms (default 30000), settle_ms (default 500 — wait for output to stop before returning)\n\nImplementation:\n- Connect to vt_state_changed signal on the terminal\n- Start a timer for timeout\n- On each vt_state_changed, reset a settle timer\n- When settle timer expires (no new output for settle_ms), return screen content\n- If timeout expires first, return what''s on screen + timed_out: true\n\nThis is the "wait for response" capability. The settle delay handles chunked output (programs write in bursts — we wait until it stops).\n\nReturns: {content: String, timed_out: bool, rows: int}','\n',char(10)),'2026-03-25T23:10:36','2026-03-25T23:10:36','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d2743ad83795ab1eeada1d7da3bab','work_item','done','Helper: find terminal by ID across groups',replace('All terminal MCP tools need to find a TerminalNew by ID (or default to active). Create a shared helper.\n\nfunc _find_terminal(terminal_id) -> TerminalNew:\n- If terminal_id provided: search all terminals in group "terminal_pane" by instance_id\n- If empty/null: return active terminal from TerminalTabContainer\n- Return null if not found\n\nUsed by: terminal_list, terminal_read, terminal_write, terminal_wait, terminal_close','\n',char(10)),'2026-03-25T23:10:40','2026-03-25T23:14:20','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d2743bdeb7246a836e64b0aa549c6','work_item','backlog','Write tests for terminal MCP tools',replace('Integration tests for terminal MCP tools. These need a running terminal (can''t fully test headless).\n\nHeadless-testable:\n- Terminal helper finds terminals by group\n- Screen content extraction (reuse existing text extraction tests)\n\nManual test script:\n- Create terminal, write command, read screen, verify content\n- Wait for output with timeout\n- List terminals shows correct count','\n',char(10)),'2026-03-25T23:10:44','2026-03-25T23:10:44','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d27433533752685776558b8046c78',NULL);
INSERT INTO items VALUES('019d278a9d097bd382b4044b970c4501','dcr','approved','Automatic tool token management: search-based discovery + LRU budget',replace('Replace sending all ~170 tool schemas upfront (~25K tokens) with search-based discovery + LRU-managed tools array. Automatic, zero user management.\n\n**Architecture:**\n\n1. **System prompt (~400 tokens):** Short starter list of common tool names + category hints. No schemas.\n```\nYou have MCP tools available. Common tools:\nFiles: minerva_file_read, file_write, file_edit, file_glob, file_grep, bash, cwd\nChat: minerva_send_message, list_chats, create_chat\nTerminal: minerva_terminal_write, terminal_read, terminal_wait\nNotes: minerva_create_note, get_note, enable_notes\n\nMore tools available (spreadsheet, PCB, graphics, video, agents, etc.)\nCall minerva_tool_search(query) to discover and activate any tool.\n```\n\n2. **Tools array:** Starts with ONLY `minerva_tool_search` schema (~150 tokens).\n\n3. **Search activates tools:** Calling `tool_search("file_edit")` returns the schema AND adds it to the tools array for subsequent turns. The LLM can then call the tool directly.\n\n4. **LRU with token budget:** Max ~3,000 tokens for the tools array. Each tool tracks `last_used_turn`. When adding a tool would exceed budget, prune least-recently-used. `tool_search` is never pruned.\n\n5. **Compaction resets:** On chat compaction, tools array resets to just `tool_search`.\n\n6. **Pruned tool recovery:** If LLM tries to call a pruned tool, return "Tool not loaded. Call minerva_tool_search to reload." — graceful, 1 extra turn.\n\n7. **Workflow hints in descriptions:** Tool descriptions include prerequisites ("call X first to get Y"). Costs ~20 extra tokens per tool but prevents Haiku from calling tools with wrong parameters.\n\n**Token budget comparison:**\n\n| Scenario | Current | New |\n|----------|---------|-----|\n| First tool use | ~25,000 | ~1,150 |\n| 5 tools in use | ~25,000 | ~2,500 |\n| Just chatting (no tools) | ~25,000 | ~550 |\n| After compaction | ~25,000 | ~150 |\n\n**Test scenarios (must pass):**\n1. Simple: "edit a file" → search finds file_edit, 1 discovery call\n2. Esoteric: "annotate a PCB component" → search finds pcb_add_annotation, workflow hints guide multi-step plan\n3. Multi-tool: "create spreadsheet, add data, format cells, make chart" → progressive discovery, LRU keeps all spreadsheet tools active\n4. Budget pressure: use 10+ different tools → LRU prunes idle ones, active ones stay\n5. Pruned tool recovery: tool gets pruned, LLM re-discovers it gracefully\n6. Compaction: tools reset, LLM re-discovers what it needs\n7. Haiku-specific: Haiku agent discovers and correctly uses pcb_add_annotation with coordinate resolution','\n',char(10)),'2026-03-26T00:28:08','2026-03-26T00:32:07','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d278ad56b7dd78b5208c315ab8a26','work_item','done','Build ToolBudgetManager: LRU tracking + token budget enforcement',replace('New class: ToolBudgetManager.gd (~100 lines)\n\n**State:**\n- `_active_tools: Dictionary` — tool_name → {schema: Dictionary, last_used_turn: int, token_cost: int}\n- `_current_turn: int`\n- `_token_budget: int` (default 3000, configurable)\n- `minerva_tool_search` always present, never pruned\n\n**Methods:**\n- `activate_tool(name, schema)` — add to active set, prune LRU if over budget\n- `mark_used(name)` — update last_used_turn\n- `get_active_schemas() -> Array[Dictionary]` — for the tools array in API requests\n- `get_token_usage() -> int` — current total\n- `advance_turn()` — increment turn counter\n- `reset()` — compaction, back to just tool_search\n- `try_call(name) -> Dictionary` — returns schema if active, error message if pruned\n\n**Token estimation:** ~4 chars per token on the JSON schema string.\n\n**Prune logic:** When activate_tool would exceed budget, sort active tools by last_used_turn ascending, remove oldest until under budget. Never remove tool_search.','\n',char(10)),'2026-03-26T00:28:23','2026-03-26T00:33:57','','','',1,0,'Created ToolBudgetManager.gd and test_tool_budget_manager.gd with 13 tests covering LRU eviction, budget enforcement, protected tool, and reset.',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278aefd97a279de932676a61a196','work_item','backlog','Implement minerva_tool_search MCP tool',replace('Register minerva_tool_search in MinervaMCPServer.\n\n**Parameters:**\n- query: String — keyword search or exact tool name\n- category: String (optional) — filter by tool_set\n- limit: int (default 5)\n\n**Search logic (keyword index):**\n- Build inverted index at registration time: tokenize each tool''s name + description into keywords → Dictionary of keyword → [tool_names]\n- On search: tokenize query, find tools matching most keywords, rank by match count\n- Exact name match always returns that tool\n\n**Returns:**\n- Array of {name, description, input_schema} for matching tools\n- Each returned tool is AUTO-ACTIVATED via ToolBudgetManager.activate_tool()\n\n**Registration:** Always in tools array (never pruned). Schema: ~150 tokens.\n\nBlocked by: ToolBudgetManager','\n',char(10)),'2026-03-26T00:28:30','2026-03-26T00:28:30','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278b076b7581aaf6018398146719','work_item','done','Add workflow hints to tool descriptions',replace('Review all ~170 tool descriptions and add workflow hints where tools have prerequisites.\n\n**Pattern:** "Description. Call X first to get Y."\n\n**Known tools needing hints:**\n- PCB tools: need editor_name from list_editors, component positions from describe_component\n- Spreadsheet tools: need editor_name, column/row data from get_spreadsheet_data\n- Chart tools: need editor_name + data range\n- send_message: needs chat_id from list_chats\n- terminal_write: use \r for Enter, prefer minerva_bash for normal commands\n- file_edit: read file first to find exact string\n\n**Estimated effort:** ~30 tools need hints. Most are fine as-is.\n\nCan be done by Sonnet agent — mechanical review with clear pattern.','\n',char(10)),'2026-03-26T00:28:36','2026-03-26T00:35:35','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278b223d71bebe28468a5589a0a8','work_item','backlog','Integrate ToolBudgetManager into MCP request pipeline',replace('Wire ToolBudgetManager into the existing tool-sending pipeline.\n\n**Changes to MCPManager.get_tools_for_chat():**\n- When automatic tool management is active, use ToolBudgetManager.get_active_schemas() instead of iterating all tools\n- When a tool is called, call ToolBudgetManager.mark_used(name)\n- On each LLM turn, call advance_turn()\n\n**Changes to MinervaMCPHttpServer:**\n- tools/list response uses ToolBudgetManager active schemas\n- Before tool execution: check try_call(name), return "not loaded" error if pruned\n\n**Changes to chat compaction handler:**\n- Call ToolBudgetManager.reset()\n\n**Backward compatible:** When automatic management is OFF (preference toggle), use existing full-schema pipeline. Default: ON.\n\nBlocked by: ToolBudgetManager + tool_search','\n',char(10)),'2026-03-26T00:28:42','2026-03-26T00:28:42','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278b35c57289a8412f6b8387b611','work_item','backlog','Generate starter tool list for system prompt',replace('Create the short system prompt insert listing common tool names + category hints.\n\n**Content (~400 tokens):**\n- ~20 most common tool names grouped by category (no schemas)\n- Category hints for less common tools: "More tools: spreadsheet, PCB, graphics, video, agents..."\n- Instruction: "Call minerva_tool_search(query) to discover and activate any tool."\n\n**Where it goes:** Injected into the system prompt by ChatPane when automatic tool management is active. Similar to how notes and skills inject prompt fragments.\n\n**Must be dynamic:** If the user has a PCB editor open, include PCB tool names in the starter list. Context-aware starter.','\n',char(10)),'2026-03-26T00:28:47','2026-03-26T00:28:47','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278b58467553b619120a372b6c6c','work_item','backlog','Write tests: tool discovery + LRU + budget scenarios',replace('Comprehensive test suite — all automated via `godot --headless`, zero API calls.\n\n**1. ToolBudgetManager unit tests (headless):**\n- activate_tool adds to active set\n- activate_tool over budget triggers LRU prune\n- tool_search schema never pruned\n- mark_used updates last_used_turn\n- Oldest unused tool pruned first (not most recently used)\n- reset() clears all except tool_search\n- try_call on active tool returns schema\n- try_call on pruned tool returns error message\n- Token budget respected after N activations\n- Token estimation is accurate (verify against known schema sizes)\n\n**2. Keyword search tests (headless):**\n- Exact name "minerva_file_edit" → returns that tool\n- Keywords "edit file" → file_edit ranked first\n- Keywords "pcb annotation" → pcb_add_annotation found\n- Category filter "terminal" → only terminal tools\n- No match → empty result\n- Limit=1 → only top result\n\n**3. Simulated multi-turn session (headless, no LLM):**\n\nSimulate a 20-turn coding session programmatically:\n```\nTurn 1:  search("file_read") → activate\nTurn 2:  use file_read, search("file_edit") → activate  \nTurn 3:  use file_edit\nTurn 5:  search("bash") → activate\nTurn 8:  search("pcb_add_annotation") → activate\nTurn 10: search("pcb_describe_component") → activate\nTurn 12: search("spreadsheet") → activate 5 tools\nTurn 15: budget exceeded → assert LRU prunes file_read (unused since turn 2)\nTurn 18: try_call("file_read") → "not loaded" → search to reload\nTurn 20: compaction → assert only tool_search remains\n```\n\n**Assertions at each turn:**\n- `manager.get_token_usage() <= budget` (budget never exceeded)\n- `manager.get_active_schemas().size()` (correct tool count)\n\n**4. Token savings measurement (headless):**\n\nCalculate and report:\n```\nvar old_total: int = sum of ALL tool schema token costs (~25,000)\nvar turn_costs: Array[int] = [] # token cost per turn\n\nfor each simulated turn:\n    turn_costs.append(manager.get_token_usage())\n\nvar avg_new_cost: float = average(turn_costs)\nvar savings_pct: float = (old_total - avg_new_cost) / old_total * 100\nvar total_savings: int = old_total - int(avg_new_cost)\n\n# Assert\nassert(savings_pct > 90.0, "Expected >90%% savings, got %f%%" % savings_pct)\nassert(avg_new_cost < 3000, "Expected avg <3000 tokens, got %d" % avg_new_cost)\n```\n\nOutput: print a report showing per-turn cost and cumulative savings.\n\n**5. Turn penalty tracking (headless):**\n\nCount discovery overhead in simulated session:\n```\nvar discovery_calls: int = 0   # tool_search invocations\nvar wasted_calls: int = 0      # pruned tool recovery attempts\nvar total_turns: int = 20\n\n# Assert\nassert(discovery_calls <= 8, "Too many searches: %d" % discovery_calls)\nassert(wasted_calls <= 2, "Too many pruned recoveries: %d" % wasted_calls)\nvar overhead_pct: float = float(discovery_calls) / total_turns * 100\n# Report: "Discovery overhead: X% of turns required a search"\n```\n\n**6. Scenario-specific simulations (headless):**\n\na) **"Edit a file" scenario:**\n   - search("file_edit") → 1 discovery call\n   - Assert: file_edit in active schemas, budget < 600\n\nb) **"Annotate PCB from U1 to C3" scenario:**\n   - search("pcb annotation") → finds pcb_add_annotation with workflow hint\n   - Assert: description contains "describe_component"\n   - search("pcb describe") → activate\n   - search("list editors") → activate\n   - Assert: 3 PCB tools active, budget < 1500, discovery_calls == 3\n\nc) **"Create spreadsheet + format + chart" scenario:**\n   - search("spreadsheet") → activate create + update + add_row\n   - search("format") → activate format_cells\n   - search("chart") → activate create_chart\n   - Assert: 5 tools active, budget < 2500\n\nd) **"Budget pressure" scenario:**\n   - Activate 15 different tools sequentially\n   - Assert: budget never exceeds cap\n   - Assert: most recently used tools survive\n   - Assert: oldest idle tools pruned\n\n**7. NOT automated (requires real LLM — manual test only):**\n- Haiku end-to-end: does Haiku actually find and correctly use pcb_add_annotation?\n- Sonnet multi-tool: does Sonnet do a spreadsheet + chart workflow?\n- Token measurement against real API response usage fields\n\n**Test output format:**\n```\n=== Tool Token Management Tests ===\n\n--- Unit Tests ---\n  PASS: activate adds tool\n  PASS: budget enforced\n  ...\n\n--- Simulated Session ---\n  Turn 1:  550 tokens (file_read activated)\n  Turn 5:  1200 tokens (bash activated)\n  Turn 12: 2800 tokens (spreadsheet activated, 8 tools)\n  Turn 15: 1500 tokens (LRU pruned 3 idle tools)\n  Turn 20: 150 tokens (compaction reset)\n\n--- Token Savings ---\n  Old approach: 25,000 tokens/request\n  New average:  1,450 tokens/request\n  Savings:      94.2%\n\n--- Turn Penalties ---\n  Discovery calls: 7 / 20 turns (35%)\n  Pruned recoveries: 1 / 20 turns (5%)\n\n=== Results: XX passed, 0 failed ===\n```','\n',char(10)),'2026-03-26T00:28:56','2026-03-26T00:31:23','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d278b6934709aa1b8c180d9b2677d','work_item','backlog','Preference toggle: automatic vs manual tool management',replace('Add preference in settings to toggle between automatic (new) and manual (existing) tool management.\n\n**Default: automatic (new system).**\n\nWhen OFF: existing behavior — all tool schemas sent, tool_sets/profiles filter as before.\nWhen ON: ToolBudgetManager controls the tools array, minerva_tool_search available.\n\nSingle checkbox in preferences. Persisted to config. No other UI changes needed — the existing tool set/profile UI still works for manual mode.','\n',char(10)),'2026-03-26T00:29:01','2026-03-26T00:29:01','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d278a9d097bd382b4044b970c4501',NULL);
INSERT INTO items VALUES('019d292bf3977bdc92522cf5857eecda','dcr','approved','Tool calling reliability: idempotency, loop detection, workflow planning',replace('Improve tool call reliability for LLM agents. Observed failure: agent called create_note_tab 10 times with identical args instead of advancing to next step. The LLM''s self-diagnosis: orchestration failure, not tool failure. But Minerva can help prevent this.\n\n**Root causes (from LLM postmortem):**\n- Missing state transition after successful tool call\n- No duplicate-action guard\n- No idempotency check (created 10 tabs instead of reusing 1)\n- Over-eager intermediate narration without advancing\n\n**Four improvements:**\n\n1. **Idempotency in tool responses.** Tools that create resources (create_note_tab, create_chat, create_spreadsheet_editor, etc.) should detect duplicates and return `already_existed: true` instead of silently creating duplicates. The LLM sees "already existed" and knows to move on.\n\n2. **Duplicate call detection.** Track last N tool calls per session. If same tool called with identical arguments 2+ times in a row, return a warning: `"warning": "This exact call was already made. Consider advancing to the next step."` Doesn''t block — just warns.\n\n3. **Workflow hints for multi-step operations.** Add workflow hints to tool descriptions for common multi-step flows:\n   - "Create spreadsheet → populate → create chart → link to note"\n   - "Create note tab → create note → update note"\n   - Similar to the PCB workflow hints we already added\n\n4. **minerva_plan_workflow tool.** Given a goal description, returns a step-by-step plan with specific tool names and order. Pre-built recipes for common workflows + LLM-generated plans for novel goals. This is the most ambitious item — could be a separate DCR.\n\n**Impact:** Prevents agent loops, reduces wasted tool calls, improves Haiku reliability significantly. Items 1-2 are quick defensive wins. Item 3 is a content pass. Item 4 is a larger feature.','\n',char(10)),'2026-03-26T08:03:59','2026-03-26T15:00:51','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d292c265f7d55b5832aef517ab727','work_item','done','Add idempotency to resource-creating tools',replace('Tools that create resources should check for existing duplicates before creating.\n\n**Tools to update:**\n- minerva_create_note_tab: check if tab with same name exists → return it\n- minerva_create_chat: check if chat with same name exists → return it\n- minerva_create_text_editor: check if editor with same name/file exists → return it\n- minerva_create_spreadsheet_editor: same\n- minerva_create_graphics_editor: same\n- minerva_create_pcb_editor: same\n- minerva_create_video_editor: same\n- minerva_terminal_create: check if terminal with same name exists → return it\n\n**Return format when duplicate found:**\n```json\n{"success": true, "already_existed": true, "id": "existing_id", "name": "Corvette Test"}\n```\n\n**Behavior:** Don''t block creation — just detect and return the existing one. The LLM sees `already_existed: true` and knows to move on instead of creating another.\n\n**Test:** Call create_note_tab("Test") twice → second call returns already_existed: true.','\n',char(10)),'2026-03-26T08:04:12','2026-03-26T15:03:16','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d292bf3977bdc92522cf5857eecda',NULL);
INSERT INTO items VALUES('019d292c427f7fb193798b7accb4a7cc','work_item','done','Add duplicate call detection with warning',replace('Track recent tool calls and warn on exact duplicates.\n\n**Implementation in _execute_tool_impl:**\n- Maintain a ring buffer of last 5 calls: Array of {tool_name, arguments_hash}\n- Before executing, check if this exact call (name + args hash) matches the previous call\n- If duplicate: still execute, but add `"warning": "Identical call repeated. Consider advancing to the next step in your plan."` to the result\n- If 3+ consecutive identical calls: add stronger warning `"warning": "This tool has been called 3+ times with identical arguments. You are likely stuck in a loop. Stop and reassess your plan."`\n\n**Hash method:** JSON.stringify(arguments).sha256_text() — fast, deterministic\n\n**Does NOT block execution** — just adds warning field. The LLM sees it and self-corrects.\n\n**Test:** Call create_note_tab("X") 3 times → third call has loop warning.','\n',char(10)),'2026-03-26T08:04:19','2026-03-26T15:01:54','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d292bf3977bdc92522cf5857eecda',NULL);
INSERT INTO items VALUES('019d292c5f457b159c0a74d9295451e7','work_item','done','Add workflow hints for common multi-step operations',replace('Add multi-step workflow hints to tool descriptions for common flows.\n\n**Workflows to document in descriptions:**\n\nSpreadsheet workflow:\n- create_spreadsheet_editor: "After creating, use minerva_update_spreadsheet_data to add data, minerva_format_cells for styling, minerva_create_chart for visualization, and minerva_link_spreadsheet_to_note to save as a note."\n\nNote workflow:\n- create_note_tab: "After creating a tab, use minerva_create_note to add notes to it."\n- create_note: "After creating, the note is immediately available. Use minerva_update_note to modify content."\n\nChat workflow:\n- create_chat: "After creating, use minerva_set_system_prompt to configure, then minerva_send_message to start conversation."\n\nEditor workflow:\n- create_text_editor: "After creating, use minerva_update_editor to set content, minerva_save_editor to write to disk."\n\n**Pattern:** Each "create" tool''s description should end with "Next steps: ..." listing the typical follow-up tools.\n\nCan be done by Sonnet agent — mechanical description updates.','\n',char(10)),'2026-03-26T08:04:27','2026-03-26T15:03:24','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d292bf3977bdc92522cf5857eecda',NULL);
INSERT INTO items VALUES('019d292c803778078fe1f0fb24bee780','work_item','backlog','Design minerva_plan_workflow tool',replace('Design a tool that returns a step-by-step execution plan for a given goal.\n\n**Concept:**\n```\nminerva_plan_workflow(goal="create a spreadsheet about corvettes and save as a note")\n→ {\n  "steps": [\n    {"step": 1, "tool": "minerva_create_note_tab", "args": {"name": "Corvettes"}, "purpose": "Create a tab for the note"},\n    {"step": 2, "tool": "minerva_create_spreadsheet_editor", "args": {"name": "Corvette Data"}, "purpose": "Create spreadsheet"},\n    {"step": 3, "tool": "minerva_update_spreadsheet_data", "args": {}, "purpose": "Populate with corvette data"},\n    {"step": 4, "tool": "minerva_format_cells", "args": {}, "purpose": "Style the spreadsheet"},\n    {"step": 5, "tool": "minerva_link_spreadsheet_to_note", "args": {}, "purpose": "Link to the note tab"}\n  ]\n}\n```\n\n**Implementation options:**\nA. Pre-built recipes for common workflows (dictionary of goal keywords → plans)\nB. LLM-generated plans (call a small model to generate the plan — recursive tool use)\nC. Graph-based: tools have declared inputs/outputs, planner finds a path from goal to result\n\n**This is a research/design task.** Output: a design document, not code. Implementation is a follow-up DCR.\n\n**Questions to answer:**\n- How many workflows can we pre-build vs need dynamic planning?\n- Does the plan need to be editable by the user before execution?\n- Should the agent be required to follow the plan, or is it advisory?','\n',char(10)),'2026-03-26T08:04:35','2026-03-26T08:04:35','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d292bf3977bdc92522cf5857eecda',NULL);
INSERT INTO items VALUES('019d292c937c7f2fa231bcb175bcef7b','work_item','backlog','Write tests for idempotency and loop detection',replace('Tests for items 1 and 2.\n\n**Idempotency tests:**\n- create_note_tab("X") twice → second returns already_existed: true\n- create_chat("Y") twice → second returns already_existed: true\n- Different names → both create successfully (no false positive)\n\n**Loop detection tests:**\n- Same call 1x → no warning\n- Same call 2x → warning on second\n- Same call 3x → stronger warning on third\n- Different calls → no warning (not a loop)\n- Same tool, different args → no warning (different operation)\n\nHeadless testable with mock tool calls against _execute_tool_impl.','\n',char(10)),'2026-03-26T08:04:40','2026-03-26T08:04:40','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d292bf3977bdc92522cf5857eecda',NULL);
INSERT INTO items VALUES('019d2bc2aef478daa40618524db0cdd1','bug','new','format_cells crashes: bold/italic passed as String instead of bool to SpreadsheetCell',replace('SpreadsheetEditor.format_cell_with_history (line 1684) crashes when bold is passed as String "true" instead of bool true.\n\nStack: MinervaMCPServer._format_cells → SpreadsheetEditor.format_cell_with_history\nError: Invalid assignment of property or key ''bold'' with value of type ''String'' on a base object of type ''RefCounted (SpreadsheetCell)''\n\nRoot cause: MCP JSON deserializer may return booleans as strings. The _format_cells handler needs to coerce bool parameters before passing to SpreadsheetCell.\n\nFix: In _format_cells, add type coercion:\n```gdscript\nif arguments.has("bold"):\n    cell.bold = bool(arguments["bold"]) # or: arguments["bold"] == true or arguments["bold"] == "true"\n```','\n',char(10)),'2026-03-26T20:07:52','2026-03-26T20:07:52','','','',2,2,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2c56cdfd7b10853d20ee7864e3cc','work_item','backlog','ToolSearchIndex: keyword and wildcard+category queries return 0 results after reconnect',replace('Two search patterns that should work return empty results:\n\n1. **Keyword search**: `query: "spreadsheet"` → 0 results. Should match tools like `minerva_create_spreadsheet_editor`, `minerva_format_cells`, `minerva_update_spreadsheet_data`, etc.\n\n2. **Wildcard + category**: `query: "*", category: "spreadsheet"` → 0 results. Should return all tools in the spreadsheet category.\n\nObserved after MCP reconnect. Possible causes:\n- Search index not rebuilt on reconnect\n- Keywords not extracted from tool names/descriptions at registration time (e.g. "spreadsheet" not tokenized from `minerva_create_spreadsheet_editor`)\n- Category filter not matching registered categories','\n',char(10)),'2026-03-26T22:49:39','2026-03-26T22:49:39','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2c60c721721f95d4ff40c54922a1','bug','new','Spreadsheet bold/italic formatting has no visible effect — UI and MCP','Bold and italic properties are set on SpreadsheetCell but have no visible effect in the rendered spreadsheet. Affects both human UI (toolbar buttons) and MCP (minerva_format_cells). The cell.bold/cell.italic values are stored but never applied to the rendered text.','2026-03-26T23:00:33','2026-03-26T23:00:33','','','',2,2,NULL,NULL,replace('1. Create a spreadsheet with data\n2. Select cells, click Bold toolbar button (or call minerva_format_cells with bold:true)\n3. Observe: no visual change in the cell text','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2c8ed6557d62972757c29e9f8476','dcr','implementing','WebViewEditor: LLM-generated HTML panels in Minerva editor pane via Godot WRY',replace('## Problem\n\nMinerva''s vision extends beyond IDE — it should support any informational workflow: presentations, data analysis, movie-making, sales outreach, stock analysis, etc. Non-developer users need polished, custom UIs that both they and the LLM can drive. Current editor types (spreadsheet, text, graphics) aren''t visually rich enough for presentation-quality output.\n\n## Architecture Decision\n\n**Webview (Godot WRY) for all LLM-generated panels.** Dynamic GDScript was rejected after crash testing — infinite loops nearly crashed the entire PC, invalid API calls caused severe impact, no sandboxing possible. Webview provides full fault isolation (WebKitGTK runs in separate process), and LLMs excel at HTML/CSS/JS generation.\n\nExperiment validated at ~/gitlab/ccsandbox/experiments/rich-panel (Godot 4.6.1).\n\n## Solution: WebViewEditor Type\n\nA new `Editor.Type.WEBVIEW` that hosts a Godot WRY WebView control in the editor pane. The LLM generates HTML/CSS/JS content, Minerva renders it in the tab. Standard editor controls work: save to note, save to file (.html), save all.\n\n### Key Components\n\n**1. Godot WRY GDExtension integration**\n- Build godot_wry from source (v1.0.2 has GTK panic on Linux, need PR #79 fix)\n- Linux: libgtk-3-dev + libwebkit2gtk-4.1-dev + cargo build\n- Register in .godot/extension_list.cfg\n- Gotchas: set url="" before html, full_window_size=false\n\n**2. WebViewEditor.gd**\n- New script at src/Scripts/UI/Controls/WebViewEditor/WebViewEditor.gd\n- Extends Control, builds UI in _ready() (PCBEditor pattern)\n- Hosts WRY WebView node sized to fill the panel\n- Stores HTML source string for save/reload/note export\n- JS↔GDScript bridge for data access (read spreadsheets, notes, docket)\n- content_changed signal for unsaved indicator\n\n**3. Editor.gd integration**\n- Add WEBVIEW to Editor.Type enum\n- Add webview_editor var\n- Add match branch in Editor.create()\n- Hide irrelevant buttons (autowrap, syntax, find) in _ready()\n- get_saved_state() support\n- Save to file as .html\n- Save to note as rendered HTML or screenshot\n\n**4. MCP tools**\n- minerva_create_webview_panel(name, html) — create tab with HTML content\n- minerva_update_webview_panel(editor_name, html) — replace HTML content\n- minerva_get_webview_source(editor_name) — read current HTML source\n\n**5. JS↔Minerva bridge**\n- JS library injected into every panel: window.minerva.call(tool, args)\n- Routes through MCP HTTP server on localhost\n- Panels can read spreadsheet data, trigger workflows, update docket items\n- Buttons in the HTML can invoke MCP tools\n\n### Guiding Scenario: Web Dev Sales Guy\n\n1. Research law firms → co-browser + spreadsheet (existing)\n2. Competitive analysis → spreadsheet + charts (existing)\n3. Custom dashboard → LLM generates HTML with Chart.js/D3, opens in WebViewEditor tab. Polished, branded, animated.\n4. Video pitch → video recorder captures the dashboard walkthrough\n5. Outreach → email tool sends video + personal note\n6. Pipeline → docket tracks prospects\n\nThe sales guy never sees code. The LLM generates, iterates, and fixes the HTML invisibly.','\n',char(10)),'2026-03-26T23:50:51','2026-03-27T04:11:05','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2caefe867cfc9e38055ae7494d54','work_item','in_progress','rich-panel: Experimental test bed for LLM-generated runtime panels',replace('Experimental Godot app to empirically test approaches for LLM-generated UI panels in Minerva. Tests GDScript hot-loading vs webview rendering, measures crash behavior, and prototypes progressive disclosure UI for LLM work visibility.\n\nMotivated by research on DCR 019d2c8e (RuntimePanel). Located at ~/gitlab/ccsandbox/experiments/rich-panel.\n\nFour phases: (1) GDScript hot-load test bed, (2) Webview test bed, (3) MCP generation loop, (4) Progressive disclosure prototype.','\n',char(10)),'2026-03-27T00:25:59','2026-03-27T00:28:27','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2caf16187a33b58e73bbec2e4f7f','work_item','done','P1: Scaffold Godot project, main scene, CLAUDE.md','Create project.godot (4.6.1, gl_compatibility), main.tscn with split layout (CodeEdit left, PanelContainer right, build log bottom), CLAUDE.md with architecture and run commands. Follow ccsandbox experiment conventions.','2026-03-27T00:26:05','2026-03-27T00:32:11','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf2406773bb54ca60fd411b971','work_item','done','P1: Implement GDScript hot-loader (GDScript.new → reload → instantiate)','Core loader: takes GDScript source string, creates GDScript resource, sets source_code, calls reload(), checks for errors, instantiates into panel host container. Must handle reload() error return gracefully. Log all steps as structured events for build log consumption.','2026-03-27T00:26:08','2026-03-27T00:32:13','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf30a87cc4a0fa8f069de37b32','work_item','done','P1: Build control sidebar UI (CodeEdit, Load button, status)','Left sidebar: CodeEdit with GDScript syntax highlighting, "Load Panel" button, status label showing last load result (success/error). Dropdown to select from sample panels. Later: approach picker (GDScript vs webview).','2026-03-27T00:26:12','2026-03-27T00:34:24','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf3cc4753c9688714319f526ee','work_item','done','P1: Create sample GDScript panels (dashboard, cards, table)','3-4 sample GDScript panels that extend Control and demonstrate different UI patterns: (1) metric dashboard with StyleBoxFlat cards, (2) bar chart using _draw(), (3) sortable data table, (4) animated counter. These serve as baseline quality reference and LLM generation targets.','2026-03-27T00:26:15','2026-03-27T00:32:13','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf4ca67394b2e33ed130da6334','work_item','done','P1: Create crash scenario test scripts and document results','Create intentional crash scripts: (1) null reference access, (2) infinite loop in _process(), (3) stack overflow via recursion, (4) invalid API call, (5) resource exhaustion (spawn 10k nodes). Load each via the hot-loader, document: does Godot crash? Freeze? Recover? What error info survives? This is the key data point for the architecture decision.','2026-03-27T00:26:19','2026-03-27T00:34:24','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf5e5c71198182bd4f238a2ca7','work_item','done','P2: Evaluate Godot WRY plugin for 4.6.1 compatibility','Download and test Godot WRY (doceazedo/godot_wry) with Godot 4.6.1. Does it compile/load? Can it render a basic HTML page? Test on Linux first. If WRY fails, evaluate GDCef and godotwebview.com as fallbacks. Document: binary size impact, API surface, stability, input forwarding quality.','2026-03-27T00:26:23','2026-03-27T04:11:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf6a997d80a9f90e29a752679c','work_item','done','P2: Integrate webview loader + create HTML sample panels','Create webview_loader.gd that loads HTML/CSS/JS into a webview panel. Create HTML versions of the same sample panels from Phase 1 for direct comparison. Implement JS↔GDScript bridge for data passing (postMessage or equivalent).','2026-03-27T00:26:26','2026-03-27T04:11:10','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf78a976dfb1ede39eb776ff44','work_item','done','P2: Run crash isolation tests with webview and compare to GDScript','Same crash scenarios as Phase 1 but in webview: infinite JS loop, memory exhaustion, thrown exceptions, invalid DOM ops. Key question: does the webview crash kill Minerva or just the panel? Produce a comparison table: GDScript vs webview crash behavior for each scenario.','2026-03-27T00:26:30','2026-03-27T04:11:10','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf83567733a0c514e2445f9248','work_item','done','P3: Python MCP server with create_panel / update_panel tools','FastMCP server (stdio transport). Tools: create_panel(title, source, language), update_panel(id, source), get_panel_status(id). Each tool call includes step_description field for build log. Server pushes panel source to Godot via HTTP endpoint.','2026-03-27T00:26:33','2026-03-27T00:32:13','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf8f7278f5814ac4815569a982','work_item','done','P3: Godot-side MCP HTTP handler for panel operations','HTTP server in Godot (port 3030) accepting panel create/update requests from the Python MCP server. Routes to the appropriate loader (GDScript or webview). Returns structured status (success, error with details, panel screenshot if possible).','2026-03-27T00:26:36','2026-03-27T00:34:26','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2caf9da37e1fb48d49ed2ee83127','work_item','backlog','P3: End-to-end LLM generation test — describe → generate → render → iterate','Full loop test: user describes a dashboard in natural language → Claude generates panel code via MCP → Godot renders it → user gives feedback → Claude iterates. Test with both GDScript and HTML targets. Measure: iteration time, code quality, error recovery, how many rounds to a usable panel.','2026-03-27T00:26:39','2026-03-27T00:26:56','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2cafacdf7efd9facb50b5787c90f','work_item','done','P4: Build log UI — activity indicator + structured event log','Level 1: status bar with progress (building... N/M components). Level 2: collapsible build log showing human-readable narrative from structured step_description events. Timestamp, description, warnings, completion. Both GDScript (RichTextLabel) and webview (HTML) implementations for comparison.','2026-03-27T00:26:43','2026-03-27T00:34:26','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2cafb7f17a94b89bc9766a65b891','work_item','backlog','P4: Source + diff view — code inspection with iteration history','Level 3: syntax-highlighted source view with diffs between iterations. Build log entries link to code ranges. For webview approach: embed CodeMirror/Monaco. For GDScript approach: CodeEdit with custom highlighting. Show what changed and why on each iteration.','2026-03-27T00:26:46','2026-03-27T00:26:46','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2cb8513479abb13c189bcd376381','question','asked','Do LLM-generated panels need direct access to Minerva core services, or is LLM-as-broker sufficient?',replace('## Question\n\nWhen an LLM-generated panel needs data from Minerva core services (media-gen, model-chat, spreadsheets, etc.), what''s the right integration model?\n\nThree candidates:\n1. **Direct service access** — panel code calls Minerva services directly (GDScript: trivial via scene tree; webview: needs JS↔GDScript bridge or local HTTP API)\n2. **LLM-as-broker** — the LLM fetches data from services via MCP tools and "bakes" it into the panel source before loading. Panel is static/self-contained. LLM re-generates when data changes.\n3. **Hybrid** — LLM bakes initial data, panel has thin bridge for live updates (refresh button calls back through Minerva)\n\n## Why this matters\n\nOption 2 (LLM-as-broker) is simpler and works identically for both GDScript and webview panels — no bridge needed. But it means panels are snapshots, not live dashboards. Option 1 enables reactive UIs but requires the bridge infrastructure that differs per approach.\n\n## Initial thinking (from discussion with user)\n\nUser notes the LLM already has MCP access to core services and can bake data in or act as a broker. Direct panel→service access may not be needed for v1. Worth validating experimentally: mock a core service, test both patterns, see which the LLM generates more naturally and which produces better UX.\n\n## Test plan\n\n- Mock a simple service (e.g., fake media_gen returning placeholder images after delay)\n- Have LLM generate a panel using baked data (option 2)\n- Have LLM generate a panel with direct service call (option 1, GDScript path)\n- Compare: code complexity, user experience, iteration speed','\n',char(10)),'2026-03-27T00:36:10','2026-03-27T00:36:10','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2caefe867cfc9e38055ae7494d54',NULL);
INSERT INTO items VALUES('019d2d3502b37893aeb3cf57daf8a585','dcr','proposed','Sightline delivery architecture for Minerva: built-in Explore suite core plus modular capabilities',replace('Define how the long-term Explore tooling suite (currently being prototyped as Sightline) should be delivered as part of Minerva.\n\nProblem statement:\n- Minerva is a Godot app and the Explore tooling needs to ship as part of the product without requiring a separate install.\n- The suite should remain extensible over time, but the default delivery path should be reliable and cross-platform.\n- The tooling should support a plugin/capability model without making runtime compilation or dynamic native loading the only story.\n\nProposed architectural direction:\n- Ship a built-in Sightline core as a native component for Minerva, likely a Rust core with a GDExtension wrapper.\n- Treat the initial capability set as built-in modular capabilities registered with the core, even if statically linked.\n- Store runtime state, caches, indexes, artifacts, and optional downloaded capability assets under `user://sightline/`.\n- Treat on-device compilation (for advanced plugin development or optional capability builds) as an advanced or developer-mode path, not as the primary delivery mechanism.\n\nWhy this direction:\n- No extra install for end users.\n- Preserves a plugin/capability model logically without taking on the full complexity of dynamic native plugin loading on day one.\n- Gives Minerva a stable internal API for Explore/Inspect/Validate-style capability growth.\n- Keeps future optional capability bundles possible.\n\nDecision areas this DCR should cover:\n- core Rust/GDExtension boundary\n- internal capability registry model\n- built-in vs optional capability packaging\n- `user://` layout for caches, manifests, artifacts, and optional builds\n- update/install story for optional capabilities\n- long-term relationship between agent-facing capability discovery and the internal plugin registry\n\nDesired outcome:\nA delivery model that makes Sightline a first-class Minerva subsystem rather than an external tool, while still allowing incremental capability growth over time.','\n',char(10)),'2026-03-27T02:52:22','2026-03-27T02:52:22','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
INSERT INTO items VALUES('019d2d35039c77c79e7308de2be61a33','work_item','backlog','Define built-in Sightline delivery model for Minerva (GDExtension core, modular capabilities, user:// state)',replace('Capture the recommended delivery architecture for shipping Sightline as part of Minerva.\n\nRecommendation:\n- Build Sightline as a Rust core library with a GDExtension wrapper for Godot.\n- Ship the baseline Explore capability set inside Minerva as built-in modular capabilities rather than as a separately installed tool.\n- Use a runtime capability registry inside the core so built-in modules and future optional modules look the same to the rest of Minerva.\n- Store caches, indexes, session state, artifact handles, manifests, and related runtime data under `user://sightline/`.\n- If Minerva later supports user-extensible or downloadable capability modules, treat those as optional bundles. Keep on-device Rust compilation as a developer-mode or advanced path, not the baseline product path.\n\nWhy:\n- avoids extra install requirements\n- preserves a clean extensibility model\n- avoids making dynamic native plugin loading or runtime compilation mandatory for every user\n- keeps Minerva in control of cross-platform delivery and version compatibility\n\nSuggested subtopics:\n- internal capability registry API\n- built-in capability packaging strategy\n- optional bundle manifest format\n- `user://sightline/` directory layout\n- how agents discover available capabilities through the registry\n- when and whether downloaded bundles are compiled, loaded dynamically, or shipped as prebuilt artifacts','\n',char(10)),'2026-03-27T02:52:22','2026-03-27T02:57:20','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2d3502b37893aeb3cf57daf8a585',NULL);
INSERT INTO items VALUES('019d2d79d06b7621bb8e19a8abd8c84d','work_item','done','Integrate Godot WRY GDExtension into Minerva build',replace('Add Godot WRY as a GDExtension dependency to Minerva.\n\n1. Clone godot_wry repo, build from source (NOT v1.0.2 release — GTK panic on Linux)\n2. Linux deps: libgtk-3-dev, libwebkit2gtk-4.1-dev, cargo\n3. Copy libgodot_wry.so to src/bin/ or addons/godot_wry/bin/\n4. Add WRY.gdextension file\n5. Create/update .godot/extension_list.cfg with gdextension path\n6. Update scripts/build-extensions.sh to include WRY build step\n7. Verify WebView node is available in Godot after build\n\nReference: ~/gitlab/ccsandbox/experiments/rich-panel for working setup.\nGotchas documented in DCR comments #81 and #82.','\n',char(10)),'2026-03-27T04:07:31','2026-03-27T04:12:53','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d79efcd7a3399c14cccad1f09f2','work_item','done','Create WebViewEditor.gd control',replace('New script at src/Scripts/UI/Controls/WebViewEditor/WebViewEditor.gd following the PCBEditor pattern.\n\n1. Extends Control, builds UI in _build_ui() called from _ready()\n2. Creates WRY WebView node, sizes to fill panel\n3. Critical setup: webview.url = \"\" before setting html, webview.full_window_size = false\n4. Stores html_source: String for persistence and note export\n5. set_html(source: String) method — updates content and emits content_changed\n6. get_html() method — returns current source\n7. content_changed signal for dirty/unsaved tracking\n8. Simple .tscn scene wrapper (just the root Control node)\n\nDepends on: WRY GDExtension integrated (task 1)','\n',char(10)),'2026-03-27T04:07:39','2026-03-27T04:23:23','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d7a15d27c1ca3f7d9bd2e0bf876','work_item','done','Add WEBVIEW to Editor.Type enum and Editor.create()',replace('Wire WebViewEditor into the existing editor system. Follow the established pattern (see PCBEditor, SpreadsheetEditor).\n\n1. Add WEBVIEW to Editor.Type enum\n2. Add webview_editor var on Editor\n3. Add match branch in Editor.create() — instantiate WebViewEditor, add to vbox, connect content_changed\n4. In Editor._ready() — hide irrelevant buttons for WEBVIEW type (autowrap, syntax highlight, find, reload)\n5. Enable note check button for WEBVIEW (save to note)\n6. Add WEBVIEW to EditorPane.add() tab naming\n7. Add EditorPane helper: add_webview_editor(name) -> Editor\n\nDepends on: WebViewEditor.gd created (task 2)','\n',char(10)),'2026-03-27T04:07:48','2026-03-27T04:23:24','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d7a45bc7e138271aba23c73aa6e','work_item','backlog','Save/load support for WebViewEditor',replace('Persistence for webview panels.\n\n1. get_saved_state() — check if html_source matches last saved version\n2. Save to file — write html_source as .html file via FileDialog (add *.html filter)\n3. Load from file — read .html and call set_html()\n4. Save to note — export as HTML text note (markdown code block) or as screenshot (viewport capture of webview)\n5. Project save/load — include webview panels in .minproj with html_source and tab name\n6. Handle the \"save all\" flow for webview tabs\n\nDepends on: Editor.Type.WEBVIEW integration (task 3)','\n',char(10)),'2026-03-27T04:08:01','2026-03-27T04:08:01','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d7aae2a7341823122709eeef4f3','work_item','done','MCP tools: create, update, and read webview panels',replace('Register webview MCP tools in MinervaMCPServer.gd.\n\n1. minerva_create_webview_panel(name, html) — creates a WebViewEditor tab, sets HTML content, returns editor_name. Workflow hint: \"After creating, use minerva_update_webview_panel to modify content.\"\n2. minerva_update_webview_panel(editor_name, html) — replaces HTML content in existing tab. Supports iterative LLM development (generate → view → refine).\n3. minerva_get_webview_source(editor_name) — returns current HTML source string. Lets LLM read what''s currently rendered before making changes.\n\nRegistration: _register_webview_tools() in _init() chain, tool_set = \"editor\"\nHandler: _find_webview_editor(name) pattern (same as _find_spreadsheet_editor)\nAdd to tool search index with category \"editor\" or new \"webview\" category.\n\nDepends on: Editor.Type.WEBVIEW integration (task 3)','\n',char(10)),'2026-03-27T04:08:27','2026-03-27T04:23:24','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d7ad6237632a0e8251f4ec17d4b','work_item','backlog','JS↔Minerva bridge for webview panels',replace('A small JS library auto-injected into every webview panel that lets the HTML call back into Minerva.\n\n1. window.minerva.call(toolName, args) → Promise — routes to MCP HTTP server on localhost:9315\n2. Convenience helpers: minerva.getSpreadsheet(name), minerva.updateSpreadsheet(name, updates), minerva.createNote(title, content)\n3. Event listener: minerva.on(''data_changed'', callback) — notified when linked data changes\n4. The bridge JS is injected by WebViewEditor.gd before the panel''s HTML (prepended to source or injected via WRY''s JS evaluation)\n5. Authentication: local-only, no tokens needed (same-machine localhost)\n\nThis enables interactive panels — buttons, forms, live data binding. The sales guy clicks \"Send Pitch\" in the HTML dashboard and it triggers an MCP workflow.\n\nDepends on: MCP tools (task 5), WebViewEditor (task 2)','\n',char(10)),'2026-03-27T04:08:38','2026-03-27T04:08:38','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2d7b1d7d7eda81c775d85d595413','work_item','backlog','Cross-platform WRY build support (macOS + Windows)',replace('Extend WRY integration to macOS and Windows.\n\n- macOS: WRY uses WebKit natively, should build with just cargo. Verify rendering matches Linux.\n- Windows: WRY uses WebView2 (Edge). May need WebView2 runtime bundled or detected.\n- Update scripts/build-extensions.sh and scripts/build-extensions.ps1\n- Test full_window_size, url/html precedence, JS bridge on all platforms\n- Document platform-specific gotchas\n\nLower priority — Linux-first is fine for validation. But needed before any release.\n\nDepends on: Linux WRY integration working (task 1)','\n',char(10)),'2026-03-27T04:08:56','2026-03-27T04:08:56','','','',3,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2da826d2767abee88e0200714096','bug','new','WebViewEditor has extra vertical gap between toolbar and webview content',replace('The WebViewEditor tab has approximately one row of extra vertical space between the ButtonsHBoxContainer toolbar and the start of the webview content. Other editor types that hide the toolbar entirely (LOGS, KANBAN, ACTIVITY_LOG) don''t have this issue.\n\n## Attempted fixes (all failed)\n\n1. **Hide entire ButtonsHBoxContainer** — removed the gap but also removed all editor controls (save, note toggle, create note). Reverted.\n\n2. **Hide individual text-editing buttons** (mic, autowrap, syntax, find, diff, reload, export) while keeping container visible — gap persists. The hidden buttons aren''t causing it.\n\n3. **Hide spacer nodes** ($VBoxContainer/Control, $VBoxContainer/FillerControl3) — gap persists even with .hide().\n\n4. **queue_free() spacer nodes + TextureRect** — freed Control, FillerControl3, and TextureRect (which has size_flags_vertical=EXPAND_FILL). Gap still present.\n\n## Likely root cause\n\nThe VBoxContainer has theme_override_constants/separation = 10 (Editor.tscn line 65). Even after removing spacer nodes, there are still hidden children (FindStringContainer) that may occupy layout space, or the separation between ButtonsHBoxContainer and the webview child itself creates the gap.\n\n## Potential fixes to try\n\n- Set VBoxContainer separation to 0 for WEBVIEW type\n- Check if FindStringContainer.hide() still occupies space (try queue_free)\n- Inspect at runtime with Godot remote debugger to see which node is taking the space\n- The webview Control itself may have margin/offset that creates the gap','\n',char(10)),'2026-03-27T04:58:07','2026-03-27T04:58:07','','','',3,3,NULL,NULL,replace('1. Create a webview panel via MCP: minerva_create_webview_panel(name, html)\n2. Observe the gap between the top toolbar row and the webview content\n3. Compare with a text editor tab — the text editor content starts immediately below the toolbar','\n',char(10)),NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2db67d1678a6bbf5fa21934311a5','dcr','implementing','WebView note type: render HTML/charts visually in notes pane',replace('## Problem\n\nWhen saving a webview panel to a note, the raw HTML source is stored and displayed. Users expect to see the rendered chart/dashboard in the note itself. The current text-note approach forces users to look at HTML code instead of the visual output they created.\n\n## Solution: HTML Note Type\n\nAdd a new note type that renders HTML content using a WRY WebView control in the notes pane. This enables:\n- Charts and dashboards visible directly in notes\n- Markdown preview notes\n- Mixed-media formatted content\n- Edit button opens the HTML in a WebViewEditor tab\n\n## Architecture\n\n### WebView in Notes\n- Add HTML to Note types (alongside text, image, audio, video)\n- HTML notes render using a WRY WebView control instead of RichTextLabel\n- The WebView is sized to the note''s area, displays the rendered HTML\n- Edit button opens the HTML source in a WebViewEditor tab in the editor pane\n- Changes in the WebViewEditor sync back to the note\n\n### Performance: Lazy Loading\n- WRY WebViews are OS-native (WebKitGTK) — lightweight but not free\n- Only create WebView instances for notes currently visible on screen\n- Destroy/recycle WebViews when notes scroll off-screen\n- Show a static placeholder (thumbnail or \"HTML Note\" label) when not visible\n- This keeps memory bounded regardless of how many HTML notes exist\n\n### MCP Integration\n- minerva_create_note with type=html creates an HTML note\n- Save from WebViewEditor creates/updates the linked HTML note\n- get_note returns the HTML source for HTML notes\n\n### Future Possibilities\n- Markdown notes rendered via HTML (markdown→HTML conversion)\n- Mixed-media notes: text + embedded charts + images all in one HTML document\n- Interactive notes: JS bridge enables buttons/forms within notes\n- Note templates: pre-built HTML layouts for common patterns (dashboard, report, presentation slide)','\n',char(10)),'2026-03-27T05:13:47','2026-03-27T05:23:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2c8ed6557d62972757c29e9f8476',NULL);
INSERT INTO items VALUES('019d2db6b5777cc7a430d0f4f8d7a8a0','work_item','backlog','Add HTML note type to Note system',replace('Add HTML as a note type in the Note data model.\n\n1. Add HTML to Note type enum/constants (alongside text, image, audio, video)\n2. Note.create_html_note(title, html_source) factory method\n3. HTML notes store the source string (same as text notes store text)\n4. Serialization: save/load HTML notes in project files and note threads\n5. Note.Proxy support for HTML notes (for injection into chat if needed)\n\nThis is the data model change only — no rendering yet.','\n',char(10)),'2026-03-27T05:14:01','2026-03-27T05:14:01','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d2db6c9e8786290c6a22a31d4092f','work_item','backlog','Render HTML notes with WebView in notes pane',replace('When an HTML note is displayed in the notes pane, render it using a WRY WebView control instead of RichTextLabel.\n\n1. In Note.gd (or wherever note UI is built), detect HTML note type\n2. Create a WebView control (via ClassDB.instantiate) sized to the note area\n3. Set url=\"\", full_window_size=false, html=source (same pattern as WebViewEditor)\n4. Inject the Minerva JS bridge for interactivity\n5. Fallback: if WebView addon not installed, show HTML as code block in RichTextLabel\n6. Note height: either fixed height (e.g., 300px) or auto-size based on content\n\nDepends on: HTML note type in data model (task 1)','\n',char(10)),'2026-03-27T05:14:07','2026-03-27T05:14:07','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d2db6dcca7afa989f377c8500f867','work_item','backlog','Hard cap: max 3 concurrent WebViews in notes pane (LRU eviction)',replace('Resource control for HTML notes. Moved from Phase 3 optimization to Phase 1 requirement.\n\n1. Track active note WebViews in an Array on the notes pane (or a shared manager)\n2. When creating a WebView for an HTML note, check if count >= 3\n3. If at cap, destroy the oldest (LRU) WebView and replace with placeholder\n4. Placeholder shows note title + clickable "HTML Note — click to preview"\n5. Clicking placeholder creates a WebView (and evicts oldest if needed)\n6. Edit button always works regardless of WebView state — opens WebViewEditor tab\n7. Configurable cap via constant (default 3), can expose in preferences later\n\nThis runs inside the rendering task (task 2) — not a separate implementation. Integrate directly into the HTML note rendering code.\n\nDepends on: HTML note type (task 1), rendering (task 2)','\n',char(10)),'2026-03-27T05:14:12','2026-03-27T05:18:09','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d2db6ec6a79c6beca782503fce862','work_item','backlog','Edit button: open HTML note in WebViewEditor',replace('When the user clicks the edit button on an HTML note, open the HTML source in a WebViewEditor tab in the editor pane.\n\n1. Detect HTML note type in the edit button handler\n2. Create a WebViewEditor tab (via EditorPane.add_webview_editor) with the note''s HTML\n3. Set the note as the associated_object on the Editor so changes sync back\n4. When the WebViewEditor content changes, update the linked note\n5. When saved, the note''s HTML source is updated and the note re-renders\n\nDepends on: HTML note rendering (task 2), WebViewEditor already exists (Phase 1)','\n',char(10)),'2026-03-27T05:14:16','2026-03-27T05:14:16','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d2db6fddc7d4ca68341000f773077','work_item','backlog','Wire WebViewEditor save-to-note to create HTML notes',replace('Update the WebViewEditor''s create-note-button handler to create HTML notes instead of text notes.\n\n1. In Editor.gd _on_create_note_button_pressed, change the WEBVIEW case from Note.create_text_note to Note.create_html_note\n2. The note should display the rendered webview, not raw HTML code\n3. If the editor has an existing linked note, update it instead of creating a new one\n\nDepends on: HTML note type (task 1)','\n',char(10)),'2026-03-27T05:14:20','2026-03-27T05:14:20','','','',1,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d2db70c50760086525702aacd6c51','work_item','backlog','MCP support for HTML notes',replace('Enable MCP tools to create and read HTML notes.\n\n1. minerva_create_note: accept type=html parameter, create HTML note with provided content\n2. minerva_get_note: return HTML source for HTML notes\n3. minerva_update_note: update HTML content for HTML notes\n4. minerva_link_webview_to_note: convenience tool that takes a webview editor_name and creates/updates a linked HTML note (similar to minerva_link_spreadsheet_to_note)\n\nDepends on: HTML note type (task 1)','\n',char(10)),'2026-03-27T05:14:24','2026-03-27T05:14:24','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'minerva:019d2db67d1678a6bbf5fa21934311a5',NULL);
INSERT INTO items VALUES('019d301392b77fd6a137ca7f6dfd28cf','work_item','backlog','Investigate vertical misalignment of WRY WebView in editor pane and HTML notes','Bug: the native WRY-backed WebView renders vertically shifted downward when embedded both in the center editor pane (''webview editor'') and inside HTML notes. The visible effect is that the webview content overflows down relative to its intended container slot.','2026-03-27T16:14:42','2026-03-27T16:25:50','','','',2,0,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,0,0,NULL,'',NULL);
