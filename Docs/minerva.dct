INSERT INTO item_events VALUES(521,'019cc71fd07d7a139723be42b7c6fb2d','transition','agent','2026-03-07T07:47:36','in_progress → done. TTS playback implemented in ChatPane._voice_speak_response() with AudioStreamWAV parsing, volume control from VoiceConfig. Per-message playback controls and audio caching deferred to Phase 2.');
INSERT INTO item_events VALUES(522,'019cc71fe5ca76ef8d1f03713d2bba56','transition','agent','2026-03-07T07:47:37','backlog → open');
