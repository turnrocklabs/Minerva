INSERT INTO item_events VALUES(60,'DKT-0002','transition','agent','2026-03-02T17:54:44','triaged → closed. Fixed: plan_task_ids_used tracks which tasks produced output. _check_generation_completeness() validates file-to-task mapping. Test: test_task_completeness.py');
INSERT INTO item_events VALUES(61,'DKT-0003','transition','agent','2026-03-02T17:54:46','triaged → closed. Fixed: max_tokens auto-increase now applies to ALL agents unconditionally (line 896-900). Dynamic scaling up to 32000. Test: test_review_max_tokens.py');
INSERT INTO item_events VALUES(62,'DKT-0006','transition','agent','2026-03-02T17:54:47','triaged → closed. Fixed: warning guarded by session_id_provided — only fires when continuing sessions, not new generation.');
INSERT INTO item_events VALUES(63,'DKT-0010','transition','agent','2026-03-02T17:54:49','triaged → closed. Fixed: godot_validators.py ProjectGodotValidator.validate() now checks run/main_scene exists and points to real file.');
INSERT INTO item_events VALUES(64,'DKT-0011','transition','agent','2026-03-02T17:54:50','triaged → closed. Fixed: _calculate_next_iteration() reads last_iteration from storage and increments. Test: test_iteration_tracking.py');
INSERT INTO item_events VALUES(65,'DKT-0013','transition','agent','2026-03-02T17:54:52','triaged → closed. Fixed: _parse_planning_response() now has 6+ fallback strategies including _extract_json_block() that finds first { and matches to closing }. Handles truncated JSON by closing open brackets.');
INSERT INTO item_events VALUES(66,'DKT-0014','transition','agent','2026-03-02T17:54:54','triaged → closed. Fixed: _git_revert_head() now uses git reset --hard HEAD~1 as primary strategy with git checkout fallback. Returns False only if both fail.');
INSERT INTO item_events VALUES(67,'DKT-0015','transition','agent','2026-03-02T17:54:56','triaged → closed. Fixed: tasks_started notification only sent when selected_tasks is non-empty, preventing UI from getting stuck waiting for a transition that won''t come.');
INSERT INTO item_events VALUES(68,'DKT-0016','transition','agent','2026-03-02T17:54:58','triaged → closed. Fixed: _has_new_errors() now uses error-line counting via _is_error_line() pattern matching instead of raw output size comparison. Non-error output growth is ignored. Test: test_validation_regression.py');
INSERT INTO item_events VALUES(69,'DKT-0017','transition','agent','2026-03-02T17:54:59','triaged → closed. Fixed: godot_validators.py validates ExtResource declarations against actual resource definitions. Detects missing assets and unreferenced ext_resources.');
INSERT INTO item_events VALUES(70,'DKT-0023','transition','agent','2026-03-02T17:55:01','triaged → closed. Fixed: when run_review=False, system transitions to awaiting_user (not complete). Human approval gate is now independent of AI review setting.');
INSERT INTO item_events VALUES(71,'DKT-0024','transition','agent','2026-03-02T17:55:03','triaged → closed. Fixed: _handle_request_review() detects whether input is UUID or model name string. Non-UUIDs become model_override, UUIDs resolve to agent configs.');
INSERT INTO item_events VALUES(72,'DKT-0028','transition','agent','2026-03-02T17:55:04','triaged → closed. Fixed: ReviewModelConfig now has configurable timeout_seconds field (default 120). Custom agents can specify their own timeout. Test: test_configurable_timeout.py');
INSERT INTO item_events VALUES(73,'DKT-0029','transition','agent','2026-03-02T17:55:06','triaged → closed. Fixed: tasks now explicitly set to in_progress when generation starts (line 8696), then transition to review on completion. Proper plan → in_progress → review → done flow.');
