CREATE TABLE attachments (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
		filename TEXT NOT NULL,
		mime_type TEXT DEFAULT 'application/octet-stream',
		size_bytes INTEGER DEFAULT 0,
		data BLOB NOT NULL,
		created_at TEXT NOT NULL,
		description TEXT DEFAULT ''
	);
CREATE TABLE comments (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
		parent_id INTEGER DEFAULT 0,
		author TEXT NOT NULL DEFAULT '',
		text TEXT NOT NULL DEFAULT '',
		status TEXT NOT NULL DEFAULT 'open',
		created_at TEXT NOT NULL,
		resolved_at TEXT DEFAULT '',
		resolved_by TEXT DEFAULT ''
	);
INSERT INTO comments VALUES(1,'DKT-0004',0,'imran','This is a good bug to attack -- we should investigate this. Moving to Triaged.','open','2026-03-02T17:59:25','','');
INSERT INTO comments VALUES(2,'DKT-0007',0,'imran','Another good one -- investiaget this and come back with a plan','open','2026-03-02T18:00:05','','');
INSERT INTO comments VALUES(3,'DKT-0004',0,'claude',replace('## Investigation Results — Message Queue Overflow\n\n### Server-Side Findings (minervaservices)\n\n**Queue Implementation** — `infrastructure/minerva-services/minerva/service.py`\n- Queue is a hardcoded 50K `asyncio.Queue(maxsize=50000)` (line 1135)\n- Comment says: "Increased queue size to 50000 for high-throughput streaming scenarios"\n- Overflow handling (lines 1153-1155): `put_nowait()` wrapped in try/except, drops with `print()` only — no logger, no metric, no counter\n- **Single worker** task (`_message_handler_worker`, lines 1108-1130) processes ALL messages sequentially via `text_message_received()`\n\n**LLM Streaming Volume** — `autocoder-orchestrator/autocoder.py`\n- `_stream_llm_traffic()` (lines 5216-5342) stays open for entire session, fires hundreds of `response_chunk` events/sec\n- Each chunk triggers `_publish_to_core()` → `ws.send(json.dumps(notification))` (line 5398)\n- During review, 3 agents × token streaming = massive event throughput\n\n**Status Notification Path** — `autocoder.py`\n- `_update_review_state()` (lines 1873-1949) persists to storage via DBProxy → succeeds ✓\n- `_multicast_iteration()` (lines 5776-5901) sends pub/sub notification via 2x `ws.send()` → fire-and-forget, can be dropped ✗\n- **Result**: DB has `review_state="awaiting_user"` but client never receives the notification\n\n**No Priority Mechanism**: All messages (streaming chunks AND critical status updates) enter the same queue with identical priority. No differentiation.\n\n### Client-Side Findings (Minerva Godot)\n\n**WebSocket Buffer Conflict** — `core_client.gd`\n- Lines 89-90: Global project settings cap at 16384 KB (16 MB)\n- Lines 185-187: Per-socket `inbound_buffer_size = 32 MB`, `max_queued_packets = 10000`\n- Godot enforces the SMALLER limit — the 32 MB setting may be ineffective\n\n**Single-Frame Processing** — `core_client.gd:211-272`\n- `_process()` calls `_client.poll()` then processes packets in a while loop\n- No backpressure mechanism — doesn''t tell server to slow down\n\n**Signal Race Condition** — `AutocoderManager.gd:442-596`\n- `_subscribe_to_session()` sets up handlers with `receive_all().connect()`\n- Messages arriving between subscription and signal connection are LOST\n\n**Event Buffer Cap** — `AutocoderManager.gd:46-55`\n- `MAX_EVENTS_PER_SESSION = 200` with FIFO eviction (oldest dropped)\n- Fast iterations easily exceed 200 events\n\n**No Guaranteed Delivery**: Status notifications (`awaiting_user`) are one-shot. If missed, client sees no approval card and job appears stuck. No client-side retry or polling fallback.\n\n### Root Cause Summary\n\nCascade of failures across 3 layers:\n1. **Server**: 50K queue fills during LLM streaming → status messages silently dropped\n2. **Protocol**: Pub/sub is fire-and-forget, no ACK, no retry for critical messages\n3. **Client**: Undersized buffers + single-frame processing + no guaranteed delivery\n\n**Recommendation**: This is a systemic, multi-layer issue that warrants a full 5-Why RCA to decompose contributing factors and plan a layered fix.','\n',char(10)),'accepted','2026-03-02T18:07:57','2026-03-02T18:17:40','imran');
INSERT INTO comments VALUES(4,'DKT-0007',0,'claude',replace('## Investigation Results — Review Agent 120s Timeout\n\n### Timeout Locations (3 places)\n\n1. **HTTP Client Default** — `review_executor.py:33`: `httpx.AsyncClient(timeout=120.0)` — hardcoded, but overridden per-request\n2. **Per-Request Timeout** — `review_executor.py:937,1347`: Uses `model_config.timeout_seconds` — already dynamic\n3. **Default in Config** — `review_models.py:37`: `timeout_seconds: int = 120` — dataclass default\n\n### Key Finding: Per-Agent Timeout IS ALREADY CONFIGURABLE\n\nCustom agents can specify `timeout_seconds` (30-600s range) when created:\n- Schema defined in `autocoder.py:902-906`\n- Applied in `review_executor.py:2437-2438`: `custom_model.timeout_seconds = agent["timeout_seconds"]`\n- Test file `test_configurable_timeout.py` verifies the feature works\n\n### Retry Loop Structure (The Real Problem)\n\n`review_executor.py:890-1310`:\n- **Per tool iteration**: up to `max_retries=3` attempts with backoff [1s, 2s, 4s]\n- **Tool iterations**: up to 25 iterations\n- **Final JSON call**: 3 more attempts after tool iterations exhausted\n- **Total potential**: 75 tool requests + 3 final JSON = **78 HTTP requests per agent**\n\nWhen a verbose model (gpt-5.2) times out:\n1. Attempt 1: 120s wait → timeout → 1s backoff\n2. Attempt 2: 120s wait → timeout → 2s backoff\n3. Attempt 3: 120s wait → timeout → exit retry loop\n4. Move to next tool iteration → repeat cycle\n5. **Worst case**: 78 × 120s = 2.6 hours of retrying before giving up\n\n### Findings Lost on Timeout\n\n`review_executor.py:1618-1628`: On timeout, returns empty ReviewResult:\n```python\nresult = ReviewResult(model_id=..., approved=False, summary=f"Review failed: {error}", issues=[], error=error)\n```\n- **All accumulated tool findings are DISCARDED** — not preserved in partial result\n- If agent spent 14+ tool calls gathering data then times out on final JSON synthesis → all findings lost\n\n### No Orchestrator-Level Retry\n\n`autocoder.py:2761-2767`: Review phase runs ONCE. No automatic restart after timeout. Timeout is catastrophic for the review phase.\n\n### Client-Side UX Gap (Minerva Godot)\n\n- No client-side timeout countdown or per-agent progress bars\n- No indication of WHICH agent timed out when multiple agents are used\n- Shows only final result as approval card (success/failure)\n- Error display: generic toast "Generation error: ..." — not timeout-specific\n\n### Root Cause Summary\n\nThe 120s default is too low for verbose models, but the fix path is clear:\n\n1. **Already done**: Per-agent `timeout_seconds` is configurable (30-600s)\n2. **Missing**: Users don''t know about it — no documentation or UI exposure\n3. **Missing**: No model-aware defaults (fast models → 120s, verbose → 180-300s)\n4. **Missing**: Partial result preservation on timeout (accumulated tool findings discarded)\n5. **Missing**: Adaptive timeout for final JSON synthesis (should be longer than tool calls)\n6. **Missing**: Client-side per-agent progress/timeout visibility\n\n**Recommendation**: This does NOT need a full 5-Why RCA. The root cause is clear. Needs a DCR to: (a) increase default to 180s, (b) add model-tier-based defaults, (c) preserve partial results on timeout, (d) expose timeout_seconds in Minerva agent editor UI.','\n',char(10)),'accepted','2026-03-02T18:08:16','2026-03-02T18:19:21','imran');
INSERT INTO comments VALUES(5,'DKT-0004',0,'imran','I accept that an RCA is needed. Also, can we architect without a queue, or is it there for some important reason? If we need a queue -- why such a small one? is it 50k per transaction? Or is it a global 50k? I''f it''s per transaction, that might cretee memory pressure. Maybe we could do a single large, shared queue, and make it huge -- like 20-30mb?','open','2026-03-02T18:18:59','','');
INSERT INTO comments VALUES(6,'DKT-0004',0,'claude',replace('## Answering Architecture Questions\n\n**Q: Is it 50K per transaction or global?**\nIt''s **one 50K queue per service instance** — global to the orchestrator. Created in `_legacy_message_loop()` on `self._message_queue` (service.py:1135). Since the orchestrator is a single process with one WebSocket connection, all messages (streaming, status, storage responses) share this single queue. Not per-transaction, so no memory pressure from multiple queues.\n\n**Q: Can we architect without a queue?**\nYes — the newer `_message_loop()` (service.py:1042-1090) already does direct `await text_message_received()` without any queue. However, the `network_resilience` module it depends on doesn''t exist yet (`minerva/network_resilience.py` is missing), so ALL services currently fall through to `_single_connection_attempt()` → `_legacy_message_loop()` → the 50K queue.\n\nThe queue was added to decouple WebSocket receiving from handler execution (so slow handlers don''t block the receive loop). The non-queue path blocks on `await text_message_received()`, but the autocoder already spawns long-running handlers as background tasks (`_spawn_background_handler`, service.py:1184), so the direct-await path should be fast enough.\n\n**Q: Why not a single large shared queue (20-30MB)?**\nBigger queue delays the problem but doesn''t solve it. The issue isn''t queue capacity — it''s that hundreds of streaming events/sec eventually saturate ANY fixed-size queue. Even at 20-30MB, a 3-agent review streaming 1KB chunks at 300/sec would fill 30MB in ~100 seconds.\n\n**Better approaches (from RCA):**\n1. **Eliminate the queue** — switch to `_message_loop()` (needs network_resilience module or removing the gate)\n2. **Priority separation** — if keeping a queue, use 2 queues: high-priority (status/control) + low-priority (streaming), with the worker always draining high-priority first\n3. **Client-side polling fallback** — periodic `/session-state` poll catches any missed `awaiting_user` notifications regardless of queue behavior','\n',char(10)),'open','2026-03-02T18:21:55','','');
INSERT INTO comments VALUES(7,'019cbedf0a9d78539b96eddbb41a794a',0,'claude',replace('## Investigation Findings\n\n**Root cause:** `SubmitJob.gd:215-220` uses Godot''s global `_input()` to capture Ctrl+Enter unconditionally. This fires before ChatPane''s `_gui_input()` handler (Godot processes `_input()` before `_gui_input()`), so the keystroke never reaches the chat handler. No mode check exists — even when autocoder is hidden, the handler intercepts and marks input as handled.\n\n**Key files:**\n- `src/Scripts/UI/Controls/Autocoder/manager/SubmitJob.gd:215-220` — global `_input()` handler, no visibility guard\n- `src/Scripts/UI/Views/ChatPane.gd:2169-2172` — correct chat handler via `_gui_input()`, never reached\n- `src/Scenes/chat.gd:224-268` — mode tracking via `current_service_type`\n\n**Fix:** Add visibility or focus check to SubmitJob''s `_input()`. Best approach: check if autocoder''s prompt TextEdit has focus before intercepting. ~5 lines changed in 1 file.','\n',char(10)),'open','2026-03-05T17:18:29','','');
INSERT INTO comments VALUES(8,'019cbc3fa4d074468a47bb9699e13bba',0,'claude',replace('## Investigation Findings\n\n**Root cause:** Each provider''s `Format()` function maps `ChatRole.SYSTEM` → `{"role": "system"}` in the messages array. Providers already handle system prompts correctly at the top level in `generate_content()` (Anthropic: `"system"` param, Google: `"system_instruction"`, OpenAI/Ollama: prepend to messages), but `Format()` also emits them in the array — causing duplicates or API rejections.\n\n**Google is the only correct provider** — its `Format()` returns `null` for SYSTEM role (line 214-216).\n\n**Files to fix (same pattern — return `null` for SYSTEM role in `Format()`):**\n- `AnthropicProvider.gd:156-157`\n- `OpenAIProvider.gd:159-160`\n- `OpenRouterProvider.gd:191-192`\n- `OllamaProvider.gd:83-84`\n\n**ChatPane.gd:590-642** has `_build_history_list_with_system_prompt()` which attempts to filter SYSTEM messages for providers with `supports_system_prompt == true`, but the `Format()` bug means SYSTEM messages still leak through when that flag isn''t set correctly.\n\n4 files, same 2-line fix each.','\n',char(10)),'open','2026-03-05T17:18:36','','');
INSERT INTO comments VALUES(9,'019cbee2d4667f9eafa6474b014438d3',0,'claude',replace('## Investigation Findings\n\n**Root cause:** `regenerate_response()` (ChatPane.gd:692) never increments `_active_chat_requests` and never enables the cancel button (`audio_stop_1`). The normal send flow (`execute_regular_chat`) does both at lines 936-937, but regenerate skips them.\n\n**Bug flow:**\n1. User clicks Regenerate → `regenerate_response()` called\n2. `_active_chat_requests` NOT incremented, `audio_stop_1` NOT enabled\n3. `loading = true` set on message node → `_toggle_controls(false)` disables all message buttons\n4. Request stalls → cancel button was never enabled → user stuck\n\n**Fix:** Add `_active_chat_requests += 1` and `audio_stop_1.disabled = false` at the start of `regenerate_response()` (after line 707), and corresponding decrement/disable at all exit points (lines 758, 806).\n\n1 file, ~6 lines added.','\n',char(10)),'open','2026-03-05T17:18:39','','');
INSERT INTO comments VALUES(10,'019cbc3fa4d074468a47bb9699e13bba',0,'claude',replace('## Updated Investigation — Root Cause Refined\n\nOriginal diagnosis (fix in each provider''s Format()) was wrong. The real bug is in ChatPane.gd:628-629.\n\n**`_format_with_system_prompt_handling()` line 628-629:**\n```gdscript\nif chat.Role == ChatHistoryItem.ChatRole.SYSTEM:\n    if agent_mode or not provider.supports_system_prompt:\n        return null\n```\n\nThis filters SYSTEM messages only when `supports_system_prompt` is **false**. But providers with `supports_system_prompt = true` (Anthropic, Google) handle system prompts at the top level in `generate_content()` — they also need the SYSTEM item filtered from messages.\n\n**Condition is inverted.** Should be:\n```gdscript\nif agent_mode or provider.supports_system_prompt:\n    return null\n```\n\nFor providers WITHOUT system prompt support (OpenAI-style), the SYSTEM item should still pass through because line 633-640 prepends it to the first user message.\n\n**Fix:** One-character change in ChatPane.gd:629 — remove the `not`.','\n',char(10)),'open','2026-03-05T17:33:57','','');
INSERT INTO comments VALUES(11,'019cbf10148e7d27a5c6ba078d0523bd',0,'claude',replace('## Investigation Findings\n\n**MinervaMCPServer.gd:1740-1745** — `_set_system_prompt()` sets `HasUsedSystemPrompt = true` but never sets `SystemPromptEnabled = true`.\n\n**ChatPane.gd:527** requires both:\n```gdscript\nelif history.SystemPromptEnabled and history.HasUsedSystemPrompt and not history.HistoryItemList.is_empty():\n```\n\nSince `SystemPromptEnabled` stays false, `effective_system_prompt` is never populated, so `provider.system_prompt` stays empty. The top-level `"system"` param in the API request is empty string.\n\n**Fix:** Add `history.SystemPromptEnabled = true` in MinervaMCPServer.gd after line 1745.','\n',char(10)),'open','2026-03-05T17:34:00','','');
INSERT INTO comments VALUES(12,'019cbee2d4667f9eafa6474b014438d3',0,'claude',replace('## Detailed Investigation — Code Trace\n\n**Normal send flow** (`execute_regular_chat`, line 932+):\n- Line 936: `_active_chat_requests += 1`\n- Line 937: `audio_stop_1.disabled = false` (enables cancel button)\n- ... API call ...\n- Line 1038: `_active_chat_requests -= 1`\n- Line 1041: `audio_stop_1.disabled = true` (if counter hits 0)\n\n**Regenerate flow** (`regenerate_response`, line 692+):\n- Line 747: `create_prompt()` — builds history\n- Line 753: `existing_response.rendered_node.loading = true`\n- Line 755: `await history.provider.generate_content(history_list)` — API call\n- Line 758: early return on error\n- Line 784/793: `existing_response.rendered_node.loading = false`\n- **MISSING: No `_active_chat_requests` increment, no `audio_stop_1.disabled = false`**\n\n**Stop button handler** (`_on_audio_stop_1_pressed`, line 2202):\n- Line 2203: `if _active_chat_requests > 0:` — guards all cancellation logic\n- Even if button were enabled, counter is 0 so cancel would no-op\n\n**Two things missing in `regenerate_response()`:**\n1. Increment `_active_chat_requests` and enable cancel button before the API call (after line 747)\n2. Decrement `_active_chat_requests` and conditionally disable cancel button at all exit points (line 758 early return, and after line 793/787 normal completion)\n\n**Files:** ChatPane.gd only — add ~6 lines mirroring the pattern from execute_regular_chat.','\n',char(10)),'open','2026-03-05T17:38:58','','');
INSERT INTO comments VALUES(13,'019cbef3897b7299a409548623391896',0,'claude',replace('## Research Findings\n\n### What Already Exists\n\n**Summarization (agent mode only) — ChatPane.gd:192-273:**\n- Auto-triggers when agent context exceeds 60k tokens (configurable per-chat)\n- Keeps system prompt + last 6 messages, replaces older messages with a USER-role summary\n- Summary includes: message counts, first 200 chars of each user message, tool names called\n- Triggered at ChatPane.gd:1250-1253 during agent mode context checks\n- **Limitation:** Only works in agent mode. Regular chats have no compaction.\n\n**Token estimation — per-provider:**\n- Word-based (~1.335 tokens/word) in OpenAI/Anthropic providers\n- ChatPane.gd:143-153 has `estimate_agent_context_size()` using 4 chars/token\n- ChatHistoryItem tracks: EstimatedTokenCost (quick), InputTokens (actual), OutputTokens (actual)\n\n**Context thresholds — ChatPane.gd:27-32:**\n- AGENT_CONTEXT_WARNING_THRESHOLD: 80k tokens\n- AGENT_CONTEXT_HARD_LIMIT: 100k tokens\n- AGENT_SUMMARIZE_THRESHOLD: 60k tokens\n- AGENT_KEEP_RECENT_MESSAGES: 6\n- Per-chat overrides via ServiceHistory fields (AgentContextWarningThreshold, etc.)\n\n**Persistence — ProjectMenuActions.gd:141-231:**\n- Chats serialized as JSON inside .minproject ZIP files\n- Full history preserved: all messages, tokens, images (base64), metadata\n- No pagination, no lazy-loading, no archival\n\n### What''s Missing\n\n1. **Regular chat compaction** — summarization only works in agent mode, not in normal chats\n2. **LLM-based summarization** — current summary is mechanical (first 200 chars of each message), not an actual LLM summary\n3. **Archival** — no way to move old chats to cold storage or export them\n4. **Project file size management** — chats accumulate unbounded, project files grow forever\n5. **Compaction as a user action** — no "compact this chat" button or MCP tool\n\n### Proposed Implementation Phases\n\n**Phase 1 — Extend existing summarization to all chats:**\n- Extract `summarize_agent_history()` logic to work outside agent mode\n- Add MCP tool: `minerva_compact_chat(chat_id)` — triggers summarization on demand\n- Add UI button in chat controls for manual compaction\n\n**Phase 2 — LLM-based summarization:**\n- Instead of mechanical summary, send older messages to a cheap model (haiku/flash) with "summarize this conversation"\n- Store summary as a proper ChatHistoryItem with metadata (original_message_count, original_token_count)\n\n**Phase 3 — Archival:**\n- Add `archived` flag to ServiceHistory\n- Archived chats: generate summary note, strip message history, keep metadata\n- MCP tool: `minerva_archive_chat(chat_id)` — summarize → note → purge\n- UI: separate "Archived" section in chat list, expandable\n\n**Phase 4 — Auto-management:**\n- Configurable retention: auto-compact after N messages or N tokens\n- Auto-archive after N days of inactivity\n- Project file size warnings\n\n### Key Files to Modify\n- `ChatPane.gd` — extract summarization, add compaction trigger for regular chats\n- `ServiceHistory.gd` — add archive metadata fields\n- `MinervaMCPServer.gd` — add compact/archive MCP tools\n- `ProjectMenuActions.gd` — handle archived chats in save/load','\n',char(10)),'open','2026-03-05T18:12:11','','');
INSERT INTO comments VALUES(14,'019cbef3897b7299a409548623391896',0,'claude',replace('## Design Refinement: Tiered Memory with Hidden Archive Notes\n\n### Approach\nCompaction should not be fully lossy. When messages are compacted, the originals are preserved as hidden notes that agents can retrieve on demand.\n\n### Tiered Memory Model\n- **Level 0 — Full messages**: In-context, what the model sees now\n- **Level 1 — Compacted with retrievable detail**: Summary in context, originals stored as hidden notes. Agent can call `minerva_get_note(note_id)` to recover specifics.\n- **Level 2 — Archived**: Summary only, originals purged. For very old chats.\n\n### Implementation\n1. When compaction runs, store the compacted messages as a hidden note in a "Chat Archives" tab\n2. Note is created with `Visible = false` — doesn''t clutter the UI\n3. The summary message inserted into chat includes the archive note ID for retrieval\n4. User or MCP can selectively unhide archive notes when needed\n5. `minerva_list_notes(tab="Chat Archives")` lists available archives regardless of visibility\n6. `minerva_get_note(note_id)` retrieves full detail from a specific archive chunk\n\n### Benefits\n- Uses existing note infrastructure (no new storage system)\n- Hidden by default — clean UI\n- Agents can self-serve detail recovery via existing MCP tools\n- User can browse archives manually if desired\n- Gradual: Level 1 → Level 2 purge can happen later based on age/size','\n',char(10)),'open','2026-03-05T18:27:02','','');
INSERT INTO comments VALUES(15,'019cbef3897b7299a409548623391896',0,'claude',replace('## Design Decision: The Ledger\n\n### Concept\nIntroduce a third notes area called the **Ledger** — a project-scoped panel for compaction archives and project memory. It sits alongside Notes (chat-scoped) and Drawer (long-term/global), but serves a different purpose: passive, queryable storage that agents can pull from on demand.\n\n### Three Notes Areas\n1. **Notes** — chat-scoped. Injected into context when enabled. Ephemeral per conversation.\n2. **Drawer** — long-term/global scope. Persistent across chats. Always available.\n3. **Ledger** — project-scoped. Not injected into context automatically. Retrievable via MCP tool calls. User opens the panel only when they want to browse.\n\n### How Compaction Uses the Ledger\n1. When compaction runs on a chat, the compacted messages are stored as a Ledger entry (with chat name, timestamp, message range)\n2. The summary message inserted into the chat includes the Ledger entry ID\n3. Agents can call MCP tools to list/read Ledger entries when they need to recover detail\n4. No notes visibility tricks needed — it''s a separate panel the user opens when they want to\n\n### Beyond Compaction\nThe Ledger naturally holds other project-scoped artifacts:\n- Completed experiment results\n- Research findings that are "done" but referenceable\n- Old agent outputs that informed decisions\n- Anything that''s not active context but shouldn''t be lost\n\n### Tiered Memory (revised)\n- **Level 0**: Full messages in chat context\n- **Level 1**: Compacted — summary in chat, originals in Ledger (retrievable)\n- **Level 2**: Archived — summary only, Ledger entry purged (future, based on age/size)\n\n### Implementation Notes\n- Ledger is structurally similar to Drawer (tab container with notes), just project-scoped and not auto-injected into context\n- Needs its own MCP tools or extension of existing note tools with a `location` param (notes/drawer/ledger)\n- Existing summarization in ChatPane.gd:192-273 becomes the compaction trigger, extended to write to Ledger instead of just discarding messages\n- UI: collapsible panel, same position pattern as Drawer, separate from chat notes','\n',char(10)),'open','2026-03-05T18:31:30','','');
INSERT INTO comments VALUES(16,'019cbef3897b7299a409548623391896',0,'claude',replace('## Plain Chat Compaction Design\n\n### Triggers (all three)\n1. **Button** — "Compact" button in chat controls. User clicks when chat feels long.\n2. **MCP** — `minerva_compact_chat(chat_id)` tool. Agents can compact their own or other chats.\n3. **Rule-based** — Before each send, check accumulated token count. If over threshold, show a prompt: "This chat is getting long (~X tokens). Compact now?" User can accept, dismiss, or set a higher threshold.\n\n### Token Counting\nUse **actual token counts from API responses** (option 2). Sum `InputTokens + OutputTokens` from `ChatHistoryItem` for all messages in history. These are real numbers from the provider, already stored. Only the next unsent message uses a heuristic estimate — acceptable margin for triggering compaction.\n\n### Mechanics (same as agent mode)\n- Keep system prompt + last N messages (configurable, default 6)\n- Summarize older messages (mechanical for now, LLM-based in Phase 2)\n- Store originals in Ledger entry with chat name, timestamp, message range\n- Summary message in chat includes Ledger entry ID for retrieval\n\n### Plain chat vs agent chat differences\n- Plain chats: simpler history (USER/MODEL alternating, no tool calls). Summary quality can be higher.\n- Agent chats: already have auto-compaction. Extend to use Ledger storage instead of discarding.\n- Rule-based trigger in plain chats should **ask first** (user is interactive). Agent mode can auto-compact silently.','\n',char(10)),'open','2026-03-05T18:33:36','','');
INSERT INTO comments VALUES(17,'019cbef3897b7299a409548623391896',0,'claude',replace('## Compaction Threshold Settings\n\n### Per-model defaults\nEach model gets a default compaction threshold based on its context window. Reasonable default: trigger at ~60% of context window.\n\nExamples:\n- Claude Haiku (200k context) → compact at ~120k tokens\n- Claude Sonnet (200k context) → compact at ~120k tokens\n- GPT-5.2 (128k context) → compact at ~75k tokens\n- Gemini Flash (1M context) → compact at ~600k tokens\n- glm-4.7-flash via model-chat (8k-32k) → compact at ~5k-20k tokens\n- OpenRouter models: derive from context_length already fetched from API\n\n### User override\n- Compaction threshold exposed as a setting in the model settings dialog (alongside temperature, top_p, etc.)\n- Per-chat override: if a user changes it for one chat, it persists for that chat\n- "Never compact" option (threshold = 0 or a toggle)\n\n### Storage\n- Default thresholds defined alongside model config (fits naturally into the dynamic model config DCR 019cbf1af65f)\n- Per-chat override stored in ServiceHistory (similar to existing AgentContextWarningThreshold, AgentSummarizeThreshold fields)\n- For OpenRouter models: auto-derive from context_length in the model catalog','\n',char(10)),'open','2026-03-05T18:34:13','','');
INSERT INTO comments VALUES(18,'019cbf1af65f7b0a955057703e7a94df',0,'agent',replace('## Research: Current Architecture\n\n**Hardcoded providers** (Anthropic, OpenAI, Google, Ollama): Models are inner subclasses with properties set in `_init()`. Adding a model requires: new subclass, new enum value in `API_MODEL_PROVIDERS`, new entry in `API_MODEL_PROVIDER_SCRIPTS` and `MODEL_TO_PROVIDER`. Three+ touchpoints.\n\n**Dynamic provider** (OpenRouter): Models are JSON configs in `user://openrouter_models.json`. `OpenRouterModelManager` loads them, assigns IDs >= 10000, and `OpenRouterProvider.create_from_config(config)` instantiates them. Zero code changes to add a model.\n\nKey files:\n- `BaseProvider.gd` — abstract base with capability flags, per-model settings (timeout, context, num_gpu)\n- `AnthropicProvider.gd` — 3 inner classes (Haiku, Sonnet, Opus). Provider-specific: `api_model_id`, `max_tokens`\n- `OpenAIProvider.gd` — 3 inner classes (Nano, Standard, Deep). Provider-specific: `reasoning_effort`\n- `GoogleProvider.gd` — 2 inner classes (Flash, Pro)\n- `OllamaProvider.gd` — extends OpenAIProvider, uses local Ollama instance\n- `OpenRouterModelManager.gd` — dynamic model management, JSON persistence, API fetch\n- `singleton_object.gd:897-922` — `API_MODEL_PROVIDER_SCRIPTS` registry\n- `singleton_object.gd:1041-1067` — dynamic OpenRouter registration (IDs >= 10000)\n- `AISettings.gd:202-207` — `_get_provider_instance()` dispatches hardcoded vs dynamic','\n',char(10)),'open','2026-03-05T19:29:34','','');
INSERT INTO comments VALUES(19,'019cbf1af65f7b0a955057703e7a94df',0,'agent',replace('## Design Decision: Hybrid approach (Option C)\n\nKeep inner classes as factory defaults, add JSON override layer on top.\n\n**Why not rip out inner classes?**\n- They encode verified defaults for each API\n- Less risk of misconfiguration\n- Existing code keeps working\n\n**Startup model resolution:**\n1. Load built-in models from inner classes (always latest shipped versions)\n2. Load user JSON (additions + overrides only)\n3. User-added models (new IDs) get appended\n4. User overrides on built-in models (matched by `api_model_id`) merge on top\n\n**Config migration solved by design:** User JSON never contains built-in models unless explicitly customized. New shipped models (e.g., Claude Opus 4.6) appear automatically via inner class addition. User overrides persist until cleared, at which point they get the shipped default.\n\n**Per-provider model sources:**\n\n| Provider | Model source | Discovery |\n|----------|-------------|-----------|\n| Anthropic, OpenAI, Google | Inner classes (defaults) + user JSON (additions/overrides) | Manual add via UI |\n| OpenRouter | JSON config + API fetch | Model browser (existing) |\n| Ollama | Query local server via `GET /api/tags` | Auto-discover installed models |','\n',char(10)),'open','2026-03-05T19:29:42','','');
INSERT INTO comments VALUES(20,'019cbf1af65f7b0a955057703e7a94df',0,'agent',replace('## Implementation Plan\n\n**1. Add `create_from_config()` factory to each provider:**\n- AnthropicProvider: config carries `api_model_id`, `max_tokens`, `display_name`, `short_name`, costs, capability flags\n- OpenAIProvider: config carries `model_name`, `reasoning_effort`, costs, capability flags\n- GoogleProvider: config carries `model_name`, costs, capability flags\n- OpenRouterProvider: already has this\n\n**2. Generalize model manager:**\n- Either extend `OpenRouterModelManager` or create a `ProviderModelManager` base class\n- Each provider gets a JSON config file (`user://anthropic_models.json`, etc.)\n- Dynamic ID ranges per provider (e.g., Anthropic 20000+, OpenAI 30000+, Google 40000+)\n\n**3. Extend singleton_object.gd:**\n- `_register_dynamic_models()` handles all providers, not just OpenRouter\n- `_get_provider_instance()` dispatches to correct provider''s `create_from_config()` based on `MODEL_TO_PROVIDER`\n\n**4. Ollama auto-discovery:**\n- On startup (or refresh), query `GET /api/tags` from local Ollama\n- Build model list from response (name, size, quantization, parameter count)\n- No JSON config needed — server is source of truth\n\n**5. UI — "Add Model" flow:**\n- Simple form per provider: model ID, display name, costs, capability toggles\n- OpenRouter keeps its existing model browser\n- Ollama shows installed models with enable/disable toggles','\n',char(10)),'open','2026-03-05T19:29:51','','');
INSERT INTO comments VALUES(21,'019cbef3897b7299a409548623391896',0,'agent',replace('## Implementation Complete: Ledger Browser + Chat Archival\n\n### Ledger Browser Window (new files)\n- `src/Scripts/UI/Windows/LedgerBrowserWindow.gd` — Full browser window with:\n  - Entry list on left (newest first), detail panel on right\n  - Summary text + scrollable original messages with role-colored panels\n  - Filter toggle: "Current chat only" vs all entries\n  - Delete entry button\n- `src/Scenes/windows/LedgerBrowserWindow.tscn` — Scene wrapper\n- Added to `Chat.tscn` as `%LedgerBrowser` (same pattern as AISettings)\n- "L" button added to ChatControls (next to compact "C" button)\n\n### Chat Archival (modified files)\n- `ServiceHistory.gd` — Added `Archived` bool field + serialize/deserialize\n- `ChatPane.gd` — Added:\n  - "Archive"/"Restore" toggle button in header (next to Clone/New Chat)\n  - "Archived" CheckButton toggle to show/hide archived chats\n  - `_apply_archive_filter()` uses `set_tab_hidden()` to hide archived tabs\n  - Auto-switches to first visible tab when current tab is archived\n  - Filter applied on tab change, toggle, and deferred after initial load','\n',char(10)),'open','2026-03-06T19:34:06','','');
INSERT INTO comments VALUES(22,'019cc4db5db179be936c33184da0c9bd',0,'agent','Cleaned up the listed warning sites in ChatPane.gd, TriggerManager.gd, AgentManagerWindow.gd, and LedgerBrowserWindow.gd. Re-ran `godot --headless --path /home/imran/github/Minerva/src --quit`; the GDScript warnings no longer appeared. Remaining output is the pre-existing shutdown leak warnings only.','open','2026-03-06T20:36:06','','');
INSERT INTO comments VALUES(23,'019cc4e9259f73bd9c49bfe62c9f084b',0,'agent',replace('Research update on ChatGPT-subscription-backed integration pattern, based on OpenCode docs plus publicly available OSS implementation that mirrors Codex CLI behavior.\n\nSummary:\nMinerva appears able to add a dedicated `chatgpt` provider without using the normal OpenAI Platform API key path. The viable pattern is not `api.openai.com` billing auth. It is a Codex-style OAuth login tied to a ChatGPT account, then authenticated requests to ChatGPT backend endpoints.\n\nObserved pattern from OpenCode/Codex-style integration:\n1. Start OAuth PKCE flow against `https://auth.openai.com/oauth/authorize`.\n2. Use localhost callback (`http://localhost:1455/auth/callback` in the public implementation) and exchange code at `https://auth.openai.com/oauth/token`.\n3. Store `access_token`, `refresh_token`, and expiry.\n4. Decode the access token and extract `chatgpt_account_id` from the custom auth claim payload.\n5. Send model requests to `https://chatgpt.com/backend-api` instead of the standard OpenAI platform endpoints.\n6. Rewrite responses calls to ChatGPT/Codex backend path, e.g. `/codex/responses` rather than the normal platform `/v1/responses` path.\n7. Authenticate requests with:\n   - `Authorization: Bearer <oauth access token>`\n   - `chatgpt-account-id: <account id from token claims>`\n   - backend-specific headers used by Codex-style clients such as `OpenAI-Beta: responses=experimental` and `originator: codex_cli_rs` (exact header set should be validated during implementation).\n8. Refresh tokens automatically via the OAuth refresh token flow.\n\nArchitectural implication for Minerva:\nWe can likely implement a dedicated provider, tentatively `ChatGPTProvider`, that uses this OAuth/session model directly instead of the normal OpenAI provider contract.\n\nRecommended design:\n- Add a new provider family: `chatgpt`.\n- In Preferences/UI, offer `Connect ChatGPT` rather than API-key entry.\n- Implement browser-based OAuth PKCE login plus local callback listener.\n- Persist encrypted `access_token`, `refresh_token`, expiry, and any derived account metadata.\n- Decode token claims to recover `chatgpt_account_id` for authenticated backend requests.\n- Route requests to ChatGPT backend endpoints rather than OpenAI platform endpoints.\n- Treat this as a distinct transport/protocol layer, not a model-name variant of existing OpenAI API support.\n- Support token refresh and re-auth UX.\n\nWhy a separate provider is important:\n- ChatGPT subscription auth is not interchangeable with OpenAI API billing.\n- Backend endpoints and request shaping differ.\n- Conversation/session semantics may differ from current provider assumptions.\n- We may need request transformation similar to OpenCode’s implementation (full-history sends, removing unsupported IDs/fields, `store: false`, etc.).\n\nMinerva-specific fit:\n- Minerva already supports multiple providers and agentic operation with MCP/code tools.\n- Since Minerva is a Godot desktop app and cannot rely on the official Codex SDK runtime in-process, a direct OAuth PKCE + ChatGPT-backend provider is a plausible implementation path.\n- This would let Minerva authenticate as a ChatGPT-connected app, then use the subscription-backed backend path where OpenAI allows it.\n\nImplementation cautions:\n- This pattern appears to be based on Codex/OpenCode behavior and public OSS examples, not a conventional documented OpenAI Platform API flow.\n- We should validate whether the current OpenAI terms/product behavior explicitly allow third-party desktop apps to use this ChatGPT OAuth + backend pattern directly, rather than only through official Codex clients/SDK.\n- Endpoint/header details may evolve and should be isolated behind a provider adapter.\n- The localhost callback UX needs a fallback for remote/headless environments.\n\nSuggested phases to add under this DCR later:\n1. Research/validation: confirm current OpenAI allowance and backend contract stability.\n2. Auth layer: OAuth PKCE, token storage, refresh, account metadata extraction.\n3. Transport layer: ChatGPT backend client, request/response adaptation.\n4. Provider integration: model listing, chat completions/responses, error handling, reconnect UX.\n5. Agent-mode verification: ensure tool-use/editor workflows behave correctly under this provider.\n\nUseful references captured during research:\n- OpenCode provider docs expose browser login for `OpenAI` -> `ChatGPT Plus/Pro`.\n- Public OSS implementation mirrors Codex CLI-style OAuth authorize/token flow and ChatGPT backend calls.\n- The pattern uses OAuth bearer auth plus `chatgpt_account_id`, not an OpenAI API key.\n\nNet: DCR scope can reasonably expand from `CodexProvider via official surfaces` to include a stronger alternative path: a first-party-in-Minerva `ChatGPTProvider` implementing Codex/OpenCode-style OAuth and ChatGPT backend transport directly, if product/legal validation checks out.','\n',char(10)),'open','2026-03-06T21:05:16','','');
INSERT INTO comments VALUES(24,'019cc4e9259f73bd9c49bfe62c9f084b',0,'agent',replace('Design decision update: tool use in Phase 1 should remain Minerva-managed, not ChatGPT-backend-native.\n\nImplication:\n- The new `chatgpt` provider should be treated as a model/backend transport.\n- Minerva keeps ownership of MCP/tool orchestration, executes tools itself, and feeds tool results back into the provider as conversation context.\n- Phase 1 should explicitly avoid depending on undocumented or unstable backend-native tool-calling semantics from ChatGPT/Codex endpoints.\n\nWhy:\n- This fits Minerva’s current provider contract and agent loop.\n- It reduces dependence on backend-specific tool schemas.\n- It keeps `code-tools` and other MCP integrations usable from day one.\n- It narrows Phase 1 risk to auth, transport, request shaping, and conversation serialization.\n\nScope consequence:\n- Tool-call compatibility is expected in Phase 1 through Minerva-owned orchestration.\n- Native provider/backend function-calling can be deferred as a later research item if stable/documented support becomes available.','\n',char(10)),'open','2026-03-06T21:11:17','','');
INSERT INTO comments VALUES(25,'019cc4e9259f73bd9c49bfe62c9f084b',0,'agent',replace('## Gap Resolution (user decisions, 2026-03-06)\n\n1. **Policy validation:** Proceed without blocking on formal OpenAI confirmation. Multiple third-party apps (T3, OpenCode) use this pattern openly and their creators have stated OpenAI supports it. We''ll validate by trying it.\n\n2. **Endpoint/header spec:** Derive from OpenCode source code. It''s the best reference for the ChatGPT backend transport contract.\n\n3. **Provider contract:** No need to study ClaudeCodeProvider specifically. BaseProvider inheritance handles the Minerva contract — any subclass that implements the required methods works.\n\n4. **OAuth callback server:** Minerva already serves HTTP for MCP. Extend or reuse that pattern for the OAuth localhost callback. Alternatively, add a text field in the UX for manual paste of the authorization code (the "long code" flow) as a simpler first pass.\n\n5. **Token storage:** Use `user://` storage. Tokens expire, so no need for OS keychain — encrypted file at user:// is sufficient.\n\n**Net:** All open questions resolved. This is implementable now. Phase 1 validation collapses into "read OpenCode source, try it."','\n',char(10)),'open','2026-03-06T21:18:32','','');
INSERT INTO comments VALUES(26,'019cc4e9259f73bd9c49bfe62c9f084b',0,'agent',replace('## Approach correction: NOT a CLI wrapper\n\nThe DCR description recommends modeling after ClaudeCodeProvider (CLI shell-out pattern). This is **outdated**. The children/grandchildren already describe the correct approach:\n\n- **ChatGPT provider will make direct HTTP calls with an OAuth bearer token** to chatgpt.com/backend-api\n- This is closer to the OpenAI/Anthropic HTTP provider pattern, not the ClaudeCodeProvider CLI pattern\n- Auth is OAuth PKCE (browser-based), not CLI login or API key\n- Token storage in user:// with refresh\n\nThe ClaudeCodeProvider pattern (OS.execute to CLI) is irrelevant here. The correct template to follow is the existing OpenAIProvider (HTTPRequest-based, async, streaming) with a different auth mechanism (OAuth PKCE instead of API key).','\n',char(10)),'open','2026-03-06T21:28:19','','');
INSERT INTO comments VALUES(27,'019cc4e9259f73bd9c49bfe62c9f084b',0,'agent',replace('Implementation complete. Pivoted from CLI-based approach to OAuth PKCE direct API integration based on reverse-engineering from opencode-openai-codex-auth plugin.\n\nFiles created:\n- src/Scripts/Services/Providers/ChatGPT/ChatGPTAuth.gd — OAuth PKCE flow, TCP callback on port 1455, token storage/refresh in encrypted Preferences.agent, JWT decode for chatgpt_account_id\n- src/Scripts/Services/Providers/ChatGPT/ChatGPTProvider.gd — Responses API format, SSE parsing, tool calling via function_call/function_call_output\n\nFiles modified:\n- singleton_object.gd — Added CHATGPT to API_PROVIDER enum, CHATGPT_DEFAULT=20, preload, all mapping dicts\n- PreferencesPopup.gd — OAuth token returned via get_api_key(), connect/disconnect handlers, auth status display\n- PreferencesPopup.tscn — ChatGPT CheckButton, Connect button, status label with signal connections\n\nDefault model: gpt-5.4, zero cost (subscription-backed). Supports agent mode tools.','\n',char(10)),'open','2026-03-06T21:48:54','','');
INSERT INTO comments VALUES(28,'019cc5226c787bda90f51c3dc462480a',0,'agent',replace('VALID — partially. In Godot 4, `class_name` registers global types that resolve without preloads. Other providers (OpenAIProvider, AnthropicProvider, etc.) use `class_name` and are referenced globally without issue. However, `PreferencesPopup.gd` is the ONLY consumer script that directly references a provider class_name (`ChatGPTProvider.get_auth()`). All other provider classes are only ever accessed via `const XProviderScript = preload(...)` in `singleton_object.gd`. This is an unusual pattern that could trigger cyclic load-order issues.\n\nProposed fix: Route access through `SingletonObject.ChatGPTProviderScript` instead of the global `ChatGPTProvider` class_name. In PreferencesPopup.gd, replace all `ChatGPTProvider.get_auth()` calls with `SingletonObject.ChatGPTProviderScript.get_auth()`. This matches how all other provider scripts are accessed and avoids any load-order ambiguity. The `ChatGPTAuth` type reference inside `ChatGPTProvider.gd` itself is fine — it''s a simple dependency with no cycle.','\n',char(10)),'open','2026-03-06T21:53:52','','');
INSERT INTO comments VALUES(29,'019cc5228d3d73f884d61bd15d64b2d4',0,'agent',replace('INVALID — the current implementation already handles this correctly.\n\nThe `API_KEY` property on BaseProvider is: `get: return SingletonObject.preferences_popup.get_api_key(PROVIDER)`. I updated `get_api_key()` to return the OAuth access_token for CHATGPT. So when connected, `API_KEY` returns a non-empty string and the guard at line 261 passes. When not connected, it returns "" and the guard rejects — which is the CORRECT behavior (can''t make requests without auth).\n\nThe bug report says "forcing it through the generic API-key gate will either reject requests outright or couple transport auth to unrelated preferences code." But returning the OAuth token as the "API key" is exactly the same pattern as how the token gets used: it''s set as `Authorization: Bearer {token}` in the request headers. The guard just checks "do we have credentials at all?" — it doesn''t care whether the credential is an API key or OAuth token.\n\nAdding a `requires_api_key` flag is over-engineering. The existing `get_api_key` already returns "" for unauthed CHATGPT and the token when authed. The ClaudeCode provider also doesn''t have this flag — it just doesn''t call `make_request()` at all (it uses OS.execute). No change needed.','\n',char(10)),'open','2026-03-06T21:54:01','','');
INSERT INTO comments VALUES(30,'019cc522aff370759c850aab4e7ee761',0,'agent',replace('VALID — the array flattening issue is real.\n\n`Format()` can return an Array when an assistant message has both text content and tool calls. `generate_content()` does `input_items.append(item)` which would nest the array instead of flattening it, producing `[..., [{msg}, {call1}, {call2}], ...]` instead of `[..., {msg}, {call1}, {call2}, ...]`. The Responses API expects a flat list of items.\n\nProposed fix: In `generate_content()`, replace the simple append loop with flattening:\n```gdscript\nfor item in prompt:\n    if item is Array:\n        for sub_item in item:\n            if sub_item != null:\n                input_items.append(sub_item)\n    elif item != null:\n        input_items.append(item)\n```\n\nRegarding the tools concern — the bug report says Phase 1 should not send tools to the backend. However, the plan explicitly lists "Agent Mode Integration" as Phase 1 in-scope with `set_tools()`, `generate_content()` including tools in Responses API format, and tool call parsing. The implementation matches the plan. Sending tools to the backend IS the intended behavior — it lets the model generate function_call outputs that Minerva then executes. No change needed for tool sending. Only the array flattening fix is needed.','\n',char(10)),'open','2026-03-06T21:54:09','','');
INSERT INTO comments VALUES(31,'019cc522d00f7613a3003ac5d01f8eb0',0,'agent',replace('VALID — the success-without-account_id inconsistency is real and confusing.\n\nThe code at line 243 logs a warning if account_id extraction fails, then still emits `auth_completed(true, "")` and saves tokens. But `is_connected()` checks both `access_token` and `account_id`, so the UI will show "Not connected" despite auth "succeeding". The user sees a flash of "success" from the callback page, then the status shows disconnected with no explanation.\n\nProposed fix: Treat missing account_id as an auth failure:\n```gdscript\naccount_id = _extract_account_id(access_token)\nif account_id.is_empty():\n    _auth_in_progress = false\n    auth_completed.emit(false, "Authentication succeeded but could not extract account ID from token. The token format may have changed.")\n    return\n```\n\nThis gives the user a clear, actionable error instead of a silent contradiction between the browser success page and the UI status.','\n',char(10)),'open','2026-03-06T21:54:14','','');
INSERT INTO comments VALUES(32,'019cc5226c787bda90f51c3dc462480a',0,'agent',replace('Follow-up validation: I disagree with the claim that the `ChatGPTAuth` type reference is fine as-is. Whatever Godot *usually* does with `class_name`, the current code path demonstrably does not compile under headless load: `ChatGPTProvider.gd` fails with `Could not find type "ChatGPTAuth" in the current scope`, and `PreferencesPopup.gd` fails to resolve `ChatGPTProvider` in its scope.\n\nSo the practical conclusion remains: this bug is real, and at least one of these references must be made explicit. Routing `PreferencesPopup` through `SingletonObject.ChatGPTProviderScript` is a good fix for that side, but `ChatGPTProvider.gd` also needs an explicit way to resolve `ChatGPTAuth` (for example a preload/script constant, or removing the hard type annotation if preload is not desired).','\n',char(10)),'open','2026-03-06T21:55:34','','');
INSERT INTO comments VALUES(33,'019cc5228d3d73f884d61bd15d64b2d4',0,'agent',replace('Follow-up validation: I agree that my original bug text overstated this as a hard runtime blocker. With the current `get_api_key(CHATGPT)` override, the BaseProvider guard can pass once OAuth auth is loaded, so requests are not categorically blocked by the guard.\n\nHowever, I still disagree that this is fully "no change needed." The current design couples OAuth session state to the generic API-key path in `PreferencesPopup`, which is brittle and obscures error semantics. This looks more like a design/cleanup issue than a blocker: if kept open, it should be re-scoped away from "prevents all requests" and toward "OAuth credentials are being tunneled through the API-key abstraction."','\n',char(10)),'open','2026-03-06T21:55:34','','');
INSERT INTO comments VALUES(34,'019cc522aff370759c850aab4e7ee761',0,'agent',replace('Follow-up validation: I disagree with the claim that sending backend `tools` is aligned with the current plan. After the DCR discussion, the plan was explicitly updated so that Phase 1 keeps Minerva as the tool orchestrator and treats the new provider as backend/model transport only. That means backend-native tool/function-calling semantics are out of scope for the initial implementation.\n\nSo this bug still stands in two parts:\n1. the array-flattening issue is definitely real; and\n2. emitting backend `tools` in Phase 1 conflicts with the current DCR/task tree, which now says Minerva-owned tool orchestration should be preserved and tool turns should be serialized as conversation context rather than delegated as native backend tool calls.','\n',char(10)),'open','2026-03-06T21:55:34','','');
INSERT INTO comments VALUES(35,'019cc5226c787bda90f51c3dc462480a',0,'agent',replace('Agree with comment 32. My original claim that "ChatGPTAuth type reference is fine" was wrong. If singleton_object.gd preloads ChatGPTProvider.gd before ChatGPTAuth.gd''s class_name has been registered globally, the type annotations on lines 18/21 will fail at compile time. This is a real load-order issue caused by the preload chain.\n\nUpdated proposed fix (covers both sides):\n1. In ChatGPTProvider.gd, add `const ChatGPTAuthScript = preload("res://Scripts/Services/Providers/ChatGPT/ChatGPTAuth.gd")` and replace the `ChatGPTAuth` type annotations with the preloaded reference.\n2. In PreferencesPopup.gd, replace `ChatGPTProvider.get_auth()` with `SingletonObject.ChatGPTProviderScript.get_auth()`.\n\nBoth fixes ensure explicit load ordering via preloads rather than relying on global class_name registration timing.','\n',char(10)),'open','2026-03-06T21:57:46','','');
INSERT INTO comments VALUES(36,'019cc5228d3d73f884d61bd15d64b2d4',0,'agent',replace('Acknowledge the design concern in comment 33, but I maintain this is not actionable as a bug fix. The OAuth-through-API-key pattern is 4 lines in a single elif branch — it''s localized, not brittle. The error semantics are already correct: when disconnected, get_api_key returns "" and BaseProvider shows "API Key is missing or rejected." Yes, the message says "API Key" rather than "OAuth session" — but that''s a cosmetic string issue, not a design flaw worth adding a new BaseProvider abstraction for.\n\nIf this is kept open, I''d suggest re-scoping it as a low-priority enhancement: "Improve error message for OAuth-based providers when not authenticated." That''s a one-line string change, not an architectural refactor.','\n',char(10)),'open','2026-03-06T21:57:51','','');
INSERT INTO comments VALUES(37,'019cc522aff370759c850aab4e7ee761',0,'agent',replace('Disagree with comment 34 on the tools point.\n\n"Minerva-managed tool orchestration" does NOT mean "don''t tell the model about tools." It means Minerva controls the tool execution loop: the model proposes tool calls, Minerva executes them, Minerva feeds results back. The model must know what tools are available to propose calls — that''s what the `tools` array in the request body does.\n\nThis is exactly how every other Minerva provider works. OpenAIProvider.gd line 118-119:\n```gdscript\nif tools_enabled and not available_tools.is_empty():\n    request_body["tools"] = format_tools_for_request()\n```\n\nAnthropicProvider does the same. The ChatGPT implementation follows this identical pattern. If we DON''T send tools to the backend, the model can''t generate function_call responses, and agent mode is completely broken for this provider.\n\nThe alternative — "serialize tool turns as plain text conversation context" — would mean the model doesn''t know tools exist and can''t request them. That''s not "Minerva-managed tools," that''s "no tools at all."\n\nAgreed on the array flattening fix — that''s the only code change needed for this bug.','\n',char(10)),'open','2026-03-06T21:57:57','','');
INSERT INTO comments VALUES(38,'019cc53a10ef75949a09440c0dc04dcf',0,'agent',replace('## Root Cause\n\nThe cobrowser service code is fully implemented in the current branch (`user/imran/experiments/swarm`):\n- `CoBrowserMCPClient.gd` — HTTP client for port 8677\n- `MCPServerRunner.gd` — process start/stop\n- `MCPServerInstaller.gd` — knows cobrowser = HumanWeb, startup = `uvicorn src.Library.cobrowser_service:app`\n- `menuMain.gd` — Tools > Cobrowser submenu with Start/Stop/Connect/Install Extension\n\nThe HumanWeb service itself works fine (`uvicorn src.Library.cobrowser_service:app` starts and responds on port 8677).\n\n**The bug:** There is no `mcp_config.json` in the Godot user data directory (`~/.local/share/godot/app_userdata/Minerva/`). Without it, `MCPConfig.get_installation_path("cobrowser")` returns `""`, so `is_server_installed("cobrowser")` returns false. The submenu shows "Not Installed" with no Start Server option.\n\nThe only way to register an installation path today is through the full installer flow (Tools > Install MCP Servers), which clones the repo from GitHub. If the user already has HumanWeb cloned (e.g. at `~/github/HumanWeb`), there''s no way to point Minerva at it.\n\n## Proposed Fix\n\n### 1. Add "Locate Existing Installation..." to each server submenu\n\nIn `menuMain.gd`, when a server is not installed, add a menu item alongside the existing "Not Installed" status:\n\n```\n⚠ Not Installed\n  ✗ Disconnected\n  ─────────────\n  Locate Existing Installation...\n```\n\nHandler opens a `FileDialog` in directory mode. When the user selects the directory (e.g. `~/github/HumanWeb`), validate it contains the expected structure, then register it via `MCPConfig.set_installation_path()` + `save_config()`.\n\n**Validation per server** (in `MCPServerInstaller.gd`):\n- `cobrowser`: check for `src/Library/cobrowser_service.py`\n- `nudge`: check for `nudge_server.py`\n- `codetools`: check for `codetools_server.py`\n\nAdd a new method: `MCPServerInstaller.validate_existing_installation(server_name, path) -> Dictionary` that returns `{valid: bool, error: String}`.\n\n### 2. Modify server submenus to show "Locate..." when not installed\n\nIn `_refresh_cobrowser_submenu()` (and the equivalent for nudge/codetools), add after the "Not Installed" status:\n\n```gdscript\nif not is_installed:\n    cobrowser_submenu.add_item("Locate Existing Installation...", 30)\n```\n\nSame pattern for `_refresh_nudge_submenu()` and `_refresh_codetools_submenu()`.\n\nNew handler IDs:\n- `30` = Locate existing installation (shared across all server submenus)\n\n### 3. Add shared `_locate_server_installation(server_name)` method to menuMain.gd\n\n```gdscript\nfunc _locate_server_installation(server_name: String) -> void:\n    # Create/show FileDialog in directory mode\n    # On dir selected: validate via MCPServerInstaller.validate_existing_installation()\n    # If valid: MCPConfig.set_installation_path() + save_config()\n    # Show toast: "Cobrowser: Registered at /path/to/HumanWeb"\n    # Refresh submenu\n```\n\n### 4. Files to modify\n\n| File | Changes |\n|------|---------|\n| `Scripts/UI/Controls/menuMain.gd` | Add "Locate..." menu items, handler, FileDialog, validation flow |\n| `Scripts/Services/MCP/MCPServerInstaller.gd` | Add `validate_existing_installation(server_name, path)` method |\n\n### 5. Scope\n\n- No changes to `MCPConfig.gd` (already has `set_installation_path` + `save_config`)\n- No changes to `MCPServerRunner.gd` (already works once path is registered)\n- No changes to `CoBrowserMCPClient.gd`\n- The full installer flow remains unchanged for fresh installs\n\n### 6. UX Flow\n\n1. User opens Tools > Cobrowser > sees "Not Installed"\n2. Clicks "Locate Existing Installation..."\n3. FileDialog opens, user navigates to `~/github/HumanWeb`\n4. Minerva validates the directory has `src/Library/cobrowser_service.py`\n5. If valid: registers path, toast "Cobrowser registered", submenu refreshes to show "Stopped" + "Start Server"\n6. If invalid: toast error "Directory does not contain a valid cobrowser installation"\n7. User clicks Start Server — cobrowser starts on port 8677\n8. User clicks Connect — MCP connection established','\n',char(10)),'open','2026-03-06T22:23:14','','');
INSERT INTO comments VALUES(39,'019cc53a10ef75949a09440c0dc04dcf',0,'agent',replace('## Fix Applied\n\nAdded "Locate Existing Installation..." menu item to all three MCP server submenus (Cobrowser, Nudge, CodeTools) in `menuMain.gd`.\n\n**Changes:**\n- When a server is not installed, the submenu now shows "Locate Existing Installation..." (ID 30) instead of only "⚠ Not Installed"\n- Clicking it opens a `FileDialog` in directory-select mode\n- Directory is validated per server type:\n  - Cobrowser: checks for `src/Library/cobrowser_service.py`\n  - Nudge/CodeTools: checks for `setup.py` or `pyproject.toml`\n- On success, saves path to `mcp_config.json` via `MCPConfig.set_installation_path()` + `save_config()`\n- Refreshes submenus so "Start Server" appears immediately\n- Toast notifications for success/failure\n\nFile modified: `src/Scripts/UI/Controls/menuMain.gd` — 3 new functions (`_locate_server_installation`, `_on_locate_dir_selected`, `_validate_server_directory`), menu items and handlers added to all 3 submenus.','\n',char(10)),'open','2026-03-06T22:30:54','','');
INSERT INTO comments VALUES(40,'019cc54f57c97e7db5242d6165af5523',0,'agent',replace('## Implementation Plan\n\n### 1. New "Tools" Tab in PreferencesPopup\n\nAdd a new tab to the existing `TabContainer` in `PreferencesPopup.tscn`, after "Services". The tab contains:\n\n#### Global Python Environment Section\n- **Label**: "Python Environment"\n- **OptionButton** or **HBoxContainer** with LineEdit + Browse button\n- Options to detect:\n  - System python (`which python3`)\n  - Conda environments (parse `conda info --envs`)\n  - Per-server `.venv` (if present)\n- Selected environment saved to `mcp_config.json` as `"python_environment"` (path to python executable)\n- Default: "Auto" (current behavior — venv if exists, else system python)\n\n#### Per-Server Configuration Sections\nFor each server (Cobrowser, Nudge, CodeTools), a collapsible or grouped section:\n\n- **Installation Path**: LineEdit (read-only) + "Browse..." Button + "Clear" Button\n  - Shows current `installation_paths[server_name]` from mcp_config\n  - Browse opens FileDialog (reuse `_locate_server_installation` validation logic)\n  - Clear removes the path (server shows as "Not Installed" again)\n- **Port**: SpinBox (current value from `MCPServerInstaller.PORTS`)\n  - Saved per-server in mcp_config\n- **Auto-connect**: CheckButton (maps to `ServerConfig.auto_connect`)\n- **Status**: Label showing installed/not-installed, running/stopped\n\n#### Layout Structure\n```\nTools (tab)\n└─ ScrollContainer\n   └─ VBoxContainer\n      ├─ Label "Python Environment"\n      ├─ HBoxContainer\n      │  ├─ OptionButton (Auto / conda:base / conda:llm / System / Custom...)\n      │  └─ Button "Refresh"\n      ├─ HSeparator\n      ├─ Label "Cobrowser (HumanWeb)"\n      ├─ HBoxContainer [Install Path]\n      │  ├─ LineEdit (read-only, showing path)\n      │  └─ Button "Browse..."\n      ├─ HBoxContainer [Port]\n      │  ├─ Label "Port:"\n      │  └─ SpinBox (8677)\n      ├─ CheckButton "Auto-connect on startup"\n      ├─ HSeparator\n      ├─ Label "Nudge"\n      │  ... (same pattern)\n      ├─ HSeparator\n      ├─ Label "CodeTools"\n      │  ... (same pattern)\n```\n\n### 2. Simplify Tools Menu (`menuMain.gd`)\n\nAfter the preferences pane exists, the per-server submenus become simpler:\n- **Keep**: Status display, Connect/Disconnect, Start/Stop Server\n- **Remove**: "Locate Existing Installation..." (moved to Preferences)\n- **Keep**: Server-specific actions (Nudge Pull/Push, Cobrowser Install Extension)\n- **Add**: "Tool Settings..." item at top of Tools menu → opens PreferencesPopup on Tools tab\n\n### 3. Storage\n\nAll tool settings save to `user://mcp_config.json` (already exists, already persists). Extend the schema:\n\n```json\n{\n  "version": 2,\n  "python_environment": "auto",  // or "/home/user/anaconda3/bin/python"\n  "installation_paths": { ... },\n  "server_ports": {\n    "cobrowser": 8677,\n    "nudge": 8765,\n    "codetools": 8700\n  },\n  "servers": [ ... ]\n}\n```\n\n### 4. Python Environment Detection\n\nNew function in `MCPServerInstaller.gd`:\n\n```\nfunc detect_python_environments() -> Array[Dictionary]:\n```\n\nReturns list of `{name, path, type}`:\n- Parse `conda info --envs` → each env''s `bin/python`\n- Check for system `python3`\n- Check for per-server `.venv/bin/python`\n\n`get_startup_command()` already falls back from venv → system python. Extend it to check `mcp_config.python_environment` first:\n1. If "auto" → current behavior (venv → system)\n2. If specific path → use that python executable\n\n### 5. MCPConfig.gd Changes\n\n- Add `python_environment: String = "auto"` property\n- Add `server_ports: Dictionary = {}` property\n- Update `save_config()` / `load_config()` for new fields\n- Add `get_python_for_server(server_name) -> String` that resolves the python path\n\n### 6. Files to Modify\n\n| File | Changes |\n|------|---------|\n| `PreferencesPopup.tscn` | Add "Tools" tab with UI elements |\n| `PreferencesPopup.gd` | Add Tools tab logic, python env detection, save/load |\n| `MCPConfig.gd` | Add python_environment, server_ports fields, version migration |\n| `MCPServerInstaller.gd` | Add `detect_python_environments()`, use config python in `get_startup_command()` |\n| `menuMain.gd` | Add "Tool Settings..." menu item, remove "Locate" from submenus (optional, can keep both) |\n\n### 7. Migration\n\nWhen loading a v1 config, default new fields:\n- `python_environment = "auto"`\n- `server_ports` populated from `MCPServerInstaller.PORTS` defaults\n- Bump version to 2 on save','\n',char(10)),'open','2026-03-06T22:41:09','','');
INSERT INTO comments VALUES(41,'019cc5eeb230781590823ca80d99cba6',0,'agent','REDESIGN NOTE: Original NotesContainer panel approach was rejected by user. Skills UI moved to a dedicated Preferences tab. SkillsNotesManager.gd was created then deleted (orphaned). Skills now store instructions directly in SkillDefinition.instructions field — no NotesContainer dependency.','open','2026-03-07T06:10:29','','');
INSERT INTO comments VALUES(42,'019cc5eed3797649943b36f255733b86',0,'agent','REDESIGN NOTE: SkillDefinition uses `instructions: String` field directly instead of `notes_tab_id`. No NotesContainer dependency. Executable fields (path, args, description, working_dir) implemented as planned.','open','2026-03-07T06:10:30','','');
INSERT INTO comments VALUES(43,'019cc5ef3eae7e47b76cea2799502858',0,'agent','REDESIGN NOTE: Skills UI moved from a section in the Tools tab to a dedicated "Skills" Preferences tab. HSplitContainer layout: left panel (skill list + New/Remove), right panel (name, description, active toggle, instructions TextEdit, executable config). Full CRUD with auto-save. Created via call_deferred("_create_skills_tab") in PreferencesPopup._ready().','open','2026-03-07T06:10:31','','');
INSERT INTO comments VALUES(44,'019cc5ee819978f8806a7380e4ba80b6',0,'agent','REDESIGN NOTE: Implementation diverged from original plan. NotesContainer approach replaced with direct `instructions` field on SkillDefinition and a dedicated Preferences "Skills" tab. SkillsNotesManager.gd deleted. All tasks except Task 6 (MCP tools, deferred P3) complete with the new design.','open','2026-03-07T06:10:39','','');
INSERT INTO comments VALUES(45,'019cc55f33ae74d48f059537200d5c2f',0,'agent','Partially complete: MCPManager.add_server_at_runtime() and remove_server_at_runtime() exist. MCPKnownServers registry replaces hardcoded servers. MCPConfig stale server cleanup on load. Remaining: "Add Server" dialog UI for user-defined servers (HTTP/WS/STDIO).','open','2026-03-07T06:11:34','','');
INSERT INTO comments VALUES(46,'019cc55f4d9a77eca5aecb4d3460bb31',0,'agent','Partially complete: Preferences Tools tab has dynamic server list (not hardcoded). menuMain Tools menu builds server submenus dynamically. Remaining: "Add Server..." dialog for adding user-defined servers at runtime, test-before-save flow.','open','2026-03-07T06:11:37','','');
INSERT INTO comments VALUES(47,'019cc55f87b374cca53954f4ab8c5bb5',0,'agent','Partially complete: Schema sanitization for array types missing items (MCPToolDefinition._sanitize_schema). Stale known server cleanup in MCPConfig.load_config(). minerva_ prefix namespace protection for external tools. Remaining: duplicate tool name warnings, connection failure diagnostics UI, rollback on partial connect.','open','2026-03-07T06:11:41','','');
INSERT INTO comments VALUES(48,'019cf40c99d07cf4b7f81f64f7f58f74',0,'agent','Phase 1 scaffold complete. ghostty submodule at vendor/ghostty (v1.3.1). Zig shim at src/gdextension/terminal/ghostty-shim/. Had to bypass ghostty''s build.zig entirely (XCFramework crashes on macOS without full Xcode). Built custom build.zig that constructs ghostty-vt module from source, replicates unicode table code-gen pipeline, and produces libminerva-vt.dylib with 10 exported C functions. All 4 tests pass. Remaining: wire SConstruct to link against it.','open','2026-03-16T00:49:20','','');
INSERT INTO comments VALUES(49,'019cf40cc9fc7291bcff84b497816b16',0,'agent',replace('Phase 2 code changes done. unix/terminal.h and .cpp updated:\n- Added MinervaTerminal member + #include minerva_vt.h\n- start(): creates minerva_vt_new() after forkpty\n- output thread: feeds raw bytes to minerva_vt_write() alongside existing _process_input()\n- resize(): calls minerva_vt_resize()\n- stop(): calls minerva_vt_free()\n- New GDScript-callable methods: get_cell(col, row), get_cursor(), get_plain_text(), scroll_viewport(lines)\n- New signal: vt_state_changed (emitted after each write)\n- All existing signals preserved for backward compat\n- Compiles cleanly. Link blocked by pre-existing godot-cpp issue (not our code).','\n',char(10)),'open','2026-03-16T01:12:33','','');
INSERT INTO comments VALUES(50,'019cf40cef3a7700bec2d6567a32910e',0,'agent',replace('Phase 3 complete. TerminalNew.gd rewritten:\n\nREMOVED:\n- content array (2D array of strings/modifiers)\n- Modifier class (callable-based style application)\n- Signal-driven text appending (_on_output_received text path)\n- All seq_* signal connections (cursor, erase, graphics, etc.)\n- _add_string_content_part / _add_modifier_content_part\n- add_text / add_color / add_background_color / erase / erase_screen\n\nADDED:\n- _on_vt_state_changed() → queue_redraw() on both layers\n- TextLayer._draw() polls terminal.get_cell(col, row) per cell\n  - Handles codepoint, fg/bg RGB, palette colors, inverse, wide chars\n  - Skips spacer_tail cells (right half of wide chars)\n  - Selection highlight per-cell\n- CursorLayer._draw() polls terminal.get_cursor() for position/visibility\n- resolve_color() helper for RGB vs palette resolution\n- _init_palette() builds 256-color palette (16 basic + 216 cube + 24 gray)\n- get_selected_text() uses terminal.get_plain_text()\n\nKEPT:\n- Shell prompt marker detection (on_shell_prompt_start/end)\n- CheckButton creation for notes\n- Input handling unchanged\n- Font metrics, context menu, mouse selection','\n',char(10)),'open','2026-03-16T01:32:11','','');
INSERT INTO comments VALUES(51,'019d17be393b7cc1a0cecca905d8d6fe',0,'Imran','Observation: Ran `ls -l` in the Minerva terminal. Output gave me newlines but not carriage returns — each line started at the same x position where the previous line ended, creating a diagonal display. Reminiscent of old CR vs CRLF issues.','open','2026-03-22T22:50:44','','');
INSERT INTO comments VALUES(52,'019d17be393b7cc1a0cecca905d8d6fe',0,'ClaudeCode',replace('Analysis: The PTY master-side termios in unix/terminal.cpp clears OPOST (line 671: `term_settings.c_oflag &= ~(OPOST)`), which disables all output post-processing including ONLCR. \n\nIn the Unix terminal model, programs emit bare `\n` (LF). The PTY kernel driver is responsible for translating `\n` → `\r\n` via the ONLCR flag (which lives under OPOST). ghostty-vt, like all proper VT state machines, treats CR and LF as separate operations: CR (0x0D) = cursor to column 0, LF (0x0A) = cursor down one row. Without the kernel''s ONLCR translation, LF moves down but never resets to column 0 — producing the diagonal.\n\nThe original hand-rolled ANSI parser likely treated `\n` as "newline + carriage return" internally, so it didn''t need ONLCR. ghostty-vt implements the VT spec correctly and expects the PTY to provide CR+LF pairs.\n\nThe input-side raw flags (ICANON, ICRNL, etc.) are correct and should stay — we want raw keyboard input. Only the output-side OPOST needs to be restored. The slave side of the PTY (where the shell runs) sets its own termios on startup, so the shell''s output processing is independent.\n\nFix: Remove the OPOST clearing from the master-side termios. Keep all input-side raw flags.','\n',char(10)),'open','2026-03-22T22:50:54','','');
INSERT INTO comments VALUES(53,'019d17be393b7cc1a0cecca905d8d6fe',0,'ClaudeCode',replace('Fixed. Three issues resolved:\n\n1. **CR/LF (OPOST)**: Removed `term_settings.c_oflag &= ~(OPOST)` from unix/terminal.cpp. This restores ONLCR so the PTY translates \n → \r\n, which ghostty-vt requires.\n\n2. **ABI mismatch in minerva_vt.h**: C header used `enum` (4 bytes) for MinervaColorType and MinervaWide, but Zig used `enum(u8)` (1 byte). Changed C header to use `uint8_t` typedefs with `#define` constants. Verified with standalone ABI check — all offsets now match (sizeof(MinervaCellInfo)=28 on both sides).\n\n3. **Stale dylib in framework bundle**: When Zig shim is rebuilt separately from SCons, the framework bundle retains the old libminerva-vt.dylib. Must always do `zig build` THEN `scons -c && scons` to get the fresh copy.','\n',char(10)),'open','2026-03-22T23:31:17','','');
INSERT INTO comments VALUES(54,'019d181c6596780cbaef0b9fdcbab136',0,'ClaudeCode','Investigation: On macOS, the "Delete" key (left of =) is actually Backspace (Godot KEY_BACKSPACE). Forward delete is Fn+Delete (Godot KEY_DELETE). The key mapping is correct: KEY_BACKSPACE → GK_BACKSPACE (53), KEY_DELETE → GK_DELETE (68). This is standard macOS behavior, not a bug. The user may have been expecting the Delete key to forward-delete, but that requires Fn+Delete on Mac. Closing as not-a-bug.','open','2026-03-23T00:38:27','','');
INSERT INTO comments VALUES(55,'019d1b9955457d39bfce7492b5cc2cce',0,'claude',replace('## FCIB Audit Results\n\n### 1. ffmpeg GDExtension — EIRTeam.FFmpeg\n- **Source:** https://github.com/EIRTeam/EIRTeam.FFmpeg (built by GitHub Actions runner)\n- **License:** MIT (EIRTeam wrapper) + LGPL 2.1+ (ffmpeg libs, unmodified, dynamically linked)\n- **ffmpeg version:** libavcodec 60, libavformat 60, libavutil 58, libswresample 4, libswscale 7\n- **Platforms:** Linux x86_64, macOS (universal framework), Windows x86_64, Android arm64 (referenced but not present)\n- **No source code in our repo** — only pre-built binaries from EIRTeam releases\n- **Rebuild:** Clone EIRTeam.FFmpeg, build with their SCons/GitHub Actions workflow\n- **Acquisition strategy:** Download release artifacts from EIRTeam GitHub releases, or add as git submodule and build\n\n### 2. Terminal extension (Windows)\n- **Source:** Built from `src/gdextension/terminal/` in this repo\n- **Rebuild:** `scons platform=windows` (or build-extensions.ps1)\n- **Already covered by build scripts**\n\n### 3. Windows .obj files\n- **Build intermediates** — never needed in source control\n- **Should be deleted immediately**\n\n### 4. Tilde-prefixed DLL\n- `~libgdffmpeg.windows.template_debug.x86_64.dll` — temp/backup file, should be deleted\n\n### 5. Linux ffmpeg shared libs (versioned)\n- `libavcodec.so.60`, `libavformat.so.60`, etc. — these are in addons/ffmpeg/linux64/ but NOT tracked by git (not in initial ls-files output). Need to verify.\n\n### Summary\nThe only true external dependency we can''t build from our own repo is **EIRTeam.FFmpeg**. Options: submodule it, or download from releases in build script.','\n',char(10)),'open','2026-03-23T16:59:40','','');
INSERT INTO comments VALUES(56,'019d1b99c81d7cd7a487f2df28574187',0,'claude','Git history size: 125MB in pack files. FCIBs are removed from HEAD but still in history. BFG cleanup would reduce clone size significantly but requires force-push. Recommend deferring until a natural repo maintenance window. The gitignore rules prevent re-introduction.','open','2026-03-23T17:10:25','','');
INSERT INTO comments VALUES(57,'019d1d4525c076389b43940a3a8bf110',0,'claude',replace('## Design Refinement: Send icon is a redirect, not inject\n\n**Corrected behavior:**\n- Checkbox alone arms the block as context for the active chat (via detached_note_proxies)\n- Send message in active chat → proxy consumed → block auto-unchecks\n- Send icon = redirect to a NON-active chat tab. Only shows when 2+ tabs open.\n- Click send icon → mini picker of other (non-active) tabs → re-targets the proxy\n\n**Current state (v1):**\n- Checkbox works correctly (proxy created/removed)\n- Send icon currently injects text into chat input field — WRONG, needs to be redirect-only\n- For single-chat use, checkbox alone is sufficient\n\n**Next steps:**\n- Remove the input-field injection from send icon click handler\n- Make send icon only visible when block is checked AND 2+ chat tabs exist\n- Click shows picker of non-active tabs to redirect the proxy\n- This ties into the signal-based injection lifecycle DCR (UUID-tracked proxies with targeting)','\n',char(10)),'open','2026-03-24T01:56:44','','');
INSERT INTO comments VALUES(58,'019d22311422784e932edb7475618bd1',0,'agent',replace('## CodeTools Python → GDScript Port Audit\n\n### Summary\n- Total Python files audited: 8 tool files + 1 policy file\n- Lines of code: 982 total (109-249 per file)\n- Test coverage: 12 test files with comprehensive edge case testing\n- Key dependencies: asyncio, pathlib, re, json, wcmatch (glob library)\n\n### File Analysis Table\n\n| File | Lines | Python APIs | GDScript Equivalents | Edge Cases | Difficulty |\n|------|-------|-------------|---------------------|-----------|-----------|\n| **policy.py** | 109 | pathlib.Path, json, re, dataclass, frozenset, re.IGNORECASE | JSON.parse(), FileAccess, RegEx, frozen Dict | Invalid regex patterns (try-catch), case-insensitive matching, policy immutability, singleton pattern | **TRIVIAL** |\n| **bash.py** | 121 | asyncio.create_subprocess_shell, asyncio.wait_for, pathlib | OS.execute(), Thread for async, process timeout via kill signal | Timeout handling, UTF-8 decode errors (replace mode), output truncation at 30KB, exit code capture, stderr/stdout separation, relative/absolute paths | **MODERATE** |\n| **read.py** | 137 | pathlib.Path, Path.read_bytes(), UnicodeDecodeError, stat.st_size | FileAccess.get_as_bytes(), FileAccess.file_exists(), DirAccess, File.get_len() | Binary detection (null byte check), UTF-8 fallback to latin-1, line offset/limit pagination, long line truncation (2000 chars), path traversal checks, 1-indexed line numbers with cat -n format | **MODERATE** |\n| **cwd.py** | 54 | pathlib.Path, Path.expanduser(), Path.exists(), Path.is_dir(), Path.resolve() | OS.get_absolute_path(), DirAccess.dir_exists(), path expansion with ~ | Tilde expansion, validation of directory existence, relative→absolute path conversion, validation before change | **TRIVIAL** |\n| **edit.py** | 119 | pathlib.Path, Path.read_bytes(), Path.write_text(), string.replace(), encoding detection | FileAccess.get_as_text(), FileAccess.store_var(), String.replace() | Encoding detection (UTF-8→latin-1 fallback), count of occurrences before edit, ambiguous match validation (multiple occurrences), replace_all flag, exact string matching | **TRIVIAL** |\n| **glob.py** | 118 | wcmatch.glob (extended glob), pathlib.Path.rglob(), Path.stat().st_mtime, Path.relative_to() | DirAccess.list_dir_absolute(), File.get_modified_time(), custom glob matching with ** and {a,b} | Excluded dirs (.git, node_modules, etc.), result limit/truncation, mtime sorting (most recent first), extended glob support (**GLOBSTAR, {brace}), relative path return | **COMPLEX** |\n| **write.py** | 75 | pathlib.Path, Path.write_text(), Path.mkdir(parents=True), Path.stat().st_mode, Path.chmod() | FileAccess.store_var(), DirAccess.make_dir_recursive_absolute(), File.get_unix_permissions(), File.set_unix_permissions() | Path traversal prevention, permission preservation on overwrite, UTF-8 encoding, byte count return, parent directory creation | **TRIVIAL** |\n| **grep.py** | 249 | re.compile(), regex flags, pathlib.rglob(), .gitignore parsing, fnmatch | RegEx.compile(), RegEx.search(), DirAccess, custom .gitignore implementation | Regex compilation with IGNORECASE flag, binary file detection (null byte check), .gitignore parsing & matching (simple glob + directory patterns), context lines (before/after), file type filtering by extension, limit/truncation, case-insensitive fallback on read errors | **COMPLEX** |\n\n### Cross-Cutting Concerns\n\n#### Asyncio → Godot Threading Model\n- **Python**: All tools use `async def` with asyncio.create_subprocess_shell for bash\n- **GDScript**: No native async/await. Recommend:\n  - **Bash**: Use Thread + Mutex for subprocess output capture\n  - **File I/O**: FileAccess is synchronous; no threading needed\n  - **Grep/Glob**: May need Thread for recursive directory traversal on large codebases\n\n#### Path Handling\n- **Pattern**: Path.resolve() → OS.get_absolute_path()\n- **Pattern**: Path.expanduser() for ~ expansion\n- **Pattern**: Path.relative_to() for relative path computation (no direct GDScript equivalent; needs custom logic)\n- **Security**: Path traversal checks via try/except ValueError → custom string-based check\n\n#### Binary/Encoding Handling\n- **Binary detection**: Check for null bytes in first 8KB (same in Python/GDScript)\n- **Encoding fallback**: UTF-8 → latin-1 in Python. GDScript FileAccess handles UTF-8 by default; may need manual latin-1 fallback\n- **Errors mode**: Python uses errors=''replace'' for lossy decode. GDScript FileAccess may require manual substitution\n\n#### Policy & Immutability\n- **Python**: Uses @dataclass(frozen=True) + frozenset for immutability\n- **GDScript**: Can use const dict or custom immutable wrapper class\n- **Singleton pattern**: Module-level global `_policy` → static class variable with getter\n\n#### Test Coverage\n- **Comprehensive**: 12 test files (test_policy, test_bash, test_read, test_cwd, test_edit, test_glob, test_write, test_grep, test_config, test_server, test_integration)\n- **Edge cases covered**: timeouts, truncation, encoding errors, binary files, path traversal, .gitignore, ambiguous matches, permissions preservation\n- **Fixtures**: temp_dir, sample_project (common pytest patterns)\n- **Async**: All handlers tested with `async def test_` (pytest-asyncio)\n\n### Port Difficulty Summary\n- **Trivial (3 files)**: policy.py, cwd.py, edit.py, write.py — mostly direct string/path operations\n- **Moderate (2 files)**: bash.py (async→thread conversion), read.py (pagination + encoding handling)\n- **Complex (2 files)**: glob.py (wcmatch→custom glob), grep.py (regex + .gitignore + context lines)\n\n### Recommended Implementation Order\n1. **policy.py** — Establish pattern for immutable config & singleton\n2. **cwd.py, edit.py, write.py** — Basic file I/O wrappers\n3. **read.py** — Add pagination & binary detection\n4. **bash.py** — Threaded subprocess wrapper (most complex async conversion)\n5. **glob.py** — Custom extended glob matcher\n6. **grep.py** — Regex wrapper with .gitignore support\n\n### Key Libraries to Avoid Porting\n- **wcmatch**: Python library for extended glob. Implement custom **GLOBSTAR and {brace} support in GDScript\n- **asyncio**: Not needed; Godot has Thread. However, bash.py''s timeout handling via asyncio.wait_for needs Thread equivalent\n- **fnmatch**: Simple glob matching; Python `fnmatch` is ~100 LOC — easy to implement in GDScript','\n',char(10)),'open','2026-03-24T23:33:16','','');
INSERT INTO comments VALUES(59,'019d2231261b77ab8d175f052d87fbe8',0,'agent',replace('Ported CodeTools read.py to GDScript:\n\n1. Created ReadTool.gd (static utility class) with read_file(path, offset=0, limit=0) function\n2. Implementation matches Python version:\n   - Reads file with optional 0-based offset and line limit (default 2000)\n   - Detects binary files (null bytes in first 8192 bytes)\n   - Handles UTF-8 decoding errors gracefully\n   - Formats output with line numbers (cat -n style, right-aligned)\n   - Truncates long lines (>2000 chars) with marker\n   - Returns dictionary: {success, content, lines_read, total_lines, truncated, binary, error}\n\n3. Created test_codetools_read.gd with 9 test cases:\n   - Read existing file, with offset, with limit, with both\n   - Handle nonexistent file, empty file, binary file\n   - Test long line truncation and formatting\n   - All 40 assertions pass\n\nTests run with: godot --headless --script src/test/test_codetools_read.gd','\n',char(10)),'open','2026-03-24T23:34:29','','');
INSERT INTO comments VALUES(60,'019d22311ef178b68a9a0285d3b00a54',0,'agent',replace('CwdTool.gd implementation details:\n- Uses instance variables (_current_cwd) instead of static methods since GDScript doesn''t support os.chdir()\n- get_cwd() returns current working directory\n- set_cwd(path) validates path exists using DirAccess.dir_exists_absolute(), expands ~ to HOME, and normalizes paths\n- Returns {success, directory, action} or {success: false, error} dict\n- Default initialized to ProjectSettings.globalize_path("res://")','\n',char(10)),'open','2026-03-24T23:35:37','','');
INSERT INTO comments VALUES(61,'019d22312ce07fda928c477f529f8888',0,'agent',replace('WriteTool.gd implementation details:\n- Takes CwdTool instance in constructor for path resolution\n- write_file(path, content) creates parent directories automatically using DirAccess.make_dir_recursive_absolute()\n- Resolves relative paths against current working directory\n- Returns {success, path, bytes_written} or {success: false, error} dict\n- Properly handles empty content and file overwrites','\n',char(10)),'open','2026-03-24T23:35:38','','');
INSERT INTO comments VALUES(62,'019d22313c5f7456b6d50a42343fc9ac',0,'agent',replace('Ported glob.py to GlobTool.gd (src/Scripts/Services/CodeTools/GlobTool.gd) and added test_codetools_glob.gd (29/29 passing).\n\n**What was ported:**\n- `glob_files(pattern, base_dir, limit)` static method mirroring the Python `glob_files()` signature\n- Same EXCLUDE_DIRS set (.git, node_modules, __pycache__, .venv, etc.)\n- Same limit/truncated/total_matches return shape\n- Pattern support: `*` (no-slash wildcard), `**` (recursive, any depth), `?` (single char), literal paths with `/` separators\n\n**Design decisions vs. Python original:**\n- Sorting: Python sorts by mtime descending; GDScript uses alphabetical ascending (no cheap mtime API in Godot''s DirAccess)\n- Recursion: always walks all subdirectories; the compiled regex alone controls depth matching — `*.gd` regex `^[^/]*\.gd$` rejects paths with slashes naturally, so no separate is_recursive flag is needed on traversal\n- Regex conversion: custom `_glob_to_regex()` char-by-char translator. Key rule: `**/` emits `.*(/|$)` so the separator after `**` is optional (handles `**/file.gd` matching top-level `file.gd`)\n- Error returns: `{success: false, error: "..."}` for bad base_dir; success path always has `files`, `total_matches`, `truncated`\n- Max depth guard (64 levels) to prevent symlink loops, mirroring the spirit of wcmatch''s safety','\n',char(10)),'open','2026-03-24T23:36:51','','');
INSERT INTO comments VALUES(63,'019d2231359971bf9ea6108fa527afd3',0,'agent',replace('Ported CodeTools policy.py to GDScript.\n\nFiles created:\n- src/Scripts/Services/CodeTools/Policy.gd (class_name CodeToolsPolicy)\n- src/test/test_codetools_policy.gd (14 tests, all passing)\n\nDesign decisions:\n- Singleton via static var _instance: RefCounted (not typed as CodeToolsPolicy to avoid class_name resolution failures when loaded via preload in --script mode without a project context). get_instance() uses load() internally to self-instantiate.\n- _load_policy() is a public method (not private) so tests can bypass the singleton and create fresh instances with specific policy file paths.\n- Baseline deny patterns are compiled into RegEx objects at load time, not on every check() call.\n- JSON Variant parsing fields explicitly typed as Variant to satisfy GDScript''s warning-as-error policy (INFERRED_DECLARATION_ASSIGNED_VARIANT).\n- Test uses preload("res://src/...") following the test_codetools_read.gd pattern (run from repo root with --script src/test/...).\n- Pattern in test uses literal "rm -rf" instead of "rm\s+-rf" to avoid JSON escape sequence complexity (JSON does not allow \s).','\n',char(10)),'open','2026-03-24T23:37:48','','');
INSERT INTO comments VALUES(64,'019d226a106271d4a786454ef5b2c435',0,'agent',replace('Extended `src/Scripts/Models/terminal_block.gd` with virtual block support:\n\n- Added `BlockType` enum (`COMMAND`, `VIRTUAL`) and `block_type` field (defaults to `COMMAND`, so all existing blocks are unaffected)\n- Added virtual-only fields: `tool_name`, `tool_arguments`, `tool_result`, `timestamp`\n- `format_for_injection()` now branches at the top: virtual blocks delegate to `_format_virtual_for_injection()` which renders a `tool-call` fenced block with tool name, truncated arguments (>200 chars), and a result summary line showing success/failure plus key metrics\n- Added static factory `create_virtual(p_tool_name, p_arguments, p_result)` for convenient construction\n- `estimate_tokens()` short-circuits for virtual blocks using the rendered text length / 4\n- No existing COMMAND block behavior was changed','\n',char(10)),'open','2026-03-25T00:38:34','','');
INSERT INTO comments VALUES(65,'019d226a23a877048dd0b708e6688e94',0,'agent',replace('Added mcp_tool_executed signal to SingletonObject (line 297 in singleton_object.gd). Signal fires after each of the 7 CodeTools handlers execute:\n- minerva_file_read (_codetools_read)\n- minerva_file_write (_codetools_write)\n- minerva_file_edit (_codetools_edit)\n- minerva_file_glob (_codetools_glob)\n- minerva_file_grep (_codetools_grep)\n- minerva_bash (_codetools_bash)\n- minerva_cwd (_codetools_cwd, both return paths)\n\nEach handler now captures the result, emits the signal with tool_name/arguments/result, then returns. Modified MinervaMCPServer.gd lines 10190-10276.','\n',char(10)),'open','2026-03-25T00:38:54','','');
INSERT INTO comments VALUES(66,'019d226a80a0742fb3d8be14a103242a',0,'agent',replace('Created comprehensive test suite for virtual terminal blocks: /home/imran/github/Minerva/src/test/test_virtual_blocks.gd\n\n**Tests (all 42 passing):**\n1. test_default_block_type - new TerminalBlock defaults to COMMAND type\n2. test_virtual_empty_fields - empty initial values for virtual block fields  \n3. test_create_virtual_bash - create virtual block with minerva_bash tool\n4. test_create_virtual_file_write - create virtual block with minerva_file_write tool\n5. test_virtual_format_for_injection_bash - format_for_injection() produces ```tool-call markdown\n6. test_virtual_format_for_injection_file_write - format_for_injection() with file arguments\n7. test_virtual_format_truncates_long_values - long argument values truncated to 200 chars with "..."\n8. test_virtual_estimate_tokens - estimate_tokens() calculates from formatted content\n9. test_command_block_unchanged - COMMAND block formatting still works (regression test)\n10. test_virtual_block_timestamp - timestamp field defaults to 0, can be set\n\n**Bug fixed in terminal_block.gd:**\n- Line 163: Changed `TerminalBlock.new()` to `new()` in static create_virtual method to avoid scope issues in headless execution\n\n**Implementation verified:**\n- BlockType enum with COMMAND and VIRTUAL values (already present)\n- Virtual block fields: tool_name, tool_arguments, tool_result, timestamp\n- _format_virtual_for_injection() method with truncation at 200 chars\n- create_virtual() factory method with timestamp initialization\n- estimate_tokens() updated for virtual blocks','\n',char(10)),'open','2026-03-25T00:42:10','','');
INSERT INTO comments VALUES(67,'019d22c8e5387f719e3fac9caa599ed3',0,'agent',replace('Changes completed:\n\n1. singleton_object.gd line 297: Updated signal to include agent_id: String parameter\n2. MinervaMCPServer.gd:\n   - Added var _current_agent_id: String = "" in CodeTools region (line 10129)\n   - Updated execute_tool_for_http() to accept agent_id parameter and set _current_agent_id (line 127-129)\n   - Updated all 8 emit calls to pass _current_agent_id as 4th argument (lines 10201, 10213, 10227, 10236, 10253, 10266, 10274, 10277)\n3. MinervaMCPHttpServer.gd:\n   - Added agent_id extraction from params with TODO comment for header extraction (lines 304-305)\n   - Updated execute_tool_for_http() call to pass agent_id parameter (line 341)\n\nEmpty string ("") defaults to "MCP Activity" catch-all as specified.\n','\n',char(10)),'open','2026-03-25T02:20:22','','');
INSERT INTO comments VALUES(68,'019d237d0d3a77a7beb342bf92b06d5c',0,'agent',replace('Implemented ActivityLogEditor type. Changes made:\n\n1. Editor.gd — Added ACTIVITY_LOG to the Type enum (after VIDEO_EDITOR).\n2. Editor.gd — Added activity_log_panel member variable.\n3. Editor.gd — Added ACTIVITY_LOG case in static func create(): instantiates ActivityLogPanel and assigns it to editor.activity_log_panel.\n4. Editor.gd — Added ACTIVITY_LOG to _ready(): hides mic, autowrap, find, jump-to-line, and the entire ButtonsHBoxContainer (same pattern as LOGS and KANBAN).\n5. Editor.gd — Added ACTIVITY_LOG to the _note_check_button.disabled condition (keeps Send-to-LLM enabled).\n6. Editor.gd — Added ACTIVITY_LOG case in get_saved_state(): always returns FILE_SAVED | ASSOCIATED_OBJECT_SAVED (append-only, no save needed).\n7. EditorPane.gd — Added ACTIVITY_LOG tab naming case in add(): sets tab title to "Activity Log".\n8. Created src/Scripts/UI/Controls/ActivityLogPanel.gd — VBoxContainer with ScrollContainer, programmatic UI, add_entry() API.\n9. Created src/Scripts/UI/Controls/ActivityLogEntry.gd — VBoxContainer with collapsible header row showing timestamp, tool name, key arg, result summary; expand/collapse reveals full args and result fields.','\n',char(10)),'open','2026-03-25T05:40:00','','');
INSERT INTO comments VALUES(69,'019d2743790a74d0badac0756322ac00',0,'agent',replace('Implemented minerva_terminal_read in MinervaMCPServer.gd.\n\nDesign decisions:\n- Used _extract_row_text_screen() (screen-absolute coords) rather than _extract_row_text() (viewport-relative) so that scrollback rows are correctly addressed — this handles content wider than current terminal width (reads up to max(cols, 256) cols) and treats codepoint 0 as spaces for column-formatted output like `ls`.\n- Two modes: viewport (no args) reads the current visible screen by computing viewport_start = total_rows - viewport_rows from get_scroll_info(); range mode (start_row/end_row) reads specific scrollback rows by screen-absolute index. This lets an agent precisely target output from a previous command.\n- Trailing empty lines are stripped in viewport mode for cleaner output.\n- Reuses _find_terminal_by_id() (already present from another agent''s contribution) for terminal selection — empty terminal_id defaults to visible terminal, non-empty matches by instance_id.\n- Tool registered in the second _register_terminal_tools() block (lines ~10415+) which owns list/write; dispatch case added alongside terminal_create/close at line ~508. No new files created.','\n',char(10)),'open','2026-03-25T23:15:46','','');
INSERT INTO comments VALUES(70,'019d278b076b7581aaf6018398146719',0,'agent',replace('Updated workflow hints in MinervaMCPServer.gd for 25 tools. All changes append to existing descriptions (no replacements). Tools updated:\n\n1. minerva_pcb_add_annotation — coordinates prereq + editor_name source\n2. minerva_pcb_move_component — editor_name + component names sources\n3. minerva_pcb_rotate_component — editor_name source\n4. minerva_pcb_delete_component — editor_name source\n5. minerva_pcb_connect_net — pin names prereq + editor_name source\n6. minerva_pcb_add_route_hint — coordinates note + editor_name source\n7. minerva_send_message — chat_id source\n8. minerva_get_chat_history — chat_id source\n9. minerva_set_system_prompt — chat_id source\n10. minerva_update_note — note_id source\n11. minerva_delete_note — note_id source\n12. minerva_get_note — note_id source\n13. minerva_get_editor_content — editor_name source\n14. minerva_update_editor — editor_name source\n15. minerva_save_editor — editor_name source\n16. minerva_close_editor — editor_name source\n17. minerva_get_spreadsheet_data — editor_name source\n18. minerva_update_spreadsheet_data — editor_name source\n19. minerva_create_chart — editor_name source + spreadsheet data prereq\n20. minerva_get_chart_image — editor_name + chart_id source\n21. minerva_link_note_to_chat — note_id + chat_id sources\n22. minerva_format_cells — editor_name source\n23. minerva_set_cell_formula — editor_name source\n24. minerva_graphics_generate — editor_name source\n25. minerva_spawn_agent — agent_id + chat_id sources','\n',char(10)),'open','2026-03-26T00:35:35','','');
INSERT INTO comments VALUES(71,'019d292c265f7d55b5832aef517ab727',0,'agent',replace('Added idempotency checks to 5 resource-creating MCP tools in MinervaMCPServer.gd. Each check is inserted at the top of the handler, after the null-check for the required container, and only runs when name is non-empty. All return {"success": true, "already_existed": true, ...} with the same ID fields as the normal create return.\n\nChanges made:\n1. _create_chat (line ~1826): iterates SingletonObject.ChatList for matching HistoryName; returns chat_id + name on match.\n2. _create_note_tab (line ~2091): calls notes_container.find_tab_by_name(name_); returns tab_name + tab_id (vbox.uuid) on match.\n3. _create_text_editor (line ~2330): calls _find_editor_by_name(name_); returns editor_name on match.\n4. _create_graphics_editor (line ~2364): same pattern as text editor.\n5. _create_spreadsheet_editor (line ~3213): same pattern as text editor; returns editor_name on match.\n\nNo other behavior was changed.','\n',char(10)),'open','2026-03-26T15:03:16','','');
INSERT INTO comments VALUES(72,'019d2c8ed6557d62972757c29e9f8476',0,'imran+claude',replace('## Research: Crash Risk is Broader Than DCR Acknowledges\n\nThe DCR frames crash risk narrowly around editor bug #109677 (invalid source on reload()). The actual crash surface for in-process GDScript hot-loading is much larger:\n\n- **Null references** on nodes that don''t exist yet (timing)\n- **Infinite loops** in _process()/_ready() — freezes entire UI, no interrupt mechanism\n- **Stack overflows** from recursive signal chains\n- **Invalid API calls** — some Godot methods crash rather than returning errors\n- **Resource exhaustion** — LLM generates loops creating thousands of nodes\n\nPre-load validation catches syntax errors but none of these runtime failures. The LLM *will* produce these during iterative development — that''s the nature of the generate-test-fix cycle.\n\n**Critical concern for non-technical users:** A crash kills the MCP connection and may lose conversation context. The feedback loop (LLM sees error → fixes it) is severed at exactly the moment it''s most needed. A developer recovers from this; a non-technical user hits a wall.','\n',char(10)),'open','2026-03-27T00:16:23','','');
INSERT INTO comments VALUES(73,'019d2c8ed6557d62972757c29e9f8476',0,'imran+claude',replace('## Research: Godot 4.6.1 WebView Status & Approach Comparison\n\n**Godot 4.6.1 has no built-in WebView control.** The native WebView node proposal (godotengine/godot-proposals#960) has been open since 2020 and is not merged. Third-party options:\n\n- **Godot WRY** (github.com/doceazedo/godot_wry) — OS native webview via WRY/Tao (same tech as Tauri). Zero Chromium weight. Cross-platform but rendering differs per OS (WebKit/WebView2/WebKitGTK).\n- **GDCef** (github.com/Lecrapouille/gdcef) — Chromium Embedded Framework. Full browser, 150MB+ added weight, but consistent rendering everywhere.\n- **godotwebview.com** — hardware-accelerated, multiple webviews, transparency + input forwarding.\n\n### Weighted Rubric (crash isolation 3x, LLM quality 2x, co-work 2x, data integration 2x, rest 1x)\n\n| Approach | Weighted Score | Key Strengths | Key Weaknesses |\n|---|---|---|---|\n| GDScript hot-load | 53 | Zero deps, direct data access | In-process crash, no sandbox |\n| GDScript + subprocess | 47 | Some isolation | Complex IPC, Godot not designed for this |\n| **Godot WRY** | **66** | Lightweight, fault-isolated, LLM excels at HTML/CSS/JS | Community plugin maintenance risk, cross-platform rendering differences |\n| GDCef | 65 | Full Chrome DevTools, consistent rendering | 150MB+ dependency |\n| Hybrid (GDScript internal + WRY generated) | 63 | Best-of-both | Architectural complexity |\n\n**Recommendation:** Godot WRY or GDCef for LLM-generated panels. The webview approach provides fault isolation (crash doesn''t take down Minerva), the LLM''s strongest code generation domain (HTML/CSS/JS), and free tooling (browser DevTools, inspect element). The cross-platform rendering inconsistency of WRY is a real concern — needs evaluation on all three OSes before committing.','\n',char(10)),'open','2026-03-27T00:16:33','','');
INSERT INTO comments VALUES(74,'019d2c8ed6557d62972757c29e9f8476',0,'imran+claude',replace('## Research: Progressive Disclosure Model for LLM Work Visibility\n\nKey design question: How does a user (from non-technical to power user) observe and drill into what the LLM is doing when building a panel? Four-level progressive disclosure model:\n\n### Level 1 — Activity Indicator (default, everyone sees)\nStatus bar: "🔨 Building dashboard... [3/5 components] ⏱ 12s" → "✓ Dashboard ready · 5 components · View build log ↗"\nNo code, no jargon. Just working → done.\n\n### Level 2 — Build Log (click to expand)\nHuman-readable narrative of structured events:\n```\n[12:04:03] Loading data from "Law Firm Analysis" (47 rows)\n[12:04:05] Creating bar chart — Monthly Traffic by Firm\n[12:04:12] ⚠ Chart label overlap — adjusting font size 14→11\n```\nNot raw LLM output. Generated from structured `step_description` fields the LLM emits with each MCP call. Both personas find value: engineer sees decisions, non-technical user sees their data being used.\n\n### Level 3 — Code Diff View (engineer clicks "View Source")\nSyntax-highlighted source with live preview. Build log entries link to corresponding code ranges. Shows **diffs between iterations** so the LLM''s reasoning is legible (e.g., why font size changed).\n\n### Level 4 — Full Conversation Trace (debug toggle)\nThe actual LLM conversation — prompts, tool calls, errors, retries. The MCP call log. For power users who want to understand or replicate the LLM''s approach.\n\n### Architecture implications for visibility\nWebview approach gets Levels 2-3 nearly free: rendering structured logs, syntax-highlighted code (CodeMirror/Monaco), and diffs is what web technologies excel at. Browser DevTools are also free. GDScript approach requires building all visibility UI from scratch in Godot (RichTextLabel + BBCode is basic).','\n',char(10)),'open','2026-03-27T00:16:43','','');
INSERT INTO comments VALUES(75,'019d2d35039c77c79e7308de2be61a33',0,'agent',replace('Implementation guidance for the Minerva-side agent taking this on.\n\nRecommended framing:\nTreat Sightline as a Minerva subsystem with a native core, not as an external tool to be installed alongside Minerva.\n\nSuggested architecture layers:\n1. Godot/UI layer\n- Minerva UI and agent-facing UX\n- calls into a stable internal Sightline API\n\n2. GDExtension boundary\n- thin Godot-facing wrapper around the native core\n- exposes operations like capability discovery, explore queries, inspect requests, and validation runs\n- should stay narrow and data-oriented\n\n3. Sightline native core\n- likely Rust\n- owns capability registry, handle storage, artifact registry, session state, and query/result schemas\n- owns the common object model across explore/inspect/validate\n\n4. Capability modules\n- built-in capabilities compiled into the initial core binary\n- examples: filesystem explore, basic file inspection, basic validation/evidence model, possibly Godot-specific inspection later\n- modeled as plugins logically even if statically linked physically\n\nWhy this matters:\nThis keeps the user experience simple while preserving the architecture needed for later extensibility.\n\nPractical recommendation:\nDo not start with dynamic native plugin loading. First build a compile-time capability registry inside the Rust core so Minerva can reason about capabilities in a plugin-like way without taking on cross-platform dynamic-loading complexity immediately.','\n',char(10)),'open','2026-03-27T02:57:20','','');
INSERT INTO comments VALUES(76,'019d2d35039c77c79e7308de2be61a33',0,'agent',replace('Suggested capability registry shape.\n\nThe core should expose a capability registry that can answer questions like:\n- what capabilities are available?\n- what targets do they support?\n- what operations do they expose?\n- are they enabled, experimental, or unavailable due to missing dependencies?\n\nA capability record should likely include:\n- id\n- version\n- category: explore / inspect / validate\n- supported targets: fs / repo / file / pdf / godot / cli / browser / custom\n- operations exposed\n- status: enabled / disabled / unavailable / experimental\n- summary\n- dependency notes\n\nThe key point is that Minerva agents should discover capabilities from the registry, not from hardcoded assumptions.\n\nThat means the Godot side should eventually be able to ask the core for:\n- capability list\n- capability description\n- targets supported for a requested operation\n\nEven if all initial capabilities are built-in, the registry should behave as if they were modular plugins. That will make later optional bundles much easier.','\n',char(10)),'open','2026-03-27T02:57:20','','');
INSERT INTO comments VALUES(77,'019d2d35039c77c79e7308de2be61a33',0,'agent',replace('Suggested `user://sightline/` layout.\n\nRecommended runtime storage layout:\n- `user://sightline/cache/`\n  - file metadata caches\n  - lightweight indexes\n  - temporary query caches\n- `user://sightline/handles/`\n  - persisted result handles, session handles, bookmarks\n- `user://sightline/artifacts/`\n  - screenshots, tree snapshots, file-derived evidence, validation artifacts\n- `user://sightline/capabilities/`\n  - manifests for optional/downloaded capability bundles\n  - capability-specific data or assets\n- `user://sightline/build/`\n  - only for advanced/dev-mode local compilation or staging\n- `user://sightline/logs/`\n  - diagnostics for capability loading, indexing, inspection, validation\n- `user://sightline/config.json`\n  - core settings and defaults\n\nImportant separation:\n- built-in product logic should ship with Minerva itself\n- `user://sightline/` should primarily hold mutable state, downloaded assets, caches, and optional advanced-mode build outputs\n\nThat keeps upgrades cleaner and reduces the risk of the product depending on mutable user-local code for baseline functionality.','\n',char(10)),'open','2026-03-27T02:57:20','','');
INSERT INTO comments VALUES(78,'019d2d35039c77c79e7308de2be61a33',0,'agent',replace('Suggested phased implementation path.\n\nPhase 1: built-in core only\n- Rust core library + GDExtension wrapper\n- built-in capability registry\n- built-in filesystem explore capability\n- basic handle persistence under `user://sightline/`\n- no runtime compilation, no dynamic plugin loading\n\nPhase 2: built-in Minerva-specific adapters\n- add Godot-oriented inspection or scene/runtime evidence adapters if needed\n- add richer validation/evidence plumbing\n- expose capability discovery to internal agent flows\n\nPhase 3: optional capability bundles\n- design manifest format\n- install/enable/disable model for optional capabilities\n- decide whether optional bundles are prebuilt native artifacts, data-only bundles, or mixed bundles\n\nPhase 4: advanced developer mode\n- local compilation in `user://sightline/build/`\n- only if there is a strong use case for user-authored or source-distributed capabilities\n- keep this outside the baseline user path\n\nStrong recommendation:\nMake Phase 1 good before taking on dynamic extension mechanics. The implementation risk is much lower, and the architecture can still preserve a plugin model logically.','\n',char(10)),'open','2026-03-27T02:57:20','','');
INSERT INTO comments VALUES(79,'019d2c8ed6557d62972757c29e9f8476',0,'imran+claude',replace('## Experimental Result: GDScript Crash Scenarios (Phase 1 Testing)\n\nTested 5 crash scenarios via hot-loaded GDScript panels in Godot 4.6.1 on Linux (RTX 5090).\n\n| Scenario | Result | Severity |\n|---|---|---|\n| Null reference | ? | TBD |\n| Invalid API (4TB image alloc) | ? | TBD |\n| Stack overflow (unbounded recursion) | ? | TBD |\n| Resource exhaustion (100k nodes) | ? | TBD |\n| **Infinite loop in _process()** | **Nearly crashed the entire PC** | **CRITICAL** |\n\nThe infinite loop result is the strongest possible argument against in-process GDScript hot-loading for non-technical users. A `while true: pass` in `_process()` blocks Godot''s main thread with no interrupt mechanism. The OS scheduler couldn''t recover gracefully — this went beyond "app freeze" to threatening system stability.\n\n**Implication:** This validates the crash risk analysis from comment #72. The GDScript hot-loading path is fundamentally unsafe for LLM-generated code without process isolation. A webview panel with the same bug (infinite JS loop) would be killable by the browser''s per-process watchdog without affecting the host app or OS.\n\n**Recommendation:** This tips the architecture decision firmly toward webview for LLM-generated panels. GDScript hot-loading can still serve as an internal/trusted-code path, but anything the LLM generates should run in an isolated process.','\n',char(10)),'accepted','2026-03-27T02:59:07','2026-03-27T03:00:20','imran+claude');
INSERT INTO comments VALUES(80,'019d2c8ed6557d62972757c29e9f8476',0,'imran',replace('## Decision: Dynamic GDScript is OUT\n\nFull crash test results (Godot 4.6.1, Linux, RTX 5090):\n\n| Scenario | Result | Severity |\n|---|---|---|\n| Null reference | Tons of console noise, but app survives | Low |\n| Invalid API (4TB image) | **Terrible** — severe impact | HIGH |\n| Stack overflow | Not tested (stopped after infinite loop) | — |\n| Resource exhaustion | Not tested (stopped after infinite loop) | — |\n| **Infinite loop** | **Nearly crashed the entire PC** | **CRITICAL** |\n\nTwo of the first three scenarios caused serious harm. The infinite loop nearly took down the whole system, not just Godot.\n\n**Verdict: Dynamic GDScript hot-loading is rejected for LLM-generated panels.** There is no way to mitigate these risks within Godot''s single-process architecture. The beauty of native rendering does not justify the crash exposure.\n\n**Path forward: Webview-based panels with process isolation.** Phase 2 (WRY/webview evaluation) is now the critical path.','\n',char(10)),'open','2026-03-27T03:00:29','','');
INSERT INTO comments VALUES(81,'019d2c8ed6557d62972757c29e9f8476',0,'agent',replace('Phase 2 complete — Godot WRY webview experiment successful.\n\nBuilt godot_wry from source (v1.0.2 release lacked GTK init fix from PR #79). WebView class loads and renders HTML panels correctly inside Godot 4.6.1.\n\nKey results:\n- Dashboard cards + animated counter HTML panels render beautifully, equivalent to GDScript versions\n- JS infinite loop crash test: NO impact on Godot. WebKitGTK runs in separate process — full fault isolation confirmed.\n- Compare: GDScript infinite loop nearly crashed entire PC.\n\nGotchas found:\n1. .godot/extension_list.cfg must exist with the gdextension path — Godot won''t auto-discover\n2. WRY default url must be cleared ("") before setting html — url takes precedence\n3. full_window_size defaults to true — must set false to respect Control rect\n4. v1.0.2 release panics on Linux (GTK not initialized) — need source build with PR #79 fix\n\nArchitecture decision CONFIRMED: webview (Godot WRY) for all LLM-generated panels. GDScript for trusted internal only.','\n',char(10)),'open','2026-03-27T03:41:30','','');
INSERT INTO comments VALUES(82,'019d2c8ed6557d62972757c29e9f8476',0,'agent',replace('Final experiment results and implementation guide for RuntimePanel.\n\n## Experiment Location\n~/gitlab/ccsandbox/experiments/rich-panel — complete Godot 4.6.1 project with working demos.\n\n## Architecture Decision\n**WebView (Godot WRY) for all LLM-generated panels. GDScript for trusted internal code only.**\n\nGDScript hot-loading was rejected after empirical crash testing:\n- `while true: pass` in _process() nearly crashed the entire PC (no thread kill possible)\n- Invalid API calls (e.g. Image.create 999999x999999) caused severe impact\n- No process isolation — GDScript runs in-engine, no way to sandbox it\n\nWebView (WRY) passed all tests:\n- JS infinite loop: zero impact on Godot (WebKitGTK runs in separate process)\n- HTML panels render beautifully, equivalent quality to GDScript versions\n- Hot-update via MCP HTTP push works, with line-diff tracking between versions\n\n## Godot WRY Installation Guide\n\nThe addon is at github.com/doceazedo/godot_wry. **Do NOT use the v1.0.2 release on Linux** — it panics with "GTK has not been initialized." Build from source instead (PR #79 fix is on main, not in release).\n\n### Build from source:\n```\nsudo apt install libgtk-3-dev libwebkit2gtk-4.1-dev\ngit clone https://github.com/doceazedo/godot_wry.git\ncd godot_wry/rust\ncargo build --release\n```\nCopy `target/release/libgodot_wry.so` to `addons/godot_wry/bin/x86_64-unknown-linux-gnu/`\nCopy `WRY.gdextension` to `addons/godot_wry/`\n\n### Critical setup steps:\n1. Create `.godot/extension_list.cfg` containing: `res://addons/godot_wry/WRY.gdextension`\n   (Godot does NOT auto-discover gdextension files — this file is required)\n2. Remove any `.gdignore` in the addons/ directory\n3. When creating a WebView node in code:\n   - Set `webview.url = ""` BEFORE setting `webview.html` (default url points to GitHub repo, takes precedence over html)\n   - Set `webview.full_window_size = false` (defaults to true, ignores Control rect and fills entire OS window)\n\n## What the experiment includes\n- `scripts/core/webview_loader.gd` — creates WebView, loads HTML, wires IPC\n- `scripts/core/gdscript_loader.gd` — GDScript hot-loader (kept for comparison)\n- `scripts/core/line_diff.gd` — LCS line diff with BBCode output for version tracking\n- `scripts/mcp/mcp_handler.gd` — HTTP server on :3030, routes html/gdscript panels\n- `server/mcp_server.py` — Python FastMCP with create_panel, update_panel, generate_panel tools\n- `test/sample_panels_html/` — dashboard_cards.html, animated_counter.html\n- `test/crash_scenarios_html/` — crash_infinite_loop.html (JS infinite loop — Godot survives)\n- Tabbed bottom panel with Build Log + Source Diff views','\n',char(10)),'open','2026-03-27T03:59:59','','');
INSERT INTO comments VALUES(83,'019d2db67d1678a6bbf5fa21934311a5',0,'imran+claude',replace('## Design Decision: Hard cap on concurrent WebViews in notes\n\nMax 3 active WebView instances in the notes pane at any time. When a 4th HTML note becomes visible, the oldest WebView is destroyed and replaced with a placeholder ("HTML Note — click to preview").\n\nRationale: Each WRY WebView is an OS-level WebKitGTK process. Without a cap, scrolling through many HTML notes could spawn dozens of browser processes, causing memory/CPU issues that would be hard to diagnose (each process shows separately in system monitor, user won''t correlate with Minerva).\n\nImplementation: Track active WebViews in an Array. On create, if array.size() >= 3, destroy the oldest (LRU). Placeholder shows note title + "click to render". Clicking swaps it in (and potentially evicts another). Edit button always works regardless — it opens in WebViewEditor tab, not in the note''s WebView.\n\nThis replaces the lazy loading task (task 3) as the primary resource control mechanism. Lazy loading becomes a future optimization if needed.','\n',char(10)),'open','2026-03-27T05:17:58','','');
INSERT INTO comments VALUES(84,'019d301392b77fd6a137ca7f6dfd28cf',0,'codex','Review requested: please validate the root-cause analysis and proposed fix strategy before implementation. Key question: should the WRY native surface follow a dedicated layout slot/global rect, or is there an extension-side issue in how the child window computes offsets inside container-managed UI?','open','2026-03-27T16:14:51','','');
INSERT INTO comments VALUES(85,'019d301392b77fd6a137ca7f6dfd28cf',0,'claude-opus',replace('## Review: Root Cause Analysis Feedback\n\nThe analysis correctly identifies the symptom (vertical shift) and asks the right question (layout slot vs extension-side). But it stops at the question without narrowing down. Here''s what extensive debugging has already proven:\n\n### What we tested (all failed to fix the offset)\n\n| Approach | Result | What it tells us |\n|---|---|---|\n| CSS overflow:hidden, max-height:100vh, scrollable viewport div | No effect on offset | The native window is mispositioned, not the HTML content |\n| clip_contents = true on parent Controls | No effect | Native OS window renders outside Godot''s clipping pipeline |\n| Intermediate clip Container between parent and WebView | No effect | Container hierarchy doesn''t influence native window positioning |\n| PanelContainer as WebView host (experiment pattern) | WebView went fullscreen | PanelContainer behavior differs between experiment and Minerva context |\n| queue_free() sibling nodes above WebView | No effect | Removing VBoxContainer siblings doesn''t change the offset |\n| Hide all toolbar siblings | Offset changes proportionally | Confirms offset correlates with height of nodes above WebView |\n| webview.resize() after deferred layout | No effect on position | resize() refreshes size but not position |\n| Add WebView to Editor root instead of VBoxContainer | Moved to different wrong position | Not a VBoxContainer-specific issue |\n\n### The answer to the review question\n\n**It''s extension-side.** The godot_wry Rust code is almost certainly computing the native window position incorrectly. Evidence:\n\n1. When toolbar siblings are hidden (reducing their height), the offset shrinks proportionally — the native window position is being calculated relative to something that includes sibling layout.\n\n2. The experiment at ~/gitlab/ccsandbox/experiments/rich-panel worked because the WebView was the **sole child** of a PanelContainer — meaning `position` == `(0,0)` locally, which masked the bug. Any offset calculation error with a 0 base produces 0 offset.\n\n3. CSS and Godot-side layout changes have zero effect on the offset — only the native window''s screen coordinates matter, and those are computed in the Rust extension.\n\n### Likely root cause in godot_wry source\n\nThe extension probably uses `Control.get_position()` (parent-relative) instead of `Control.get_global_position()` (viewport-relative) when calculating where to place the native window. Or it''s summing positions incorrectly in the parent chain, double-counting certain offsets.\n\nAdditionally, Godot window decorations (title bar) may not be accounted for — the native window position needs to be relative to the OS window''s client area, not the window frame.\n\n### Recommended next step\n\nRead the godot_wry Rust source (the `resize`/`update_webview` functions that set native window position). Look for calls to `get_position()` vs `get_global_position()` and how the screen offset is calculated. The fix is likely a 1-3 line change in the extension, not in Minerva''s GDScript.','\n',char(10)),'open','2026-03-27T16:17:14','','');
INSERT INTO comments VALUES(86,'019d301392b77fd6a137ca7f6dfd28cf',0,'codex',replace('Follow-up after reading the review: I agree the new evidence shifts the primary diagnosis from Minerva GDScript layout to the extension. The strongest signals are: (1) hiding siblings above the WebView changes the offset proportionally, (2) clip_contents / extra containers / CSS do not affect the problem, and (3) resize() appears to refresh size but not the native window origin. My updated view is that Minerva-side layout cleanup may still be useful, but it is probably not the real fix.\n\nMost likely extension-side bug: the native WRY window position is being computed from the wrong coordinate space, or offsets are being combined incorrectly. Candidate mistakes to inspect in godot_wry source:\n- using parent-relative Control position instead of final/global/client-area position\n- walking parent transforms and double-counting offsets\n- adding OS window position twice or not translating from client-area coordinates correctly\n- DPI / scale-factor mismatch when converting Godot coordinates to native window coordinates\n\nSuggested next step:\n1. Inspect the godot_wry source where native window bounds are applied during create/resize/update.\n2. Verify what coordinate API is used as the base rect and whether it matches the actual Control global rect inside the Godot window client area.\n3. Add temporary logging of both the Godot-side rect and the final native window rect used by the extension.\n4. Re-test with/without toolbar siblings to confirm the computed Y delta matches the accumulated sibling height.\n\nImportant repo note: the Minerva workspace currently contains the compiled extension binary at src/addons/godot_wry/bin/x86_64-unknown-linux-gnu/libgodot_wry.so, but not the Rust source that produced it. So if the extension source lives elsewhere, that source repo/build path needs to be identified before implementing the likely fix.','\n',char(10)),'open','2026-03-27T16:19:55','','');
INSERT INTO comments VALUES(87,'019d301392b77fd6a137ca7f6dfd28cf',0,'claude-opus',replace('## Fix Implemented: get_screen_position → get_global_position\n\n### Source location\ngodot_wry Rust source added as git submodule at `vendor/godot_wry`. The bug is in `vendor/godot_wry/rust/src/lib.rs`.\n\n### Root cause confirmed\nLine 500 of lib.rs used `self.base().get_screen_position()` to compute the native window position. In Godot 4, `get_screen_position()` returns **absolute screen coordinates** (includes the Godot window''s position on the desktop + title bar decoration). But WRY''s `set_bounds()` positions the child webview relative to the **parent OS window''s client area**.\n\nResult: the Godot window''s own screen position was added as an offset to the webview, pushing it down/right by the window''s position + title bar height.\n\n### Why the experiment worked\nThe experiment placed the WebView as the sole child of a PanelContainer at local position (0,0). With `get_screen_position()` returning screen coords, the offset was the Godot window position — which happened to be (0, 0) because the experiment ran maximized on a single monitor. The bug was masked, not absent.\n\n### Fix\nReplaced all occurrences of `get_screen_position()` with `get_global_position()` in lib.rs. `get_global_position()` returns viewport-relative coordinates (position within Godot''s rendering area), which is what `set_bounds()` needs for a child window of the Godot OS window.\n\n### Build\n```bash\ncd vendor/godot_wry/rust\ncargo build --release\ncp target/release/libgodot_wry.so ../../src/addons/godot_wry/bin/x86_64-unknown-linux-gnu/\n```\n\nRebuilt binary deployed. Awaiting test to confirm fix.','\n',char(10)),'open','2026-03-27T16:25:50','','');
CREATE TABLE saved_queries (name TEXT PRIMARY KEY, query_json TEXT NOT NULL);
CREATE TABLE docket_secrets (
			handle TEXT PRIMARY KEY,
			ciphertext BLOB NOT NULL,
			iv BLOB NOT NULL,
			mac BLOB NOT NULL,
			created_at TEXT NOT NULL,
			updated_at TEXT NOT NULL,
			requires_2fa INTEGER DEFAULT 0
		);
CREATE TABLE docket_secret_versions (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			handle TEXT NOT NULL,
			version INTEGER NOT NULL,
			ciphertext BLOB NOT NULL,
			iv BLOB NOT NULL,
			mac BLOB NOT NULL,
			created_at TEXT NOT NULL,
			rotated_by TEXT DEFAULT ''
		);
CREATE TABLE transition_log (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			timestamp TEXT NOT NULL,
			item_type TEXT NOT NULL,
			from_state TEXT NOT NULL,
			attempted_to TEXT NOT NULL,
			succeeded INTEGER NOT NULL DEFAULT 0,
			valid_transitions TEXT DEFAULT ''
		);
