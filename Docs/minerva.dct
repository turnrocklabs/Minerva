INSERT INTO item_events VALUES(518,'019cc71fb63e72fba82c331292901282','transition','agent','2026-03-07T07:47:26','in_progress → done. Added voice mode toggle button (V) in ChatControls, _on_voice_transcription_completed for auto-send, _voice_speak_response for TTS playback after LLM response, _load_wav_into_stream helper, TTS player node. Hooked into update_ui_after_response.');
