INSERT INTO item_events VALUES(515,'019cc71f9f71705488374082f93e5243','transition','agent','2026-03-07T07:45:25','in_progress → done. Refactored AudioToText to route STT through VoiceConfig provider selection. Extracted _read_wav_file(), split into _start_voice_service_stt() and _start_whisper_stt(), unified completion via _finish_transcription(). Added transcription_completed signal for push-to-talk consumers. All existing callers unchanged.');
