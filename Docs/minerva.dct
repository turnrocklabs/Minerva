INSERT INTO item_events VALUES(39,'DKT-0018','transition','agent','2026-03-02T17:49:26','triaged → closed. Fixed: denied question tool in opencode.json + stall diagnosis in orchestrator + /session-state endpoint in proxy.');
INSERT INTO item_events VALUES(40,'DKT-0020','transition','agent','2026-03-02T17:49:26','triaged → closed. Fixed: checks both stdout+stderr in _run_validation_commands().');
INSERT INTO item_events VALUES(41,'DKT-0021','transition','agent','2026-03-02T17:49:27','triaged → closed. Fixed: added post-review re-packaging step.');
INSERT INTO item_events VALUES(42,'DKT-0025','transition','agent','2026-03-02T17:49:28','triaged → closed. Fixed: added review_agents_changed signal.');
INSERT INTO item_events VALUES(43,'DKT-0026','transition','agent','2026-03-02T17:49:29','triaged → closed. Resolved: rebuilt storage-main with --no-cache on AWS.');
INSERT INTO item_events VALUES(44,'DKT-0027','transition','agent','2026-03-02T17:49:29','triaged → closed. Fixed: mutate dict instead of reassign in lambda.');
INSERT INTO item_events VALUES(45,'DKT-0012','transition','agent','2026-03-02T17:49:30','triaged → closed. Superseded by DKT-0016 (validation gate false positives).');
