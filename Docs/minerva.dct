INSERT INTO item_events VALUES(512,'019cc71f658a7439a7250b6006f1e108','transition','agent','2026-03-07T07:44:09','in_progress → done. Created VoiceConfig.gd for persistence + Voice Preferences tab in PreferencesPopup with STT/TTS provider selectors, backend filter, voice picker with refresh/preview, volume slider, auto-play/auto-send toggles, whisper fallback toggle, and status check.');
