PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE docket_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
INSERT INTO docket_meta VALUES('version','2.0.0');
INSERT INTO docket_meta VALUES('counter','18');
INSERT INTO docket_meta VALUES('project','minerva-experiments');
INSERT INTO docket_meta VALUES('ui_scale','1.15');
INSERT INTO docket_meta VALUES('id_prefix','INE');
CREATE TABLE items (
		id TEXT PRIMARY KEY,
		type TEXT NOT NULL, status TEXT NOT NULL,
		title TEXT NOT NULL DEFAULT '', description TEXT DEFAULT '',
		created_at TEXT NOT NULL, updated_at TEXT NOT NULL,
		created_by TEXT DEFAULT '', assigned_to TEXT DEFAULT '',
		directed_to TEXT DEFAULT '',
		priority INTEGER DEFAULT 0, severity INTEGER DEFAULT 0,
		resolution TEXT, environment TEXT, repro_steps TEXT,
		assumed TEXT, corrected TEXT, answer TEXT,
		occurred_at TEXT, detected_at TEXT, reported_at TEXT,
		why_chain TEXT, significant_events TEXT, contributing_factors TEXT,
		value TEXT, component TEXT, key TEXT,
		topic TEXT, subtopic TEXT, confidence TEXT,
		surprise TEXT, surfaced_from TEXT,
		retrieval_count INTEGER DEFAULT 0, research_cost INTEGER DEFAULT 0,
		blocked_by TEXT
	, parent TEXT DEFAULT '', findings TEXT);
/****** CORRUPTION ERROR *******/
CREATE TABLE item_tags (
		item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
		tag TEXT NOT NULL, PRIMARY KEY (item_id, tag)
	);
/****** CORRUPTION ERROR *******/
CREATE TABLE item_events (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
		event_type TEXT NOT NULL, actor TEXT DEFAULT '',
		timestamp TEXT NOT NULL, note TEXT DEFAULT ''
	);
/****** CORRUPTION ERROR *******/
CREATE TABLE attachments (
		id INTEGER PRIMARY KEY AUTOINCREMENT,
		item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
		filename TEXT NOT NULL,
		mime_type TEXT DEFAULT 'application/octet-stream',
		size_bytes INTEGER DEFAULT 0,
		data BLOB NOT NULL,
		created_at TEXT NOT NULL,
		description TEXT DEFAULT ''
	);
/****** CORRUPTION ERROR *******/
CREATE TABLE saved_queries (name TEXT PRIMARY KEY, query_json TEXT NOT NULL);
/****** CORRUPTION ERROR *******/
CREATE TABLE comments (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			item_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
			author TEXT NOT NULL DEFAULT '',
			text TEXT NOT NULL DEFAULT '',
			status TEXT NOT NULL DEFAULT 'open',
			created_at TEXT NOT NULL,
			addressed_at TEXT DEFAULT '',
			addressed_by TEXT DEFAULT ''
		, parent_id INTEGER DEFAULT 0, resolved_at TEXT DEFAULT '', resolved_by TEXT DEFAULT '');
/****** CORRUPTION ERROR *******/
CREATE TABLE docket_secrets (
			handle TEXT PRIMARY KEY,
			ciphertext BLOB NOT NULL,
			iv BLOB NOT NULL,
			mac BLOB NOT NULL,
			created_at TEXT NOT NULL,
			updated_at TEXT NOT NULL,
			requires_2fa INTEGER DEFAULT 0
		);
/****** CORRUPTION ERROR *******/
CREATE TABLE docket_secret_versions (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			handle TEXT NOT NULL,
			version INTEGER NOT NULL,
			ciphertext BLOB NOT NULL,
			iv BLOB NOT NULL,
			mac BLOB NOT NULL,
			created_at TEXT NOT NULL,
			rotated_by TEXT DEFAULT ''
		);
/****** CORRUPTION ERROR *******/
CREATE TABLE transition_log (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			timestamp TEXT NOT NULL,
			item_type TEXT NOT NULL,
			from_state TEXT NOT NULL,
			attempted_to TEXT NOT NULL,
			succeeded INTEGER NOT NULL DEFAULT 0,
			valid_transitions TEXT DEFAULT ''
		);
/****** CORRUPTION ERROR *******/
CREATE TABLE mcp_error_log (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			timestamp TEXT NOT NULL,
			tool_name TEXT NOT NULL,
			error_message TEXT NOT NULL,
			arg_keys TEXT DEFAULT ''
		);
/****** CORRUPTION ERROR *******/
CREATE TABLE IF NOT EXISTS "item_links" (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			from_id TEXT NOT NULL REFERENCES items(id) ON DELETE CASCADE,
			to_id TEXT NOT NULL,
			relation TEXT NOT NULL
		);
DELETE FROM sqlite_sequence;
INSERT INTO sqlite_sequence VALUES('item_events',21);
INSERT INTO sqlite_sequence VALUES('item_links',0);
CREATE INDEX idx_items_type ON items(type);
CREATE INDEX idx_items_status ON items(status);
CREATE INDEX idx_items_type_status ON items(type, status);
CREATE INDEX idx_items_component_key ON items(component, key);
CREATE INDEX idx_tags_tag ON item_tags(tag);
CREATE INDEX idx_events_item ON item_events(item_id);
CREATE INDEX idx_attachments_item ON attachments(item_id);
CREATE INDEX idx_comments_item ON comments(item_id);
CREATE INDEX idx_comments_status ON comments(status);
CREATE INDEX idx_comments_parent ON comments(parent_id);
CREATE INDEX idx_secret_versions_handle ON docket_secret_versions(handle);
CREATE INDEX idx_transition_log_type ON transition_log(item_type);
CREATE INDEX idx_mcp_error_tool ON mcp_error_log(tool_name);
