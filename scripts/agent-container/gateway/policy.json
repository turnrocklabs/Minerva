{
  "comment": "Agent-container MCP allowlist. Deny by default: a tool, argument or value not listed here never reaches the upstream. Argument kinds: line (one line, <=512 chars), text (<=64 KiB), int, bool, str_list, json (any JSON, <=64 KiB encoded), ref (Docket item id: 32 hex, or allowed-project:32 hex), note_id (Minerva note id; the session's note grants decide which), project (must be one of the session's Docket projects), {enum: [...]}. Tool schemas shown to the container are generated from these specs. 'rule' names the check in mcp_policy.py that runs after argument validation. Minerva item ids and item types are data owned by the upstreams; see design minerva:01a0c9aeecc8 #2080.",
  "docket_readable_types": [
    "bug",
    "work_item",
    "chore",
    "question",
    "discussion",
    "hint",
    "insight",
    "test",
    "dcr",
    "kb",
    "rca"
  ],
  "docket_mutable_types": [
    "bug",
    "work_item",
    "chore",
    "question",
    "discussion",
    "hint",
    "insight",
    "test"
  ],
  "services": {
    "minerva": {
      "minerva_terminal_notify": {
        "args": {
          "to": "line",
          "text": "line",
          "from": "line",
          "reply_to": "line",
          "wait_ms": "int"
        },
        "required": [
          "to",
          "text"
        ],
        "rule": "terminal_notify"
      },
      "minerva_terminal_list": {
        "args": {},
        "required": [],
        "rule": "terminal_list"
      },
      "minerva_get_note": {
        "args": {
          "note_id": "note_id"
        },
        "required": [
          "note_id"
        ],
        "rule": "note_read"
      },
      "minerva_update_note": {
        "args": {
          "note_id": "note_id",
          "content": "text",
          "title": "line",
          "if_revision": "int"
        },
        "required": [
          "note_id"
        ],
        "rule": "note_write"
      },
      "minerva_append_note": {
        "args": {
          "note_id": "note_id",
          "text": "text",
          "request_id": "line"
        },
        "required": [
          "note_id",
          "text",
          "request_id"
        ],
        "rule": "note_append"
      },
      "minerva_read_note_since": {
        "args": {
          "note_id": "note_id",
          "cursor": "line",
          "limit": "int"
        },
        "required": [
          "note_id",
          "cursor"
        ],
        "rule": "note_read_since"
      }
    },
    "docket": {
      "docket_get": {
        "args": {
          "id": "ref",
          "project": "project",
          "include": "str_list"
        },
        "required": [
          "id",
          "project"
        ],
        "rule": "docket_get"
      },
      "docket_query": {
        "args": {
          "project": "project",
          "filter": "json",
          "sort": "json",
          "limit": "int",
          "detail": {
            "enum": [
              "full"
            ]
          }
        },
        "required": [
          "project"
        ],
        "rule": "docket_query"
      },
      "docket_comment": {
        "args": {
          "action": {
            "enum": [
              "list",
              "add"
            ]
          },
          "item_id": "ref",
          "project": "project",
          "text": "text"
        },
        "required": [
          "action",
          "item_id",
          "project"
        ],
        "rule": "docket_comment"
      },
      "docket_create": {
        "args": {
          "type": "line",
          "title": "line",
          "project": "project",
          "description": "text",
          "summary": "text",
          "priority": "int",
          "severity": "int",
          "component": "line",
          "tags": "str_list",
          "parent": "ref",
          "blocked_by": "ref",
          "assigned_to": "line",
          "directed_to": "line",
          "repro_steps": "text",
          "expected_result": "text",
          "environment": "text",
          "findings": "text",
          "answer": "text",
          "key": "line",
          "value": "text",
          "article": "text",
          "test_setup": "text",
          "test_steps": "text"
        },
        "required": [
          "type",
          "title",
          "project"
        ],
        "rule": "docket_create"
      },
      "docket_update": {
        "args": {
          "id": "ref",
          "project": "project",
          "title": "line",
          "description": "text",
          "summary": "text",
          "priority": "int",
          "severity": "int",
          "component": "line",
          "tags": "str_list",
          "parent": "ref",
          "blocked_by": "ref",
          "assigned_to": "line",
          "directed_to": "line",
          "repro_steps": "text",
          "expected_result": "text",
          "environment": "text",
          "findings": "text",
          "answer": "text",
          "value": "text",
          "article": "text",
          "test_setup": "text",
          "test_steps": "text"
        },
        "required": [
          "id",
          "project"
        ],
        "rule": "docket_mutate"
      },
      "docket_transition": {
        "args": {
          "id": "ref",
          "project": "project",
          "to": "line",
          "note": "text",
          "resolution": "text",
          "blocked_by": "ref"
        },
        "required": [
          "id",
          "project",
          "to"
        ],
        "rule": "docket_mutate"
      }
    },
    "nudge": {
      "nudge_get_hint": {
        "args": {
          "component": "line",
          "key": "line",
          "context": "json"
        },
        "required": [
          "component",
          "key"
        ]
      },
      "nudge_set_hint": {
        "args": {
          "component": "line",
          "key": "line",
          "value": "json",
          "meta": "json",
          "if_match_version": "int"
        },
        "required": [
          "component",
          "key",
          "value"
        ]
      },
      "nudge_query": {
        "args": {
          "component": "line",
          "keys": "str_list",
          "tags": "str_list",
          "context": "json",
          "limit": "int"
        },
        "required": []
      },
      "nudge_bump": {
        "args": {
          "component": "line",
          "key": "line",
          "delta": "int"
        },
        "required": [
          "component",
          "key"
        ]
      },
      "nudge_list_components": {
        "args": {},
        "required": []
      }
    }
  }
}
