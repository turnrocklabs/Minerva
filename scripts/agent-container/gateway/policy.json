{
  "comment": "Agent-container MCP allowlist. Deny by default: a tool, argument or value not listed here never reaches the upstream. Argument kinds: line (one line, <=512 chars), text (<=64 KiB), int, bool, str_list, json (any JSON, <=64 KiB encoded), ref (Docket item id: 32 hex, or allowed-project:32 hex), base64 (attachment data, <=900 KiB encoded), note_id (Minerva note id; the session's note grants decide which), project (must be one of the session's Docket projects), {enum: [...]}. Tool schemas shown to the container are generated from these specs. 'rule' names the check in mcp_policy.py that runs after argument validation. Minerva item ids and item types are data owned by the upstreams; see design minerva:01a0c9aeecc8 #2080.",
  "docket_scope": "Docket is scoped to the session's assigned work (docket_scope.py, evaluated on every call from the current records). The session's principals are the identity and role Minerva registered for it, carried in its grant record (control/grants.json). An item is direct when its assigned_to or directed_to equals one of them; the session's chain is its direct items plus their parents up to the first wr:objective. It may read chain items (docket_get, docket_query rows, comments, attachment lists and downloads) and add evidence to them (docket_comment add, docket_attach, docket_create under a chain item). It changes fields only on direct items (docket_update, docket_transition, docket_append, docket_claim, docket_release, docket_reassign), always with holder or actor stamped as its identity, and a protected-field change (W1 contract section 4) also needs the item's claim held by that identity. Everything else is refused as docket_out_of_scope; with no registered identity nothing is in scope.",
  "docket_readable_types": [
    "bug",
    "work_item",
    "chore",
    "question",
    "discussion",
    "hint",
    "insight",
    "test",
    "dcr",
    "kb",
    "rca"
  ],
  "docket_mutable_types": [
    "bug",
    "work_item",
    "chore",
    "question",
    "discussion",
    "hint",
    "insight",
    "test"
  ],
  "services": {
    "minerva": {
      "minerva_terminal_notify": {
        "args": {
          "to": "line",
          "text": "line",
          "from": "line",
          "reply_to": "line",
          "wait_ms": "int"
        },
        "required": [
          "to",
          "text"
        ],
        "rule": "terminal_notify"
      },
      "minerva_terminal_list": {
        "args": {},
        "required": [],
        "rule": "terminal_list"
      },
      "minerva_get_note": {
        "args": {
          "note_id": "note_id"
        },
        "required": [
          "note_id"
        ],
        "rule": "note_read"
      },
      "minerva_update_note": {
        "args": {
          "note_id": "note_id",
          "content": "text",
          "title": "line",
          "if_revision": "int"
        },
        "required": [
          "note_id"
        ],
        "rule": "note_write"
      },
      "minerva_append_note": {
        "args": {
          "note_id": "note_id",
          "text": "text",
          "request_id": "line"
        },
        "required": [
          "note_id",
          "text",
          "request_id"
        ],
        "rule": "note_append"
      },
      "minerva_read_note_since": {
        "args": {
          "note_id": "note_id",
          "cursor": "line",
          "limit": "int"
        },
        "required": [
          "note_id",
          "cursor"
        ],
        "rule": "note_read_since"
      }
    },
