# Godot 4+ specific ignores
.godot/
.vscode/
.claude/
*.so.*
*.so

# docker stuff
.env

# Secrets / credentials (defense-in-depth)
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
config.local.*

# Minerva Project Save files
*.minproj

# binary files
*.wav
*.wav.import
*.tmp

# gdextension build artifacts
bin/
*.obj
*.os
*.exp
~*.dll
.zig-cache/
zig-out/

# godot_wry addon binary (built from vendor/godot_wry submodule)
src/addons/godot_wry/bin/**/*.so
src/addons/godot_wry/bin/**/*.dylib
src/addons/godot_wry/bin/**/*.dll
src/addons/godot_wry/bin/**/*.framework/

# ffmpeg addon binaries (downloaded or built from vendor/EIRTeam.FFmpeg)
src/addons/ffmpeg/linux64/*.so*
src/addons/ffmpeg/macos/*.dylib
src/addons/ffmpeg/macos/*.framework/
src/addons/ffmpeg/win64/*.dll
src/addons/ffmpeg/win64/*.lib
src/addons/ffmpeg/.ffmpeg-version

# godot-sqlite addon binaries (downloaded by build script)
src/addons/godot-sqlite/bin/
src/addons/godot-sqlite/.sqlite-version
*.dbliteMinerva.dmg

# Stream Deck plugin compiled binaries
plugins/elgato/dist/
plugins/elgato/node_modules/

# SQLite journal files and cache
*.dct-wal
*.dct-shm
*.dct.cache
*.dct.cache-shm
*.dct.cache-wal
*.dct.lock
*.dct.tmp.*
.sconsign.dblite

# Sightline editor probe output (experimental tool — debugger state snapshots)
.sightline/

# host.pdf sidecar: stray in-place go build artifact (real binary goes to src/bin/)
src/sidecars/host_pdf/minerva-host-pdf

# host.pdf nametag pixel-diff gate: venv + generated/rasterized artifacts.
# Committed fixtures (sample.xlsx, icon.png), the harness, and the scripts stay.
src/sidecars/host_pdf/testdata/nametag_gate/.venv/
src/sidecars/host_pdf/testdata/nametag_gate/.gobuild/
src/sidecars/host_pdf/testdata/nametag_gate/reference.pdf
src/sidecars/host_pdf/testdata/nametag_gate/candidate.pdf
src/sidecars/host_pdf/testdata/nametag_gate/*.png
# keep the committed icon fixture (the *.png rule above would otherwise ignore it)
!src/sidecars/host_pdf/testdata/nametag_gate/icon.png

# Spurious Godot editor .import sidecars for the Go host.pdf sidecar assets
# (the sidecar dir is NOT a Godot resource location — the editor just indexed it)
src/sidecars/**/*.import
