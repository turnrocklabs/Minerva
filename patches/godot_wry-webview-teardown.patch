+impl Drop for WebView {
+    fn drop(&mut self) {
+        // Native callbacks can race destruction. Revoke their access to the
+        // cloned Godot base before destroying the platform webview.
+        self.callbacks_alive.store(false, Ordering::Release);
+        if let Some(webview) = self.webview.take() {
+            let _ = webview.set_visible(false);
+            drop(webview);
+            #[cfg(target_os = "linux")]
+            {
+                // WebKitGTK destroys its child surface lazily; finish a bounded
+                // amount of native teardown even when this was the last view.
+                let mut i = 0;
+                while gtk::events_pending() && i < 64 {
+                    gtk::main_iteration_do(false);
+                    i += 1;
+                }
+            }
+        }
+    }
+}
