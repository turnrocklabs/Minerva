+    let mut module_path = [0_u16; 32_768];
+    let path_len = unsafe {
+        GetModuleFileNameW(module, module_path.as_mut_ptr(), module_path.len() as u32)
+    } as usize;
+    if path_len == 0 || path_len >= module_path.len() {
+        return Err(CefError::InitializationFailed(
+            "loaded CEF module path could not be resolved".into(),
+        ));
+    }
+    let path = String::from_utf16_lossy(&module_path[..path_len]);
+    let is_libcef = Path::new(&path)
+        .file_name()
+        .and_then(|name| name.to_str())
+        .is_some_and(|name| name.eq_ignore_ascii_case("libcef.dll"));
+    if !is_libcef {
