+pub fn finalize_cef() {
+    let diagnostic = std::env::var("MINERVA_PACKAGED_MCP_HELPER_PROBE").as_deref() == Ok("1");
+    {
+        let mut state = lock_cef_state();
+        if diagnostic {
+            let live = LIVE_BROWSERS.with(|browsers| browsers.borrow().len());
+            eprintln!(
+                "[GodotCef] Finalize entry: initialized={}, finalizing={}, refs={}, browsers={}",
+                state.initialized, state.finalizing, state.ref_count, live
+            );
+        }
+        if !state.initialized || state.finalizing {
+            return;
+        }
+        state.finalizing = true;
+    }
+
+    let browsers = LIVE_BROWSERS.with(|live| live.borrow().values().cloned().collect::<Vec<_>>());
+    for browser in &browsers {
+        if let Some(host) = browser.host() {
+            host.close_browser(true as _);
+        }
+    }
+    drop(browsers);
+
+    if diagnostic {
+        let live = LIVE_BROWSERS.with(|browsers| browsers.borrow().len());
+        eprintln!("[GodotCef] Finalize before drain: browsers={live}");
+    }
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while LIVE_BROWSERS.with(|live| !live.borrow().is_empty()) {
+        cef::do_message_loop_work();
+        if Instant::now() >= deadline {
+            eprintln!("[GodotCef] Fatal: browsers did not close before CEF unload");
+            std::process::abort();
+        }
+        std::thread::sleep(Duration::from_millis(1));
     }
+    if diagnostic {
+        eprintln!("[GodotCef] Finalize after drain: browsers=0");
+        eprintln!("[GodotCef] Finalize before CefShutdown");
+    }
+    cef::shutdown();
+    if diagnostic {
+        eprintln!("[GodotCef] Finalize after CefShutdown");
+    }
+    let mut state = lock_cef_state();
+    state.initialized = false;
 }
 
