+
+pub(crate) fn mouse(
+    stage: &str,
+    receiver: &str,
+    event: &Gd<godot::classes::InputEventMouseButton>,
+) {
+    if !enabled() {
+        return;
+    }
+    let kind = match event.get_button_index() {
+        godot::global::MouseButton::LEFT => "left",
+        godot::global::MouseButton::RIGHT => "right",
+        godot::global::MouseButton::MIDDLE => "middle",
+        _ => "other",
+    };
+    godot::global::godot_print!(
+        "[MinervaCefTrace] stream=native seq={} stage={} receiver={} event={:?} kind={} down={}",
+        next_sequence(),
+        stage,
+        receiver,
+        event.instance_id(),
+        kind,
+        event.is_pressed()
+    );
+}
