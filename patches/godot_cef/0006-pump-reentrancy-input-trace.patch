diff --git a/crates/gdcef/src/input_trace.rs b/crates/gdcef/src/input_trace.rs
new file mode 100644
index 0000000..a35e445
--- /dev/null
+++ b/crates/gdcef/src/input_trace.rs
@@ -0,0 +1,48 @@
+//! Opt-in input-path evidence. Never log key codes, text, field values or clipboard data.
+use godot::classes::InputEventKey;
+use godot::global::Key;
+use godot::prelude::*;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+static EVENTS: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn enabled() -> bool {
+    std::env::var("MINERVA_CEF_INPUT_TRACE").as_deref() == Ok("1")
+}
+
+pub(crate) fn event(stage: &str) {
+    if enabled() {
+        let sequence = EVENTS.fetch_add(1, Ordering::Relaxed);
+        godot::global::godot_print!("[MinervaCefTrace] seq={} stage={}", sequence, stage);
+    }
+}
+
+pub(crate) fn key(stage: &str, cef_type: &str, event: &Gd<InputEventKey>) {
+    if !enabled() {
+        return;
+    }
+    let kind = match event.get_keycode() {
+        Key::CTRL => "control",
+        Key::META => "command",
+        Key::SHIFT => "shift",
+        Key::ALT => "alt",
+        _ => "other",
+    };
+    let paste =
+        event.get_keycode() == Key::V && (event.is_ctrl_pressed() || event.is_meta_pressed());
+    let sequence = EVENTS.fetch_add(1, Ordering::Relaxed);
+    godot::global::godot_print!(
+        "[MinervaCefTrace] seq={} stage={} cef_type={} kind={} down={} echo={} ctrl={} cmd={} shift={} alt={} paste={}",
+        sequence,
+        stage,
+        cef_type,
+        kind,
+        event.is_pressed(),
+        event.is_echo(),
+        event.is_ctrl_pressed(),
+        event.is_meta_pressed(),
+        event.is_shift_pressed(),
+        event.is_alt_pressed(),
+        paste
+    );
+}
