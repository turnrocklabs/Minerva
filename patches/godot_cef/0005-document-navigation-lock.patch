+pub(crate) type InitialDocumentLock = Arc<Mutex<InitialDocumentState>>;
+
+#[derive(Default)]
+pub(crate) struct InitialDocumentState {
+    pub expected_url: String,
+    pub initial_allowed: bool,
+    pub cleanup_path: String,
+}
+
+impl InitialDocumentState {
+    fn cleanup(&mut self) {
+        if self.cleanup_path.is_empty() {
+            return;
+        }
+        let path = std::path::PathBuf::from(std::mem::take(&mut self.cleanup_path));
+        let _ = std::fs::remove_file(&path);
+        if let Some(parent) = path.parent() {
+            let _ = std::fs::remove_dir(parent);
+        }
+    }
+}
+
+impl Drop for InitialDocumentState {
+    fn drop(&mut self) {
+        // Also covers browser creation failure, where OnBeforeClose never runs.
+        self.cleanup();
+    }
+}
