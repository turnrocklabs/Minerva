@@ -45,8 +45,25 @@ fn get_dylib_dir() -> CefResult<PathBuf> {
 }
 
 #[cfg(target_os = "macos")]
+fn get_cef_frameworks_dir() -> CefResult<PathBuf> {
+    let dylib_dir = get_dylib_dir()?;
+    // Source/addon layouts put the CEF app beside Godot CEF.framework. Godot's
+    // exporter can flatten libgdcef.dylib into Contents/Frameworks, where the
+    // app is instead beside the dylib itself.
+    let flat_export = dylib_dir.join("Godot CEF.app/Contents/Frameworks");
+    if flat_export.is_dir() {
+        return flat_export.canonicalize().map_err(CefError::from);
+    }
+    dylib_dir
+        .join("..")
+        .join("Godot CEF.app/Contents/Frameworks")
+        .canonicalize()
+        .map_err(CefError::from)
+}
