{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.minerva.streamdeck",
  "Name": "Minerva",
  "Author": "Minerva",
  "Description": "Control Minerva from your Stream Deck — PTT, audio device switching, and more.",
  "Icon": "assets/plugin-icon",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "13" },
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "linux" }
  ],
  "CodePaths": {
    "x86_64-unknown-linux-gnu": "bin/minerva-plugin-linux",
    "x86_64-pc-windows-msvc": "bin/minerva-plugin.exe",
    "aarch64-apple-darwin": "bin/minerva-plugin-mac"
  },
  "CodePathWin": "bin/minerva-plugin.exe",
  "CodePathMac": "bin/minerva-plugin-mac",
  "CodePathLin": "bin/minerva-plugin-linux",
  "PropertyInspectorPath": "propertyInspector/index.html",
  "Actions": [
    {
      "UUID": "com.minerva.streamdeck.ptt",
      "Name": "Push to Talk",
      "Icon": "assets/ptt-idle",
      "Tooltip": "Hold to record voice, release to transcribe",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/ptt-idle",
          "Name": "Idle",
          "TitleAlignment": "top"
        },
        {
          "Image": "assets/ptt-recording",
          "Name": "Recording",
          "TitleAlignment": "top"
        },
        {
          "Image": "assets/ptt-transcribing",
          "Name": "Transcribing",
          "TitleAlignment": "top"
        },
        {
          "Image": "assets/ptt-error",
          "Name": "Error",
          "TitleAlignment": "top"
        }
      ]
    },
    {
      "UUID": "com.minerva.streamdeck.input-device",
      "Name": "Choose Mic",
      "Icon": "assets/mic",
      "Tooltip": "Press to cycle through favorite input audio devices",
      "States": [
        {
          "Image": "assets/mic",
          "TitleAlignment": "top",
          "FontSize": "13"
        }
      ]
    },
    {
      "UUID": "com.minerva.streamdeck.choose-output",
      "Name": "Choose Output",
      "Icon": "assets/speaker",
      "Tooltip": "Cycle through favorite output devices",
      "States": [
        {
          "Image": "assets/speaker",
          "TitleAlignment": "top",
          "FontSize": "13"
        }
      ]
    },
    {
      "UUID": "com.minerva.streamdeck.clear-input",
      "Name": "Clear Input",
      "Icon": "assets/clear",
      "Tooltip": "Clear the chat input box",
      "States": [
        {
          "Image": "assets/clear",
          "TitleAlignment": "top"
        }
      ]
    },
    {
      "UUID": "com.minerva.streamdeck.submit-chat",
      "Name": "Submit Chat",
      "Icon": "assets/submit",
      "Tooltip": "Send the chat message",
      "States": [
        {
          "Image": "assets/submit",
          "TitleAlignment": "top"
        }
      ]
    }
  ]
}
